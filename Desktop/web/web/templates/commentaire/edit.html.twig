{% extends 'base.html.twig' %}

{% block title %}Modifier le commentaire — WinGo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .edit-comment-container {
            max-width: 800px;
            margin: 50px auto;
            padding: 30px;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.06);
        }
        .btn-submit {
            background: linear-gradient(135deg, #8d4fff, #fa9e1c);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 30px;
            cursor: pointer;
        }
        .btn-cancel {
            display: inline-block;
            margin-left: 15px;
            color: #888;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container">
    <div class="edit-comment-container">
        <h2>Modifier votre commentaire</h2>
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_row(form.contenu, {'attr': {'rows': 6, 'class': 'wingo-input'}}) }}
            <button type="submit" class="btn-submit">Enregistrer</button>
        {{ form_end(form) }}
        <a href="{{ path('app_article_show', {id: commentaire.article.id}) }}" class="btn-cancel">Annuler</a>
    </div>
</div>
{% endblock %}