<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controlles.CommentaireController"
            style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <top>
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ImageView fitHeight="30" fitWidth="30">
                    <Image url="@icons/comment-bubble.png" />
                </ImageView>
                <Label text="Gestion des Commentaires"
                       style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #2c3e50;" />
            </HBox>
            <Separator style="-fx-background-color: #ecf0f1;" />
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20 0 0 0;">

            <!-- Info article -->
            <HBox spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 15;">
                <ImageView fitHeight="40" fitWidth="40">
                    <Image url="@icons/article-icon.png" />
                </ImageView>
                <VBox>
                    <Label fx:id="articleTitleLabel" text="Article sélectionné : Aucun"
                           style="-fx-font-weight: 700; -fx-text-fill: #34495e;" />
                    <Label fx:id="articleAuthorLabel" text="Auteur : "
                           style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;" />
                </VBox>
            </HBox>

            <!-- Tableau des commentaires -->
            <Label text="Liste des commentaires" style="-fx-font-weight: 600; -fx-text-fill: #34495e;" />
            <TableView fx:id="commentTable" VBox.vgrow="ALWAYS" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colUtilisateur" text="Utilisateur" prefWidth="120" />
                    <TableColumn fx:id="colContenu" text="Commentaire" prefWidth="300" />
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120" />
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="100" />
                </columns>
            </TableView>

            <!-- Formulaire ajout -->
            <TitledPane text="➕ Ajouter un commentaire" expanded="true"
                        style="-fx-background-color: #f0f7ff; -fx-background-radius: 10;">
                <GridPane hgap="15" vgap="15" style="-fx-padding: 15;">
                    <Label text="Utilisateur:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-weight: 600;" />
                    <TextField fx:id="utilisateurField" promptText="Votre nom"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               prefWidth="250" />

                    <Label text="Commentaire:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-weight: 600;" />
                    <TextArea fx:id="contenuField" promptText="Votre commentaire..."
                              GridPane.rowIndex="1" GridPane.columnIndex="1"
                              prefRowCount="3" prefWidth="250" />

                    <Button text="Publier" onAction="#handleAddComment"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 25;"
                            GridPane.rowIndex="2" GridPane.columnIndex="1"
                            GridPane.halignment="RIGHT" />
                </GridPane>
            </TitledPane>
        </VBox>
    </center>
</BorderPane>