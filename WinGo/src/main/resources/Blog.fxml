<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controlles.BlogController">

    <!-- Top: titre -->
    <top>
        <Label text="Gestion des Blogs" style="-fx-font-size: 24px; -fx-padding: 10;" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <TableView fx:id="blogTable">
                <columns>
                    <TableColumn text="ID" fx:id="colId"/>
                    <TableColumn text="Titre" fx:id="colTitre"/>
                    <TableColumn text="Contenu" fx:id="colContenu"/>
                    <TableColumn text="Auteur" fx:id="colAuteur"/>
                    <TableColumn text="Region" fx:id="colRegion"/>
                    <TableColumn text="Categorie" fx:id="colCategorie"/>
                </columns>
            </TableView>

            <Label text="Commentaires:"/>
            <ListView fx:id="commentaireList" prefHeight="150"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="80"/>
                </columnConstraints>

                <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Contenu:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextArea fx:id="contenuField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Image:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="imageField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Auteur:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="auteurField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Region:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="regionField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Categorie:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="categorieField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Ajouter" fx:id="btnAjouter" onAction="#ajouterBlog"/>
                <Button text="Modifier" fx:id="btnModifier" onAction="#modifierBlog"/>
                <Button text="Supprimer" fx:id="btnSupprimer" onAction="#supprimerBlog"/>
            </HBox>
        </VBox>
    </bottom>