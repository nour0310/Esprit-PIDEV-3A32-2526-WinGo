<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controlles.BlogController">

    <top>
        <Label text="Gestion des Blogs" style="-fx-font-size: 24px; -fx-padding: 10 0 10 0;" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <children>
                <FlowPane fx:id="articlesFlowPane" hgap="10.0" vgap="10.0"/>
                <Label text="Commentaires:"/>
                <FlowPane fx:id="commentairesFlowPane" hgap="5.0" vgap="5.0" prefHeight="150.0"/>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <children>
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="80"/>
                    </columnConstraints>

                    <children>
                        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Contenu:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextArea fx:id="contenuField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Image:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="imageField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Auteur:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="auteurField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Region:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="regionField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Categorie:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="categorieField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Nouveau commentaire:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="newCommentField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <HBox spacing="10.0">
                    <children>
                        <Button text="Ajouter" onAction="#ajouterBlog"/>
                        <Button text="Modifier" onAction="#modifierBlog"/>
                        <Button text="Supprimer" onAction="#supprimerBlog"/>
                        <Button text="Ajouter commentaire" onAction="#ajouterCommentaire"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>