<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.BlogController">

    <!-- BACKGROUND IMAGE -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/sidi.jpg');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: 100% 100%;" />

    <!-- Overlay -->
    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.18);" />

    <!-- Main glass shell -->
    <BorderPane maxHeight="650" maxWidth="1100"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect><DropShadow color="#00000066" offsetY="14" radius="28" /></effect>
        <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>

                <!-- Logo et titre -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fitHeight="100" fitWidth="100" preserveRatio="true">
                        <Image url="@/logo.png" />
                    </ImageView>
                    <Label text="WinGo Travel"
                           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search bar -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.22);
                             -fx-background-radius: 999;
                             -fx-padding: 8 10;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95;" />
                    <TextField fx:id="searchField" promptText="Rechercher un article..."
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 340;" />
                    <Button fx:id="searchBtn" text="⚙"
                            style="-fx-background-color: #FFBD00;
                                   -fx-text-fill: #390099;
                                   -fx-background-radius: 999;
                                   -fx-font-weight: 900;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Notification button with badge -->
                <StackPane>
                    <Button fx:id="notificationButton" text="🔔"
                            style="-fx-background-color: rgba(0,0,0,0.22);
                                   -fx-text-fill: white;
                                   -fx-background-radius: 14;
                                   -fx-padding: 8 12;" />
                    <Label fx:id="notificationBadge" text="0"
                           style="-fx-background-color: red; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 2 5; -fx-font-size: 10px;"
                           visible="false" StackPane.alignment="TOP_RIGHT" />
                </StackPane>
            </HBox>
        </top>

        <!-- LEFT MINI NAV -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="18" left="12" right="12" top="18" /></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-font-size: 24px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <Button text="🔍" onAction="#goBlog"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <Button text="👤" onAction="#goCommentaires"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <!-- BOUTON FAVORIS (SIGNET) -->
                <Button text="🔖" onAction="#afficherFavoris"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <Button text="🔔" onAction="#goSettings"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <Button text="⚙" onAction="#goSettings"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                <effect><DropShadow color="#00000055" offsetY="10" radius="18"/></effect>

                <!-- ScrollPane pour la vue liste -->
                <ScrollPane fx:id="listViewScroll" fitToWidth="true" visible="true" managed="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox fx:id="listView" spacing="12">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>

                            <!-- HERO SECTION -->
                            <HBox spacing="12">
                                <VBox spacing="6" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(0,0,0,0.32);
                                             -fx-background-radius: 18;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 18;">
                                    <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>

                                    <Label text="Blog WinGo"
                                           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900;"/>

                                    <Label text="Découvrez les plus belles destinations, expériences et saveurs de la Tunisie à travers nos articles passionnants."
                                           wrapText="true"
                                           style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 11px; -fx-font-weight: 700;"/>

                                    <HBox spacing="6">
                                        <Label text="📖" style="-fx-font-size: 14px;" />
                                        <Label text="Articles et commentaires"
                                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-weight: 800;" />
                                    </HBox>
                                </VBox>

                                <!-- STATS MINI CARD -->
                                <VBox prefWidth="200" spacing="6"
                                      style="-fx-background-color: rgba(0,0,0,0.30);
                                             -fx-background-radius: 18;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 18;">
                                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>

                                    <Label text="Statistiques"
                                           style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12px; -fx-font-weight: 800;"/>
                                    <Label text="📰 Articles : "
                                           style="-fx-text-fill: #FFBD00; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                                    <Label fx:id="totalBlogsLabel" text="0"
                                           style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                                    <Separator opacity="0.28" />
                                    <Label text="💬 Commentaires : "
                                           style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                    <Label fx:id="totalCommentsLabel" text="0"
                                           style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                                </VBox>
                            </HBox>

                            <!-- FILTRES -->
                            <HBox spacing="6" alignment="CENTER_LEFT"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 18;
                                         -fx-border-color: #c49a6c;
                                         -fx-border-radius: 18;
                                         -fx-padding: 6 10;">
                                <Label text="Filtrer par :" style="-fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 11px;"/>
                                <ComboBox fx:id="regionFilterCombo" promptText="Région"
                                          style="-fx-background-color: rgba(0,0,0,0.5);
                                                 -fx-background-radius: 8;
                                                 -fx-border-color: rgba(255,255,255,0.3);
                                                 -fx-border-radius: 8;
                                                 -fx-text-fill: white; -fx-pref-width: 120;" />
                                <ComboBox fx:id="categorieFilterCombo" promptText="Catégorie"
                                          style="-fx-background-color: rgba(0,0,0,0.5);
                                                 -fx-background-radius: 8;
                                                 -fx-border-color: rgba(255,255,255,0.3);
                                                 -fx-border-radius: 8;
                                                 -fx-text-fill: white; -fx-pref-width: 120;" />
                            </HBox>

                            <!-- LISTE DES ARTICLES -->
                            <VBox spacing="6" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 18;
                                         -fx-border-color: #c49a6c;
                                         -fx-border-radius: 18;
                                         -fx-padding: 10;">
                                <Label text="📰 Articles récents"
                                       style="-fx-text-fill: #FFBD00; -fx-font-size: 15px; -fx-font-weight: 900;"/>
                                <ScrollPane fitToWidth="true" prefHeight="300"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <FlowPane fx:id="articlesFlowPane" hgap="8" vgap="8"
                                              style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>

                            <!-- FORMULAIRE D'AJOUT D'ARTICLE -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                              -fx-background-radius: 18;
                                              -fx-border-color: #c49a6c;
                                              -fx-border-radius: 18;">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <effect><DropShadow color="#00000055" offsetY="4" radius="8"/></effect>

                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label text="📝" style="-fx-font-size: 16px;" />
                                        <Label text="Formulaire Article"
                                               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="statusLabel" text="Prêt"
                                               style="-fx-text-fill: #FFBD00; -fx-font-weight: 800; -fx-font-size: 11px;" />
                                    </HBox>

                                    <Separator opacity="0.25"/>

                                    <Label fx:id="selectedArticleLabel" text="(aucun article sélectionné)"
                                           style="-fx-text-fill: #FFBD00; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5 0;"/>

                                    <GridPane hgap="8" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50" />
                                            <ColumnConstraints percentWidth="50" />
                                        </columnConstraints>

                                        <!-- ID -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="ID" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <Label fx:id="articleIdLabel" text="Nouveau"
                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                          -fx-background-radius: 8;
                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                          -fx-border-radius: 8;
                                                          -fx-padding: 6 8;
                                                          -fx-text-fill: white; -fx-font-size: 11px;"/>
                                        </VBox>

                                        <!-- Titre -->
                                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Titre" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextField fx:id="titreField" promptText="Titre"
                                                       style="-fx-background-color: rgba(0,0,0,0.5);
                                                              -fx-background-radius: 8;
                                                              -fx-border-color: rgba(255,255,255,0.3);
                                                              -fx-border-radius: 8;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                              -fx-padding: 6 8;
                                                              -fx-font-size: 11px;" />
                                            <Label fx:id="titreError" text="" style="-fx-text-fill: #ff6b6b; -fx-font-size: 10px; -fx-wrap-text: true;" visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Contenu -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                            <Label text="Contenu" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextArea fx:id="contenuField" promptText="Contenu..."
                                                      prefRowCount="2"
                                                      style="-fx-background-color: rgba(0,0,0,0.5);
                                                             -fx-background-radius: 8;
                                                             -fx-border-color: rgba(255,255,255,0.3);
                                                             -fx-border-radius: 8;
                                                             -fx-text-fill: white;
                                                             -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                             -fx-padding: 6 8;
                                                             -fx-font-size: 11px;
                                                             -fx-control-inner-background: rgba(0,0,0,0.5);" />
                                            <Label fx:id="contenuError" text="" style="-fx-text-fill: #ff6b6b; -fx-font-size: 10px; -fx-wrap-text: true;" visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Image + bouton -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label text="Image" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextField fx:id="imageField" promptText="URL"
                                                       style="-fx-background-color: rgba(0,0,0,0.5);
                                                              -fx-background-radius: 8;
                                                              -fx-border-color: rgba(255,255,255,0.3);
                                                              -fx-border-radius: 8;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                              -fx-padding: 6 8;
                                                              -fx-font-size: 11px;" />
                                            <Label fx:id="imageError" text="" style="-fx-text-fill: #ff6b6b; -fx-font-size: 10px; -fx-wrap-text: true;" visible="false" managed="false"/>
                                        </VBox>
                                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2" alignment="BOTTOM_LEFT">
                                            <Button fx:id="choisirImageBtn" text="📁 Choisir"
                                                    style="-fx-background-color: #FFBD00; -fx-text-fill: #390099; -fx-background-radius: 8; -fx-padding: 6 8; -fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand;" />
                                        </VBox>

                                        <!-- Auteur -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                            <Label text="Auteur" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <Label fx:id="auteurLabel" text="(connexion...)"
                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                          -fx-background-radius: 8;
                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                          -fx-border-radius: 8;
                                                          -fx-padding: 6 8;
                                                          -fx-text-fill: white; -fx-font-size: 11px;"/>
                                        </VBox>

                                        <!-- Région -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                            <Label text="Région" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <ComboBox fx:id="regionField" promptText="Région"
                                                      style="-fx-background-color: rgba(0,0,0,0.5);
                                                             -fx-background-radius: 8;
                                                             -fx-border-color: rgba(255,255,255,0.3);
                                                             -fx-border-radius: 8;
                                                             -fx-text-fill: white; -fx-pref-width: 130; -fx-font-size: 11px;" />
                                            <Label fx:id="regionError" text="" style="-fx-text-fill: #ff6b6b; -fx-font-size: 10px; -fx-wrap-text: true;" visible="false" managed="false"/>
                                        </VBox>

                                        <!-- Catégorie -->
                                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                            <Label text="Catégorie" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <ComboBox fx:id="categorieField" promptText="Catégorie"
                                                      style="-fx-background-color: rgba(0,0,0,0.5);
                                                             -fx-background-radius: 8;
                                                             -fx-border-color: rgba(255,255,255,0.3);
                                                             -fx-border-radius: 8;
                                                             -fx-text-fill: white; -fx-pref-width: 130; -fx-font-size: 11px;" />
                                            <Label fx:id="categorieError" text="" style="-fx-text-fill: #ff6b6b; -fx-font-size: 10px; -fx-wrap-text: true;" visible="false" managed="false"/>
                                        </VBox>

                                        <!-- TAGS -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2">
                                            <Label text="Tags (séparés par des virgules)" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextField fx:id="tagsField" promptText="ex: voyage, été, plage"
                                                       style="-fx-background-color: rgba(0,0,0,0.5);
                                                              -fx-background-radius: 8;
                                                              -fx-border-color: rgba(255,255,255,0.3);
                                                              -fx-border-radius: 8;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                              -fx-padding: 6 8;
                                                              -fx-font-size: 11px;" />
                                        </VBox>
                                    </GridPane>

                                    <!-- Boutons CRUD -->
                                    <HBox spacing="6" alignment="CENTER">
                                        <Button fx:id="ajouterBtn" text="➕ Ajouter" onAction="#ajouterBlog"
                                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="modifierBtn" text="✏️ Modifier" onAction="#modifierBlog"
                                                style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="supprimerBtn" text="🗑️ Supprimer" onAction="#supprimerBlog"
                                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="clearBtn" text="🔄 Nouveau" onAction="#clearForm"
                                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                    </HBox>
                                </VBox>
                            </StackPane>

                            <!-- FORMULAIRE D'AJOUT DE COMMENTAIRE -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                              -fx-background-radius: 18;
                                              -fx-border-color: #c49a6c;
                                              -fx-border-radius: 18;">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <VBox spacing="6">
                                    <Label text="➕ Ajouter un commentaire"
                                           style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 900;"/>
                                    <HBox spacing="6">
                                        <TextField fx:id="newCommentField" promptText="Votre commentaire..."
                                                   HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                          -fx-background-radius: 8;
                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                          -fx-border-radius: 8;
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                          -fx-padding: 6 8;
                                                          -fx-font-size: 11px;" />
                                        <Label fx:id="connectedUserLabel" text="(connexion...)"
                                               style="-fx-background-color: rgba(0,0,0,0.5);
                                                      -fx-background-radius: 8;
                                                      -fx-border-color: rgba(255,255,255,0.3);
                                                      -fx-border-radius: 8;
                                                      -fx-padding: 6 8;
                                                      -fx-text-fill: white;
                                                      -fx-font-size: 11px;
                                                      -fx-alignment: center;" />
                                        <Button fx:id="addCommentBtn" text="Envoyer" onAction="#ajouterCommentaire"
                                                style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;" />
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- VUE DÉTAIL -->
                <ScrollPane fx:id="detailViewScroll" fitToWidth="true" visible="false" managed="false"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox fx:id="detailView" spacing="25" alignment="TOP_CENTER"
                              style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 30; -fx-padding: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 20, 0.5, 0, 10); -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1.5; -fx-border-radius: 30;">

                            <Button fx:id="backToListBtn" text="← Retour aux articles"
                                    maxWidth="Infinity" alignment="CENTER_LEFT"
                                    style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 50; -fx-cursor: hand; -fx-font-size: 14px; -fx-border-color: rgba(255,255,255,0.4); -fx-border-radius: 50;"/>

                            <StackPane fx:id="detailImageContainer" prefHeight="300" maxWidth="Infinity"
                                       style="-fx-background-color: rgba(0,0,0,0.2); -fx-background-radius: 30 30 0 0; -fx-border-radius: 30 30 0 0;">
                                <ImageView fx:id="detailImageView" preserveRatio="true" smooth="true" cache="true" />
                                <Pane style="-fx-background-color: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.7) 100%);" />
                                <Label fx:id="detailTitreLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true; -fx-text-alignment: center; -fx-padding: 0 20 20 20; -fx-effect: dropshadow(gaussian, black, 5, 0.5, 2, 2);" StackPane.alignment="BOTTOM_CENTER" />
                            </StackPane>

                            <HBox spacing="30" alignment="CENTER" style="-fx-padding: 0 20;">
                                <HBox spacing="8" alignment="CENTER">
                                    <Label text="👤" style="-fx-font-size: 18px; -fx-text-fill: white;"/>
                                    <Label fx:id="detailAuteurLabel" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER">
                                    <Label text="📅" style="-fx-font-size: 18px; -fx-text-fill: white;"/>
                                    <Label fx:id="detailDateLabel" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
                                </HBox>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 20;">
                                <Button fx:id="detailLikeButton"
                                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                                    <graphic>
                                        <ImageView fx:id="detailLikeImageView" fitHeight="24" fitWidth="24" preserveRatio="true"/>
                                    </graphic>
                                </Button>
                                <Label fx:id="detailLikeCountLabel" text="0 like"
                                       style="-fx-font-size: 18px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                <!-- BOUTON FAVORI (SIGNET) -->
                                <Button fx:id="detailFavButton" text="🔖"
                                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 24px;" />
                            </HBox>

                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 20;">
                                <HBox fx:id="detailStarsBox" spacing="2" alignment="CENTER"/>
                                <Label fx:id="detailAvgLabel" text="0.0 (0 votes)" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                            </HBox>

                            <!-- Météo avec icône -->
                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 20;">
                                <ImageView fx:id="detailMeteoIcon" fitHeight="32" fitWidth="32" preserveRatio="true"/>
                                <Label fx:id="detailMeteoLabel" text="⏳ Chargement météo..." style="-fx-text-fill: #3498db; -fx-font-size: 14px;"/>
                            </HBox>

                            <!-- ZONE DE TRADUCTION ET ÉCOUTE -->
                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 20;">
                                <ComboBox fx:id="langueCombo" promptText="Langue cible"
                                          style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 5 10;"/>
                                <Button fx:id="traduireBtn" text="🌐 Traduire"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 8 20; -fx-cursor: hand;"/>
                                <Button fx:id="ecouterBtn" text="🔊 Écouter"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 30; -fx-padding: 8 20; -fx-cursor: hand;"/>
                            </HBox>

                            <HBox fx:id="detailShareBox" spacing="10" alignment="CENTER" style="-fx-padding: 0 20;"/>

                            <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20; -fx-padding: 20; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 20;">
                                <Label text="📝 Récit de voyage" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-border-color: transparent transparent rgba(255,255,255,0.3) transparent; -fx-border-width: 0 0 2 0; -fx-padding: 0 0 5 0;"/>
                                <Label fx:id="detailContenuLabel" wrapText="true" style="-fx-font-size: 15px; -fx-text-fill: white; -fx-line-spacing: 5;"/>
                            </VBox>

                            <HBox alignment="CENTER" style="-fx-padding: 5 0;">
                                <Rectangle width="50" height="2" style="-fx-fill: rgba(255,255,255,0.5); -fx-arc-width: 2; -fx-arc-height: 2;"/>
                            </HBox>

                            <VBox spacing="15" style="-fx-padding: 0 20 20 20;">
                                <Label text="💬 Commentaires" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, black, 3, 0.3, 1, 1);"/>
                                <ScrollPane fitToWidth="true" prefHeight="200" style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <FlowPane fx:id="detailCommentairesPane" hgap="15" vgap="15" style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>

                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 20 20 20;">
                                <TextField fx:id="detailNewCommentField" promptText="Votre commentaire..." HBox.hgrow="ALWAYS"
                                           style="-fx-padding: 12; -fx-background-radius: 30; -fx-border-radius: 30; -fx-background-color: rgba(255,255,255,0.2); -fx-border-color: rgba(255,255,255,0.4); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px;"/>
                                <Label fx:id="detailConnectedUserLabel" text="(connexion...)"
                                       style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 12 20; -fx-background-radius: 30; -fx-border-radius: 30; -fx-border-color: rgba(255,255,255,0.4); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Button fx:id="detailAddCommentBtn" text="Envoyer"
                                        style="-fx-background-color: rgba(46,204,113,0.8); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 30; -fx-cursor: hand; -fx-font-size: 14px; -fx-border-color: rgba(255,255,255,0.4); -fx-border-width: 1;"/>
                            </HBox>
                            <Label fx:id="detailStatusLabel" style="-fx-text-fill: #2ecc71; -fx-font-size: 13px; -fx-padding: 0 20 20 20; -fx-effect: dropshadow(gaussian, black, 1, 0.2, 1, 1);"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </StackPane>
        </center>

        <!-- BOTTOM NAV -->
        <bottom>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28); -fx-text-fill: #FFBD00; -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="📝" onAction="#goBlog"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="💬" onAction="#goCommentaires"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="❤️" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="👤" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>
