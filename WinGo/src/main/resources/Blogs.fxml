<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.BlogController">

    <!-- BACKGROUND IMAGE -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/testt.png');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: 100% 100%;" />

    <!-- Overlay -->
    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.18);" />

    <!-- Main glass shell -->
    <BorderPane maxHeight="650" maxWidth="1100"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect><DropShadow color="#00000066" offsetY="14" radius="28" /></effect>
        <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>

                <Label text="WinGo Travel"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search bar -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.22);
                             -fx-background-radius: 999;
                             -fx-padding: 8 10;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95;" />
                    <TextField fx:id="searchField" promptText="Rechercher un article..."
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 340;" />
                    <Button fx:id="searchBtn" text="⚙"
                            style="-fx-background-color: #FFBD00;
                                   -fx-text-fill: #390099;
                                   -fx-background-radius: 999;
                                   -fx-font-weight: 900;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="🔔"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white;
                               -fx-background-radius: 14;
                               -fx-padding: 8 12;" />
                <Button text="👤"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white;
                               -fx-background-radius: 14;
                               -fx-padding: 8 12;" />
            </HBox>
        </top>

        <!-- LEFT MINI NAV -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="18" left="12" right="12" top="18" /></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-font-size: 18px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="📝" onAction="#goBlog"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="💬" onAction="#goCommentaires"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="⚙" onAction="#goSettings"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- CENTER CONTENT avec deux vues -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                <effect><DropShadow color="#00000055" offsetY="10" radius="18"/></effect>

                <!-- ScrollPane pour la vue liste -->
                <ScrollPane fx:id="listViewScroll" fitToWidth="true" visible="true" managed="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox fx:id="listView" spacing="12">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>

                            <!-- HERO SECTION (compacte) -->
                            <HBox spacing="12">
                                <VBox spacing="6" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(0,0,0,0.32);
                                             -fx-background-radius: 18;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 18;">
                                    <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>

                                    <Label text="Gestion des Blogs ✍️"
                                           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900;"/>

                                    <Label text="Créez, modifiez ou supprimez vos articles"
                                           style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 11px; -fx-font-weight: 700;"/>

                                    <HBox spacing="6">
                                        <Label text="📝" style="-fx-font-size: 14px;" />
                                        <Label text="Articles et commentaires"
                                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-weight: 800;" />
                                    </HBox>
                                </VBox>

                                <!-- STATS MINI CARD (compacte) -->
                                <VBox prefWidth="200" spacing="6"
                                      style="-fx-background-color: rgba(0,0,0,0.30);
                                             -fx-background-radius: 18;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 18;">
                                    <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>

                                    <Label text="Statistiques"
                                           style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12px; -fx-font-weight: 800;"/>
                                    <Label text="📰 Articles : "
                                           style="-fx-text-fill: #FFBD00; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                                    <Label fx:id="totalBlogsLabel" text="0"
                                           style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                                    <Separator opacity="0.28" />
                                    <Label text="💬 Commentaires : "
                                           style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                    <Label fx:id="totalCommentsLabel" text="0"
                                           style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                                </VBox>
                            </HBox>

                            <!-- FILTRES (compacts) -->
                            <HBox spacing="6" alignment="CENTER_LEFT"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 18;
                                         -fx-border-color: #c49a6c;
                                         -fx-border-radius: 18;
                                         -fx-padding: 6 10;">
                                <Label text="Filtrer par :" style="-fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 11px;"/>
                                <ComboBox fx:id="regionFilterCombo" promptText="Région"
                                          style="-fx-background-color: rgba(0,0,0,0.5);
                                                 -fx-background-radius: 8;
                                                 -fx-border-color: rgba(255,255,255,0.3);
                                                 -fx-border-radius: 8;
                                                 -fx-text-fill: white; -fx-pref-width: 120;" />
                                <ComboBox fx:id="categorieFilterCombo" promptText="Catégorie"
                                          style="-fx-background-color: rgba(0,0,0,0.5);
                                                 -fx-background-radius: 8;
                                                 -fx-border-color: rgba(255,255,255,0.3);
                                                 -fx-border-radius: 8;
                                                 -fx-text-fill: white; -fx-pref-width: 120;" />
                            </HBox>

                            <!-- LISTE DES ARTICLES (agrandie) -->
                            <VBox spacing="6" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 18;
                                         -fx-border-color: #c49a6c;
                                         -fx-border-radius: 18;
                                         -fx-padding: 10;">
                                <Label text="📰 Articles récents"
                                       style="-fx-text-fill: #FFBD00; -fx-font-size: 15px; -fx-font-weight: 900;"/>
                                <ScrollPane fitToWidth="true" prefHeight="300"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <FlowPane fx:id="articlesFlowPane" hgap="8" vgap="8"
                                              style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>

                            <!-- FORMULAIRE D'AJOUT D'ARTICLE (compact) -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                              -fx-background-radius: 18;
                                              -fx-border-color: #c49a6c;
                                              -fx-border-radius: 18;">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <effect><DropShadow color="#00000055" offsetY="4" radius="8"/></effect>

                                <VBox spacing="8">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label text="📝" style="-fx-font-size: 16px;" />
                                        <Label text="Formulaire Article"
                                               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="statusLabel" text="Prêt"
                                               style="-fx-text-fill: #FFBD00; -fx-font-weight: 800; -fx-font-size: 11px;" />
                                    </HBox>

                                    <Separator opacity="0.25"/>

                                    <GridPane hgap="8" vgap="8">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50" />
                                            <ColumnConstraints percentWidth="50" />
                                        </columnConstraints>

                                        <!-- ID -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="ID" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <Label fx:id="articleIdLabel" text="Nouveau"
                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                          -fx-background-radius: 8;
                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                          -fx-border-radius: 8;
                                                          -fx-padding: 6 8;
                                                          -fx-text-fill: white; -fx-font-size: 11px;"/>
                                        </VBox>

                                        <!-- Titre -->
                                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Titre" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextField fx:id="titreField" promptText="Titre"
                                                       style="-fx-background-color: rgba(0,0,0,0.5);
                                                              -fx-background-radius: 8;
                                                              -fx-border-color: rgba(255,255,255,0.3);
                                                              -fx-border-radius: 8;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                              -fx-padding: 6 8;
                                                              -fx-font-size: 11px;" />
                                        </VBox>

                                        <!-- Contenu -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                            <Label text="Contenu" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextArea fx:id="contenuField" promptText="Contenu..."
                                                      prefRowCount="2"
                                                      style="-fx-background-color: rgba(0,0,0,0.5);
                                                             -fx-background-radius: 8;
                                                             -fx-border-color: rgba(255,255,255,0.3);
                                                             -fx-border-radius: 8;
                                                             -fx-text-fill: white;
                                                             -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                             -fx-padding: 6 8;
                                                             -fx-font-size: 11px;
                                                             -fx-control-inner-background: rgba(0,0,0,0.5);" />
                                        </VBox>

                                        <!-- Image + bouton -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label text="Image" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <TextField fx:id="imageField" promptText="URL"
                                                       style="-fx-background-color: rgba(0,0,0,0.5);
                                                              -fx-background-radius: 8;
                                                              -fx-border-color: rgba(255,255,255,0.3);
                                                              -fx-border-radius: 8;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                              -fx-padding: 6 8;
                                                              -fx-font-size: 11px;" />
                                        </VBox>
                                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2" alignment="BOTTOM_LEFT">
                                            <Button fx:id="choisirImageBtn" text="📁 Choisir"
                                                    style="-fx-background-color: #FFBD00; -fx-text-fill: #390099; -fx-background-radius: 8; -fx-padding: 6 8; -fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand;" />
                                        </VBox>

                                        <!-- Auteur (affiché) -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                            <Label text="Auteur" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <Label fx:id="auteurLabel" text="(connexion...)"
                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                          -fx-background-radius: 8;
                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                          -fx-border-radius: 8;
                                                          -fx-padding: 6 8;
                                                          -fx-text-fill: white; -fx-font-size: 11px;"/>
                                        </VBox>

                                        <!-- Région -->
                                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                            <Label text="Région" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <ComboBox fx:id="regionField" promptText="Région"
                                                      style="-fx-background-color: rgba(0,0,0,0.5);
                                                             -fx-background-radius: 8;
                                                             -fx-border-color: rgba(255,255,255,0.3);
                                                             -fx-border-radius: 8;
                                                             -fx-text-fill: white; -fx-pref-width: 130; -fx-font-size: 11px;" />
                                        </VBox>

                                        <!-- Catégorie -->
                                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                            <Label text="Catégorie" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                            <ComboBox fx:id="categorieField" promptText="Catégorie"
                                                      style="-fx-background-color: rgba(0,0,0,0.5);
                                                             -fx-background-radius: 8;
                                                             -fx-border-color: rgba(255,255,255,0.3);
                                                             -fx-border-radius: 8;
                                                             -fx-text-fill: white; -fx-pref-width: 130; -fx-font-size: 11px;" />
                                        </VBox>
                                    </GridPane>

                                    <!-- Boutons CRUD -->
                                    <HBox spacing="6" alignment="CENTER">
                                        <Button fx:id="ajouterBtn" text="➕ Ajouter" onAction="#ajouterBlog"
                                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="modifierBtn" text="✏️ Modifier" onAction="#modifierBlog"
                                                style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="supprimerBtn" text="🗑️ Supprimer" onAction="#supprimerBlog"
                                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="clearBtn" text="🔄 Nouveau" onAction="#clearForm"
                                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                    </HBox>
                                </VBox>
                            </StackPane>

                            <!-- FORMULAIRE D'AJOUT DE COMMENTAIRE (compact) avec label utilisateur -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                              -fx-background-radius: 18;
                                              -fx-border-color: #c49a6c;
                                              -fx-border-radius: 18;">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <VBox spacing="6">
                                    <Label text="➕ Ajouter un commentaire"
                                           style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 900;"/>
                                    <HBox spacing="6">
                                        <TextField fx:id="newCommentField" promptText="Votre commentaire..."
                                                   HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                          -fx-background-radius: 8;
                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                          -fx-border-radius: 8;
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                          -fx-padding: 6 8;
                                                          -fx-font-size: 11px;" />
                                        <Label fx:id="connectedUserLabel" text="(connexion...)"
                                               style="-fx-background-color: rgba(0,0,0,0.5);
                                                      -fx-background-radius: 8;
                                                      -fx-border-color: rgba(255,255,255,0.3);
                                                      -fx-border-radius: 8;
                                                      -fx-padding: 6 8;
                                                      -fx-text-fill: white;
                                                      -fx-font-size: 11px;
                                                      -fx-alignment: center;" />
                                        <Button fx:id="addCommentBtn" text="Envoyer" onAction="#ajouterCommentaire"
                                                style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;" />
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- ScrollPane pour la vue détail -->
                <ScrollPane fx:id="detailViewScroll" fitToWidth="true" visible="false" managed="false"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox fx:id="detailView" spacing="15">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
                            <Button fx:id="backToListBtn" text="← Retour aux articles"
                                    maxWidth="Infinity" alignment="CENTER_LEFT"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 5;" />
                            <StackPane fx:id="detailImageContainer" prefHeight="200" maxWidth="Infinity" style="-fx-background-color: #f0f0f0; -fx-background-radius: 10;">
                                <ImageView fx:id="detailImageView" preserveRatio="true" fitWidth="1" />
                            </StackPane>
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <Label fx:id="detailAuteurLabel" style="-fx-font-size: 13px; -fx-text-fill: #b7472a;" />
                                <Label fx:id="detailDateLabel" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="detailRegionLabel" style="-fx-font-size: 13px; -fx-text-fill: #e67e22;" />
                                <Label fx:id="detailCategorieLabel" style="-fx-font-size: 13px; -fx-text-fill: #3498db;" />
                            </HBox>
                            <Label fx:id="detailContenuLabel" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #2c3e50;" />
                            <Separator />
                            <Label text="Commentaires" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5a3e2b;" />
                            <ScrollPane fitToWidth="true" prefHeight="150">
                                <FlowPane fx:id="detailCommentairesPane" hgap="8" vgap="8" />
                            </ScrollPane>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="detailNewCommentField" promptText="Votre commentaire..." HBox.hgrow="ALWAYS" style="-fx-padding: 6; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ccc;" />
                                <Label fx:id="detailConnectedUserLabel" text="(connexion...)"
                                       style="-fx-background-color: #f0f0f0; -fx-padding: 6; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ccc; -fx-font-size: 13px;" />
                                <Button fx:id="detailAddCommentBtn" text="Commenter" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15; -fx-background-radius: 5;" />
                            </HBox>
                            <Label fx:id="detailStatusLabel" style="-fx-text-fill: #27ae60;" />
                        </VBox>
                    </content>
                </ScrollPane>
            </StackPane>
        </center>

        <!-- BOTTOM NAV -->
        <bottom>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28); -fx-text-fill: #FFBD00; -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="📝" onAction="#goBlog"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="💬" onAction="#goCommentaires"
