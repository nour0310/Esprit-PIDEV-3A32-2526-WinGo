<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane prefWidth="1200" prefHeight="720"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.BlogController">

    <!-- BACKGROUND IMAGE -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/testt.png');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: 100% 100%;" />

    <!-- Overlay -->
    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.18);" />

    <!-- Main glass shell -->
    <BorderPane maxWidth="1100" maxHeight="650"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect><DropShadow color="#00000066" offsetY="14" radius="28" /></effect>
        <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                <Label text="WinGo Travel"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.22);
                             -fx-background-radius: 999;
                             -fx-padding: 8 10;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95;" />
                    <TextField fx:id="searchField" promptText="Rechercher un article..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 340;" />
                    <Button fx:id="searchBtn" text="⚙"
                            style="-fx-background-color: #FFBD00;
                                   -fx-text-fill: #390099;
                                   -fx-background-radius: 999;
                                   -fx-font-weight: 900;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="🔔" style="-fx-background-color: rgba(0,0,0,0.22); -fx-text-fill: white; -fx-background-radius: 14; -fx-padding: 8 12;" />
                <Button text="👤" style="-fx-background-color: rgba(0,0,0,0.22); -fx-text-fill: white; -fx-background-radius: 14; -fx-padding: 8 12;" />
            </HBox>
        </top>

        <!-- LEFT MINI NAV -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets top="18" right="12" bottom="18" left="12"/></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28); -fx-text-fill: #FFBD00; -fx-font-size: 18px; -fx-font-weight: 900; -fx-background-radius: 14; -fx-padding: 12 12;" />
                <Button text="📝" onAction="#goBlog"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-font-size: 18px; -fx-background-radius: 14; -fx-padding: 12 12;" />
                <Button text="💬" onAction="#goCommentaires"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-font-size: 18px; -fx-background-radius: 14; -fx-padding: 12 12;" />
                <Button text="⚙" onAction="#goSettings"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-font-size: 18px; -fx-background-radius: 14; -fx-padding: 12 12;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <effect><DropShadow color="#00000055" offsetY="10" radius="18"/></effect>

                <VBox fx:id="listView" spacing="18" VBox.vgrow="ALWAYS">
                    <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                    <!-- HERO SECTION -->
                    <HBox spacing="16" minHeight="140">
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(0,0,0,0.32); -fx-background-radius: 22; -fx-border-color: rgba(255,255,255,0.18); -fx-border-radius: 22;">
                            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                            <Label text="Gestion des Blogs ✍️"
                                   style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                            <Label text="Créez, modifiez ou supprimez vos articles de voyage"
                                   style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 13px; -fx-font-weight: 700;"/>
                        </VBox>

                        <VBox spacing="10" minWidth="260"
                              style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 22; -fx-border-color: rgba(255,255,255,0.18); -fx-border-radius: 22;">
                            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                            <Label text="Statistiques" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                            <Label text="📰 Articles : " style="-fx-text-fill: #FFBD00; -fx-font-size: 22px; -fx-font-weight: 900;"/>
                            <Label fx:id="totalBlogsLabel" text="0" style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                            <Separator opacity="0.28" />
                            <Label text="💬 Commentaires : " style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                            <Label fx:id="totalCommentsLabel" text="0" style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                        </VBox>
                    </HBox>

                    <!-- LISTE DES ARTICLES -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: rgba(0,0,0,0.28); -fx-background-radius: 22; -fx-border-color: #c49a6c; -fx-border-radius: 22; -fx-padding: 15;">
                        <Label text="📰 Articles récents" style="-fx-text-fill: #FFBD00; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <FlowPane fx:id="articlesFlowPane" hgap="15" vgap="15" style="-fx-background-color: transparent;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- FORMULAIRE ARTICLE -->
                    <StackPane style="-fx-background-color: rgba(0,0,0,0.28); -fx-background-radius: 22; -fx-border-color: #c49a6c; -fx-border-radius: 22;">
                        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                        <VBox spacing="14">
                            <Label text="Formulaire Article" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                            <!-- Les champs: titre, contenu, image, auteur, région, catégorie -->
                            <!-- Boutons CRUD: Ajouter / Modifier / Supprimer / Nouveau -->
                        </VBox>
                    </StackPane>

                    <!-- FORMULAIRE COMMENTAIRE -->
                    <StackPane style="-fx-background-color: rgba(0,0,0,0.28); -fx-background-radius: 22; -fx-border-color: #c49a6c; -fx-border-radius: 22;">
                        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                        <VBox spacing="10">
                            <Label text="➕ Ajouter un commentaire" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                            <HBox spacing="10">
                                <TextField fx:id="newCommentField" promptText="Votre commentaire..." HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 12; -fx-text-fill: white;"/>
                                <TextField fx:id="commentUserField" promptText="ID utilisateur" minWidth="120"
                                           style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 12; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 12; -fx-text-fill: white;"/>
                                <Button fx:id="addCommentBtn" text="Envoyer" onAction="#ajouterCommentaire"
                                        style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 10 20; -fx-font-weight: 900;" />
                            </HBox>
                        </VBox>
                    </StackPane>
                </VBox>
            </StackPane>
        </center>

        <!-- BOTTOM NAV -->
        <bottom>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(0,0,0,0.22); -fx-background-radius: 18; -fx-border-color: rgba(255,255,255,0.14); -fx-border-radius: 18;">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Button text="🏠" onAction="#goDashboard" style="-fx-background-color: rgba(255,189,0,0.28); -fx-text-fill: #FFBD00; -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="📝" onAction="#goBlog" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="💬" onAction="#goCommentaires" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="❤️" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
                <Button text="👤" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;" />
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>