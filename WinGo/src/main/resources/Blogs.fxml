<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.BlogController">

    <!-- BACKGROUND IMAGE (à remplacer par votre image) -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/testt.png');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: 100% 100%;" />

    <!-- Overlay -->
    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.18);" />

    <!-- Main glass shell -->
    <BorderPane maxHeight="650" maxWidth="1100"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect><DropShadow color="#00000066" offsetY="14" radius="28" /></effect>
        <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

        <!-- TOP BAR (identique) -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>

                <Label text="WinGo Travel"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search pill pour les articles -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.22);
                             -fx-background-radius: 999;
                             -fx-padding: 8 10;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95;" />
                    <TextField fx:id="searchField" promptText="Rechercher un article..."
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 340;" />
                    <Button fx:id="searchBtn" text="⚙"
                            style="-fx-background-color: #FFBD00;
                                   -fx-text-fill: #390099;
                                   -fx-background-radius: 999;
                                   -fx-font-weight: 900;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="🔔"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white;
                               -fx-background-radius: 14;
                               -fx-padding: 8 12;" />
                <Button text="👤"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white;
                               -fx-background-radius: 14;
                               -fx-padding: 8 12;" />
            </HBox>
        </top>

        <!-- LEFT MINI NAV (à connecter si nécessaire) -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="18" left="12" right="12" top="18" /></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-font-size: 18px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="📝" onAction="#goBlog"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="💬" onAction="#goCommentaires"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="⚙" onAction="#goSettings"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                <effect><DropShadow color="#00000055" offsetY="10" radius="18"/></effect>

                <ScrollPane fitToWidth="true"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <content>
                        <VBox spacing="18">
                            <padding><Insets bottom="18" left="18" right="18" top="18"/></padding>

                            <!-- HERO SECTION -->
                            <HBox spacing="16">
                                <VBox spacing="10" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: rgba(0,0,0,0.32);
                                             -fx-background-radius: 22;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 22;">
                                    <padding><Insets bottom="18" left="18" right="18" top="18"/></padding>

                                    <Label text="Gestion des Blogs ✍️"
                                           style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 900;"/>

                                    <Label text="Créez, modifiez ou supprimez vos articles de voyage"
                                           style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 13px; -fx-font-weight: 700;"/>

                                    <HBox spacing="10">
                                        <Label text="📝" style="-fx-font-size: 18px;" />
                                        <Label text="Articles et commentaires"
                                               style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-weight: 800;" />
                                    </HBox>
                                </VBox>

                                <!-- STATS MINI CARD -->
                                <VBox prefWidth="260" spacing="10"
                                      style="-fx-background-color: rgba(0,0,0,0.30);
                                             -fx-background-radius: 22;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 22;">
                                    <padding><Insets bottom="18" left="18" right="18" top="18"/></padding>

                                    <Label text="Statistiques"
                                           style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                    <Label text="📰 Articles : "
                                           style="-fx-text-fill: #FFBD00; -fx-font-size: 22px; -fx-font-weight: 900;"/>
                                    <Label fx:id="totalBlogsLabel" text="0"
                                           style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 700;"/>
                                    <Separator opacity="0.28" />
                                    <Label text="💬 Commentaires : "
                                           style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                    <Label fx:id="totalCommentsLabel" text="0"
                                           style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 700;"/>
                                </VBox>
                            </HBox>

                            <!-- FILTRES -->
                            <HBox spacing="10" alignment="CENTER_LEFT"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 22;
                                         -fx-border-color: rgba(255,255,255,0.18);
                                         -fx-border-radius: 22;
                                         -fx-padding: 12 18;">
                                <Label text="Filtrer par :" style="-fx-text-fill: white; -fx-font-weight: 800;"/>
                                <ComboBox fx:id="regionFilterCombo" promptText="Région"
                                          style="-fx-background-color: rgba(255,255,255,0.10);
                                                 -fx-background-radius: 12;
                                                 -fx-border-color: rgba(255,255,255,0.18);
                                                 -fx-border-radius: 12;
                                                 -fx-text-fill: white;" />
                                <ComboBox fx:id="categorieFilterCombo" promptText="Catégorie"
                                          style="-fx-background-color: rgba(255,255,255,0.10);
                                                 -fx-background-radius: 12;
                                                 -fx-border-color: rgba(255,255,255,0.18);
                                                 -fx-border-radius: 12;
                                                 -fx-text-fill: white;" />
                            </HBox>

                            <!-- LISTE DES ARTICLES (FlowPane) -->
                            <VBox spacing="10"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 22;
                                         -fx-border-color: rgba(255,255,255,0.18);
                                         -fx-border-radius: 22;
                                         -fx-padding: 15;">
                                <Label text="📰 Articles récents"
                                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                                <ScrollPane fitToWidth="true" prefHeight="200"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <FlowPane fx:id="articlesFlowPane" hgap="15" vgap="15"
                                              style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>

                            <!-- COMMENTAIRES DE L'ARTICLE SÉLECTIONNÉ -->
                            <VBox spacing="10"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 22;
                                         -fx-border-color: rgba(255,255,255,0.18);
                                         -fx-border-radius: 22;
                                         -fx-padding: 15;">
                                <Label text="💬 Commentaires"
                                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                                <Label fx:id="selectedArticleLabel" text="(aucun article sélectionné)"
                                       style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-style: italic;"/>
                                <ScrollPane fitToWidth="true" prefHeight="150"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <FlowPane fx:id="commentairesFlowPane" hgap="10" vgap="10"
                                              style="-fx-background-color: transparent;"/>
                                </ScrollPane>
                            </VBox>

                            <!-- FORMULAIRE D'AJOUT/ÉDITION D'ARTICLE -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                              -fx-background-radius: 22;
                                              -fx-border-color: rgba(255,255,255,0.18);
                                              -fx-border-radius: 22;">
                                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                                <effect><DropShadow color="#00000055" offsetY="8" radius="16"/></effect>

                                <VBox spacing="14">

                                    <!-- Title row -->
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="📝"
                                               style="-fx-font-size: 22px;" />
                                        <Label text="Formulaire Article"
                                               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="statusLabel" text="Prêt"
                                               style="-fx-text-fill: #FFBD00; -fx-font-weight: 800;" />
                                    </HBox>

                                    <Separator opacity="0.25"/>

                                    <!-- Inputs -->
                                    <GridPane hgap="12" vgap="12">
                                        <!-- ID (non éditable) -->
                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="ID"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <Label fx:id="articleIdLabel" text="Nouveau"
                                                   style="-fx-background-color: rgba(255,255,255,0.10);
                                                          -fx-background-radius: 12;
                                                          -fx-padding: 10 12;
                                                          -fx-text-fill: white;"/>
                                        </VBox>

                                        <!-- Titre -->
                                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Titre"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <TextField fx:id="titreField" promptText="Titre de l'article"
                                                       style="-fx-background-color: rgba(255,255,255,0.10);
                                                              -fx-background-radius: 12;
                                                              -fx-border-color: rgba(255,255,255,0.18);
                                                              -fx-border-radius: 12;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                              -fx-padding: 10 12;" />
                                        </VBox>

                                        <!-- Contenu (TextArea) -->
                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                            <Label text="Contenu"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <TextArea fx:id="contenuField" promptText="Contenu de l'article..."
                                                      prefRowCount="3"
                                                      style="-fx-background-color: rgba(255,255,255,0.10);
                                                             -fx-background-radius: 12;
                                                             -fx-border-color: rgba(255,255,255,0.18);
                                                             -fx-border-radius: 12;
                                                             -fx-text-fill: white;
                                                             -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                             -fx-padding: 10 12;" />
                                        </VBox>

                                        <!-- Image -->
                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                            <Label text="Image (URL)"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <TextField fx:id="imageField" promptText="URL de l'image"
                                                       style="-fx-background-color: rgba(255,255,255,0.10);
                                                              -fx-background-radius: 12;
                                                              -fx-border-color: rgba(255,255,255,0.18);
                                                              -fx-border-radius: 12;
                                                              -fx-text-fill: white;
                                                              -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                              -fx-padding: 10 12;" />
                                        </VBox>

                                        <!-- Auteur (ComboBox avec utilisateurs) -->
                                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <Label text="Auteur"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <ComboBox fx:id="auteurCombo" promptText="Sélectionner un auteur"
                                                      style="-fx-background-color: rgba(255,255,255,0.10);
                                                             -fx-background-radius: 12;
                                                             -fx-border-color: rgba(255,255,255,0.18);
                                                             -fx-border-radius: 12;
                                                             -fx-text-fill: white;" />
                                        </VBox>

                                        <!-- Région -->
                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                            <Label text="Région"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <ComboBox fx:id="regionField" promptText="Région"
                                                      style="-fx-background-color: rgba(255,255,255,0.10);
                                                             -fx-background-radius: 12;
                                                             -fx-border-color: rgba(255,255,255,0.18);
                                                             -fx-border-radius: 12;
                                                             -fx-text-fill: white;" />
                                        </VBox>

                                        <!-- Catégorie -->
                                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <Label text="Catégorie"
                                                   style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;" />
                                            <ComboBox fx:id="categorieField" promptText="Catégorie"
                                                      style="-fx-background-color: rgba(255,255,255,0.10);
                                                             -fx-background-radius: 12;
                                                             -fx-border-color: rgba(255,255,255,0.18);
                                                             -fx-border-radius: 12;
                                                             -fx-text-fill: white;" />
                                        </VBox>

                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50" />
                                            <ColumnConstraints percentWidth="50" />
                                        </columnConstraints>
                                    </GridPane>

                                    <!-- Boutons CRUD article -->
                                    <HBox spacing="10" alignment="CENTER">
                                        <Button fx:id="ajouterBtn" text="➕ Ajouter" onAction="#ajouterBlog"
                                                style="-fx-background-color: #28a745;
                                                       -fx-text-fill: white;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 20;
                                                       -fx-font-weight: 900;" />
                                        <Button fx:id="modifierBtn" text="✏️ Modifier" onAction="#modifierBlog"
                                                style="-fx-background-color: #ffc107;
                                                       -fx-text-fill: black;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 20;
                                                       -fx-font-weight: 900;" />
                                        <Button fx:id="supprimerBtn" text="🗑️ Supprimer" onAction="#supprimerBlog"
                                                style="-fx-background-color: #dc3545;
                                                       -fx-text-fill: white;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 20;
                                                       -fx-font-weight: 900;" />
                                        <Button fx:id="clearBtn" text="🔄 Nouveau" onAction="#clearForm"
                                                style="-fx-background-color: rgba(255,255,255,0.10);
                                                       -fx-text-fill: white;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 20;
                                                       -fx-font-weight: 900;" />
                                    </HBox>
                                </VBox>
                            </StackPane>

                            <!-- FORMULAIRE D'AJOUT DE COMMENTAIRE -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                              -fx-background-radius: 22;
                                              -fx-border-color: rgba(255,255,255,0.18);
                                              -fx-border-radius: 22;">
                                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
                                <VBox spacing="10">
                                    <Label text="➕ Ajouter un commentaire"
                                           style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                                    <HBox spacing="10">
                                        <TextField fx:id="newCommentField" promptText="Votre commentaire..."
                                                   HBox.hgrow="ALWAYS"
                                                   style="-fx-background-color: rgba(255,255,255,0.10);
                                                          -fx-background-radius: 12;
                                                          -fx-border-color: rgba(255,255,255,0.18);
                                                          -fx-border-radius: 12;
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                          -fx-padding: 10 12;" />
                                        <TextField fx:id="commentUserField" promptText="ID utilisateur"
                                                   prefWidth="120"
                                                   style="-fx-background-color: rgba(255,255,255,0.10);
                                                          -fx-background-radius: 12;
                                                          -fx-border-color: rgba(255,255,255,0.18);
                                                          -fx-border-radius: 12;
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                          -fx-padding: 10 12;" />
                                        <Button fx:id="addCommentBtn" text="Envoyer" onAction="#ajouterCommentaire"
                                                style="-fx-background-color: #17a2b8;
                                                       -fx-text-fill: white;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 20;
                                                       -fx-font-weight: 900;" />
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </content>
                </ScrollPane>
            </StackPane>
        </center>

        <!-- BOTTOM NAV (identique) -->
        <bottom>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

                <Button text="🏠" onAction="#goDashboard"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="📝" onAction="#goBlog"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="💬" onAction="#goCommentaires"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="❤️"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="👤"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>