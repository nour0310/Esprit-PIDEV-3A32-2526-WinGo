<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlles.BlogDetailController">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="backButton" text="← Retour" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15; -fx-background-radius: 5;" />
                <Label fx:id="titreLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #5a3e2b;" />
            </HBox>
            <Separator />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>
                <StackPane fx:id="imageContainer" prefHeight="300" style="-fx-background-color: #f0f0f0; -fx-background-radius: 10;">
                    <ImageView fx:id="imageView" fitHeight="300" fitWidth="760" preserveRatio="true" />
                </StackPane>
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <Label fx:id="auteurLabel" style="-fx-font-size: 16px; -fx-text-fill: #b7472a;" />
                    <Label fx:id="dateLabel" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="regionLabel" style="-fx-font-size: 16px; -fx-text-fill: #e67e22;" />
                    <Label fx:id="categorieLabel" style="-fx-font-size: 16px; -fx-text-fill: #3498db;" />
                </HBox>
                <Label fx:id="contenuLabel" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                <Separator />
                <Label text="Commentaires" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5a3e2b;" />
                <FlowPane fx:id="commentairesPane" hgap="10" vgap="10" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="newCommentField" promptText="Votre commentaire..." HBox.hgrow="ALWAYS" style="-fx-padding: 8; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ccc;" />
                    <Button fx:id="addCommentBtn" text="Commenter" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 5;" />
                </HBox>
                <Label fx:id="statusLabel" style="-fx-text-fill: #27ae60;" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>