<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controlles.VerifyEmailController"
           prefHeight="850" prefWidth="1300">

    <!-- BACKGROUND -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/images/tunisia.png');
                 -fx-background-size: cover;
                 -fx-background-position: center;" />

    <Pane mouseTransparent="true"
          style="-fx-background-color: rgba(0,0,0,0.4);" />

    <VBox alignment="CENTER" spacing="30">
        <VBox alignment="CENTER" spacing="20" maxWidth="450"
              style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 40;">
            <effect>
                <DropShadow radius="30" offsetY="15" color="#00000066"/>
            </effect>

            <Label text="📧" style="-fx-font-size: 60px;" />
            
            <VBox alignment="CENTER" spacing="5">
                <Label text="Vérifiez votre email"
                       style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #1E293B;" />
                <Label fx:id="emailLabel" text="un utilisateur@exemple.com"
                       style="-fx-font-size: 14px; -fx-text-fill: #64748B;" />
            </VBox>

            <Label text="Nous avons envoyé un code de 6 chiffres à votre adresse email. Veuillez le saisir ci-dessous."
                   wrapText="true" alignment="CENTER" textAlignment="CENTER"
                   style="-fx-text-fill: #64748B; -fx-font-size: 14px;" />

            <TextField fx:id="codeField" promptText="000000"
                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 12; 
                              -fx-background-radius: 12; -fx-padding: 15; -fx-font-size: 24px; 
                              -fx-font-weight: 900; -fx-alignment: center; -fx-letter-spacing: 5px;" />

            <Label fx:id="messageLabel" text="" style="-fx-font-weight: bold;" />

            <Button text="Vérifier le compte" onAction="#handleVerify" maxWidth="Infinity"
                    style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-font-weight: 900; 
                           -fx-font-size: 16px; -fx-padding: 15; -fx-background-radius: 12; -fx-cursor: hand;">
                <effect><DropShadow color="#A3B1FF44" radius="10" offsetY="5"/></effect>
            </Button>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Vous n'avez pas reçu le code ?" style="-fx-text-fill: #64748B;" />
                <Button text="Renvoyer" onAction="#handleResend"
                        style="-fx-background-color: transparent; -fx-text-fill: #A3B1FF; -fx-font-weight: bold; -fx-padding: 0; -fx-cursor: hand;" />
            </HBox>

            <Button text="Retour à la connexion" onAction="#goToLogin"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-weight: bold; -fx-cursor: hand;" />
        </VBox>
    </VBox>
</StackPane>
