### Configuration example for real email sending ###
MAILER_FROM="nour.fourti@esprit.tn"
ADMIN_NOTIFICATION_EMAIL="nour.fourti@esprit.tn"

### Choose ONE provider and copy it into .env.local ###

### Outlook / Microsoft 365 ###
### Replace YOUR_OUTLOOK_PASSWORD with your real Outlook password or app password ###
# MAILER_DSN="smtp://nour.fourti%40esprit.tn:YOUR_OUTLOOK_PASSWORD@smtp.office365.com:587?encryption=tls&auth_mode=login"

### Gmail ###
### Replace YOUR_GMAIL_APP_PASSWORD with a Google app password ###
# MAILER_DSN="smtp://your-account%40gmail.com:YOUR_GMAIL_APP_PASSWORD@smtp.gmail.com:587?encryption=tls&auth_mode=login"

### Brevo ###
### Replace YOUR_BREVO_SMTP_KEY with your Brevo SMTP key ###
# MAILER_DSN="smtp://YOUR_BREVO_LOGIN:YOUR_BREVO_SMTP_KEY@smtp-relay.brevo.com:587?encryption=tls&auth_mode=login"

### Mailtrap ###
### Replace with your Mailtrap SMTP credentials ###
# MAILER_DSN="smtp://YOUR_MAILTRAP_USER:YOUR_MAILTRAP_PASSWORD@sandbox.smtp.mailtrap.io:2525?encryption=tls&auth_mode=login"

### DeepL API Free ###
### Create a free DeepL API key and copy these values into .env.local ###
# DEEPL_API_KEY="your_deepl_api_free_key"
# DEEPL_API_URL="https://api-free.deepl.com/v2/translate"
