<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="900" prefWidth="1400"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.SupportController"
           style="-fx-background-color: #F4F7FB;">

    <!-- Background Pane -->
    <Pane fx:id="backgroundPane" mouseTransparent="true" style="-fx-background-color: #F4F7FB;" />

    <!-- Main BorderPane -->
    <BorderPane maxHeight="870" maxWidth="1380" style="-fx-background-color: transparent;">

        <!-- TOP HEADER BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-padding: 15 30 25 30;">
                <!-- Logo et titre -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                        <Image url="assets/logo.png" />
                    </ImageView>
                    <Label text="WinGo" style="-fx-text-fill: #1E293B; -fx-font-size: 26px; -fx-font-weight: 900; -fx-font-family: 'Arial';" />
                </HBox>

                <!-- Navigation Menu -->
                <HBox spacing="35" alignment="CENTER" style="-fx-padding: 0 0 0 50;">
                    <Label text="Home" style="-fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand;" onMouseClicked="#goToHome" />
                    <Label text="Explore" style="-fx-text-fill: #64748B; -fx-font-size: 15px; -fx-cursor: hand;" />
                    <Label text="Support" style="-fx-text-fill: #A3B1FF; -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand;" />
                    <Label text="Contact" style="-fx-text-fill: #64748B; -fx-font-size: 15px; -fx-cursor: hand;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search Bar -->
                <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #FFFFFF; -fx-background-radius: 50; -fx-padding: 12 25;">
                    <effect><DropShadow color="#0000000A" offsetY="5" radius="15" /></effect>
                    <Label text="🔍" style="-fx-text-fill: #A3B1FF;" />
                    <TextField fx:id="globalSearchField" promptText="Rechercher une reclamation..."
                               style="-fx-background-color: transparent; -fx-text-fill: #1E293B; -fx-prompt-text-fill: #94A3B8; -fx-pref-width: 250;"/>
                </HBox>

                <!-- User Profile -->
                <StackPane>
                    <Circle fill="#A3B1FF" radius="22"/>
                    <Label fx:id="profileInitialsHeader" text="NH" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;"/>
                </StackPane>
            </HBox>
        </top>

        <!-- LEFT SIDEBAR -->
        <left>
            <VBox prefWidth="90" spacing="30" alignment="TOP_CENTER"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 35; -fx-padding: 40 10;">
                <BorderPane.margin>
                    <Insets top="10" left="25" bottom="25" right="25"/>
                </BorderPane.margin>
                <effect><DropShadow color="#0000000E" offsetY="10" radius="25" /></effect>

                <!-- Reclamations (actif) -->
                <Button fx:id="reclamationTabBtn" onAction="#showReclamationsTab"
                        style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-font-size: 22px; -fx-background-radius: 20; -fx-padding: 15 15;"
                        text="🛟" />

                <!-- Suggestions -->
                <Button fx:id="suggestionTabBtn" onAction="#showSuggestionsTab"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 22px; -fx-background-radius: 20; -fx-padding: 15 15;"
                        text="💡" />

                <!-- Statistiques -->
                <Button fx:id="statsTabBtn" onAction="#showStatsTab"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 22px; -fx-background-radius: 20; -fx-padding: 15 15;"
                        text="📊" />

                <!-- WhatsApp Bot -->
                <Button onAction="#openWhatsApp"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 22px; -fx-background-radius: 20; -fx-padding: 15 15;"
                        text="📱" />
                <!-- Admin Back Office -->
                <Button onAction="#ouvrirBackOffice"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 22px; -fx-background-radius: 20; -fx-padding: 15 15;"
                        text="⚙️" />
                <Region VBox.vgrow="ALWAYS" />

                <!-- Dark mode toggle -->
                <HBox alignment="CENTER" style="-fx-cursor: hand;" onMouseClicked="#toggleDarkMode">
                    <Label fx:id="darkModeIcon" text="🌙" style="-fx-text-fill: #64748B; -fx-font-size: 20px;" />
                </HBox>

                <!-- Logout -->
                <Button onAction="#closeForm"
                        style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-size: 22px; -fx-background-radius: 20; -fx-padding: 15 15;"
                        text="🚪" />

                <Label text="©" style="-fx-text-fill: #CBD5E1; -fx-font-size: 14px; -fx-padding: 0 0 10 0;" />
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <HBox spacing="40" style="-fx-padding: 0 20 20 10;">

                <!-- MAIN CONTENT AREA (GAUCHE) -->
                <VBox HBox.hgrow="ALWAYS" spacing="30">

                    <!-- Titre de section dynamique -->
                    <VBox spacing="10">
                        <Label fx:id="mainTitle" text="Centre de Support"
                               style="-fx-text-fill: #1E293B; -fx-font-size: 42px; -fx-font-weight: 900;" />
                        <Label fx:id="mainSubtitle" text="Gerez reclamations, suggestions et statistiques en temps reel"
                               style="-fx-text-fill: #64748B; -fx-font-size: 16px;" />
                    </VBox>

                    <!-- StackPane pour changer le contenu -->
                    <StackPane VBox.vgrow="ALWAYS">

                        <!-- ========== PANEL RECLAMATIONS ========== -->
                        <ScrollPane fx:id="reclamationPanel" fitToWidth="true"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox spacing="25" style="-fx-background-color: transparent;">
                                <padding><Insets top="5" right="20" bottom="20" left="0"/></padding>

                                <!-- Filtres et actions -->
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <HBox alignment="CENTER" spacing="10"
                                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 50; -fx-padding: 10 20;">
                                        <effect><DropShadow color="#00000008" offsetY="4" radius="10" /></effect>
                                        <Label text="Filtrer :" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="recFilterStatutBox" promptText="Statut"
                                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 50; -fx-pref-width: 140;" />
                                        <Button fx:id="recFilterBtn" onAction="#filterReclamations"
                                                style="-fx-background-color: transparent; -fx-text-fill: #A3B1FF; -fx-font-size: 18px; -fx-cursor: hand;"
                                                text="🔍" />
                                    </HBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button text="➕ Nouvelle reclamation" onAction="#showAddReclamationForm"
                                            style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 12 30; -fx-font-weight: 900;">
                                        <effect><DropShadow color="#A3B1FF44" radius="15" offsetY="5" /></effect>
                                    </Button>
                                </HBox>

                                <!-- Formulaire de reclamation (cache par defaut) -->
                                <VBox fx:id="reclamationForm" spacing="20" visible="false" managed="false"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-padding: 25;">
                                    <effect><DropShadow color="#0000000C" offsetY="5" radius="15" /></effect>

                                    <Label text="Details de la reclamation" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1E293B;" />

                                    <GridPane hgap="20" vgap="20">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50"/>
                                            <ColumnConstraints percentWidth="50"/>
                                        </columnConstraints>

                                        <!-- Type -->
                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="Type *" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                                            <ComboBox fx:id="recTypeBox" promptText="Selectionner" maxWidth="Infinity"
                                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-pref-height: 40;"/>
                                        </VBox>

                                        <!-- Priorite -->
                                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Priorite *" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                                            <ComboBox fx:id="recPrioriteBox" promptText="Niveau" maxWidth="Infinity"
                                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-pref-height: 40;"/>
                                        </VBox>

                                        <!-- Sujet -->
                                        <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                            <Label text="Sujet *" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                                            <TextField fx:id="recSujetField" promptText="Titre de votre reclamation"
                                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                                        </VBox>

                                        <!-- Description -->
                                        <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                            <Label text="Description" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                                            <TextArea fx:id="recDescArea" promptText="Decrivez en detail..." prefRowCount="3"
                                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                                        </VBox>

                                        <!-- Email client -->
                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                            <Label text="Email client" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                                            <TextField fx:id="recEmailClientField" promptText="email@exemple.com"
                                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                                        </VBox>

                                        <!-- Nom client -->
                                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <Label text="Nom client" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                                            <TextField fx:id="recNomClientField" promptText="Nom complet"
                                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                                        </VBox>
                                    </GridPane>

                                    <!-- Actions -->
                                    <HBox spacing="15" alignment="CENTER_RIGHT">
                                        <Button text="📎 Piece jointe" onAction="#attachFile"
                                                style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-background-radius: 50; -fx-padding: 10 20;"/>
                                        <Label fx:id="recPieceJointeLabel" text="Aucun fichier" style="-fx-text-fill: #94A3B8;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button text="Annuler" onAction="#hideReclamationForm"
                                                style="-fx-background-color: #FEE2E2; -fx-text-fill: #EF4444; -fx-background-radius: 50; -fx-padding: 10 25; -fx-font-weight: 700;"/>
                                        <Button text="Soumettre" onAction="#addReclamation"
                                                style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 10 30; -fx-font-weight: 900;"/>
                                    </HBox>
                                </VBox>

                                <!-- Liste des reclamations -->
                                <VBox spacing="15">
                                    <Label text="Reclamations recentes" style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 20px;" />
                                    <Label fx:id="recResultCountLabel" text="0 reclamation(s)" style="-fx-text-fill: #64748B;" />

                                    <TableView fx:id="reclamationTable" prefHeight="350"
                                               style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-background-radius: 15;">
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="📭" style="-fx-font-size: 32px;"/>
                                                <Label text="Aucune reclamation" style="-fx-text-fill: #94A3B8;"/>
                                            </VBox>
                                        </placeholder>
                                        <columns>
                                            <TableColumn fx:id="recColId" text="ID" prefWidth="50"/>
                                            <TableColumn fx:id="recColType" text="Type" prefWidth="100"/>
                                            <TableColumn fx:id="recColSujet" text="Sujet" prefWidth="200"/>
                                            <TableColumn fx:id="recColDate" text="Date" prefWidth="95"/>
                                            <TableColumn fx:id="recColStatut" text="Statut" prefWidth="95"/>
                                            <TableColumn fx:id="recColPriorite" text="Priorite" prefWidth="85"/>
                                            <TableColumn fx:id="recColReponse" text="Reponse" prefWidth="150"/>
                                        </columns>
                                    </TableView>

                                    <!-- Panel de reponse admin -->
                                    <VBox spacing="10" style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 15;">
                                        <Label text="Repondre a la reclamation selectionnee" style="-fx-text-fill: #A3B1FF; -fx-font-weight: 900;"/>
                                        <HBox spacing="15">
                                            <TextArea fx:id="recReponseArea" promptText="Votre reponse..." prefRowCount="2" HBox.hgrow="ALWAYS"
                                                      style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                                            <VBox spacing="8" prefWidth="150">
                                                <ComboBox fx:id="recNouveauStatutBox" promptText="Nouveau statut" maxWidth="Infinity"/>
                                                <Button text="Envoyer" onAction="#respondToReclamation" maxWidth="Infinity"
                                                        style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10; -fx-font-weight: 700;"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>
                        </ScrollPane>

                        <!-- ========== PANEL SUGGESTIONS ========== -->
                        <ScrollPane fx:id="suggestionPanel" fitToWidth="true" visible="false" managed="false"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox spacing="25" style="-fx-background-color: transparent;">
                                <padding><Insets top="5" right="20" bottom="20" left="0"/></padding>

                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <HBox alignment="CENTER" spacing="10"
                                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 50; -fx-padding: 10 20;">
                                        <effect><DropShadow color="#00000008" offsetY="4" radius="10" /></effect>
                                        <Label text="Filtrer :" style="-fx-text-fill: #64748B; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="sugFilterCategorieBox" promptText="Categorie"
                                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 50; -fx-pref-width: 140;" />
                                    </HBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button text="➕ Nouvelle suggestion" onAction="#showAddSuggestionForm"
                                            style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 12 30; -fx-font-weight: 900;">
                                        <effect><DropShadow color="#8B5CF644" radius="15" offsetY="5" /></effect>
                                    </Button>
                                </HBox>

                                <!-- Formulaire suggestion -->
                                <VBox fx:id="suggestionForm" spacing="20" visible="false" managed="false"
                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-padding: 25;">
                                    <Label text="Nouvelle suggestion" style="-fx-font-size: 18px; -fx-font-weight: 900;"/>

                                    <GridPane hgap="20" vgap="20">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50"/>
                                            <ColumnConstraints percentWidth="50"/>
                                        </columnConstraints>

                                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="Categorie *" style="-fx-font-weight: 700;"/>
                                            <ComboBox fx:id="sugCategorieBox" promptText="Choisir" maxWidth="Infinity"
                                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                                        </VBox>

                                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="Liee a reclamation" style="-fx-font-weight: 700;"/>
                                            <ComboBox fx:id="sugReclamationBox" promptText="Optionnel" maxWidth="Infinity"
                                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                                        </VBox>

                                        <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                            <Label text="Sujet *" style="-fx-font-weight: 700;"/>
                                            <TextField fx:id="sugSujetField" promptText="Titre de votre suggestion"
                                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;"/>
                                        </VBox>

                                        <VBox spacing="6" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                            <Label text="Description" style="-fx-font-weight: 700;"/>
                                            <TextArea fx:id="sugDescArea" promptText="Decrivez votre idee..." prefRowCount="3"
                                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                                        </VBox>
                                    </GridPane>

                                    <HBox spacing="15" alignment="CENTER_RIGHT">
                                        <Button text="Annuler" onAction="#hideSuggestionForm"
                                                style="-fx-background-color: #FEE2E2; -fx-text-fill: #EF4444; -fx-background-radius: 50; -fx-padding: 10 25;"/>
                                        <Button text="Soumettre" onAction="#addSuggestion"
                                                style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 10 30; -fx-font-weight: 900;"/>
                                    </HBox>
                                </VBox>

                                <!-- Liste suggestions -->
                                <VBox spacing="15">
                                    <Label text="Suggestions recentes" style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 20px;" />
                                    <Label fx:id="sugResultCountLabel" text="0 suggestion(s)" style="-fx-text-fill: #64748B;" />

                                    <TableView fx:id="suggestionTable" prefHeight="350"
                                               style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 15;">
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8">
                                                <Label text="💡" style="-fx-font-size: 32px;"/>
                                                <Label text="Aucune suggestion" style="-fx-text-fill: #94A3B8;"/>
                                            </VBox>
                                        </placeholder>
                                        <columns>
                                            <TableColumn fx:id="sugColId" text="ID" prefWidth="50"/>
                                            <TableColumn fx:id="sugColCategorie" text="Categorie" prefWidth="100"/>
                                            <TableColumn fx:id="sugColSujet" text="Sujet" prefWidth="200"/>
                                            <TableColumn fx:id="sugColDate" text="Date" prefWidth="95"/>
                                            <TableColumn fx:id="sugColStatut" text="Statut" prefWidth="95"/>
                                            <TableColumn fx:id="sugColReclamationLien" text="Liee" prefWidth="70"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </VBox>
                        </ScrollPane>

                        <!-- ========== PANEL STATISTIQUES ========== -->
                        <ScrollPane fx:id="statsPanel" fitToWidth="true" visible="false" managed="false"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <VBox spacing="25" style="-fx-padding: 5 20 20 0;">
                                <HBox spacing="15" alignment="CENTER_LEFT">
                                    <Label text="Statistiques en direct" style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #1E293B;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="statsCountdownLabel" text="30s" style="-fx-text-fill: #A3B1FF; -fx-font-weight: 800;"/>
                                    <Button text="Actualiser" onAction="#onStatsRefresh"
                                            style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 8 20;"/>
                                </HBox>

                                <!-- KPI Cards -->
                                <FlowPane hgap="20" vgap="20">
                                    <!-- Total reclamations -->
                                    <VBox spacing="8" prefWidth="180" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
                                        <Label text="Total" style="-fx-text-fill: #64748B;"/>
                                        <Label fx:id="statsKpiTotalRec" text="0" style="-fx-text-fill: #A3B1FF; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                                        <Label text="reclamations" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                                    </VBox>

                                    <!-- En attente -->
                                    <VBox spacing="8" prefWidth="180" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
                                        <Label text="En attente" style="-fx-text-fill: #64748B;"/>
                                        <Label fx:id="statsKpiEnAttente" text="0" style="-fx-text-fill: #F59E0B; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                                    </VBox>

                                    <!-- Resolues -->
                                    <VBox spacing="8" prefWidth="180" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
                                        <Label text="Resolues" style="-fx-text-fill: #64748B;"/>
                                        <Label fx:id="statsKpiResolues" text="0" style="-fx-text-fill: #10B981; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                                    </VBox>

                                    <!-- Urgentes -->
                                    <VBox spacing="8" prefWidth="180" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
                                        <Label text="Urgentes" style="-fx-text-fill: #64748B;"/>
                                        <Label fx:id="statsKpiUrgentes" text="0" style="-fx-text-fill: #EF4444; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                                    </VBox>

                                    <!-- Suggestions -->
                                    <VBox spacing="8" prefWidth="180" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
                                        <Label text="Suggestions" style="-fx-text-fill: #64748B;"/>
                                        <Label fx:id="statsKpiTotalSug" text="0" style="-fx-text-fill: #8B5CF6; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                                    </VBox>

                                    <!-- Taux resolution -->
                                    <VBox spacing="8" prefWidth="250" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
                                        <Label text="Taux de resolution" style="-fx-text-fill: #64748B;"/>
                                        <Label fx:id="statsKpiTauxResolution" text="0%" style="-fx-text-fill: #1E293B; -fx-font-size: 32px; -fx-font-weight: 900;"/>
                                        <ProgressBar fx:id="statsProgressBar" progress="0" prefWidth="200" style="-fx-accent: #A3B1FF;"/>
                                    </VBox>
                                </FlowPane>
                            </VBox>
                        </ScrollPane>
                    </StackPane>
                </VBox>

                <!-- RIGHT PANEL -->
                <VBox prefWidth="320" spacing="40" alignment="TOP_CENTER" style="-fx-padding: 10 10 0 0;">
                    <!-- User Profile Card -->
