<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.EventController">

    <!-- BACKGROUND -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/assets/amaan.jpg');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: cover;" />

    <!-- SOFT OVERLAY -->
    <Pane mouseTransparent="true"
          style="-fx-background-color: rgba(0,0,0,0.25);" />

    <!-- MAIN GLASS CONTAINER -->
    <BorderPane maxWidth="1100" maxHeight="650"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect>
            <DropShadow color="#00000066" offsetY="14" radius="28" />
        </effect>
        <padding>
            <Insets top="12" right="12" bottom="12" left="12" />
        </padding>

        <!-- ================= TOP BAR (Amélioré) ================= -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18" />
                </padding>

                <!-- Logo + Title -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                        <Image url="assets/logo.png" />
                    </ImageView>
                    <Label text="WinGo Travel"
                           style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Navigation Icons -->
                <HBox spacing="10" alignment="CENTER"
                      style="-fx-background-color: rgba(0,0,0,0.28);
                             -fx-background-radius: 999;
                             -fx-padding: 6 10;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Button text="🏠" onAction="#goToHome"
                            style="-fx-background-color: rgba(255,189,0,0.28);
                                   -fx-text-fill: #FFBD00;
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 999;
                                   -fx-padding: 6 10;
                                   -fx-cursor: hand;"/>
                    <Button text="👤"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.92);
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 999;
                                   -fx-padding: 6 10;
                                   -fx-cursor: hand;"/>
                    <Button text="🔔"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.92);
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 999;
                                   -fx-padding: 6 10;
                                   -fx-cursor: hand;"/>
                    <Button text="⚙️"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.92);
                                   -fx-font-size: 14px;
                                   -fx-background-radius: 999;
                                   -fx-padding: 6 10;
                                   -fx-cursor: hand;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Search Bar -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.28);
                             -fx-background-radius: 999;
                             -fx-padding: 8 14;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95; -fx-font-size: 14px;"/>
                    <TextField fx:id="globalSearchField"
                               promptText="Chercher événement..."
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 200;" />
                </HBox>

                <!-- Filter Button -->
                <HBox alignment="CENTER" spacing="6" onMouseClicked="#onFilter"
                      style="-fx-background-color: rgba(255,189,0,0.18);
                             -fx-background-radius: 999;
                             -fx-padding: 8 14;
                             -fx-border-color: rgba(255,189,0,0.35);
                             -fx-border-radius: 999;
                             -fx-cursor: hand;">
                    <Label text="Filter" style="-fx-text-fill: #FFBD00; -fx-font-size: 12px; -fx-font-weight: 900;"/>
                </HBox>
            </HBox>
        </top>

        <!-- ================= LEFT NAV (Amélioré) ================= -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding>
                    <Insets top="18" right="12" bottom="18" left="12" />
                </padding>

                <!-- HOME -->
                <Button text="🏠" onAction="#goToHome"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-font-size: 24px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <!-- EVENTS -->
                <Button text="📅" onAction="#goToEvents"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <!-- PARTICIPATIONS -->
                <Button text="👥" onAction="#goToParticipations"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <!-- MY PARTICIPATIONS -->
                <Button text="📋" onAction="#goToMesParticipations"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <!-- LOGIN/ACCOUNT -->
                <Button text="🔐"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 24px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;
                               -fx-cursor: hand;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- ================= CENTER CONTENT ================= -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10" />
                </padding>
                <effect>
                    <DropShadow color="#00000055" offsetY="10" radius="18" />
                </effect>

                <!-- TabPane -->
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                         style="-fx-background-color: transparent;
                                -fx-tab-min-width: 150;">

                    <!-- TAB 1: HOME -->
                    <Tab text="🏠 Home">
                        <content>
                            <ScrollPane fitToWidth="true"
                                        style="-fx-background-color: transparent; -fx-background: transparent;"
                                        hbarPolicy="NEVER">
                                <content>
                                    <VBox spacing="12">
                                        <padding>
                                            <Insets top="12" right="12" bottom="12" left="12" />
                                        </padding>

                                        <!-- HERO SECTION (compacte) -->
                                        <HBox spacing="12">
                                            <VBox spacing="6" HBox.hgrow="ALWAYS"
                                                  style="-fx-background-color: rgba(0,0,0,0.32);
                                                         -fx-background-radius: 18;
                                                         -fx-border-color: rgba(255,255,255,0.18);
                                                         -fx-border-radius: 18;">
                                                <padding>
                                                    <Insets bottom="12" left="12" right="12" top="12" />
                                                </padding>

                                                <Label text="Découvrez la Tunisie"
                                                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900;"/>

                                                <Label text="Explorez nos événements et participez aux meilleures expériences à travers la Tunisie."
                                                       wrapText="true"
                                                       style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 11px; -fx-font-weight: 700;"/>

                                                <HBox spacing="6">
                                                    <Label text="🎫" style="-fx-font-size: 14px;" />
                                                    <Label text="Événements et participations"
                                                           style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-weight: 800;" />
                                                </HBox>
                                            </VBox>

                                            <!-- STATS MINI CARD -->
                                            <VBox prefWidth="200" spacing="6"
                                                  style="-fx-background-color: rgba(0,0,0,0.30);
                                                         -fx-background-radius: 18;
                                                         -fx-border-color: rgba(255,255,255,0.18);
                                                         -fx-border-radius: 18;">
                                                <padding>
                                                    <Insets bottom="10" left="10" right="10" top="10" />
                                                </padding>

                                                <Label text="Statistiques"
                                                       style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 12px; -fx-font-weight: 800;"/>
                                                <Label text="🎫 Événements : "
                                                       style="-fx-text-fill: #FFBD00; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                                                <Label fx:id="totalEventsLabel" text="0"
                                                       style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                                                <Separator opacity="0.28" />
                                                <Label text="👥 Participations : "
                                                       style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                                <Label fx:id="totalParticipationsLabel" text="0"
                                                       style="-fx-text-fill: white; -fx-font-weight: 700;"/>
                                            </VBox>
                                        </HBox>

                                        <!-- SPECIAL DEAL CARD améliorée -->
                                        <VBox spacing="10"
                                              style="-fx-background-color: rgba(0,0,0,0.28);
                                                     -fx-background-radius: 18;
                                                     -fx-border-color: #c49a6c;
                                                     -fx-border-radius: 18;
                                                     -fx-padding: 15;">
                                            <Label text="🔥 Special Deal"
                                                   style="-fx-text-fill: #FFBD00;
                                                          -fx-font-size: 18px;
                                                          -fx-font-weight: 900;"/>
                                            <Label text="Djerba Escape – 189 TND"
                                                   style="-fx-text-fill: white;
                                                          -fx-font-size: 15px;
                                                          -fx-font-weight: 700;"/>
                                            <Button text="Reserve Now" onAction="#onReserveDeal"
                                                    style="-fx-background-color: #28a745;
                                                           -fx-text-fill: white;
                                                           -fx-background-radius: 25;
                                                           -fx-padding: 10 25;
                                                           -fx-font-weight: 900;
                                                           -fx-cursor: hand;"/>
                                        </VBox>

                                        <!-- POPULAR DESTINATIONS améliorées -->
                                        <VBox spacing="10">
                                            <Label text="❤️ Destinations populaires"
                                                   style="-fx-text-fill: white;
                                                          -fx-font-size: 18px;
                                                          -fx-font-weight: 900;"/>
                                            <HBox spacing="20" alignment="CENTER">
                                                <Button text="Sousse" style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 999;"/>
                                                <Button text="Tunis" style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 999;"/>
                                                <Button text="Tozeur" style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 999;"/>
                                                <Button text="Hammamet" style="-fx-background-color: rgba(0,0,0,0.4); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 999;"/>
                                            </HBox>
                                        </VBox>
                                    </VBox>
                                </content>
                            </ScrollPane>
                        </content>
                    </Tab>

                    <!-- TAB 2: EVENT MANAGEMENT -->
                    <Tab>
                        <graphic>
                            <HBox spacing="5" alignment="CENTER">
                                <Label text="📅" style="-fx-text-fill: #FFBD00; -fx-font-size: 16px;"/>
                                <Label text="Events" style="-fx-text-fill: white;"/>
                            </HBox>
                        </graphic>
                        <content>
                            <ScrollPane fitToWidth="true"
                                        style="-fx-background-color: transparent; -fx-background: transparent;"
                                        hbarPolicy="NEVER">
                                <content>
                                    <VBox spacing="12">
                                        <padding>
                                            <Insets top="12" right="12" bottom="12" left="12" />
                                        </padding>

                                        <!-- En-tête avec statut -->
                                        <HBox alignment="CENTER_LEFT" spacing="6"
                                              style="-fx-background-color: rgba(0,0,0,0.28);
                                                     -fx-background-radius: 18;
                                                     -fx-border-color: #c49a6c;
                                                     -fx-border-radius: 18;
                                                     -fx-padding: 8 12;">
                                            <Label text="📋" style="-fx-font-size: 16px;" />
                                            <Label text="Gestion des événements"
                                                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="eventStatusLabel" text="Prêt"
                                                   style="-fx-text-fill: #FFBD00; -fx-font-weight: 800; -fx-font-size: 11px;" />
                                        </HBox>

                                        <!-- EVENT FORM amélioré -->
                                        <StackPane style="-fx-background-color: rgba(0,0,0,0.28);
                                                          -fx-background-radius: 18;
                                                          -fx-border-color: #c49a6c;
                                                          -fx-border-radius: 18;">
                                            <padding>
                                                <Insets top="12" right="12" bottom="12" left="12" />
                                            </padding>
                                            <effect>
                                                <DropShadow color="#00000055" offsetY="4" radius="8" />
                                            </effect>

                                            <VBox spacing="8">
                                                <!-- Ligne pour afficher l'événement sélectionné -->
                                                <Label fx:id="selectedEventLabel" text="(aucun événement sélectionné)"
                                                       style="-fx-text-fill: #FFBD00; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5 0;"/>

                                                <GridPane hgap="8" vgap="8">
                                                    <columnConstraints>
                                                        <ColumnConstraints percentWidth="50" />
                                                        <ColumnConstraints percentWidth="50" />
                                                    </columnConstraints>

                                                    <!-- Titre -->
                                                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                                                        <Label text="Titre *" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextField fx:id="titleField" promptText="Titre de l'événement"
                                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                          -fx-padding: 8 10;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Description -->
                                                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                                        <Label text="Description" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextArea fx:id="descriptionArea" promptText="Description..."
                                                                  prefRowCount="2"
                                                                  style="-fx-background-color: rgba(0,0,0,0.5);
                                                                         -fx-background-radius: 8;
                                                                         -fx-border-color: rgba(255,255,255,0.3);
                                                                         -fx-border-radius: 8;
                                                                         -fx-text-fill: white;
                                                                         -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                         -fx-padding: 8 10;
                                                                         -fx-font-size: 12px;
                                                                         -fx-control-inner-background: rgba(0,0,0,0.5);" />
                                                    </VBox>

                                                    <!-- Location -->
                                                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                        <Label text="Location *" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextField fx:id="locationField" promptText="Lieu"
                                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                          -fx-padding: 8 10;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Date -->
                                                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                        <Label text="Date *" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <DatePicker fx:id="datePicker"
                                                                    style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-padding: 4 8;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Time -->
                                                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                                        <Label text="Heure (HH:mm) *" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextField fx:id="timeField" promptText="19:30"
                                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                          -fx-padding: 8 10;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Capacity -->
                                                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                        <Label text="Capacité *" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextField fx:id="capacityField" promptText="100"
                                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                          -fx-padding: 8 10;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Event Type -->
                                                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                                        <Label text="Type" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <ComboBox fx:id="eventTypeBox" promptText="Type"
                                                                  style="-fx-background-color: rgba(0,0,0,0.5);
                                                                         -fx-background-radius: 8;
                                                                         -fx-border-color: rgba(255,255,255,0.3);
                                                                         -fx-border-radius: 8;
                                                                         -fx-text-fill: white;
                                                                         -fx-pref-width: 130;
                                                                         -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Season -->
                                                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                                        <Label text="Saison" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <ComboBox fx:id="seasonBox" promptText="Saison"
                                                                  style="-fx-background-color: rgba(0,0,0,0.5);
                                                                         -fx-background-radius: 8;
                                                                         -fx-border-color: rgba(255,255,255,0.3);
                                                                         -fx-border-radius: 8;
                                                                         -fx-text-fill: white;
                                                                         -fx-pref-width: 130;
                                                                         -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Status -->
                                                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="5">
                                                        <Label text="Statut" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextField fx:id="statusField" promptText="À venir"
                                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                          -fx-padding: 8 10;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>

                                                    <!-- Image Path + bouton -->
                                                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                                        <Label text="Image" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 10px; -fx-font-weight: 800;" />
                                                        <TextField fx:id="imageField" promptText="URL image"
                                                                   style="-fx-background-color: rgba(0,0,0,0.5);
                                                                          -fx-background-radius: 8;
                                                                          -fx-border-color: rgba(255,255,255,0.3);
                                                                          -fx-border-radius: 8;
                                                                          -fx-text-fill: white;
                                                                          -fx-prompt-text-fill: rgba(255,255,255,0.7);
                                                                          -fx-padding: 8 10;
                                                                          -fx-font-size: 12px;" />
                                                    </VBox>
                                                </GridPane>

                                                <!-- Boutons CRUD -->
                                                <HBox spacing="6" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                                                    <Button onAction="#addEvent" text="➕ Ajouter"
