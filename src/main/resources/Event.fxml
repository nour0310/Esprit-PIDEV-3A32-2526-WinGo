<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="rootPane" prefHeight="750" prefWidth="1200" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlles.EventController">

    <!-- MAIN CONTAINER -->
    <HBox fx:id="mainContainer" prefHeight="750" prefWidth="1200">

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <VBox fx:id="sidebar" prefWidth="260" spacing="5" style="-fx-background-color: #FFFFFF; -fx-padding: 30 0; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">
            <effect>
                <DropShadow color="#00000012" offsetX="3" radius="25" />
            </effect>

            <!-- Logo Section -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 40 30;">
                <Label style="-fx-font-size: 32px; -fx-text-fill: #6366F1;" text="⛰️" />
                <VBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #6366F1; -fx-font-size: 22px; -fx-font-weight: 900;" text="WinGO" />
                    <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold;" text="Travel Agency" />
                </VBox>
            </HBox>

            <!-- HOME -->
            <HBox onMouseClicked="#goToHome" alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 0 0 30; -fx-background-color: #EEF2FF; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #6366F1; -fx-font-size: 18px;" text="🏠" />
                <Label style="-fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-font-size: 15px;" text="Home" />
                <Region HBox.hgrow="ALWAYS" />
                <Pane prefHeight="25" prefWidth="4" style="-fx-background-color: #6366F1; -fx-background-radius: 5 0 0 5;" />
            </HBox>

            <!-- EVENTS -->
            <HBox onMouseClicked="#goToEvents" alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #F59E0B; -fx-font-size: 18px;" text="📅" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Events" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- PARTICIPATIONS -->
            <HBox onMouseClicked="#goToParticipations" alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #10B981; -fx-font-size: 18px;" text="👥" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Participations" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- MY TRIPS -->
            <HBox onMouseClicked="#goToMesParticipations" alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #3B82F6; -fx-font-size: 18px;" text="📋" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="My Trips" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- STATISTICS BUTTON -->
            <HBox onMouseClicked="#openStatistics" alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand; -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #8B5CF6, #6366F1); -fx-background-radius: 0 20 20 0; -fx-margin: 10 0;">
                <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="📊" />
                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;" text="Statistics" />
                <Region HBox.hgrow="ALWAYS" />
                <Circle fill="white" radius="4" />
            </HBox>

            <!-- EXPLORE -->
            <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #87CEEB; -fx-font-size: 18px;" text="🧭" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Explore" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- SUPPORT -->
            <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #EC4899; -fx-font-size: 18px;" text="💬" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Support" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- SETTINGS -->
            <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #6366F1; -fx-font-size: 18px;" text="⚙️" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Settings" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Dark Mode Toggle - FIXED WITH ALL REQUIRED FX:IDS -->
            <HBox fx:id="darkModeToggle" alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #6366F1; -fx-font-size: 18px;" text="🌙" />
                <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 14px;" text="Dark mode" />
                <Region HBox.hgrow="ALWAYS" />
                <Pane fx:id="darkModeSlider" prefHeight="18" prefWidth="35" style="-fx-background-color: #6366F1; -fx-background-radius: 10;">
                    <Circle fx:id="darkModeCircle" fill="#FFFFFF" radius="7" translateX="3" translateY="2" />
                </Pane>
            </HBox>

            <!-- Logout -->
            <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
                <Label style="-fx-text-fill: #EF4444; -fx-font-size: 18px;" text="🚪" />
                <Label style="-fx-text-fill: #EF4444; -fx-font-weight: bold; -fx-font-size: 14px;" text="Logout" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>

        <!-- ==================== MAIN CONTENT ==================== -->
        <VBox fx:id="mainContent" prefHeight="750" spacing="20" style="-fx-padding: 20 30;" HBox.hgrow="ALWAYS">

            <!-- TOP BAR with Glass Effect -->
            <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 20; -fx-padding: 15 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">

                <!-- Search Bar -->
                <HBox fx:id="searchBar" alignment="CENTER_LEFT" prefWidth="450" spacing="10" style="-fx-background-color: #F1F5F9; -fx-background-radius: 15; -fx-padding: 8 15;">
                    <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;" text="🔍" />
                    <TextField fx:id="globalSearchField" promptText="Search destinations, events..." onAction="#onSearchEvent" style="-fx-background-color: transparent; -fx-text-fill: #1E293B; -fx-font-size: 13px; -fx-prompt-text-fill: #94A3B8;" HBox.hgrow="ALWAYS" />
                    <Button onAction="#onClearEventSearch" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 0;" text="✕" />
                </HBox>

                <Button onAction="#onSearchEvent" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #6366F1, #8B5CF6); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 10 30; -fx-font-size: 13px; -fx-cursor: hand;" text="Search">
                    <effect>
                        <DropShadow color="#6366F180" offsetY="3" radius="8" />
                    </effect>
                </Button>

                <!-- Statistics Quick Access Button -->
                <Button onAction="#openStatistics" style="-fx-background-color: #8B5CF6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 10 20; -fx-font-size: 13px; -fx-cursor: hand;" text="📊 Stats">
                    <effect>
                        <DropShadow color="#8B5CF680" offsetY="3" radius="8" />
                    </effect>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <!-- User Profile with Badge -->
                <HBox fx:id="userProfile" alignment="CENTER_RIGHT" spacing="12" style="-fx-background-color: #F1F5F9; -fx-background-radius: 30; -fx-padding: 5 15 5 5;">
                    <VBox alignment="CENTER_RIGHT">
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 13px;" text="WinGo User" />
                        <Label style="-fx-text-fill: #6366F1; -fx-font-size: 11px; -fx-font-weight: bold;" text="Travel Love" />
                    </VBox>
                    <StackPane>
                        <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #F59E0B, #FBBF24)" radius="22" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 20px;" text="👤" />
                    </StackPane>
                </HBox>
            </HBox>

            <!-- STATISTICS DASHBOARD -->
            <VBox fx:id="statisticsDashboard" visible="false" managed="false" spacing="20" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10);">

                <!-- Header with Close Button -->
                <HBox alignment="CENTER_LEFT">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: #8B5CF6; -fx-background-radius: 15; -fx-padding: 10;">
                            <Label style="-fx-text-fill: white; -fx-font-size: 24px;" text="📊" />
                        </StackPane>
                        <VBox>
                            <Label style="-fx-text-fill: #1E293B; -fx-font-size: 24px; -fx-font-weight: 900;" text="Analytics Dashboard" />
                            <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Real-time insights and metrics" />
                        </VBox>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#closeStatistics" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 50; -fx-padding: 10 15; -fx-cursor: hand;" text="✕" />
                </HBox>

                <!-- Stats Overview Cards -->
                <HBox spacing="15">
                    <!-- Total Events Card -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #6366F1, #8B5CF6); -fx-background-radius: 20; -fx-padding: 20;">
                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;" text="Total Events" />
                        <Label fx:id="totalEventsLabel" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: 900;" text="0" />
                    </VBox>

                    <!-- Total Bookings Card -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #10B981, #059669); -fx-background-radius: 20; -fx-padding: 20;">
                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;" text="Total Bookings" />
                        <Label fx:id="totalParticipationsLabel" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: 900;" text="0" />
                    </VBox>

                    <!-- Total Revenue Card -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #F59E0B, #D97706); -fx-background-radius: 20; -fx-padding: 20;">
                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;" text="Total Revenue" />
                        <Label fx:id="totalRevenueLabel" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: 900;" text="0$" />
                    </VBox>

                    <!-- Average Price Card -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #EF4444, #DC2626); -fx-background-radius: 20; -fx-padding: 20;">
                        <Label style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;" text="Avg Price" />
                        <Label fx:id="averagePriceLabel" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: 900;" text="0$" />
                    </VBox>
                </HBox>

                <!-- Charts Row -->
                <HBox spacing="15">
                    <!-- Pie Chart - Event Types Distribution -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-background-radius: 20; -fx-padding: 15;">
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="Event Types Distribution" />
                        <PieChart fx:id="eventTypePieChart" prefHeight="200" prefWidth="250" legendVisible="true" labelsVisible="true" />
                    </VBox>

                    <!-- Bar Chart - Monthly Bookings -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-background-radius: 20; -fx-padding: 15;">
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="Monthly Bookings Trend" />
                        <BarChart fx:id="monthlyBookingsChart" prefHeight="200" prefWidth="350">
                            <xAxis>
                                <CategoryAxis label="Month" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Bookings" />
                            </yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- Top Events Table -->
                <VBox spacing="10" style="-fx-background-color: #F8FAFC; -fx-background-radius: 20; -fx-padding: 15;">
                    <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="🏆 Top Performing Events" />
                    <TableView fx:id="topEventsTable" prefHeight="150" style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="topEventRank" prefWidth="40" text="#" />
                            <TableColumn fx:id="topEventTitle" prefWidth="200" text="Event" />
                            <TableColumn fx:id="topEventBookings" prefWidth="80" text="Bookings" />
                            <TableColumn fx:id="topEventRevenue" prefWidth="100" text="Revenue" />
                            <TableColumn fx:id="topEventFillRate" prefWidth="80" text="Fill Rate" />
                        </columns>
                    </TableView>
                </VBox>

                <!-- Quick Stats Row -->
                <HBox spacing="10" alignment="CENTER">
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 12 20;">
                        <Circle fill="#10B981" radius="6" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Most booked:" />
                        <Label fx:id="mostBookedEventLabel" style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 12px;" text="-" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 12 20;">
                        <Circle fill="#F59E0B" radius="6" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Highest revenue:" />
                        <Label fx:id="highestRevenueEventLabel" style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 12px;" text="-" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 12 20;">
                        <Circle fill="#6366F1" radius="6" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Upcoming:" />
                        <Label fx:id="upcomingEventsLabel" style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 12px;" text="-" />
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 12 20;">
                        <Circle fill="#EF4444" radius="6" />
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px;" text="Fill rate:" />
                        <Label fx:id="averageFillRateLabel" style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 12px;" text="0%" />
                    </HBox>
                </HBox>
            </VBox>

            <!-- TAB PANE -->
            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent; -fx-tab-min-width: 0;" tabMinHeight="0" tabMaxHeight="0" VBox.vgrow="ALWAYS">

                <!-- TAB 1: HOME with Event Cards -->
                <Tab fx:id="homeTab">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <VBox spacing="20">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10" />
                                    </padding>

                                    <!-- Welcome Section -->
                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #1E293B; -fx-font-size: 26px; -fx-font-weight: 900;" text="Discover Events" />
                                        <Label style="-fx-text-fill: #6366F1; -fx-font-size: 14px;" text="Find your next adventure" />
                                    </VBox>

                                    <!-- Category Tabs -->
                                    <HBox spacing="30">
                                        <VBox alignment="CENTER" spacing="5">
                                            <Label style="-fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="All Events" />
                                            <Pane prefHeight="3" prefWidth="30" style="-fx-background-color: #6366F1; -fx-background-radius: 5;" />
                                        </VBox>
                                        <Label style="-fx-text-fill: #94A3B8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Popular" />
                                        <Label style="-fx-text-fill: #94A3B8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Upcoming" />
                                    </HBox>

                                    <!-- Event Cards Grid -->
                                    <FlowPane fx:id="eventCardsContainer" hgap="20" vgap="20" prefWrapLength="1000" />
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- TAB 2: EVENTS MANAGEMENT -->
                <Tab fx:id="eventsTab">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <VBox spacing="20">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10" />
                                    </padding>

                                    <!-- Header -->
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #1E293B; -fx-font-size: 20px; -fx-font-weight: 900;" text="Events Management" />
                                            <Label fx:id="eventResultCountLabel" style="-fx-text-fill: #6366F1; -fx-font-size: 12px;" text="0 event(s) found" />
                                        </VBox>
                                    </HBox>

                                    <!-- Event Form Card -->
                                    <VBox spacing="16" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-padding: 20;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="15" />
                                        </effect>

                                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="✏️ Add / Edit Event" />
                                        <Label fx:id="selectedEventLabel" style="-fx-text-fill: #6366F1; -fx-font-size: 12px; -fx-font-weight: 700;" text="" />

                                        <GridPane hgap="14" vgap="12">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="33" />
                                                <ColumnConstraints percentWidth="33" />
                                                <ColumnConstraints percentWidth="33" />
                                            </columnConstraints>

                                            <!-- Form fields remain the same -->
                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Title *" />
                                                <TextField fx:id="titleField" promptText="Event title" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Location *" />
                                                <TextField fx:id="locationField" promptText="City, Country" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Status" />
                                                <TextField fx:id="statusField" promptText="À venir" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Date *" />
                                                <DatePicker fx:id="datePicker" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 4 8;" maxWidth="Infinity" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Time (HH:mm) *" />
                                                <TextField fx:id="timeField" promptText="19:30" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Capacity *" />
                                                <TextField fx:id="capacityField" promptText="100" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Type" />
                                                <ComboBox fx:id="eventTypeBox" promptText="Event Type" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" maxWidth="Infinity" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Season" />
                                                <ComboBox fx:id="seasonBox" promptText="Season" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" maxWidth="Infinity" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Price $" />
                                                <TextField fx:id="priceField" promptText="0.00" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Image" />
                                                <HBox spacing="10" alignment="CENTER_LEFT">
                                                    <TextField fx:id="imageField" promptText="Image path" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" HBox.hgrow="ALWAYS" />
                                                    <Button fx:id="chooseImageButton" onAction="#chooseImage" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20;" text="Browse..." />
                                                </HBox>
                                                <Label fx:id="eventImagePathLabel" style="-fx-text-fill: #10B981; -fx-font-size: 11px;" text="No image selected" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="3">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Preview" />
                                                <ImageView fx:id="eventImageView" fitHeight="80" fitWidth="80" preserveRatio="true" style="-fx-background-color: #F1F5F9; -fx-background-radius: 8;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="3">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Description" />
                                                <TextArea fx:id="descriptionArea" promptText="Event description..." prefRowCount="2" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>
                                        </GridPane>

                                        <!-- Action Buttons -->
                                        <HBox spacing="10" alignment="CENTER_RIGHT">
                                            <Button onAction="#clearEventFields" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 10; -fx-padding: 10 20;" text="Clear" />
                                            <Button onAction="#deleteEvent" style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20;" text="🗑 Delete" />
                                            <Button onAction="#updateEvent" style="-fx-background-color: #EEF2FF; -fx-text-fill: #6366F1; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20;" text="✏ Update" />
                                            <Button onAction="#addEvent" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 24;" text="+ Add Event" />
                                        </HBox>
                                    </VBox>

                                    <!-- Events Table -->
                                    <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-padding: 20;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="15" />
                                        </effect>

                                        <HBox alignment="CENTER_LEFT" spacing="12">
                                            <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="📋 All Events with Statistics" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#openParticipationForSelectedEvent" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 999; -fx-padding: 8 18;" text="✅ Participate" />
                                        </HBox>

                                        <TableView fx:id="eventTable" prefHeight="300" style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                                            <columns>
                                                <TableColumn fx:id="colId" prefWidth="45" text="ID" />
                                                <TableColumn fx:id="colTitle" prefWidth="150" text="Title" />
                                                <TableColumn fx:id="colLocation" prefWidth="120" text="Location" />
                                                <TableColumn fx:id="colDate" prefWidth="90" text="Date" />
                                                <TableColumn fx:id="colTime" prefWidth="70" text="Time" />
                                                <TableColumn fx:id="colCapacity" prefWidth="70" text="Capacity" />
                                                <TableColumn fx:id="colPrice" prefWidth="80" text="Price" />
                                                <TableColumn fx:id="colBookings" prefWidth="70" text="Bookings" />
                                                <TableColumn fx:id="colRevenue" prefWidth="90" text="Revenue" />
                                                <TableColumn fx:id="colSeason" prefWidth="70" text="Season" />
                                                <TableColumn fx:id="colStatus" prefWidth="90" text="Status" />
                                            </columns>
                                        </TableView>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- TAB 3: PARTICIPATIONS -->
                <Tab fx:id="participationsTab">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <VBox spacing="20">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10" />
                                    </padding>

                                    <Label style="-fx-text-fill: #1E293B; -fx-font-size: 20px; -fx-font-weight: 900;" text="Participations Management" />

                                    <!-- Event Selector -->
                                    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-padding: 14;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="10" />
                                        </effect>
                                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-font-weight: 700;" text="Event:" />
                                        <Label fx:id="eventIdLabel" style="-fx-text-fill: #6366F1; -fx-font-size: 13px; -fx-font-weight: 800;" text="No event selected" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="eventSelectorBox" prefWidth="300" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" />
                                        <Button onAction="#loadParticipationsForSelectedEvent" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20;" text="Load" />
                                    </HBox>

                                    <!-- Participation Form -->
                                    <VBox spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-padding: 20;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="15" />
                                        </effect>

                                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="✏️ Add / Edit Participation" />

                                        <GridPane hgap="14" vgap="12">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="25" />
                                                <ColumnConstraints percentWidth="25" />
                                                <ColumnConstraints percentWidth="25" />
                                                <ColumnConstraints percentWidth="25" />
                                            </columnConstraints>

                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="First Name *" />
                                                <TextField fx:id="prenomField" promptText="Prénom" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Last Name *" />
                                                <TextField fx:id="nomField" promptText="Nom" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Email *" />
                                                <TextField fx:id="emailField" promptText="email@example.com" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Phone" />
                                                <TextField fx:id="telephoneField" promptText="+216..." style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Date *" />
                                                <DatePicker fx:id="partDatePicker" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 4 8;" maxWidth="Infinity" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Status *" />
                                                <ComboBox fx:id="statutBox" promptText="Statut" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" maxWidth="Infinity" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="User ID *" />
                                                <TextField fx:id="userIdField" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" text="1" />
                                            </VBox>

                                            <VBox spacing="4" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Places *" />
                                                <TextField fx:id="placesField" promptText="1" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 10 12;" />
                                            </VBox>
                                        </GridPane>

                                        <!-- Action Buttons -->
                                        <HBox spacing="10" alignment="CENTER_RIGHT">
                                            <Button onAction="#clearParticipationFields" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 10; -fx-padding: 10 20;" text="Clear" />
                                            <Button onAction="#deleteParticipation" style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20;" text="🗑 Delete" />
                                            <Button onAction="#updateParticipation" style="-fx-background-color: #EEF2FF; -fx-text-fill: #6366F1; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 20;" text="✏ Update" />
                                            <Button onAction="#addParticipation" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 10 24;" text="+ Add" />
                                        </HBox>
                                    </VBox>

                                    <!-- Search and Table -->
                                    <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-padding: 20;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="15" />
                                        </effect>

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="👥 All Participations" HBox.hgrow="ALWAYS" />
                                            <ComboBox fx:id="searchTypeBox" prefWidth="110" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" />
                                            <TextField fx:id="participationsSearchField" onAction="#onSearch" prefWidth="200" promptText="Search..." style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 9 12;" />
                                            <Button onAction="#onSearch" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 9 18;" text="Search" />
                                            <Button onAction="#onClearSearch" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-background-radius: 10; -fx-padding: 9 14;" text="✕" />
                                            <Button onAction="#onRefresh" style="-fx-background-color: #E8F5E9; -fx-text-fill: #28a745; -fx-font-weight: 900; -fx-background-radius: 10; -fx-padding: 9 14;" text="↻" />
                                        </HBox>

                                        <Label fx:id="resultCountLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" text="0 participation(s) trouvée(s)" />

                                        <TableView fx:id="participationTable" prefHeight="260" style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                                            <columns>
                                                <TableColumn fx:id="colPartId" prefWidth="45" text="ID" />
                                                <TableColumn fx:id="colEvent" prefWidth="70" text="Event ID" />
                                                <TableColumn fx:id="colEventTitle" prefWidth="130" text="Event" />
                                                <TableColumn fx:id="colPartDate" prefWidth="90" text="Date" />
                                                <TableColumn fx:id="colStatut" prefWidth="90" text="Status" />
                                                <TableColumn fx:id="colNom" prefWidth="100" text="Last Name" />
                                                <TableColumn fx:id="colPrenom" prefWidth="100" text="First Name" />
                                                <TableColumn fx:id="colEmail" prefWidth="150" text="Email" />
                                                <TableColumn fx:id="colPlaces" prefWidth="65" text="Places" />
                                                <TableColumn fx:id="colUserId" prefWidth="55" text="User" />
                                            </columns>
                                        </TableView>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- TAB 4: MY PARTICIPATIONS -->
                <Tab fx:id="myTripsTab">
                    <content>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                            <content>
                                <VBox spacing="20">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #1E293B; -fx-font-size: 20px; -fx-font-weight: 900;" text="My Participations" />
                                            <Label fx:id="clientInfoLabel" style="-fx-text-fill: #6366F1; -fx-font-size: 12px; -fx-font-weight: 700;" text="Client:" />
                                        </VBox>
                                    </HBox>

                                    <!-- Search Card -->
                                    <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-padding: 18;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="15" />
                                        </effect>

                                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="🔍 Rechercher" />

                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <ComboBox fx:id="myTripsSearchType" prefWidth="120" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;" />
                                            <TextField fx:id="myTripsSearchField" onAction="#onSearch" promptText="Email, nom ou prénom..." HBox.hgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 12 16;" />
                                            <Button onAction="#onSearch" style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 12 22;" text="Rechercher" />
                                            <Button onAction="#onClearSearch" style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 10; -fx-padding: 12 18;" text="Effacer" />
                                            <Button onAction="#onRefresh" style="-fx-background-color: #E8F5E9; -fx-text-fill: #28a745; -fx-font-weight: 900; -fx-background-radius: 10; -fx-padding: 12 16;" text="↻" />
                                        </HBox>

                                        <Label fx:id="myTripsResultLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="0 participation(s) trouvee(s)" />
                                    </VBox>

                                    <!-- Table Card -->
                                    <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-background-radius: 18; -fx-padding: 18;">
                                        <effect>
                                            <DropShadow color="#0000000A" offsetY="5" radius="15" />
                                        </effect>

                                        <HBox alignment="CENTER_LEFT">
                                            <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 800; -fx-font-size: 14px;" text="📋 Liste de mes participations" HBox.hgrow="ALWAYS" />
                                            <Button onAction="#viewParticipationDetails" style="-fx-background-color: #EEF2FF; -fx-text-fill: #6366F1; -fx-font-weight: 800; -fx-background-radius: 10; -fx-padding: 8 18;" text="Voir détails" />
                                        </HBox>

                                        <TableView fx:id="participationTable2" prefHeight="340" style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                                            <columns>
                                                <TableColumn fx:id="colId2" prefWidth="50" text="ID" />
                                                <TableColumn fx:id="colEventTitle2" prefWidth="160" text="Événement" />
                                                <TableColumn fx:id="colDate2" prefWidth="100" text="Date" />
                                                <TableColumn fx:id="colStatut2" prefWidth="100" text="Statut" />
                                                <TableColumn fx:id="colPrenom2" prefWidth="110" text="Prénom" />
                                                <TableColumn fx:id="colNom2" prefWidth="110" text="Nom" />
                                                <TableColumn fx:id="colEmail2" prefWidth="160" text="Email" />
                                                <TableColumn fx:id="colPlaces2" prefWidth="70" text="Places" />
                                            </columns>
                                        </TableView>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </TabPane>
        </VBox>
    </HBox>
</StackPane>