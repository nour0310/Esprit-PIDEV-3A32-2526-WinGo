<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="850" prefWidth="1400"
      style="-fx-background-color: #F8F9FA;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox prefWidth="260" style="-fx-background-color: #FFFFFF; -fx-padding: 30 0; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;" spacing="5">
        <effect><DropShadow color="#0000000A" radius="20" offsetX="2" /></effect>

        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 40 30;">
            <Label text="⛰️" style="-fx-font-size: 32px; -fx-text-fill: #5B4EFA;" />
            <VBox alignment="CENTER_LEFT">
                <Label text="TripLove" style="-fx-text-fill: #5B4EFA; -fx-font-size: 22px; -fx-font-weight: 900;" />
                <Label text="Travel Agency" style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px; -fx-font-weight: bold;" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 0 0 30; -fx-background-color: #F3F2FF;">
            <Label text="🏠" style="-fx-text-fill: #5B4EFA; -fx-font-size: 18px;" />
            <Label text="Home" style="-fx-text-fill: #5B4EFA; -fx-font-weight: bold; -fx-font-size: 15px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Pane prefWidth="5" minHeight="30" style="-fx-background-color: #5B4EFA; -fx-background-radius: 5 0 0 5;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="🎫" style="-fx-text-fill: #A0AEC0; -fx-font-size: 18px;" />
            <Label text="Booking" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 15px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Circle radius="4" fill="#E53E3E" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="🌍" style="-fx-text-fill: #A0AEC0; -fx-font-size: 18px;" />
            <Label text="Explore" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 15px;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="💬" style="-fx-text-fill: #A0AEC0; -fx-font-size: 18px;" />
            <Label text="Message" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 15px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Circle radius="4" fill="#E53E3E" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="❓" style="-fx-text-fill: #A0AEC0; -fx-font-size: 18px;" />
            <Label text="Support" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 15px;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="⚙️" style="-fx-text-fill: #A0AEC0; -fx-font-size: 18px;" />
            <Label text="Setting" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 15px;" />
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="🌙" style="-fx-text-fill: #A0AEC0; -fx-font-size: 18px;" />
            <Label text="Dark mode" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 14px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Pane prefWidth="35" prefHeight="18" style="-fx-background-color: #E2E8F0; -fx-background-radius: 10;">
                <Circle radius="7" fill="#FFFFFF" translateX="3" translateY="2" />
            </Pane>
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label text="🚪" style="-fx-text-fill: #E53E3E; -fx-font-size: 18px;" />
            <Label text="Logout" style="-fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-font-size: 14px;" />
        </HBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 30 40;" spacing="30">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="500"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-padding: 10 20;">
                <effect><DropShadow color="#00000008" radius="10" offsetY="5" /></effect>
                <Label text="🔍" style="-fx-text-fill: #A0AEC0;" />
                <TextField promptText="Search destination..."
                           style="-fx-background-color: transparent; -fx-text-fill: #2D3748; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button text="⚲" style="-fx-background-color: #5B4EFA; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 16; -fx-font-size: 16px; -fx-cursor: hand;">
                <effect><DropShadow color="#5B4EFA40" radius="10" offsetY="5" /></effect>
            </Button>

            <Button text="Search" style="-fx-background-color: #5B4EFA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30; -fx-font-size: 14px; -fx-cursor: hand;">
                <effect><DropShadow color="#5B4EFA40" radius="10" offsetY="5" /></effect>
            </Button>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Circle radius="22" fill="#E2E8F0" />
                <VBox alignment="CENTER_LEFT">
                    <Label text="Norman haires" style="-fx-text-fill: #2D3748; -fx-font-weight: 900; -fx-font-size: 14px;" />
                    <Label text="SuperAdmin" style="-fx-text-fill: #A0AEC0; -fx-font-size: 12px;" />
                </VBox>
                <Label text="▼" style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px;" />
            </HBox>
        </HBox>


        <HBox spacing="30" VBox.vgrow="ALWAYS">

            <VBox HBox.hgrow="ALWAYS" spacing="20">

                <Label text="Discover World" style="-fx-text-fill: #5B4EFA; -fx-font-size: 24px; -fx-font-weight: 900;" />

                <HBox spacing="30">
                    <VBox spacing="5" alignment="CENTER">
                        <Label text="Popular Place" style="-fx-text-fill: #5B4EFA; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                        <Pane prefHeight="3" prefWidth="30" style="-fx-background-color: #5B4EFA; -fx-background-radius: 5;" />
                    </VBox>
                    <Label text="Recommended" style="-fx-text-fill: #A0AEC0; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                    <Label text="Near me" style="-fx-text-fill: #A0AEC0; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" />
                </HBox>

                <HBox spacing="20">
                    <VBox prefWidth="220" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 10;">
                        <effect><DropShadow color="#0000000A" radius="15" offsetY="5" /></effect>
                        <Pane prefHeight="140" style="-fx-background-image: url('/assets/kahf.jpg'); -fx-background-size: cover; -fx-background-radius: 15;" />
                        <VBox spacing="5" style="-fx-padding: 15 5 5 5;">
                            <Label text="The Grand Palace" style="-fx-text-fill: #2D3748; -fx-font-weight: bold; -fx-font-size: 16px;" />
                            <HBox alignment="CENTER_LEFT" spacing="5">
                                <Label text="📍" style="-fx-text-fill: #A0AEC0; -fx-font-size: 12px;" />
                                <Label text="Bangkok" style="-fx-text-fill: #718096; -fx-font-size: 13px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="⭐ 4.8" style="-fx-text-fill: #2D3748; -fx-font-weight: bold; -fx-font-size: 12px;" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox prefWidth="220" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 10;">
                        <effect><DropShadow color="#0000000A" radius="15" offsetY="5" /></effect>
                        <Pane prefHeight="140" style="-fx-background-image: url('/assets/9dim.jpg'); -fx-background-size: cover; -fx-background-radius: 15;" />
                        <VBox spacing="5" style="-fx-padding: 15 5 5 5;">
                            <Label text="Tokyo DisneySea" style="-fx-text-fill: #2D3748; -fx-font-weight: bold; -fx-font-size: 16px;" />
                            <HBox alignment="CENTER_LEFT" spacing="5">
                                <Label text="📍" style="-fx-text-fill: #A0AEC0; -fx-font-size: 12px;" />
                                <Label text="Tokyo" style="-fx-text-fill: #718096; -fx-font-size: 13px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="⭐ 4.7" style="-fx-text-fill: #2D3748; -fx-font-weight: bold; -fx-font-size: 12px;" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox prefWidth="220" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 10;">
                        <effect><DropShadow color="#0000000A" radius="15" offsetY="5" /></effect>
                        <Pane prefHeight="140" style="-fx-background-image: url('/assets/sidibou.jpg'); -fx-background-size: cover; -fx-background-radius: 15;" />
                        <VBox spacing="5" style="-fx-padding: 15 5 5 5;">
                            <Label text="Shilin Night Market" style="-fx-text-fill: #2D3748; -fx-font-weight: bold; -fx-font-size: 16px;" />
                            <HBox alignment="CENTER_LEFT" spacing="5">
                                <Label text="📍" style="-fx-text-fill: #A0AEC0; -fx-font-size: 12px;" />
                                <Label text="Taipei" style="-fx-text-fill: #718096; -fx-font-size: 13px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="⭐ 4.8" style="-fx-text-fill: #2D3748; -fx-font-weight: bold; -fx-font-size: 12px;" />
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-padding: 15;" spacing="25">
                    <effect><DropShadow color="#0000000A" radius="20" offsetY="10" /></effect>

                    <Pane prefWidth="500" prefHeight="250" style="-fx-background-image: url('/assets/testt.jpg'); -fx-background-size: cover; -fx-background-radius: 20;" />

                    <VBox spacing="15" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-padding: 10 10 10 0;">
                        <VBox spacing="5">
                            <Label text="Nusa Penida Island" style="-fx-text-fill: #5B4EFA; -fx-font-weight: 900; -fx-font-size: 22px;" />
                            <HBox alignment="CENTER_LEFT" spacing="5">
                                <Label text="📍" style="-fx-text-fill: #A0AEC0;" />
                                <Label text="South East Asia" style="-fx-text-fill: #718096; -fx-font-weight: bold; -fx-font-size: 14px;" />
                            </HBox>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #FFF5F5; -fx-background-radius: 10; -fx-padding: 8 15; -fx-max-width: 150;">
                            <Label text="🎫" style="-fx-text-fill: #ED8936;" />
                            <Label text="\$ 1205" style="-fx-text-fill: #2D3748; -fx-font-weight: 900; -fx-font-size: 18px;" />
                        </HBox>

                        <Label text="Take a speed boat from Sanur to one of Bali's most enchanting locations."
                               style="-fx-text-fill: #718096; -fx-font-size: 13px; -fx-wrap-text: true;" />

                        <Button text="Book Now" style="-fx-background-color: #5B4EFA; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30; -fx-cursor: hand;">
                            <effect><DropShadow color="#5B4EFA40" radius="10" offsetY="5" /></effect>
                        </Button>
                    </VBox>
                </HBox>

            </VBox>

            <VBox prefWidth="320" spacing="20">
            </VBox>
        </HBox>
    </VBox>
</HBox>