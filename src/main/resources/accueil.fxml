<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="850" prefWidth="1400" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <VBox prefWidth="260" spacing="5" style="-fx-background-color: #FFFFFF; -fx-padding: 30 0; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">
        <effect><DropShadow color="#00000012" offsetX="3" radius="25" /></effect>

        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 40 30;">
            <Label style="-fx-font-size: 32px; -fx-text-fill: #FF4785;" text="⛰️" />
            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-text-fill: #FF4785; -fx-font-size: 22px; -fx-font-weight: 900;" text="WinGO" />
                <Label style="-fx-text-fill: #A0AEC0; -fx-font-size: 10px; -fx-font-weight: bold;" text="Travel Agency" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 0 0 30; -fx-background-color: #F5F3FF;">
            <Label style="-fx-text-fill: #8B5CF6; -fx-font-size: 18px;" text="🏠" />
            <Label style="-fx-text-fill: #8B5CF6; -fx-font-weight: bold; -fx-font-size: 15px;" text="Home" />
            <Region HBox.hgrow="ALWAYS" />
            <Pane prefHeight="25" prefWidth="4" style="-fx-background-color: #8B5CF6; -fx-background-radius: 5 0 0 5;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #3B82F6; -fx-font-size: 18px;" text="🎫" />
            <Label style="-fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-font-size: 15px;" text="Booking" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #10B981; -fx-font-size: 18px;" text="🌍" />
            <Label style="-fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-font-size: 15px;" text="Explore" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #F43F5E; -fx-font-size: 18px;" text="💬" />
            <Label style="-fx-text-fill: #4A5568; -fx-font-weight: bold; -fx-font-size: 15px;" text="Message" />
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #E11D48; -fx-font-size: 18px;" text="🚪" />
            <Label style="-fx-text-fill: #E11D48; -fx-font-weight: bold; -fx-font-size: 14px;" text="Logout" />
        </HBox>
    </VBox>

    <VBox prefHeight="850.0" prefWidth="1187.0" spacing="30" style="-fx-padding: 30 40;" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" prefWidth="500" spacing="10" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-padding: 10 20;">
                <effect><DropShadow color="#00000008" offsetY="5" radius="10" /></effect>
                <Label style="-fx-text-fill: #3B82F6;" text="🔍" />
                <TextField promptText="Search destination..." style="-fx-background-color: transparent; -fx-text-fill: #2D3748; -fx-font-size: 14px; -fx-prompt-text-fill: #A0AEC0;" HBox.hgrow="ALWAYS" />
            </HBox>

            <Button style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 16; -fx-font-size: 16px; -fx-cursor: hand;" text="⚲">
                <effect><DropShadow color="#3B82F640" offsetY="5" radius="10" /></effect>
            </Button>

            <Button style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30; -fx-font-size: 14px; -fx-cursor: hand;" text="Search">
                <effect><DropShadow color="#10B98140" offsetY="5" radius="10" /></effect>
            </Button>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Circle fill="#F59E0B" radius="22" />
                <VBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #1A202C; -fx-font-weight: 900; -fx-font-size: 14px;" text="Norman Haires" />
                    <Label style="-fx-text-fill: #3B82F6; -fx-font-size: 12px; -fx-font-weight: bold;" text="SuperAdmin" />
                </VBox>
            </HBox>
        </HBox>

        <VBox spacing="20" HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #1A202C; -fx-font-size: 26px; -fx-font-weight: 900;" text="Discover World" />

            <HBox spacing="30">
                <VBox alignment="CENTER" spacing="5">
                    <Label style="-fx-text-fill: #F43F5E; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Popular Place" />
                    <Pane prefHeight="3" prefWidth="30" style="-fx-background-color: #F43F5E; -fx-background-radius: 5;" />
                </VBox>
                <Label style="-fx-text-fill: #A0AEC0; -fx-font-weight: bold; -fx-font-size: 14px;" text="Recommended" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="25" style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-padding: 15;">
                <effect><DropShadow color="#0000000A" offsetY="10" radius="20" /></effect>

                <Pane prefHeight="250" prefWidth="450" style="-fx-background-color: #EDF2F7; -fx-background-radius: 20;" />

                <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS" style="-fx-padding: 10;">
                    <VBox spacing="5">
                        <Label style="-fx-text-fill: #3B82F6; -fx-font-weight: 900; -fx-font-size: 24px;" text="Nusa Penida Island" />
                        <Label style="-fx-text-fill: #10B981; -fx-font-weight: bold;" text="📍 South East Asia" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #FFFBEB; -fx-background-radius: 10; -fx-padding: 8 15; -fx-max-width: 150;">
                        <Label style="-fx-text-fill: #D97706; -fx-font-weight: 900; -fx-font-size: 18px;" text="\$ 1205" />
                    </HBox>

                    <HBox spacing="20">
                        <Label style="-fx-text-fill: #8B5CF6; -fx-font-weight: bold; -fx-font-size: 13px;" text="⏱ 6 Days" />
                        <Label style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 13px;" text="🚗 1200 KM" />
                        <Label style="-fx-text-fill: #F59E0B; -fx-font-weight: bold; -fx-font-size: 13px;" text="⛅ 24° C" />
                    </HBox>

                    <Button style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 15 40; -fx-cursor: hand; -fx-font-size: 14px;" text="Book Now">
                        <effect><DropShadow color="#F59E0B40" offsetY="5" radius="10" /></effect>
                    </Button>
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 20;">
            <Label style="-fx-text-fill: #1A202C; -fx-font-weight: 900;" text="Transportation" />
            <HBox spacing="15">
                <Button style="-fx-background-color: #DBEAFE; -fx-text-fill: #3B82F6; -fx-background-radius: 10; -fx-padding: 10 20;" text="✈️ Flight" />
                <Button style="-fx-background-color: #D1FAE5; -fx-text-fill: #10B981; -fx-background-radius: 10; -fx-padding: 10 20;" text="🚌 Bus" />
                <Button style="-fx-background-color: #FEE2E2; -fx-text-fill: #EF4444; -fx-background-radius: 10; -fx-padding: 10 20;" text="🚆 Train" />
            </HBox>
        </VBox>
    </VBox>
</HBox>