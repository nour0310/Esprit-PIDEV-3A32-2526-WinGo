<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="850" prefWidth="1400" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <VBox prefWidth="260" spacing="5" style="-fx-background-color: #FFFFFF; -fx-padding: 30 0; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;">
        <effect><DropShadow color="#00000012" offsetX="3" radius="25" /></effect>

        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 40 30;">
            <Label style="-fx-font-size: 32px; -fx-text-fill: #6366F1;" text="⛰️" />
            <VBox alignment="CENTER_LEFT">
                <Label style="-fx-text-fill: #6366F1; -fx-font-size: 22px; -fx-font-weight: 900;" text="WinGO" />
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold;" text="Travel Agency" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 0 0 30; -fx-background-color: #EEF2FF;">
            <Label style="-fx-text-fill: #6366F1; -fx-font-size: 18px;" text="🏠" />
            <Label style="-fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-font-size: 15px;" text="Home" />
            <Region HBox.hgrow="ALWAYS" />
            <Pane prefHeight="25" prefWidth="4" style="-fx-background-color: #6366F1; -fx-background-radius: 5 0 0 5;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #F59E0B; -fx-font-size: 18px;" text="🎫" />
            <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Booking" />
            <Region HBox.hgrow="ALWAYS" />
            <Circle fill="#EF4444" radius="4" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #10B981; -fx-font-size: 18px;" text="🌍" />
            <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Explore" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #3B82F6; -fx-font-size: 18px;" text="💬" />
            <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Message" />
            <Region HBox.hgrow="ALWAYS" />
            <Circle fill="#EF4444" radius="4" />
        </HBox>

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #8B5CF6; -fx-font-size: 18px;" text="❓" />
            <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 15px;" text="Support" />
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_LEFT" minHeight="50" spacing="15" style="-fx-padding: 0 30; -fx-cursor: hand;">
            <Label style="-fx-text-fill: #6366F1; -fx-font-size: 18px;" text="🌙" />
            <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 14px;" text="Dark mode" />
            <Region HBox.hgrow="ALWAYS" />
            <Pane prefHeight="18" prefWidth="35" style="-fx-background-color: #6366F1; -fx-background-radius: 10;">
                <Circle fill="#FFFFFF" radius="7" translateX="15" translateY="2" />
            </Pane>
        </HBox>
    </VBox>

    <VBox prefHeight="850.0" prefWidth="1187.0" spacing="30" style="-fx-padding: 30 40;" HBox.hgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" prefWidth="500" spacing="10" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-padding: 10 20;">
                <effect><DropShadow color="#00000008" offsetY="5" radius="10" /></effect>
                <Label style="-fx-text-fill: #94A3B8;" text="🔍" />
                <TextField promptText="Search destination..." style="-fx-background-color: transparent; -fx-text-fill: #1E293B; -fx-font-size: 14px; -fx-prompt-text-fill: #94A3B8;" HBox.hgrow="ALWAYS" />
            </HBox>

            <Button style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 16; -fx-font-size: 16px; -fx-cursor: hand;" text="⚲">
                <effect><DropShadow color="#6366F140" offsetY="5" radius="10" /></effect>
            </Button>

            <Button style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30; -fx-font-size: 14px; -fx-cursor: hand;" text="Search">
                <effect><DropShadow color="#10B98140" offsetY="5" radius="10" /></effect>
            </Button>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Circle fill="#F59E0B" radius="22" />
                <VBox alignment="CENTER_LEFT">
                    <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 14px;" text="Norman Haires" />
                    <Label style="-fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-font-size: 12px;" text="SuperAdmin" />
                </VBox>
            </HBox>
        </HBox>

        <HBox spacing="30" VBox.vgrow="ALWAYS">
            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #1E293B; -fx-font-size: 28px; -fx-font-weight: 900;" text="Discover World" />

                <HBox spacing="30">
                    <VBox alignment="CENTER" spacing="5">
                        <Label style="-fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Popular Place" />
                        <Pane prefHeight="3" prefWidth="30" style="-fx-background-color: #6366F1; -fx-background-radius: 5;" />
                    </VBox>
                    <Label style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 14px;" text="Recommended" />
                </HBox>

                <HBox spacing="20">
                    <VBox prefWidth="220" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 10; -fx-border-color: #DBEAFE; -fx-border-width: 1; -fx-border-radius: 20;">
                        <effect><DropShadow color="#0000000A" offsetY="5" radius="15" /></effect>
                        <Pane prefHeight="140" style="-fx-background-color: #6366F1; -fx-background-radius: 15;" />
                        <VBox spacing="5" style="-fx-padding: 15 5 5 5;">
                            <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold;" text="The Grand Palace" />
                            <Label style="-fx-text-fill: #3B82F6;" text="📍 Bangkok" />
                        </VBox>
                    </VBox>

                    <VBox prefWidth="220" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-padding: 10; -fx-border-color: #FFEDD5; -fx-border-width: 1; -fx-border-radius: 20;">
                        <effect><DropShadow color="#0000000A" offsetY="5" radius="15" /></effect>
                        <Pane prefHeight="140" style="-fx-background-color: #F59E0B; -fx-background-radius: 15;" />
                        <VBox spacing="5" style="-fx-padding: 15 5 5 5;">
                            <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold;" text="Tokyo DisneySea" />
                            <Label style="-fx-text-fill: #F59E0B;" text="📍 Tokyo" />
                        </VBox>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <HBox spacing="25" style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-padding: 20; -fx-border-color: #EEF2FF; -fx-border-width: 2; -fx-border-radius: 25;">
                    <effect><DropShadow color="#6366F115" offsetY="10" radius="30" /></effect>
                    <Pane prefHeight="250" prefWidth="450" style="-fx-background-color: #6366F1; -fx-background-radius: 20;" />
                    <VBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #6366F1; -fx-font-weight: 900; -fx-font-size: 24px;" text="Nusa Penida Island" />
                        <HBox style="-fx-background-color: #ECFDF5; -fx-background-radius: 10; -fx-padding: 10; -fx-max-width: 120;">
                            <Label style="-fx-text-fill: #059669; -fx-font-weight: 900; -fx-font-size: 18px;" text="\$ 1,205" />
                        </HBox>
                        <Button style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 15 40;" text="Book Now" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox prefWidth="320" spacing="20">
                <VBox spacing="15" style="-fx-background-color: #6366F1; -fx-background-radius: 25; -fx-padding: 20;">
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="March 2024" />
                    <HBox spacing="10">
                        <VBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 10;">
                            <Label style="-fx-text-fill: white;" text="24" />
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 25; -fx-padding: 20;" VBox.vgrow="ALWAYS">
                    <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 900;" text="My Schedule" />
                    <VBox spacing="15">
                        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #F8FAFC; -fx-padding: 10; -fx-background-radius: 15;">
                            <Circle fill="#F472B6" radius="20" />
                            <Label style="-fx-text-fill: #1E293B; -fx-font-weight: bold;" text="Bangkok Trip" />
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</HBox>