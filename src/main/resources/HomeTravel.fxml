<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1200" prefHeight="720"
            stylesheets="@wow.css"
            styleClass="root">

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="topbar" spacing="14" alignment="CENTER_LEFT">
            <padding>
                <Insets top="14" right="18" bottom="14" left="18"/>
            </padding>

            <Label text="Wingo" styleClass="logo"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField promptText="Rechercher..." styleClass="search"/>

            <Button text="Ajouter" styleClass="btn btn-primary"/>
            <Button text="Promo" styleClass="btn btn-accent"/>
        </HBox>
    </top>

    <!-- LEFT MENU -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <padding>
                <Insets top="16" right="14" bottom="16" left="14"/>
            </padding>

            <Label text="Menu" styleClass="section-title"/>

            <Button text="Dashboard" styleClass="menu-item menu-active"/>
            <Button text="Produits" styleClass="menu-item"/>
            <Button text="Réservations" styleClass="menu-item"/>
            <Button text="Transport" styleClass="menu-item"/>
            <Button text="Réclamations" styleClass="menu-item"/>
            <Button text="Blog" styleClass="menu-item"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox styleClass="user-chip" spacing="10" alignment="CENTER_LEFT">
                <Label text="👤" styleClass="user-icon"/>
                <VBox>
                    <Label text="Commerçant" styleClass="user-name"/>
                    <Label text="En ligne" styleClass="user-status"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="14" styleClass="content">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <HBox spacing="14">
                <VBox styleClass="card card-blue" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Ventes" styleClass="card-title"/>
                    <Label text="1,248" styleClass="card-value"/>
                    <Label text="+12% ce mois" styleClass="card-sub"/>
                </VBox>

                <VBox styleClass="card card-orange" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Commandes" styleClass="card-title"/>
                    <Label text="342" styleClass="card-value"/>
                    <Label text="+8% cette semaine" styleClass="card-sub"/>
                </VBox>

                <VBox styleClass="card card-pink" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Favoris" styleClass="card-title"/>
                    <Label text="96" styleClass="card-value"/>
                    <Label text="+4 nouveaux" styleClass="card-sub"/>
                </VBox>
            </HBox>

            <VBox styleClass="panel" spacing="12">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Dernières activités" styleClass="panel-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Voir tout" styleClass="btn btn-ghost"/>
                </HBox>

                <TableView styleClass="table">
                    <columns>
                        <TableColumn text="Date" prefWidth="160"/>
                        <TableColumn text="Action" prefWidth="420"/>
                        <TableColumn text="Statut" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>