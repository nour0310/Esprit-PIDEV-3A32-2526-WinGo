<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="GUI.TransportFX"
            prefHeight="400.0" prefWidth="600.0">

    <VBox spacing="15" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
        </padding>

        <!-- TITLE -->
        <Label text="Reservation System"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <!-- FORM -->
        <VBox spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Type:" prefWidth="80"/>
                <TextField fx:id="typeField" promptText="Enter type"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Capacity:" prefWidth="80"/>
                <TextField fx:id="capaciteField" promptText="Enter capacity"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tarif:" prefWidth="80"/>
                <TextField fx:id="tarifField" promptText="Enter tarif"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Depart:" prefWidth="80"/>
                <TextField fx:id="departField" promptText="Enter depart"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Arrivee:" prefWidth="80"/>
                <TextField fx:id="arriveeField" promptText="Enter arrivee"/>
            </HBox>
        </VBox>

        <!-- BUTTONS -->
        <HBox spacing="15">
            <Button text="Add" onAction="#addTransport"/>
            <Button text="Update" onAction="#updateTransport"/>
            <Button text="Delete" onAction="#deleteTransport"/>
        </HBox>

        <!-- TABLE -->
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="100"/>
                <TableColumn fx:id="capaciteCol" text="Capacity" prefWidth="100"/>
                <TableColumn fx:id="tarifCol" text="Tarif" prefWidth="80"/>
                <TableColumn fx:id="departCol" text="Depart" prefWidth="100"/>
                <TableColumn fx:id="arriveeCol" text="Arrivee" prefWidth="100"/>
                <TableColumn fx:id="dateCol" text="Date" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>

