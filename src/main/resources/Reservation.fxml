<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="GUI.MixedFX">

    <!-- BACKGROUND -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/assets/testt.png');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: 100% 100%;" />

    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.18);" />

    <BorderPane maxHeight="650" maxWidth="1100"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect><DropShadow color="#00000066" offsetY="14" radius="28" /></effect>
        <padding><Insets bottom="12" left="12" right="12" top="12" /></padding>

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                <Label text="WinGo Management"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔔"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white; -fx-background-radius: 14; -fx-padding: 8 12;" />
                <Button text="👤"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white; -fx-background-radius: 14; -fx-padding: 8 12;" />
            </HBox>
        </top>

        <!-- LEFT MINI NAV -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets bottom="18" left="12" right="12" top="18" /></padding>

                <Button fx:id="reservationToggleBtn" text="📄" onAction="#showReservations"
                        style="-fx-background-color: #FFBD00; -fx-text-fill: #390099; -fx-font-size: 18px; -fx-font-weight: 900; -fx-background-radius: 14; -fx-padding: 12 12;" />

                <Button fx:id="transportToggleBtn" text="🚚" onAction="#showTransports"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-font-size: 18px; -fx-background-radius: 14; -fx-padding: 12 12;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- CENTER CONTENT -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
                <effect><DropShadow color="#00000055" offsetY="10" radius="18"/></effect>

                <!-- LIST VIEW -->
                <ScrollPane fx:id="listScroll" fitToWidth="true" style="-fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="listContainer" spacing="12">
                            <padding><Insets top="12" left="12" right="12" bottom="12"/></padding>

                            <!-- FILTERS -->
                            <HBox spacing="6" alignment="CENTER_LEFT"
                                  style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 18;
                                         -fx-border-color: #c49a6c;
                                         -fx-border-radius: 18;
                                         -fx-padding: 6 10;">
                                <Label text="Filtrer par :" style="-fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 11px;"/>
                                <ComboBox fx:id="filter1" promptText="Filtre 1"
                                          style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 8; -fx-text-fill: white; -fx-pref-width: 120;" />
                                <ComboBox fx:id="filter2" promptText="Filtre 2"
                                          style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 8; -fx-text-fill: white; -fx-pref-width: 120;" />
                            </HBox>

                            <!-- FLOWPANE FOR ITEMS -->
                            <ScrollPane fitToWidth="true" prefHeight="200" style="-fx-background-color: transparent;">
                                <FlowPane fx:id="itemsFlowPane" hgap="8" vgap="8" style="-fx-background-color: transparent;" />
                            </ScrollPane>

                            <!-- FORM -->
                            <StackPane style="-fx-background-color: rgba(0,0,0,0.28); -fx-background-radius: 18; -fx-border-color: #c49a6c; -fx-border-radius: 18;">
                                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                                <VBox spacing="8">
                                    <Label fx:id="formTitle" text="Formulaire" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 900;" />

                                    <GridPane fx:id="formGrid" hgap="8" vgap="8">
                                        <!-- Dynamic form fields populated by controller -->
                                    </GridPane>

                                    <!-- CRUD Buttons -->
                                    <HBox spacing="6" alignment="CENTER">
                                        <Button fx:id="addBtn" text="➕ Ajouter" onAction="#handleAdd"
                                                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="editBtn" text="✏️ Modifier" onAction="#handleEdit"
                                                style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="deleteBtn" text="🗑️ Supprimer" onAction="#handleDelete"
                                                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                        <Button fx:id="clearBtn" text="🔄 Nouveau" onAction="#clearForm"
                                                style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-weight: 900; -fx-font-size: 11px;"/>
                                    </HBox>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- DETAIL VIEW -->
                <ScrollPane fx:id="detailScroll" fitToWidth="true" visible="false" managed="false" style="-fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="detailContainer" spacing="15">
                            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
                            <Button fx:id="backBtn" text="← Retour" onAction="#backToList"
                                    maxWidth="Infinity" alignment="CENTER_LEFT"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 5;" />
                            <GridPane fx:id="detailGrid" hgap="8" vgap="8">
                                <!-- Dynamic detail fields -->
                            </GridPane>
                        </VBox>
                    </content>
                </ScrollPane>

            </StackPane>
        </center>
    </BorderPane>
</StackPane>
