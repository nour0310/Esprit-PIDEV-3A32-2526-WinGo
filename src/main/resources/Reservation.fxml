<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="GUI.MixedFX">

    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/assets/testt.png');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: cover;" />

    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.4);" />

    <BorderPane maxHeight="680" maxWidth="1150"
                style="-fx-background-color: rgba(255,255,255,0.05);
                       -fx-background-radius: 30;
                       -fx-border-color: rgba(255,255,255,0.15);
                       -fx-border-radius: 30;
                       -fx-border-width: 1.5;">
        <effect><DropShadow color="#00000088" offsetY="15" radius="30" /></effect>
        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>

        <top>
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10 20 25 20;">
                <Label text="WinGo Travel"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: 900;" />

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.4); -fx-background-radius: 20; -fx-padding: 8 20;">
                    <Label text="🔍" style="-fx-text-fill: rgba(255,255,255,0.6);" />
                    <TextField promptText="Rechercher une reservation ..."
                               style="-fx-background-color: transparent; -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.6); -fx-pref-width: 200;"/>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="⚙"
                        style="-fx-background-color: #FFBD00; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 15; -fx-padding: 8 12; -fx-font-size: 14px;" />
                <Button text="🔔"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;" />
                <Button text="👤"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px;" />
            </HBox>
        </top>

        <left>
            <VBox prefWidth="80" spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.08);
                         -fx-background-radius: 20;
                         -fx-border-color: rgba(255,255,255,0.1);
                         -fx-border-radius: 20;
                         -fx-padding: 20 10;">

                <Button fx:id="reservationToggleBtn" text="🏠" onAction="#showReservations"
                        style="-fx-background-color: #c49a6c; -fx-text-fill: white; -fx-font-size: 18px; -fx-background-radius: 12; -fx-padding: 12 15;" />

                <Button fx:id="transportToggleBtn" text="📝" onAction="#showTransports"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 18px;" />

                <Button text="💬" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 18px;" />
                <Button text="⚙" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 18px;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <center>
            <HBox spacing="20" style="-fx-padding: 0 0 0 20;">

                <VBox HBox.hgrow="ALWAYS" spacing="15">
                    <VBox spacing="5">
                        <Label text="Réserver le voyage de vos reves  ✍️" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
                        <Label text="Créez, modifiez ou supprimez vos reservation" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 14px;" />
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10 0 0 0;">
                            <Label text="📁" style="-fx-text-fill: white;" />
                            <Label text="Reservation et Transport" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>

                    <StackPane VBox.vgrow="ALWAYS">

                        <ScrollPane fx:id="listScroll" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
                            <content>
                                <VBox fx:id="listContainer" spacing="20" style="-fx-background-color: transparent;">
                                    <padding><Insets top="5" right="10" bottom="10" left="0"/></padding>

                                    <HBox spacing="15" alignment="CENTER_LEFT"
                                          style="-fx-background-color: rgba(0,0,0,0.3);
                                                 -fx-background-radius: 20;
                                                 -fx-border-color: #c49a6c;
                                                 -fx-border-radius: 20;
                                                 -fx-padding: 8 20;">
                                        <Label text="Filtrer par :" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                                        <ComboBox fx:id="filter1" promptText="Toutes"
                                                  style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 8; -fx-text-fill: white; -fx-pref-width: 130;" />
                                        <ComboBox fx:id="filter2" promptText="Toutes"
                                                  style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 8; -fx-text-fill: white; -fx-pref-width: 130;" />
                                    </HBox>

                                    <VBox style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 20; -fx-border-color: #c49a6c; -fx-border-radius: 20;">
                                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 20;">
                                            <Label text="📰 Reservation récents" style="-fx-text-fill: #FFBD00; -fx-font-weight: bold; -fx-font-size: 15px;" />
                                        </HBox>

                                        <ScrollPane fitToWidth="true" prefHeight="250" style="-fx-background: transparent; -fx-background-color: transparent;">
                                            <FlowPane fx:id="itemsFlowPane" hgap="15" vgap="15" style="-fx-background-color: transparent; -fx-padding: 0 20 20 20;" />
                                        </ScrollPane>
                                    </VBox>

                                    <VBox style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 20; -fx-border-color: #c49a6c; -fx-border-radius: 20; -fx-padding: 20;">
                                        <Label fx:id="formTitle" text="Formulaire" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;" />

                                        <GridPane fx:id="formGrid" hgap="10" vgap="10">
                                        </GridPane>

                                        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                                            <Button fx:id="addBtn" text="➕ Ajouter" onAction="#handleAdd"
                                                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold;"/>
                                            <Button fx:id="editBtn" text="✏️ Modifier" onAction="#handleEdit"
                                                    style="-fx-background-color: #ffc107; -fx-text-fill: black; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold;"/>
                                            <Button fx:id="deleteBtn" text="🗑️ Supprimer" onAction="#handleDelete"
                                                    style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold;"/>
                                            <Button fx:id="clearBtn" text="🔄 Nouveau" onAction="#clearForm"
                                                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 15; -fx-font-weight: bold;"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <ScrollPane fx:id="detailScroll" fitToWidth="true" visible="false" managed="false" style="-fx-background: transparent; -fx-background-color: transparent;">
                            <content>
                                <VBox fx:id="detailContainer" spacing="15" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 20; -fx-padding: 20;">
                                    <Button fx:id="backBtn" text="← Retour" onAction="#backToList"
                                            style="-fx-background-color: #c49a6c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 10;" />
                                    <GridPane fx:id="detailGrid" hgap="10" vgap="10">
                                    </GridPane>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </StackPane>
                </VBox>

                <VBox prefWidth="180" spacing="20" style="-fx-padding: 0 10 0 0;">
                    <Label text="Statistiques" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" />

                    <VBox spacing="5">
                        <Label text="📰 Reservation :" style="-fx-text-fill: #FFBD00; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        <Label text="2" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="💬 Commentaires :" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        <Label text="4" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px;" />
                    </VBox>
                </VBox>
            </HBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <HBox spacing="15"
                      style="-fx-background-color: rgba(255,255,255,0.08);
                             -fx-background-radius: 30;
                             -fx-border-color: rgba(255,255,255,0.1);
                             -fx-border-radius: 30;
                             -fx-padding: 8 20;">
                    <Button text="🏠" style="-fx-background-color: #c49a6c; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 6 15; -fx-font-size: 16px;" />
                    <Button text="🏰" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 16px; -fx-padding: 6 15;" />
                    <Button text="💬" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 16px; -fx-padding: 6 15;" />
                    <Button text="👤" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 16px; -fx-padding: 6 15;" />
                </HBox>
            </HBox>
        </bottom>

    </BorderPane>
</StackPane>