<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="1200" prefHeight="720">

   <!-- Background gradient -->
   <Pane style="-fx-background-color: linear-gradient(to bottom right, #390099, #9E0059);"/>

   <!-- Decorative blobs -->
   <Pane mouseTransparent="true">
      <children>
         <Region prefWidth="520" prefHeight="520" translateX="-330" translateY="-160"
                 style="-fx-background-radius: 999; -fx-background-color: rgba(255,189,0,0.35);">
            <effect><DropShadow radius="40" offsetY="12" color="#00000055"/></effect>
         </Region>

         <Region prefWidth="420" prefHeight="420" translateX="360" translateY="-60"
                 style="-fx-background-radius: 999; -fx-background-color: rgba(255,0,84,0.32);">
            <effect><DropShadow radius="40" offsetY="12" color="#00000055"/></effect>
         </Region>

         <Region prefWidth="520" prefHeight="520" translateX="260" translateY="260"
                 style="-fx-background-radius: 999; -fx-background-color: rgba(255,84,0,0.30);">
            <effect><DropShadow radius="40" offsetY="12" color="#00000055"/></effect>
         </Region>
      </children>
   </Pane>

   <!-- Main glass shell -->
   <BorderPane maxWidth="1100" maxHeight="650"
               style="-fx-background-color: rgba(255,255,255,0.18);
       -fx-background-radius: 26;
       -fx-border-color: rgba(255,255,255,0.45);
       -fx-border-radius: 26;
       -fx-border-width: 1.4;">
      <effect><DropShadow radius="28" offsetY="14" color="#00000066"/></effect>

      <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

      <!-- TOP BAR -->
      <top>
         <HBox alignment="CENTER_LEFT" spacing="12"
               style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.22);
                         -fx-border-width: 0 0 1 0;">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

            <Label text="WinGo Travel"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Search pill -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: rgba(0,0,0,0.22);
       -fx-background-radius: 999;
       -fx-padding: 8 10;
       -fx-border-color: rgba(255,255,255,0.22);
       -fx-border-radius: 999;">
               <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95;"/>
               <TextField promptText="Search destination (Djerba, Sousse…)"
                          style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 340;"/>
               <Button text="⚙"
                       style="-fx-background-color: #FFBD00;
                                   -fx-text-fill: #390099;
                                   -fx-background-radius: 999;
                                   -fx-font-weight: 900;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🔔"
                    style="-fx-background-color: rgba(0,0,0,0.22);
       -fx-text-fill: white;
       -fx-background-radius: 14;
       -fx-padding: 8 12;"/>
            <Button text="👤"
                    style="-fx-background-color: rgba(0,0,0,0.22);
       -fx-text-fill: white;
       -fx-background-radius: 14;
       -fx-padding: 8 12;"/>
         </HBox>
      </top>

      <!-- LEFT MINI NAV -->
      <left>
         <VBox spacing="14" prefWidth="86"
               style="-fx-background-color: rgba(0,0,0,0.22);
       -fx-background-radius: 18;
       -fx-border-color: rgba(255,255,255,0.22);
       -fx-border-radius: 18;">
            <padding><Insets top="18" right="12" bottom="18" left="12"/></padding>

            <Button text="🏠"
                    style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-font-size: 18px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;"/>

            <Button text="🧭"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;"/>

            <Button text="🔥"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;"/>

            <Button text="❤️"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;"/>

            <Button text="⚙"
                    style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="© 2026"
                   style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;"/>
         </VBox>
      </left>

      <!-- CENTER CONTENT (moins transparent = plus lisible) -->
      <center>
         <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <effect><DropShadow radius="18" offsetY="10" color="#00000055"/></effect>

            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
               <content>
                  <VBox spacing="18">
                     <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                     <!-- HERO -->
                     <HBox spacing="16">
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(0,0,0,0.32);
                                             -fx-background-radius: 22;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 22;">
                           <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                           <Label text="Explore Tunisia ✨"
                                  style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: 900;"/>
                           <Label text="Deals, trips, jawista vibes."
                                  style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 13px; -fx-font-weight: 700;"/>

                           <HBox spacing="10">
                              <Button text="🎟 Deals"
                                      style="-fx-background-color: #FFBD00;
                                                       -fx-text-fill: #390099;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 16;
                                                       -fx-font-weight: 900;"/>
                              <Button text="📍 Map"
                                      style="-fx-background-color: #FF0054;
                                                       -fx-text-fill: white;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 16;
                                                       -fx-font-weight: 900;"/>
                              <Button text="🧳 Trips"
                                      style="-fx-background-color: #FF5400;
                                                       -fx-text-fill: white;
                                                       -fx-background-radius: 999;
                                                       -fx-padding: 10 16;
                                                       -fx-font-weight: 900;"/>
                           </HBox>
                        </VBox>

                        <!-- STAT CARD -->
                        <VBox spacing="10" prefWidth="260"
                              style="-fx-background-color: rgba(0,0,0,0.30);
                                             -fx-background-radius: 22;
                                             -fx-border-color: rgba(255,255,255,0.18);
                                             -fx-border-radius: 22;">
                           <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                           <Label text="Today"
                                  style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                           <Label text="12"
                                  style="-fx-text-fill: #FFBD00; -fx-font-size: 40px; -fx-font-weight: 900;"/>
                           <Label text="Hot offers"
                                  style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 700;"/>

                           <Separator opacity="0.28"/>

                           <Label text="Top"
                                  style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                           <Label text="Djerba"
                                  style="-fx-text-fill: #FF0054; -fx-font-size: 22px; -fx-font-weight: 900;"/>
                           <Label text="Most booked"
                                  style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 700;"/>
                        </VBox>
                     </HBox>

                     <!-- DEAL STRIP -->
                     <HBox spacing="12" alignment="CENTER_LEFT"
                           style="-fx-background-color: rgba(0,0,0,0.28);
                                         -fx-background-radius: 18;
                                         -fx-border-color: rgba(255,255,255,0.18);
                                         -fx-border-radius: 18;">
                        <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

                        <Label text="🔥 Deal du jour"
                               style="-fx-text-fill: white; -fx-font-weight: 900;"/>
                        <Label text="Djerba • 3j/2n • -30%"
                               style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-weight: 800;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="189 TND"
                               style="-fx-text-fill: #FFBD00; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                        <Button text="Réserver"
                                style="-fx-background-color: #FF0054;
                                               -fx-text-fill: white;
                                               -fx-background-radius: 999;
                                               -fx-padding: 10 16;
                                               -fx-font-weight: 900;"/>
                     </HBox>

                     <!-- DESTINATIONS GRID -->
                     <GridPane hgap="14" vgap="14">

                        <!-- Card 1 -->
                        <StackPane GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   style="-fx-background-color: rgba(0,0,0,0.30);
                                                  -fx-background-radius: 20;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 20;
                                                  -fx-padding: 16;">
                           <effect><DropShadow radius="16" offsetY="8" color="#00000055"/></effect>
                           <VBox spacing="6">
                              <Label text="Sousse" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                              <Label text="⭐ 4.6 • Plage" style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 800; -fx-font-size: 12px;"/>
                              <HBox spacing="8" alignment="CENTER_LEFT">
                                 <Label text="From" style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-weight: 700;"/>
                                 <Label text="120 TND" style="-fx-text-fill: #FFBD00; -fx-font-weight: 900;"/>
                                 <Region HBox.hgrow="ALWAYS"/>
                                 <Button text="♡" style="-fx-background-color: transparent; -fx-text-fill: #FF0054; -fx-font-size: 16px;"/>
                              </HBox>
                           </VBox>
                        </StackPane>

                        <!-- Card 2 -->
                        <StackPane GridPane.rowIndex="0" GridPane.columnIndex="1"
                                   style="-fx-background-color: rgba(0,0,0,0.30);
                                                  -fx-background-radius: 20;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 20;
                                                  -fx-padding: 16;">
                           <effect><DropShadow radius="16" offsetY="8" color="#00000055"/></effect>
                           <VBox spacing="6">
                              <Label text="Tunis" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                              <Label text="⭐ 4.4 • Culture" style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 800; -fx-font-size: 12px;"/>
                              <HBox spacing="8" alignment="CENTER_LEFT">
                                 <Label text="From" style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-weight: 700;"/>
                                 <Label text="90 TND" style="-fx-text-fill: #FFBD00; -fx-font-weight: 900;"/>
                                 <Region HBox.hgrow="ALWAYS"/>
                                 <Button text="♡" style="-fx-background-color: transparent; -fx-text-fill: #FF0054; -fx-font-size: 16px;"/>
                              </HBox>
                           </VBox>
                        </StackPane>

                        <!-- Card 3 -->
                        <StackPane GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   style="-fx-background-color: rgba(0,0,0,0.30);
                                                  -fx-background-radius: 20;
                                                  -fx-border-color: rgba(255,255,255,0.22);
                                                  -fx-border-radius: 20;
                                                  -fx-padding: 16;">
                           <effect><DropShadow radius="16" offsetY="8" color="#00000055"/></effect>
                           <VBox spacing="6">
                              <Label text="Tozeur" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                              <Label text="⭐ 4.7 • Aventure" style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 800; -fx-font-size: 12px;"/>
                              <HBox spacing="8" alignment="CENTER_LEFT">
                                 <Label text="From" style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-weight: 700;"/>
                                 <Label text="150 TND" style="-fx-text-fill: #FFBD00; -fx-font-weight: 900;"/>
                                 <Region HBox.hgrow="ALWAYS"/>
                                 <Button text="♡" style="-fx-background-color: transparent; -fx-text-fill: #FF0054; -fx-font-size: 16px;"/>
                              </HBox>
                           </VBox>
                        </StackPane>

                        <!-- Card 4 -->
                        <StackPane GridPane.rowIndex="1" GridPane.columnIndex="1"
                                   style="-fx-background-color: rgba(0,0,0,0.30);
                                                  -fx-background-radius: 20;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 20;
                                                  -fx-padding: 16;">
                           <effect><DropShadow radius="16" offsetY="8" color="#00000055"/></effect>
                           <VBox spacing="6">
                              <Label text="Hammamet" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                              <Label text="⭐ 4.5 • Chill" style="-fx-text-fill: rgba(255,255,255,0.74); -fx-font-weight: 800; -fx-font-size: 12px;"/>
                              <HBox spacing="8" alignment="CENTER_LEFT">
                                 <Label text="From" style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-weight: 700;"/>
                                 <Label text="110 TND" style="-fx-text-fill: #FFBD00; -fx-font-weight: 900;"/>
                                 <Region HBox.hgrow="ALWAYS"/>
                                 <Button text="♡" style="-fx-background-color: transparent; -fx-text-fill: #FF0054; -fx-font-size: 16px;"/>
                              </HBox>
                           </VBox>
                        </StackPane>

                     </GridPane>

                  </VBox>
               </content>
            </ScrollPane>
         </StackPane>
      </center>

      <!-- BOTTOM NAV -->
      <bottom>
         <HBox alignment="CENTER" spacing="10"
               style="-fx-background-color: rgba(0,0,0,0.22);
       -fx-background-radius: 18;
       -fx-border-color: rgba(255,255,255,0.22);
       -fx-border-radius: 18;">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <Button text="🏠" style="-fx-background-color: rgba(255,189,0,0.28); -fx-text-fill: #FFBD00; -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;"/>
            <Button text="🧭" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;"/>
            <Button text="📅" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;"/>
            <Button text="❤️" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;"/>
            <Button text="👤" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-background-radius: 14; -fx-padding: 8 18; -fx-font-size: 16px;"/>
         </HBox>
      </bottom>

   </BorderPane>
</StackPane>