<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="520.0" prefWidth="860.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controlles.AjouterProduitController"
            style="-fx-background-color: linear-gradient(to bottom right, #390099, #9E0059);">

   <children>
      <VBox layoutX="30.0" layoutY="25.0" prefWidth="800.0" spacing="18.0">
         <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
         </padding>

         <!-- Header -->
         <HBox spacing="12.0" alignment="CENTER_LEFT"
               style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-padding: 14;">
            <Label text="Ajouter Produit"
                   style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: white;"/>
            <Label text="(Produits Dashboard)"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);"/>
         </HBox>

         <!-- Card Form -->
         <VBox spacing="14"
               style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 18, 0.2, 0, 6);">

            <GridPane hgap="12" vgap="12">
               <columnConstraints>
                  <ColumnConstraints prefWidth="150"/>
                  <ColumnConstraints prefWidth="260"/>
                  <ColumnConstraints prefWidth="150"/>
                  <ColumnConstraints prefWidth="260"/>
               </columnConstraints>

               <!-- id_commercant -->
               <Label text="ID Commerçant" GridPane.rowIndex="0" GridPane.columnIndex="0"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="idCommercantField" promptText="ex: 12"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- nom -->
               <Label text="Nom" GridPane.rowIndex="0" GridPane.columnIndex="2"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="nomField" promptText="ex: Mug Wingo"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- description -->
               <Label text="Description" GridPane.rowIndex="1" GridPane.columnIndex="0"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextArea fx:id="descriptionArea" promptText="Texte (optionnel)"
                         prefRowCount="3"
                         GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"
                         style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- prix -->
               <Label text="Prix (TND)" GridPane.rowIndex="2" GridPane.columnIndex="0"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="prixField" promptText="ex: 15.50"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- stock -->
               <Label text="Stock" GridPane.rowIndex="2" GridPane.columnIndex="2"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="stockField" promptText="ex: 10"
                          GridPane.rowIndex="2" GridPane.columnIndex="3"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- region -->
               <Label text="Région" GridPane.rowIndex="3" GridPane.columnIndex="0"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="regionField" promptText="ex: Tunis"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- categorie -->
               <Label text="Catégorie" GridPane.rowIndex="3" GridPane.columnIndex="2"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="categorieField" promptText="ex: Accessoires"
                          GridPane.rowIndex="3" GridPane.columnIndex="3"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

               <!-- image -->
               <Label text="Image" GridPane.rowIndex="4" GridPane.columnIndex="0"
                      style="-fx-font-weight: 700; -fx-text-fill: #390099;"/>
               <TextField fx:id="imageField" promptText="ex: mug.jpg"
                          GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3"
                          style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

            </GridPane>

            <!-- Buttons -->
            <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
               <Button text="Vider" onAction="#clearForm"
                       style="-fx-background-color: transparent; -fx-border-color: #9E0059; -fx-text-fill: #9E0059; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 16; -fx-font-weight: 700;"/>
               <Button text="Ajouter Produit" onAction="#ajouterProduit"
                       style="-fx-background-color: #FF0054; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 10 16; -fx-font-weight: 800;"/>
            </HBox>

            <Label fx:id="statusLabel" text=""
                   style="-fx-text-fill: #FF5400; -fx-font-weight: 700;"/>
         </VBox>
      </VBox>
   </children>
</AnchorPane>