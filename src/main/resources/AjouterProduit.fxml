<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="560.0" prefWidth="980.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controlles.AjouterProduit"
            style="-fx-background-color: linear-gradient(to bottom right, #390099, #9E0059);">

   <children>
      <HBox layoutX="18" layoutY="18" prefWidth="944" prefHeight="524" spacing="16">

         <!-- SIDEBAR -->
         <VBox prefWidth="210" spacing="12"
               style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-padding: 14;">

            <!-- Logo + name -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 6 0 10 0;">
               <ImageView fitHeight="36" fitWidth="36" preserveRatio="true">
                  <image>
                     <Image url="@assets/logo.png"/>
                  </image>
               </ImageView>
               <VBox>
                  <Label text="Wingo" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 900;"/>
                  <Label text="Backoffice" style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 11px;"/>
               </VBox>
            </HBox>

            <Separator opacity="0.25"/>

            <!-- nav buttons -->
            <Button text="➕  Ajouter Produit" onAction="#goAjouter"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: white; -fx-font-weight: 900; -fx-background-radius: 12; -fx-padding: 10 12; -fx-cursor: hand;"/>

            <Button text="📋  Liste Produits" onAction="#goListe"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 12; -fx-font-weight: 800; -fx-cursor: hand;"/>

            <Button text="📊  Dashboard" onAction="#goDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.92); -fx-border-color: rgba(255,255,255,0.35); -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 12; -fx-font-weight: 800; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="© 2026 Wingo" style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 11px;"/>
         </VBox>

         <!-- MAIN -->
         <VBox prefWidth="718" spacing="14">

            <!-- Header -->
            <HBox spacing="12.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 18; -fx-padding: 14;">
               <Label text="Ajouter Produit"
                      style="-fx-font-size: 22px; -fx-font-weight: 900; -fx-text-fill: white;"/>
               <Label text="(Produits Dashboard)"
                      style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.75);"/>
               <Region HBox.hgrow="ALWAYS"/>
               <Label text="✨" style="-fx-font-size: 18px;"/>
            </HBox>

            <!-- Card Form -->
            <VBox spacing="14"
                  style="-fx-background-color: rgba(255,255,255,0.95); -fx-background-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 18, 0.2, 0, 6);">

               <GridPane hgap="12" vgap="12">
                  <columnConstraints>
                     <ColumnConstraints prefWidth="140"/>
                     <ColumnConstraints prefWidth="240"/>
                     <ColumnConstraints prefWidth="140"/>
                     <ColumnConstraints prefWidth="240"/>
                  </columnConstraints>

                  <Label text="🧑‍💼  ID Commerçant" GridPane.rowIndex="0" GridPane.columnIndex="0"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <TextField fx:id="idCommercantField" promptText="ex: 12"
                             GridPane.rowIndex="0" GridPane.columnIndex="1"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="🏷️  Nom" GridPane.rowIndex="0" GridPane.columnIndex="2"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <!-- IMPORTANT: fx:id matches your controller -->
                  <TextField fx:id="nomTextField" promptText="ex: Mug Wingo"
                             GridPane.rowIndex="0" GridPane.columnIndex="3"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="📝  Description" GridPane.rowIndex="1" GridPane.columnIndex="0"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <TextArea fx:id="descriptionArea" promptText="Texte (optionnel)"
                            prefRowCount="3"
                            GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"
                            style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="💰  Prix (TND)" GridPane.rowIndex="2" GridPane.columnIndex="0"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <!-- IMPORTANT: fx:id matches your controller -->
                  <TextField fx:id="prixTextField" promptText="ex: 15.50"
                             GridPane.rowIndex="2" GridPane.columnIndex="1"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="📦  Stock" GridPane.rowIndex="2" GridPane.columnIndex="2"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <TextField fx:id="stockField" promptText="ex: 10"
                             GridPane.rowIndex="2" GridPane.columnIndex="3"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="📍  Région" GridPane.rowIndex="3" GridPane.columnIndex="0"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <TextField fx:id="regionField" promptText="ex: Tunis"
                             GridPane.rowIndex="3" GridPane.columnIndex="1"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="🧩  Catégorie" GridPane.rowIndex="3" GridPane.columnIndex="2"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <TextField fx:id="categorieField" promptText="ex: Accessoires"
                             GridPane.rowIndex="3" GridPane.columnIndex="3"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>

                  <Label text="🖼️  Image" GridPane.rowIndex="4" GridPane.columnIndex="0"
                         style="-fx-font-weight: 900; -fx-text-fill: #390099;"/>
                  <TextField fx:id="imageField" promptText="ex: mug.jpg"
                             GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3"
                             style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(57,0,153,0.25); -fx-padding: 10;"/>
               </GridPane>

               <!-- Buttons -->
               <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                  <Button text="🧹  Vider" onAction="#clearForm"
                          style="-fx-background-color: transparent; -fx-border-color: #9E0059; -fx-text-fill: #9E0059; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10 16; -fx-font-weight: 900; -fx-cursor: hand;"/>
                  <Button text="✅  Ajouter Produit" onAction="#ajouterProduit"
                          style="-fx-background-color: #FF0054; -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 10 16; -fx-font-weight: 900; -fx-cursor: hand;"/>
               </HBox>

               <Label fx:id="statusLabel" text=""
                      style="-fx-text-fill: #FF5400; -fx-font-weight: 800;"/>
            </VBox>
         </VBox>
      </HBox>
   </children>
</AnchorPane>