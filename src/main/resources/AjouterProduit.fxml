<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.WinGoShopController">

    <!-- BACKGROUND -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/assets/testt.png');
                 -fx-background-repeat: no-repeat;
                 -fx-background-position: center center;
                 -fx-background-size: 100% 100%;" />
    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.18);" />

    <BorderPane maxHeight="650" maxWidth="1100"
                style="-fx-background-color: rgba(0,0,0,0.22);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.16);
                       -fx-border-radius: 26;
                       -fx-border-width: 1.2;">
        <effect><DropShadow color="#00000066" offsetY="14" radius="28"/></effect>
        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 26 26 18 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-width: 0 0 1 0;">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                <Label text="WinGo Travel"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-background-color: rgba(0,0,0,0.22);
                             -fx-background-radius: 999;
                             -fx-padding: 8 10;
                             -fx-border-color: rgba(255,255,255,0.22);
                             -fx-border-radius: 999;">
                    <Label text="🔍" style="-fx-text-fill: white; -fx-opacity: 0.95;"/>
                    <TextField fx:id="searchField"
                               promptText="Search product..."
                               onKeyReleased="#onSearch"
                               style="-fx-background-color: transparent;
                                      -fx-border-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.70);
                                      -fx-pref-width: 320;" />
                    <Button text="🛒" onAction="#showCart"
                            style="-fx-background-color: #FFBD00;
                                   -fx-text-fill: #390099;
                                   -fx-background-radius: 999;
                                   -fx-font-weight: 900;" />
                </HBox>

                <Label fx:id="cartCountLabel" text="0"
                       style="-fx-text-fill: #FFBD00; -fx-font-weight: 900; -fx-font-size: 14px;" />

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="👤" onAction="#showLogin"
                        style="-fx-background-color: rgba(0,0,0,0.22);
                               -fx-text-fill: white;
                               -fx-background-radius: 14;
                               -fx-padding: 8 12;" />
            </HBox>
        </top>

        <!-- LEFT NAV -->
        <left>
            <VBox prefWidth="86" spacing="14"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets top="18" right="12" bottom="18" left="12"/></padding>

                <Button text="🏠" onAction="#showProducts"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-font-size: 18px;
                               -fx-font-weight: 900;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="➕" onAction="#showAddForm"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="🛒" onAction="#showCart"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Button text="🔐" onAction="#showLogin"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-font-size: 18px;
                               -fx-background-radius: 14;
                               -fx-padding: 12 12;" />

                <Region VBox.vgrow="ALWAYS" />
                <Label text="© 2026" style="-fx-text-fill: rgba(255,255,255,0.62); -fx-font-size: 10px;" />
            </VBox>
        </left>

        <!-- CENTER -->
        <center>
            <StackPane style="-fx-background-color: rgba(0,0,0,0.22);
                              -fx-background-radius: 20;
                              -fx-border-color: rgba(255,255,255,0.22);
                              -fx-border-radius: 20;">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <effect><DropShadow color="#00000055" offsetY="10" radius="18"/></effect>

                <!-- SCREENS STACK -->
                <StackPane fx:id="screens">

                    <!-- 1) LOGIN SCREEN -->
                    <VBox fx:id="loginPane" spacing="12" alignment="CENTER"
                          style="-fx-background-color: rgba(0,0,0,0.28);
                                 -fx-background-radius: 22;
                                 -fx-border-color: rgba(255,255,255,0.18);
                                 -fx-border-radius: 22;"
                          maxWidth="520" maxHeight="420">
                        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                        <Label text="🔐 Login"
                               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 900;" />
                        <Label text="Connecte-toi pour gérer produits/panier"
                               style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-weight: 700;" />

                        <TextField fx:id="emailField" promptText="Email"
                                   style="-fx-background-color: rgba(255,255,255,0.10);
                                          -fx-background-radius: 12;
                                          -fx-border-color: rgba(255,255,255,0.18);
                                          -fx-border-radius: 12;
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                          -fx-padding: 10 12;
                                          -fx-max-width: 360;" />

                        <PasswordField fx:id="passwordField" promptText="Mot de passe"
                                       style="-fx-background-color: rgba(255,255,255,0.10);
                                              -fx-background-radius: 12;
                                              -fx-border-color: rgba(255,255,255,0.18);
                                              -fx-border-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                              -fx-padding: 10 12;
                                              -fx-max-width: 360;" />

                        <Label fx:id="loginStatusLabel" text=""
                               style="-fx-text-fill: #FFBD00; -fx-font-weight: 800;" />

                        <HBox spacing="10" alignment="CENTER">
                            <Button text="Se connecter" onAction="#doLogin"
                                    style="-fx-background-color: #FF0054;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 18;
                                           -fx-font-weight: 900;" />
                            <Button text="Continuer sans login" onAction="#showProducts"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 18;
                                           -fx-font-weight: 900;" />
                        </HBox>
                    </VBox>

                    <!-- 2) PRODUCTS LIST SCREEN -->
                    <VBox fx:id="productsPane" spacing="12"
                          style="-fx-background-color: transparent;">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📦 Produits"
                                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900;" />
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statusLabel" text=""
                                   style="-fx-text-fill: #FFBD00; -fx-font-weight: 800;" />
                        </HBox>

                        <TableView fx:id="produitsTable" prefHeight="420"
                                   style="-fx-background-color: rgba(0,0,0,0.28);
                                          -fx-background-radius: 18;
                                          -fx-border-color: rgba(255,255,255,0.18);
                                          -fx-border-radius: 18;">
                            <columns>
                                <TableColumn fx:id="colImage" text="Image" prefWidth="90"/>
                                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colNom" text="Nom" prefWidth="220"/>
                                <TableColumn fx:id="colPrix" text="Prix" prefWidth="90"/>
                                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                                <TableColumn fx:id="colCat" text="Catégorie" prefWidth="140"/>
                                <TableColumn fx:id="colRegion" text="Région" prefWidth="140"/>
                            </columns>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="🛒 Ajouter au panier" onAction="#addSelectedToCart"
                                    style="-fx-background-color: #FFBD00;
                                           -fx-text-fill: #390099;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                            <Button text="✏ Modifier" onAction="#editSelectedProduct"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                            <Button text="🗑 Supprimer" onAction="#deleteSelectedProduct"
                                    style="-fx-background-color: rgba(255,0,84,0.25);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                        </HBox>
                    </VBox>

                    <!-- 3) PRODUCT FORM SCREEN (ADD / EDIT) -->
                    <VBox fx:id="formPane" spacing="12"
                          style="-fx-background-color: rgba(0,0,0,0.28);
                                 -fx-background-radius: 22;
                                 -fx-border-color: rgba(255,255,255,0.18);
                                 -fx-border-radius: 22;"
                          maxWidth="860">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="formTitleLabel" text="➕ Ajouter Produit"
                                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="⬅ Retour" onAction="#showProducts"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 8 14;
                                           -fx-font-weight: 900;" />
                        </HBox>

                        <!-- ✅ NEW: Welcome banner -->
                        <HBox alignment="CENTER_LEFT" spacing="10"
                              style="-fx-background-color: rgba(255,189,0,0.18);
                                     -fx-background-radius: 16;
                                     -fx-border-color: rgba(255,189,0,0.28);
                                     -fx-border-radius: 16;
                                     -fx-padding: 10 12;">
                            <Label text="🏪" style="-fx-font-size: 18px;" />
                            <Label fx:id="welcomeLabel" text="Bienvenue"
                                   style="-fx-text-fill: #FFBD00; -fx-font-weight: 900;" />
                        </HBox>

                        <!-- hidden for edit -->
                        <TextField fx:id="idProduitHidden" visible="false" managed="false"/>

                        <GridPane hgap="12" vgap="12">

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nom" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextField fx:id="nomTextField" promptText="Nom du produit"
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                  -fx-padding: 10 12;" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Prix" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextField fx:id="prixTextField" promptText="ex: 15.50"
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                  -fx-padding: 10 12;" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Stock" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextField fx:id="stockField" promptText="ex: 20"
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                  -fx-padding: 10 12;" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label text="Région" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextField fx:id="regionField" promptText="ex: Tunis, Sousse..."
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                  -fx-padding: 10 12;" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label text="Catégorie" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextField fx:id="categorieField" promptText="ex: Souvenir..."
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                  -fx-padding: 10 12;" />
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                <Label text="Description" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextArea fx:id="descriptionArea"
                                          promptText="Description..."
                                          prefRowCount="3"
                                          minHeight="90"
                                          wrapText="true"
                                          style="
              -fx-background-color: rgba(255,255,255,0.10);
              -fx-background-radius: 12;
              -fx-background-insets: 0;

              -fx-border-color: rgba(255,255,255,0.18);
              -fx-border-radius: 12;
              -fx-border-insets: 0;

              -fx-text-fill: white;
              -fx-prompt-text-fill: rgba(255,255,255,0.55);

              -fx-control-inner-background: rgba(255,255,255,0.10);
              -fx-padding: 10 12;

              -fx-highlight-fill: rgba(255,189,0,0.35);
              -fx-highlight-text-fill: white;
          "/>
                                    <stylesheets></stylesheets>
                                </TextArea>
                            </VBox>

                            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                                <Label text="Image" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-weight: 800;"/>
                                <TextField fx:id="imageField" promptText="URL / chemin"
                                           style="-fx-background-color: rgba(255,255,255,0.10);
                                                  -fx-background-radius: 12;
                                                  -fx-border-color: rgba(255,255,255,0.18);
                                                  -fx-border-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.55);
                                                  -fx-padding: 10 12;" />
                            </VBox>

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                        </GridPane>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="Effacer" onAction="#clearForm"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                            <Button fx:id="saveBtn" text="✅ Enregistrer" onAction="#saveProduct"
                                    style="-fx-background-color: #FF0054;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                        </HBox>
                    </VBox>

                    <!-- 4) CART SCREEN -->
                    <VBox fx:id="cartPane" spacing="12"
                          style="-fx-background-color: rgba(0,0,0,0.28);
                                 -fx-background-radius: 22;
                                 -fx-border-color: rgba(255,255,255,0.18);
                                 -fx-border-radius: 22;"
                          maxWidth="900">
                        <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🛒 Panier"
                                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;" />
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cartTotalLabel" text="Total: 0.00 TND"
                                   style="-fx-text-fill: #FFBD00; -fx-font-weight: 900;"/>
                            <Button text="⬅ Produits" onAction="#showProducts"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 8 14;
                                           -fx-font-weight: 900;" />
                        </HBox>

                        <TableView fx:id="cartTable" prefHeight="420"
                                   style="-fx-background-color: rgba(0,0,0,0.22);
                                          -fx-background-radius: 18;
                                          -fx-border-color: rgba(255,255,255,0.18);
                                          -fx-border-radius: 18;">
                            <columns>
                                <TableColumn fx:id="cartColNom" text="Produit" prefWidth="280"/>
                                <TableColumn fx:id="cartColPrix" text="Prix" prefWidth="90"/>
                                <TableColumn fx:id="cartColQty" text="Qté" prefWidth="70"/>
                                <TableColumn fx:id="cartColSub" text="Sous-total" prefWidth="110"/>
                            </columns>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="➖" onAction="#qtyMinus"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                            <Button text="➕" onAction="#qtyPlus"
                                    style="-fx-background-color: rgba(255,255,255,0.10);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                            <Button text="🗑 Retirer" onAction="#removeFromCart"
                                    style="-fx-background-color: rgba(255,0,84,0.25);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                            <Button text="Vider" onAction="#clearCart"
                                    style="-fx-background-color: rgba(255,189,0,0.25);
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 16;
                                           -fx-font-weight: 900;" />
                        </HBox>
                    </VBox>

                </StackPane>
            </StackPane>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: rgba(0,0,0,0.22);
                         -fx-background-radius: 18;
                         -fx-border-color: rgba(255,255,255,0.14);
                         -fx-border-radius: 18;">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                <Button text="🏠" onAction="#showProducts"
                        style="-fx-background-color: rgba(255,189,0,0.28);
                               -fx-text-fill: #FFBD00;
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="➕" onAction="#showAddForm"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="🛒" onAction="#showCart"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
                <Button text="🔐" onAction="#showLogin"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.92);
                               -fx-background-radius: 14;
                               -fx-padding: 8 18;
                               -fx-font-size: 16px;" />
            </HBox>
        </bottom>

    </BorderPane>
</StackPane>