<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    NAV STRUCTURE:
      Visible top links  →  Home  |  My Participations
      Participation form → modal overlay, opened ONLY via "Book Now" on a card
-->
<StackPane fx:id="rootPane" prefHeight="850" prefWidth="1300"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controlles.Front.FrontEventController">

    <Pane mouseTransparent="true" style="-fx-background-color: #F4F7FB;" />

    <BorderPane maxHeight="820" maxWidth="1250" style="-fx-background-color: transparent;">

        <!-- ══════════════ TOP NAV ══════════════ -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-padding: 15 30 25 30;">

                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="⛰️" style="-fx-font-size: 32px; -fx-text-fill: #A3B1FF;" />
                    <Label text="WinGO" style="-fx-text-fill: #1E293B; -fx-font-size: 26px; -fx-font-weight: 900;" />
                </HBox>

                <!-- Nav: only Home + My Participations -->
                <HBox spacing="35" alignment="CENTER" style="-fx-padding: 0 0 0 50;">

                    <VBox alignment="CENTER" spacing="4" onMouseClicked="#goToHome" style="-fx-cursor: hand;">
                        <Label text="Home"
                               style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 15px;" />
                        <Pane prefHeight="3" prefWidth="36"
                              style="-fx-background-color: #A3B1FF; -fx-background-radius: 5;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="4" onMouseClicked="#goToMesParticipations" style="-fx-cursor: hand;">
                        <Label text="My Participations"
                               style="-fx-text-fill: #64748B; -fx-font-size: 15px;" />
                        <Pane prefHeight="3" prefWidth="0" style="-fx-background-color: transparent;" />
                    </VBox>

                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search -->
                <HBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 50; -fx-padding: 12 25;">
                    <effect>
                        <DropShadow color="#0000000A" offsetY="5" radius="15" />
                    </effect>
                    <Label text="🔍" style="-fx-text-fill: #A3B1FF;" />
                    <TextField fx:id="globalSearchField" onAction="#onSearchEvent"
                               promptText="Search events…"
                               style="-fx-background-color: transparent; -fx-text-fill: #1E293B; -fx-prompt-text-fill: #94A3B8; -fx-pref-width: 220;"/>
                    <Button onAction="#onClearEventSearch" text="✕"
                            style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 0;" />
                </HBox>

                <!-- Back Office Button -->
                <Button onAction="#goToBackOffice" text="⚙️ Back Office"
                        style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-background-radius: 50; -fx-padding: 12 22; -fx-font-weight: 900; -fx-font-size: 13px;">
                    <effect>
                        <DropShadow color="#1E293B44" radius="15" offsetY="5" />
                    </effect>
                </Button>

                <!-- Dark Mode Toggle -->
                <HBox fx:id="darkModeToggle" alignment="CENTER" style="-fx-cursor: hand; -fx-padding: 0 10;">
                    <Pane fx:id="darkModeSlider" prefHeight="18" prefWidth="35"
                          style="-fx-background-color: #E2E8F0; -fx-background-radius: 10;">
                        <Circle fx:id="darkModeCircle" fill="#FFFFFF" radius="7" translateX="3" translateY="2" />
                    </Pane>
                </HBox>

                <!-- User -->
                <HBox alignment="CENTER_RIGHT" spacing="10"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 30; -fx-padding: 5 15 5 5;">
                    <effect>
                        <DropShadow color="#0000000A" offsetY="3" radius="10" />
                    </effect>
                    <VBox alignment="CENTER_RIGHT">
                        <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 13px;" text="WinGO User" />
                        <Label style="-fx-text-fill: #A3B1FF; -fx-font-size: 11px; -fx-font-weight: bold;" text="Travel Love" />
                    </VBox>
                    <StackPane>
                        <Circle fill="#A3B1FF" radius="20" />
                        <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="👤" />
                    </StackPane>
                </HBox>
            </HBox>
        </top>

        <!-- ══════════════ LEFT SIDEBAR ══════════════ -->
        <left>
            <VBox prefWidth="90" spacing="18" alignment="TOP_CENTER"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 35; -fx-padding: 35 10;">
                <BorderPane.margin>
                    <Insets top="10" left="25" bottom="25" right="25"/>
                </BorderPane.margin>
                <effect>
                    <DropShadow color="#0000000E" offsetY="10" radius="25" />
                </effect>

                <VBox alignment="CENTER" spacing="5" onMouseClicked="#goToHome" style="-fx-cursor: hand;">
                    <StackPane prefWidth="54" prefHeight="54" style="-fx-background-color: #F1F5F9; -fx-background-radius: 18;">
                        <Label text="🏠" style="-fx-font-size: 22px;" />
                    </StackPane>
                    <Label text="Home" style="-fx-text-fill: #94A3B8; -fx-font-size: 9px; -fx-font-weight: 700;" />
                </VBox>

                <VBox alignment="CENTER" spacing="5" style="-fx-cursor: hand;">
                    <StackPane prefWidth="54" prefHeight="54" style="-fx-background-color: #F1F5F9; -fx-background-radius: 18;">
                        <Label text="🛎️" style="-fx-font-size: 22px;" />
                    </StackPane>
                    <Label text="Reserve" style="-fx-text-fill: #94A3B8; -fx-font-size: 9px; -fx-font-weight: 700;" />
                </VBox>

                <!-- Events — ACTIVE -->
                <VBox alignment="CENTER" spacing="5" onMouseClicked="#goToHome" style="-fx-cursor: hand;">
                    <StackPane prefWidth="54" prefHeight="54" style="-fx-background-color: #A3B1FF; -fx-background-radius: 18;">
                        <effect>
                            <DropShadow color="#A3B1FF66" offsetY="6" radius="14" />
                        </effect>
                        <Label text="📅" style="-fx-font-size: 22px;" />
                    </StackPane>
                    <Label text="Events" style="-fx-text-fill: #A3B1FF; -fx-font-size: 9px; -fx-font-weight: 900;" />
                </VBox>

                <VBox alignment="CENTER" spacing="5" style="-fx-cursor: hand;">
                    <StackPane prefWidth="54" prefHeight="54" style="-fx-background-color: #F1F5F9; -fx-background-radius: 18;">
                        <Label text="🛍️" style="-fx-font-size: 22px;" />
                    </StackPane>
                    <Label text="Product" style="-fx-text-fill: #94A3B8; -fx-font-size: 9px; -fx-font-weight: 700;" />
                </VBox>

                <VBox alignment="CENTER" spacing="5" style="-fx-cursor: hand;">
                    <StackPane prefWidth="54" prefHeight="54" style="-fx-background-color: #F1F5F9; -fx-background-radius: 18;">
                        <Label text="📝" style="-fx-font-size: 22px;" />
                    </StackPane>
                    <Label text="Blogs" style="-fx-text-fill: #94A3B8; -fx-font-size: 9px; -fx-font-weight: 700;" />
                </VBox>

                <VBox alignment="CENTER" spacing="5" style="-fx-cursor: hand;">
                    <StackPane prefWidth="54" prefHeight="54" style="-fx-background-color: #F1F5F9; -fx-background-radius: 18;">
                        <Label text="📣" style="-fx-font-size: 22px;" />
                    </StackPane>
                    <Label text="Reclaim" style="-fx-text-fill: #94A3B8; -fx-font-size: 9px; -fx-font-weight: 700;" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <Label text="©" style="-fx-text-fill: #CBD5E1; -fx-font-size: 11px;" />
            </VBox>
        </left>

        <!-- ══════════════ MAIN CONTENT ══════════════ -->
        <center>
            <StackPane>

                <!-- Main VBox holding tab pane -->
                <VBox fx:id="mainContent" spacing="20" style="-fx-padding: 0 20 20 10;">

                    <!-- Tab headers hidden — navigation controlled by top nav + sidebar -->
                    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                             style="-fx-background-color: transparent; -fx-tab-min-width: 0;"
                             tabMinHeight="0" tabMaxHeight="0" VBox.vgrow="ALWAYS">

                        <!-- ═══ TAB 1: HOME ═══ -->
                        <Tab fx:id="homeTab">
                            <content>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content>
                                        <VBox spacing="28">
                                            <padding>
                                                <Insets top="5" right="10" bottom="20" left="0"/>
                                            </padding>

                                            <!-- Hero -->
                                            <VBox spacing="8">
                                                <Label text="Discover Events&#10;Around The World"
                                                       style="-fx-text-fill: #1E293B; -fx-font-size: 36px; -fx-font-weight: 900; -fx-line-spacing: -5px;" />
                                                <Label text="Click «Book Now» on any event to reserve your spot instantly."
                                                       style="-fx-text-fill: #64748B; -fx-font-size: 14px; -fx-wrap-text: true; -fx-max-width: 550;" />
                                            </VBox>

                                            <!-- Filter bar -->
                                            <HBox spacing="15" alignment="CENTER_LEFT">
                                                <HBox alignment="CENTER" spacing="10"
                                                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 50; -fx-padding: 10 25;">
                                                    <effect>
                                                        <DropShadow color="#00000008" offsetY="4" radius="10" />
                                                    </effect>
                                                    <Label text="Category:" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                                    <ComboBox fx:id="categoryFilterBox" promptText="Event Type…" style="-fx-background-color: #F8FAFC; -fx-background-radius: 50; -fx-pref-width: 160;" />
                                                    <ComboBox fx:id="seasonFilterBox" promptText="Season…" style="-fx-background-color: #F8FAFC; -fx-background-radius: 50; -fx-pref-width: 130;" />
                                                </HBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="eventResultCountLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="0 event(s) found" />
                                            </HBox>

                                            <!-- Event Cards -->
                                            <VBox spacing="12">
                                                <Label text="Available Events" style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 22px;" />
                                                <FlowPane fx:id="eventCardsContainer" hgap="25" vgap="25"
                                                          style="-fx-background-color: transparent;" />
                                            </VBox>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>

                        <!-- ═══ TAB 2: MY PARTICIPATIONS ═══ -->
                        <Tab fx:id="myTripsTab">
                            <content>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content>
                                        <VBox spacing="25">
                                            <padding>
                                                <Insets top="5" right="10" bottom="20" left="0"/>
                                            </padding>

                                            <HBox alignment="CENTER_LEFT">
                                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                                    <Label style="-fx-text-fill: #1E293B; -fx-font-size: 28px; -fx-font-weight: 900;" text="My Participations" />
                                                    <Label fx:id="clientInfoLabel" style="-fx-text-fill: #A3B1FF; -fx-font-size: 12px; -fx-font-weight: 700;" text="Client:" />
                                                </VBox>
                                            </HBox>

                                            <!-- Search Card -->
                                            <VBox spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 35; -fx-padding: 30;">
                                                <effect>
                                                    <DropShadow color="#0000000C" offsetY="10" radius="25" />
                                                </effect>
                                                <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 16px;" text="🔍 Search" />
                                                <HBox spacing="12" alignment="CENTER_LEFT">
                                                    <ComboBox fx:id="myTripsSearchType" prefWidth="130"
                                                              style="-fx-background-color: #F8FAFC; -fx-background-radius: 50; -fx-border-color: #E2E8F0; -fx-border-radius: 50;" />
                                                    <HBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS"
                                                          style="-fx-background-color: #F1F5F9; -fx-background-radius: 50; -fx-padding: 8 18;">
                                                        <Label text="🔍" style="-fx-text-fill: #A3B1FF;" />
                                                        <TextField fx:id="myTripsSearchField" onAction="#onSearchMyTrips"
                                                                   promptText="Email, name…"
                                                                   style="-fx-background-color: transparent; -fx-prompt-text-fill: #94A3B8;" HBox.hgrow="ALWAYS" />
                                                    </HBox>
                                                    <Button onAction="#onSearchMyTrips" text="Search"
                                                            style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 50; -fx-padding: 12 25;">
                                                        <effect>
                                                            <DropShadow color="#A3B1FF44" radius="12" offsetY="3" />
                                                        </effect>
                                                    </Button>
                                                    <Button onAction="#onClearMyTripsSearch" text="Clear"
                                                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B; -fx-font-weight: 700; -fx-background-radius: 50; -fx-padding: 12 20;" />
                                                    <Button onAction="#onRefreshMyTrips" text="↻"
                                                            style="-fx-background-color: #E8F5E9; -fx-text-fill: #28a745; -fx-font-weight: 900; -fx-background-radius: 50; -fx-padding: 12 18;" />
                                                </HBox>
                                                <Label fx:id="myTripsResultLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;" text="0 participation(s) found" />
                                            </VBox>

                                            <!-- Table Card (removed detail scroll) -->
                                            <VBox spacing="14" style="-fx-background-color: #FFFFFF; -fx-background-radius: 35; -fx-padding: 30;">
                                                <effect>
                                                    <DropShadow color="#0000000C" offsetY="10" radius="25" />
                                                </effect>

                                                <HBox alignment="CENTER_LEFT">
                                                    <Label style="-fx-text-fill: #1E293B; -fx-font-weight: 900; -fx-font-size: 16px;"
                                                           text="📋 My Participation History" HBox.hgrow="ALWAYS" />
                                                    <Button onAction="#viewParticipationDetails" text="View Details"
                                                            style="-fx-background-color: #A3B1FF; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 50; -fx-padding: 10 22;">
                                                        <effect>
                                                            <DropShadow color="#A3B1FF44" radius="12" offsetY="3" />
                                                        </effect>
                                                    </Button>
                                                </HBox>
                                                <TableView fx:id="participationTable" prefHeight="420"
                                                           style="-fx-background-color: transparent; -fx-border-color: #E2E8F0; -fx-border-radius: 15;">
                                                    <columns>
                                                        <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                                                        <TableColumn fx:id="colEventTitle" prefWidth="180" text="Event" />
                                                        <TableColumn fx:id="colDate" prefWidth="100" text="Date" />
                                                        <TableColumn fx:id="colStatut" prefWidth="100" text="Status" />
                                                        <TableColumn fx:id="colPrenom" prefWidth="110" text="First Name" />
                                                        <TableColumn fx:id="colNom" prefWidth="110" text="Last Name" />
                                                        <TableColumn fx:id="colEmail" prefWidth="170" text="Email" />
                                                        <TableColumn fx:id="colPlaces" prefWidth="70" text="Places" />
                                                    </columns>
                                                </TableView>
                                            </VBox>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </content>
                        </Tab>
                    </TabPane>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════
                     BOOK NOW MODAL OVERLAY (without QR ticket section)
                ══════════════════════════════════════════════════════════════ -->
                <VBox fx:id="bookingOverlay" visible="false" managed="false"
                      alignment="CENTER"
                      style="-fx-background-color: rgba(15,23,42,0.75);">

                    <!-- Modal Card -->
                    <VBox maxWidth="640" spacing="0"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 35;">
                        <effect>
                            <DropShadow color="#00000060" radius="55" offsetY="12" />
                        </effect>

                        <!-- ── Header ── -->
                        <HBox alignment="CENTER_LEFT" spacing="15"
                              style="-fx-padding: 28 35 22 35; -fx-background-color: #A3B1FF; -fx-background-radius: 35 35 0 0;">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="🎟  Book Your Spot"
                                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: 900;" />
                                <Label fx:id="bookingEventNameLabel" text=""
                                       style="-fx-text-fill: rgba(255,255,255,0.88); -fx-font-size: 13px; -fx-font-weight: 700;" />
                            </VBox>
                            <Button onAction="#closeBookingOverlay" text="✕"
                                    style="-fx-background-color: rgba(255,255,255,0.22); -fx-text-fill: white;
                                           -fx-font-size: 15px; -fx-font-weight: 900; -fx-background-radius: 50;
                                           -fx-padding: 8 14; -fx-cursor: hand;" />
                        </HBox>

                        <!-- ── Event info banner ── -->
                        <HBox spacing="30" alignment="CENTER_LEFT"
                              style="-fx-background-color: #F8FAFC; -fx-padding: 16 35;">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label fx:id="bookingEventDateLabel"
                                       style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: 700;" text="📅  —" />
                                <Label fx:id="bookingEventLocationLabel"
                                       style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-weight: 700;" text="📍  —" />
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="2">
                                <Label fx:id="bookingEventPriceLabel"
                                       style="-fx-text-fill: #A3B1FF; -fx-font-size: 24px; -fx-font-weight: 900;" text="0.00$" />
                                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" text="per person" />
                            </VBox>
                        </HBox>

                        <!-- ── Form ── -->
                        <VBox spacing="18" style="-fx-padding: 28 35 20 35;">

                            <GridPane hgap="16" vgap="14">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50" />
                                    <ColumnConstraints percentWidth="50" />
                                </columnConstraints>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="First Name *" />
                                    <TextField fx:id="modalPrenomField" promptText="Prénom"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-padding: 12 14;" />
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Last Name *" />
                                    <TextField fx:id="modalNomField" promptText="Nom"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-padding: 12 14;" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Email *" />
                                    <TextField fx:id="modalEmailField" promptText="email@example.com"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-padding: 12 14;" />
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Phone" />
                                    <TextField fx:id="modalTelephoneField" promptText="+216 …"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-padding: 12 14;" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Number of Seats *" />
                                    <TextField fx:id="modalPlacesField" promptText="1"
                                               style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-padding: 12 14;" />
                                </VBox>
                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label style="-fx-text-fill: #64748B; -fx-font-size: 11px; -fx-font-weight: 800;" text="Booking Date *" />
                                    <DatePicker fx:id="modalPartDatePicker"
                                                style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-border-color: #E2E8F0; -fx-border-radius: 15; -fx-padding: 5 8;"
                                                maxWidth="Infinity" />
                                </VBox>
                            </GridPane>

                            <!-- Total preview -->
                            <HBox alignment="CENTER_RIGHT" spacing="8"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 15; -fx-padding: 14 20;">
                                <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px;" text="Total to pay:" />
                                <Label fx:id="bookingTotalLabel"
                                       style="-fx-text-fill: #1E293B; -fx-font-size: 20px; -fx-font-weight: 900;" text="0.00$" />
                            </HBox>

                            <!-- Action buttons -->
                            <HBox spacing="14" alignment="CENTER_RIGHT">
                                <Button onAction="#closeBookingOverlay" text="Cancel"
                                        style="-fx-background-color: #F1F5F9; -fx-text-fill: #64748B;
                                               -fx-font-weight: 700; -fx-background-radius: 50; -fx-padding: 14 28; -fx-cursor: hand;" />
                                <Button onAction="#confirmBooking" text="✓  Confirm Booking"
                                        style="-fx-background-color: #A3B1FF; -fx-text-fill: white;
                                               -fx-font-weight: 900; -fx-background-radius: 50;
                                               -fx-padding: 14 38; -fx-font-size: 14px; -fx-cursor: hand;">
                                    <effect>
                                        <DropShadow color="#A3B1FF55" radius="20" offsetY="6" />
                                    </effect>
                                </Button>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>