{% extends 'base.html.twig' %}

{% block title %}{{ ui.page_title|default('WinGo - Connexion') }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/responsive.css') }}">
<style>
    .auth_section { min-height: 80vh; display: flex; align-items: center; padding-top: 200px; padding-bottom: 60px; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); }
    .auth_card { background: #fff; border-radius: 16px; padding: 50px 40px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 460px; width: 100%; margin: 0 auto; }
    .auth_title { font-size: 28px; font-weight: 700; color: #333; margin-bottom: 8px; text-align: center; }
    .auth_subtitle { color: #888; text-align: center; margin-bottom: 35px; font-size: 14px; }
    .auth_input { width: 100%; padding: 14px 16px; border: 2px solid #e8e8e8; border-radius: 10px; font-size: 15px; transition: all 0.3s; outline: none; margin-bottom: 18px; }
    .auth_input:focus { border-color: #fa9e1b; box-shadow: 0 0 0 3px rgba(250,158,27,0.15); }
    .auth_label { font-size: 13px; font-weight: 600; color: #555; margin-bottom: 6px; display: block; }
    .auth_btn { width: 100%; padding: 15px; background: linear-gradient(135deg, #fa9e1b, #8d4fff); border: none; border-radius: 10px; color: #fff; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; margin-top: 8px; }
    .auth_btn:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 8px 25px rgba(250,158,27,0.4); }
    .auth_link { text-align: center; margin-top: 20px; font-size: 14px; color: #666; }
    .auth_link a { color: #fa9e1b; font-weight: 600; text-decoration: none; }
    .alert_error { background: #fff3f3; border: 1px solid #ffcdd2; color: #c62828; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
    .alert_success { background: #f1f8f1; border: 1px solid #c8e6c9; color: #2e7d32; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; }
    .check_container { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
    .check_container input { width: auto; margin: 0; }
    .wingo_logo_auth { text-align: center; margin-bottom: 24px; }
    .wingo_logo_auth span { font-size: 36px; font-weight: 800; background: linear-gradient(135deg, #fa9e1b, #8d4fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .lang_switcher { display: flex; justify-content: center; gap: 10px; margin-bottom: 18px; }
    .lang_chip { padding: 8px 12px; border-radius: 999px; border: 1px solid #ddd; color: #444; font-size: 12px; font-weight: 700; text-decoration: none; background: #fff; }
    .lang_chip.active { background: linear-gradient(135deg, #fa9e1b, #8d4fff); color: #fff; border-color: transparent; }
</style>
{% endblock %}

{% block content %}
<div class="auth_section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="auth_card" {% if lang == 'AR' %}dir="rtl"{% endif %}>
                    <div class="wingo_logo_auth"><span>WinGo</span></div>
                    <div class="lang_switcher">
                        <a class="lang_chip {% if lang == 'FR' %}active{% endif %}" href="{{ path('app_login', {lang: 'FR'}) }}">FR</a>
                        <a class="lang_chip {% if lang == 'EN' %}active{% endif %}" href="{{ path('app_login', {lang: 'EN'}) }}">EN</a>
                        <a class="lang_chip {% if lang == 'AR' %}active{% endif %}" href="{{ path('app_login', {lang: 'AR'}) }}">AR</a>
                    </div>
                    <div class="auth_title">{{ ui.title }}</div>
                    <div class="auth_subtitle">{{ ui.subtitle }}</div>

                    {% for message in app.flashes('success') %}
                        <div class="alert_success">{{ message }}</div>
                    {% endfor %}

                    {% for message in app.flashes('error') %}
                        <div class="alert_error">{{ message }}</div>
                    {% endfor %}

                    {% if error %}
                        <div class="alert_error">
                            <i class="fa fa-exclamation-circle"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login', {lang: lang}) }}" novalidate>
                        <label class="auth_label" for="email">{{ ui.email }}</label>
                        <input class="auth_input" type="email" id="email" name="email" value="{{ last_username }}" placeholder="{{ ui.email_placeholder }}" autofocus>

                        <label class="auth_label" for="password">{{ ui.password }}</label>
                        <input class="auth_input" type="password" id="password" name="password" placeholder="********">

                        <div class="check_container">
                            <input type="checkbox" name="_remember_me" id="remember_me">
                            <label for="remember_me" style="font-size:13px;color:#666;margin:0;">{{ ui.remember_me }}</label>
                        </div>

                        <div class="form_group">
                            <label for="captcha">{{ ui.captcha }}</label>
                            <div style="display: flex; align-items: center; gap: 15px;">
                                <img src="{{ path('app_captcha') }}" alt="captcha" id="captcha_img" style="border-radius: 8px; border: 1px solid #ddd; cursor: pointer;" title="Cliquer pour changer">
                                <input type="text" name="captcha" id="captcha" class="auth_input" placeholder="{{ ui.captcha_placeholder }}" required style="flex: 1;">
                            </div>
                            <script>
                                document.getElementById('captcha_img').onclick = function() {
                                    this.src = '{{ path('app_captcha') }}?' + Math.random();
                                };
                            </script>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 10px;">
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                                <button type="submit" class="auth_btn" style="width: auto; flex: 1; margin-right: 15px;">{{ ui.submit }}</button>
                                <a href="{{ path('app_forgot_password_link_request') }}" style="font-size: 13px; color: #8d4fff; text-decoration: none; font-weight: 600;">{{ ui.forgot_password }}</a>
                            </div>

                            <button type="button" id="face_id_btn" class="auth_btn" style="background: linear-gradient(135deg, #1a1a2e, #0f3460); display: flex; align-items: center; justify-content: center; gap: 10px;">
                                <i class="fa fa-user-shield"></i> {{ ui.face_id }}
                            </button>
                        </div>
                    </form>

                    <div id="face_modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); z-index:9999; flex-direction:column; align-items:center; justify-content:center; color:#fff; padding: 20px;">
                        <div style="position:relative; width:100%; max-width:400px; border-radius:20px; overflow:hidden; border: 4px solid #fa9e1b; box-shadow: 0 0 30px rgba(250,158,27,0.5);">
                            <video id="video" width="400" height="300" autoplay muted style="display:block;"></video>
                            <canvas id="overlay" style="position:absolute; top:0; left:0;"></canvas>
                            <div id="scan_line" style="position:absolute; top:0; left:0; width:100%; height:2px; background:#fa9e1b; box-shadow: 0 0 10px #fa9e1b; animation: scan 2s linear infinite;"></div>
                        </div>
                        <style> @keyframes scan { 0% { top: 0; } 100% { top: 100%; } } </style>
                        <h3 id="face_status" style="margin-top:20px;">Initialisation de l'IA...</h3>
                        <p style="font-size:14px; opacity:0.7;">Veuillez rester face a la camera.</p>
                        <button id="close_face" style="margin-top:20px; background:rgba(255,255,255,0.1); border:1px solid #fff; color:#fff; padding:8px 20px; border-radius:10px; cursor:pointer;">Annuler</button>
                    </div>

                    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
                    <script>
                        const faceIdBtn = document.getElementById('face_id_btn');
                        const faceModal = document.getElementById('face_modal');
                        const video = document.getElementById('video');
                        const faceStatus = document.getElementById('face_status');

                        faceIdBtn.onclick = async () => {
                            faceModal.style.display = 'flex';
                            faceStatus.innerText = "Chargement des modeles IA...";

                            try {
                                const MODEL_URL = '/models';
                                await Promise.all([
                                    faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
                                    faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
                                    faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)
                                ]);

                                faceStatus.innerText = "Acces a la camera...";
                                const stream = await navigator.mediaDevices.getUserMedia({ video: {} });
                                video.srcObject = stream;

                                video.onplay = () => {
                                    faceStatus.innerText = "Analyse faciale en cours...";
                                    const interval = setInterval(async () => {
                                        const detections = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptor();

                                        if (detections) {
                                            faceStatus.innerText = "Visage detecte ! Verification...";
                                            clearInterval(interval);

                                            const email = document.getElementById('email')?.value;
                                            if (!email) {
                                                alert("Veuillez d'abord saisir votre email pour que l'IA puisse verifier votre identite.");
                                                closeModal();
                                                return;
                                            }

                                            const formData = new FormData();
                                            formData.append('email', email);
                                            formData.append('descriptor', JSON.stringify(Array.from(detections.descriptor)));

                                            const csrfToken = document.querySelector('input[name="_csrf_token"]')?.value;
                                            if (csrfToken) {
                                                formData.append('_csrf_token', csrfToken);
                                            }

                                            const response = await fetch('{{ path('app_face_id_login') }}', {
                                                method: 'POST',
                                                body: formData
                                            });

                                            if (!response.ok) {
                                                const text = await response.text();
                                                console.error("Erreur serveur:", text);
                                                throw new Error("Le serveur a rÃ©pondu avec une erreur (Code: " + response.status + ").");
                                            }

                                            const result = await response.json();
                                            if (result.success) {
                                                faceStatus.innerText = "Authentification rÃ©ussie ! Redirection...";
                                                window.location.href = result.redirect;
                                            } else {
                                                faceStatus.innerText = "Erreur : " + result.error;
                                                setTimeout(closeModal, 3000);
                                            }
                                        }
                                    }, 1000);
                                };
                            } catch (err) {
                                console.error("Detail de l'erreur Face ID:", err);
                                faceStatus.innerText = "Erreur : " + err.message;
                            }
                        };

                        function closeModal() {
                            faceModal.style.display = 'none';
                            if (video.srcObject) {
                                video.srcObject.getTracks().forEach(track => track.stop());
                            }
                        }
                        document.getElementById('close_face').onclick = closeModal;
                    </script>

                    <div class="auth_link">
                        {{ ui.no_account }} <a href="{{ path('app_register', {lang: lang}) }}">{{ ui.register }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
