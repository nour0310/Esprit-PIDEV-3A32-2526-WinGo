{% extends 'base.html.twig' %}

{% block title %}{{ ui.page_title|default('WinGo - Reinitialiser le mot de passe') }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
<style>
    .auth_section { min-height: 80vh; display: flex; align-items: center; justify-content: center; background: #f8f9fa; padding-top: 150px; padding-bottom: 50px; }
    .auth_card { background: #fff; width: 100%; max-width: 450px; border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); overflow: hidden; }
    .auth_header { background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 100%); padding: 40px; text-align: center; color: #fff; }
    .auth_logo { font-size: 32px; font-weight: 800; background: linear-gradient(135deg, #fa9e1b, #8d4fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 10px; }
    .auth_body { padding: 40px; }
    .form_group { margin-bottom: 24px; }
    label { font-size: 13px; font-weight: 600; color: #555; margin-bottom: 8px; display: block; }
    .form_input { width: 100%; padding: 12px 16px; border: 2px solid #f0f0f0; border-radius: 10px; font-size: 14px; transition: all 0.3s; }
    .form_input:focus { border-color: #fa9e1b; outline: none; background: #fff; }
    .btn_auth { width: 100%; background: linear-gradient(135deg, #fa9e1b, #8d4fff); color: #fff; padding: 14px; border-radius: 10px; border: none; font-weight: 700; font-size: 15px; cursor: pointer; transition: transform 0.2s; margin-top: 10px; }
    .btn_auth:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(250, 158, 27, 0.3); }
    .alert { padding: 14px; border-radius: 10px; font-size: 14px; margin-bottom: 20px; border-left: 4px solid; }
    .alert-danger { background: #fff5f5; color: #c0392b; border-color: #e74c3c; }
    .alert-success { background: #f0fdf4; color: #15803d; border-color: #22c55e; }
    .lang_switcher { display: flex; justify-content: center; gap: 10px; margin-bottom: 16px; }
    .lang_chip { padding: 8px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.25); color: #fff; font-size: 12px; font-weight: 700; text-decoration: none; }
    .lang_chip.active { background: rgba(255,255,255,0.2); }
</style>
{% endblock %}

{% block content %}
<div class="auth_section">
    <div class="auth_card" {% if lang == 'AR' %}dir="rtl"{% endif %}>
        <div class="auth_header">
            <div class="auth_logo">WinGo</div>
            <div class="lang_switcher">
                <a class="lang_chip {% if lang == 'FR' %}active{% endif %}" href="{{ path('app_reset_password_link', {lang: 'FR'}) }}">FR</a>
                <a class="lang_chip {% if lang == 'EN' %}active{% endif %}" href="{{ path('app_reset_password_link', {lang: 'EN'}) }}">EN</a>
                <a class="lang_chip {% if lang == 'AR' %}active{% endif %}" href="{{ path('app_reset_password_link', {lang: 'AR'}) }}">AR</a>
            </div>
            <p style="margin:0; opacity:0.8; font-size:14px;">{{ ui.title }}</p>
        </div>
        <div class="auth_body">
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post" novalidate>
                <div class="form_group">
                    <label for="password">{{ ui.password }}</label>
                    <input type="password" id="password" name="password" class="form_input" placeholder="********" autofocus autocomplete="new-password">
                    <small style="display:block; margin-top:5px; color:#888; font-size:11px;">
                        {{ ui.hint }}
                    </small>
                </div>

                <button type="submit" class="btn_auth">{{ ui.submit }}</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
