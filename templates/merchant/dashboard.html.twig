{% extends 'base.html.twig' %}

{% block title %}Dashboard Commerçant{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .merchant_dash_section{
            padding: 180px 0 90px 0;
            background:
                radial-gradient(circle at top left, rgba(141,79,255,0.10), transparent 28%),
                radial-gradient(circle at top right, rgba(250,158,27,0.10), transparent 28%),
                linear-gradient(180deg, #eef3f8 0%, #f7f9fc 100%);
            min-height: 100vh;
        }

        .merchant_dash_box{
            background:#fff;
            border-radius:28px;
            padding:35px;
            box-shadow:0 18px 45px rgba(25,30,70,0.10);
            margin-bottom:30px;
        }

        .merchant_dash_title{
            font-size:42px;
            font-weight:900;
            margin-bottom:10px;
            background: linear-gradient(135deg, #1d2140 10%, #8d4fff 58%, #fa9e1b 100%);
            -webkit-background-clip:text;
            -webkit-text-fill-color:transparent;
        }

        .merchant_dash_sub{
            color:#71758a;
            margin-bottom:25px;
        }

        .merchant_top_actions{
            display:flex;
            gap:12px;
            flex-wrap:wrap;
            margin-bottom:25px;
        }

        .merchant_btn{
            display:inline-flex;
            align-items:center;
            gap:10px;
            padding:14px 24px;
            border-radius:999px;
            color:#fff !important;
            text-decoration:none !important;
            font-weight:800;
            text-transform:uppercase;
            font-size:14px;
        }

        .merchant_btn_add{
            background: linear-gradient(135deg, #ff9800, #ff5e62);
        }

        .merchant_btn_back{
            background: linear-gradient(135deg, #5d7cf3, #8d4fff);
        }

        .stats_grid{
            display:grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap:18px;
            margin-bottom:30px;
        }

        .stat_card{
            background: linear-gradient(135deg, rgba(255,255,255,0.96), rgba(248,249,255,0.92));
            border-radius:22px;
            padding:22px;
            box-shadow:0 14px 35px rgba(25,30,70,0.08);
            border:1px solid #edf0f6;
        }

        .stat_icon{
            width:54px;
            height:54px;
            border-radius:16px;
            display:flex;
            align-items:center;
            justify-content:center;
            color:#fff;
            font-size:20px;
            margin-bottom:14px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
        }

        .stat_value{
            font-size:30px;
            font-weight:900;
            color:#1f2235;
            line-height:1.1;
            margin-bottom:6px;
        }

        .stat_label{
            color:#7b8095;
            font-size:14px;
            font-weight:700;
            text-transform:uppercase;
            letter-spacing:0.5px;
        }

        .merchant_info_box{
            background:#f8f9ff;
            border:1px solid #eceefe;
            border-radius:20px;
            padding:22px;
            margin-bottom:30px;
        }

        .merchant_info_box h3{
            font-size:22px;
            font-weight:800;
            color:#1f2235;
            margin-bottom:10px;
        }

        .merchant_info_box p{
            margin:0;
            color:#6f758a;
            font-weight:600;
        }

        .merchant_table_wrap{
            overflow-x:auto;
        }

        .merchant_table{
            width:100%;
            border-collapse:collapse;
        }

        .merchant_table th,
        .merchant_table td{
            padding:16px 14px;
            border-bottom:1px solid #edf0f6;
            text-align:left;
        }

        .merchant_table th{
            font-size:13px;
            text-transform:uppercase;
            color:#7b8095;
            font-weight:800;
        }

        .merchant_table td{
            color:#1f2235;
            font-weight:600;
        }

        .table_img{
            width:70px;
            height:70px;
            border-radius:14px;
            object-fit:cover;
            background:#f4f6fb;
        }

        .table_actions{
            display:flex;
            gap:8px;
            flex-wrap:wrap;
        }

        .action_btn{
            padding:8px 14px;
            border-radius:10px;
            text-decoration:none !important;
            color:#fff !important;
            font-size:13px;
            font-weight:700;
        }

        .btn_view{ background:#17a2b8; }
        .btn_edit{ background:#f0ad4e; }
        .btn_delete{ background:#dc3545; }

        .badge_stock_ok,
        .badge_stock_low,
        .badge_stock_out{
            display:inline-block;
            padding:7px 12px;
            border-radius:999px;
            font-size:12px;
            font-weight:800;
            color:#fff;
        }

        .badge_stock_ok{ background:#28a745; }
        .badge_stock_low{ background:#ff9800; }
        .badge_stock_out{ background:#dc3545; }

        .empty_box{
            text-align:center;
            padding:30px;
            color:#888;
        }
    </style>
{% endblock %}

{% block content %}
<div class="merchant_dash_section">
    <div class="container">
        <div class="merchant_dash_box">
            <h1 class="merchant_dash_title">Dashboard commerçant</h1>
            <p class="merchant_dash_sub">Gérez ici les produits ajoutés par votre compte et suivez vos statistiques.</p>

            <div class="merchant_top_actions">
                <a href="{{ path('produit_add') }}" class="merchant_btn merchant_btn_add">
                    <i class="fa fa-plus"></i> Ajouter produit
                </a>

                <a href="{{ path('client_produits') }}" class="merchant_btn merchant_btn_back">
                    <i class="fa fa-arrow-left"></i> Retour boutique
                </a>
            </div>

            <div class="stats_grid">
                <div class="stat_card">
                    <div class="stat_icon"><i class="fa fa-shopping-bag"></i></div>
                    <div class="stat_value">{{ totalProduits }}</div>
                    <div class="stat_label">Total produits</div>
                </div>

                <div class="stat_card">
                    <div class="stat_icon"><i class="fa fa-check-circle"></i></div>
                    <div class="stat_value">{{ produitsEnStock }}</div>
                    <div class="stat_label">Produits en stock</div>
                </div>

                <div class="stat_card">
                    <div class="stat_icon"><i class="fa fa-times-circle"></i></div>
                    <div class="stat_value">{{ produitsRupture }}</div>
                    <div class="stat_label">Produits en rupture</div>
                </div>

                <div class="stat_card">
                    <div class="stat_icon"><i class="fa fa-exclamation-triangle"></i></div>
                    <div class="stat_value">{{ stockFaible }}</div>
                    <div class="stat_label">Stock faible</div>
                </div>

                <div class="stat_card">
                    <div class="stat_icon"><i class="fa fa-tags"></i></div>
                    <div class="stat_value">{{ nombreCategories }}</div>
                    <div class="stat_label">Catégories utilisées</div>
                </div>

                <div class="stat_card">
                    <div class="stat_icon"><i class="fa fa-money"></i></div>
                    <div class="stat_value">{{ valeurStock|number_format(2, '.', ' ') }} DT</div>
                    <div class="stat_label">Valeur du stock</div>
                </div>
            </div>

            <div class="merchant_info_box">
                <h3>Dernier produit ajouté</h3>
                {% if dernierProduit %}
                    <p>
                        <strong>{{ dernierProduit.nom }}</strong>
                        {% if dernierProduit.dateAjout %}
                            — ajouté le {{ dernierProduit.dateAjout|date('d/m/Y H:i') }}
                        {% endif %}
                    </p>
                {% else %}
                    <p>Aucun produit ajouté pour le moment.</p>
                {% endif %}
            </div>

            <div class="merchant_table_wrap">
                <table class="merchant_table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Nom</th>
                            <th>Prix</th>
                            <th>Région</th>
                            <th>Catégorie</th>
                            <th>Stock</th>
                            <th>État</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for p in mesProduits %}
                        <tr>
                            <td>
                                {% if p.image %}
                                    <img src="{{ asset('images/' ~ p.image) }}" alt="{{ p.nom }}" class="table_img">
                                {% else %}
                                    <img src="{{ asset('images/default-product.jpg') }}" alt="Image par défaut" class="table_img">
                                {% endif %}
                            </td>
                            <td>{{ p.nom }}</td>
                            <td>{{ p.prix }} DT</td>
                            <td>{{ p.region }}</td>
                            <td>{{ p.categorie }}</td>
                            <td>{{ p.stock }}</td>
                            <td>
                                {% if p.stock == 0 %}
                                    <span class="badge_stock_out">Rupture</span>
                                {% elseif p.stock <= 5 %}
                                    <span class="badge_stock_low">Stock faible</span>
                                {% else %}
                                    <span class="badge_stock_ok">Disponible</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="table_actions">
                                    <a href="{{ path('produit_details', {'id': p.id}) }}" class="action_btn btn_view">Voir</a>
                                    <a href="{{ path('produit_update', {'id': p.id}) }}" class="action_btn btn_edit">Modifier</a>
                                    <a href="{{ path('produit_delete', {'id': p.id}) }}" class="action_btn btn_delete">Supprimer</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="empty_box">Vous n'avez encore ajouté aucun produit.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}