    <style>
        .wingo-notif-wrap { position: relative; margin-right: 18px; display: inline-flex; align-items: center; }
        .wingo-notif-btn {
            background: transparent; border: none; color: #fff; cursor: pointer; padding: 4px 8px;
            position: relative; font-size: 18px; line-height: 1;
        }
        .wingo-notif-badge {
            position: absolute; top: -2px; right: 0; min-width: 18px; height: 18px; padding: 0 5px;
            background: #fa9e1c; color: #fff; font-size: 11px; font-weight: 700; border-radius: 9px;
            display: none; align-items: center; justify-content: center;
        }
        .wingo-notif-badge.wingo-notif-badge--visible { display: inline-flex; }
        .wingo-notif-panel {
            display: none; position: absolute; top: 100%; right: 0; margin-top: 8px; width: 320px; max-height: 380px;
            background: #fff; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,0.18); z-index: 10050;
            overflow: hidden; flex-direction: column; text-align: left;
        }
        .wingo-notif-panel.wingo-notif-panel--open { display: flex; }
        .wingo-notif-panel-header {
            padding: 12px 14px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center;
            background: linear-gradient(135deg, #8d4fff, #fa9e1c); color: #fff; font-weight: 600; font-size: 14px;
        }
        .wingo-notif-mark-all {
            background: rgba(255,255,255,0.25); border: none; color: #fff; font-size: 11px; padding: 4px 10px; border-radius: 20px; cursor: pointer;
        }
        .wingo-notif-list { overflow-y: auto; max-height: 300px; }
        .wingo-notif-item {
            display: block; padding: 12px 14px; border-bottom: 1px solid #f0f0f0; text-decoration: none; color: #333; font-size: 13px; line-height: 1.4;
            cursor: pointer; transition: background 0.15s;
        }
        .wingo-notif-item:hover { background: #f9f7ff; }
        .wingo-notif-item--unread { background: #f3efff; font-weight: 500; }
        .wingo-notif-item-meta { font-size: 11px; color: #888; margin-top: 4px; }
        .wingo-notif-empty { padding: 24px; text-align: center; color: #888; font-size: 13px; }
        /* Nav Avatar */
        .wingo-nav-avatar { display: inline-flex; align-items: center; margin-left: 14px; }
        .wingo-nav-avatar-link { display: block; width: 36px; height: 36px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.4); overflow: hidden; transition: border-color 0.2s, transform 0.2s; }
        .wingo-nav-avatar-link:hover { border-color: #fa9e1c; transform: scale(1.08); }
        .wingo-nav-avatar-img { width: 36px; height: 36px; object-fit: cover; display: block; background: #fff; }
        .wingo-nav-avatar-initials { width: 36px; height: 36px; background: linear-gradient(135deg, #fa9e1b, #8d4fff); color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
    </style>
    {% endif %}
