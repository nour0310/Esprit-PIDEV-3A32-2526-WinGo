{% block javascripts %}{% endblock %}
{% if app.user %}
<script>
(function () {
    var root = document.getElementById('wingo-notif-root');
    if (!root) return;
    var listUrl = root.dataset.listUrl;
    var markReadTpl = root.dataset.markReadUrl;
    var markAllUrl = root.dataset.markAllUrl;
    var toggle = document.getElementById('wingo-notif-toggle');
    var panel = document.getElementById('wingo-notif-panel');
    var listEl = document.getElementById('wingo-notif-list');
    var badge = document.getElementById('wingo-notif-badge');
    var markAllBtn = document.getElementById('wingo-notif-mark-all');

    function markReadUrl(id) {
        return markReadTpl.replace(/\/0$/, '/' + id);
    }

    function setBadge(count) {
        if (count > 0) {
            badge.textContent = count > 99 ? '99+' : String(count);
            badge.classList.add('wingo-notif-badge--visible');
        } else {
            badge.classList.remove('wingo-notif-badge--visible');
            badge.textContent = '0';
        }
    }

    function renderList(items) {
        listEl.innerHTML = '';
        if (!items.length) {
            listEl.innerHTML = '<div class="wingo-notif-empty">Aucune notification</div>';
            return;
        }
        items.forEach(function (n) {
            var a = document.createElement('a');
            a.href = n.lien || '#';
            a.className = 'wingo-notif-item' + (n.lu ? '' : ' wingo-notif-item--unread');
            a.dataset.id = n.id;
            a.textContent = n.contenu;
            var meta = document.createElement('div');
            meta.className = 'wingo-notif-item-meta';
            meta.textContent = n.type ? n.type : '';
            if (n.dateCreation) {
                try {
                    var d = new Date(n.dateCreation);
                    meta.textContent += (meta.textContent ? ' · ' : '') + d.toLocaleString();
                } catch (e) {}
            }
            a.appendChild(meta);
            a.addEventListener('click', function (ev) {
                if (!n.lu && n.id) {
                    ev.preventDefault();
                    fetch(markReadUrl(n.id), { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
                        .finally(function () {
                            if (n.lien) window.location.href = n.lien;
                            else loadNotifications();
                        });
                }
            });
            listEl.appendChild(a);
        });
    }

    function loadNotifications() {
        fetch(listUrl, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.unreadCount !== undefined) setBadge(data.unreadCount);
                renderList(data.notifications || []);
            })
            .catch(function () {});
    }

    toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = panel.classList.toggle('wingo-notif-panel--open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) loadNotifications();
    });

    markAllBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        fetch(markAllUrl, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
            .then(function () { loadNotifications(); })
            .catch(function () {});
    });

    document.addEventListener('click', function () {
        panel.classList.remove('wingo-notif-panel--open');
        toggle.setAttribute('aria-expanded', 'false');
    });
    panel.addEventListener('click', function (e) { e.stopPropagation(); });

    loadNotifications();
    setInterval(loadNotifications, 60000);
})();
</script>
{% endif %}
<script src="{{ asset('js/custom.js') }}"></script>

