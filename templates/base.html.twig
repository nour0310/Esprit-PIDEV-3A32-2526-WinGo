    <style>
    .notification_wrapper {
        position: relative;
        margin-right: 18px;
    }

    .notification_bell {
        position: relative;
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        background: rgba(255,255,255,0.10);
        color: #ffffff;
        font-size: 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .25s ease;
    }

    .notification_bell:hover {
        background: rgba(255,255,255,0.18);
        transform: translateY(-1px);
    }

    .notification_badge {
        position: absolute;
        top: -4px;
        right: -3px;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: #ff4d6d;
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(255, 77, 109, 0.35);
    }

    .notification_dropdown {
        position: absolute;
        top: 54px;
        right: 0;
        width: 360px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 18px 45px rgba(18, 22, 45, 0.18);
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all .25s ease;
        z-index: 9999;
    }

    .notification_dropdown.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .notification_header {
        padding: 16px 18px;
        background: linear-gradient(135deg, #fa9e1b, #8d4fff);
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
    }

    .notification_header small {
        font-size: 12px;
        opacity: .95;
    }

    .notification_list {
        max-height: 320px;
        overflow-y: auto;
        background: #fff;
    }

    .notification_item {
        display: flex;
        gap: 12px;
        padding: 14px 16px;
        text-decoration: none !important;
        border-bottom: 1px solid #f1f3f8;
        transition: background .2s ease;
    }

    .notification_item:hover {
        background: #f8faff;
    }

    .notification_item.unread {
        background: #fcfcff;
    }

    .notification_icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
    }

    .bg_orange {
        background: linear-gradient(135deg, #fa9e1b, #ff7b54);
    }

    .bg_green {
        background: linear-gradient(135deg, #1abc9c, #2ecc71);
    }

    .bg_purple {
        background: linear-gradient(135deg, #8d4fff, #5d7cf3);
    }

    .notification_content {
        flex: 1;
        min-width: 0;
    }

    .notification_title {
        font-size: 14px;
        font-weight: 800;
        color: #1f2235;
        margin-bottom: 3px;
    }

    .notification_text {
        font-size: 13px;
        color: #6d748b;
        line-height: 1.5;
        margin-bottom: 4px;
    }

    .notification_time {
        font-size: 11px;
        color: #9aa1b5;
        font-weight: 600;
    }

    .notification_footer {
        padding: 12px 16px;
        background: #fafbff;
        text-align: center;
    }

    .notification_footer a {
        color: #8d4fff;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
    }

    @media (max-width: 767px) {
        .notification_dropdown {
            width: 300px;
            right: -40px;
        }
    }
    .nav_notification_wrapper {
    position: relative;
    margin-left: 25px;
    margin-right: 18px;
    display: flex;
    align-items: center;
}
</style>
