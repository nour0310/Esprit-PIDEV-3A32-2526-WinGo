{% extends 'base.html.twig' %}

{% block title %}Ajouter Produit{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ════════════════════════════════════════════════════════════
           FORM SECTION
        ════════════════════════════════════════════════════════════ */
        .product_form_section{
            padding: 170px 0 90px 0;
            background: #eef2f5;
        }

        .product_form_box{
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 18px 40px rgba(0,0,0,0.08);
            padding: 45px 50px;
        }

        .product_form_title{
            font-size: 48px;
            font-weight: 800;
            color: #2d2c2c;
            margin-bottom: 10px;
            text-align: center;
        }

        .product_form_subtitle{
            text-align: center;
            color: #6d6d6d;
            margin-bottom: 35px;
            font-size: 17px;
        }

        .product_form_box label{
            display: block;
            font-size: 15px;
            font-weight: 700;
            color: #2d2c2c;
            margin-bottom: 8px;
        }

        .product_form_box input,
        .product_form_box textarea,
        .product_form_box select{
            width: 100%;
            border: 1px solid #dcdcdc;
            border-radius: 14px;
            padding: 14px 16px;
            font-size: 15px;
            color: #333;
            background: #fafafa;
            outline: none;
            transition: all 0.25s ease;
            box-shadow: none;
        }

        .product_form_box textarea{
            min-height: 130px;
            resize: vertical;
        }

        .product_form_box input:focus,
        .product_form_box textarea:focus,
        .product_form_box select:focus{
            border-color: #8d4fff;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(141,79,255,0.10);
        }

        .product_form_grid{
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .product_full{
            grid-column: 1 / -1;
        }

        .product_submit_btn{
            border: none;
            border-radius: 30px;
            padding: 14px 28px;
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            background: linear-gradient(to right, #fa9e1b, #8d4fff);
            cursor: pointer;
            transition: 0.25s ease;
            box-shadow: 0 10px 25px rgba(141,79,255,0.22);
        }

        .product_submit_btn:hover{
            transform: translateY(-2px);
            opacity: 0.95;
        }

        .product_back_link{
            display: inline-block;
            margin-top: 18px;
            font-weight: 600;
            color: #8d4fff;
        }

        .product_back_link:hover{
            color: #fa9e1b;
            text-decoration: none;
        }

        .merchant_info_box{
            margin-bottom: 25px;
            padding: 16px 20px;
            border-radius: 16px;
            background: #f7f2ff;
            border: 1px solid #e7dcff;
            color: #5d4a9e;
            font-weight: 600;
        }

        .form_error_block{
            color: #dc3545;
            font-size: 13px;
            font-weight: 600;
            margin-top: 6px;
        }

        .form_error_block ul{
            margin: 0;
            padding-left: 18px;
        }

        .form_error_block li{
            margin: 0;
        }

        /* ════════════════════════════════════════════════════════════
           DESCRIPTION LABEL ROW
        ════════════════════════════════════════════════════════════ */
        .description_label_row{
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .description_label_row label{
            margin-bottom: 0;
        }

        /* ════════════════════════════════════════════════════════════
           BOUTON "GÉNÉRER AVEC IA"
        ════════════════════════════════════════════════════════════ */
        .ia_btn{
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, #8d4fff, #5d7cf3);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.2s;
            white-space: nowrap;
        }

        .ia_btn:hover{
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .ia_btn:disabled{
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        .ia_btn_spinner{
            display: none;
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: ia_spin 0.7s linear infinite;
        }

        @keyframes ia_spin{
            to { transform: rotate(360deg); }
        }

        .ia_msg{
            font-size: 13px;
            margin-top: 6px;
            min-height: 18px;
            padding: 0 2px;
        }

        .ia_msg.success{ color: #1a6b3a; }
        .ia_msg.error  { color: #dc3545; }

        /* ════════════════════════════════════════════════════════════
           PANEL RÉSULTAT IA
        ════════════════════════════════════════════════════════════ */
        .ia_panel{
            display: none;          /* caché jusqu'à la 1ère génération */
            margin-top: 18px;
            border: 1.5px solid #e0dffe;
            border-radius: 18px;
            background: linear-gradient(145deg, #f8f7ff 0%, #fdf9ff 100%);
            overflow: hidden;
            animation: ia_slide_in 0.35s cubic-bezier(.4,0,.2,1);
        }

        @keyframes ia_slide_in{
            from { opacity: 0; transform: translateY(-10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── En-tête du panel ── */
        .ia_panel_header{
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px;
            background: linear-gradient(90deg, #8d4fff15, #5d7cf310);
            border-bottom: 1px solid #e0dffe;
        }

        .ia_panel_title{
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: 14px;
            color: #4f46e5;
        }

        .ia_panel_badge{
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            background: #8d4fff;
            color: #fff;
            padding: 2px 8px;
            border-radius: 99px;
        }

        /* ── Corps du panel ── */
        .ia_panel_body{
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* ── Bloc générique ── */
        .ia_block_label{
            display: block;
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
            color: #9ca3af;
            margin-bottom: 6px;
        }

        /* ── Titre amélioré ── */
        .ia_titre_value{
            font-size: 16px;
            font-weight: 700;
            color: #1e1b4b;
            margin: 0;
        }

        /* ── Description ── */
        .ia_desc_value{
            font-size: 14px;
            color: #374151;
            line-height: 1.65;
            margin: 0;
        }

        /* ── Tags ── */
        .ia_tags_wrap{
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .ia_tag{
            background: #ede9fe;
            color: #6d28d9;
            font-size: 12px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 99px;
        }

        /* ── Score qualité ── */
        .ia_score_row{
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .ia_score_bar_wrap{
            flex: 1;
            height: 8px;
            background: #e5e7eb;
            border-radius: 99px;
            overflow: hidden;
        }

        .ia_score_fill{
            height: 100%;
            border-radius: 99px;
            background: linear-gradient(90deg, #10b981, #34d399);
            transition: width 0.7s cubic-bezier(.4,0,.2,1);
            width: 0%;
        }

        .ia_score_number{
            font-size: 14px;
            font-weight: 800;
            color: #1e1b4b;
            min-width: 48px;
            text-align: right;
        }

        /* ── Conseils ── */
        .ia_conseils_list{
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .ia_conseils_list li{
            display: flex;
            align-items: flex-start;
            gap: 8px;
            font-size: 13.5px;
            color: #374151;
            line-height: 1.5;
        }

        .ia_conseils_list li::before{
            content: '💡';
            flex-shrink: 0;
            margin-top: 1px;
        }

        /* ── Séparateur ── */
        .ia_divider{
            border: none;
            border-top: 1px solid #e0dffe;
            margin: 0;
        }

        /* ── Boutons d'action dans le panel ── */
        .ia_panel_actions{
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .ia_use_btn{
            flex: 1;
            min-width: 180px;
            padding: 11px 20px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #10b981, #059669);
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s;
        }

        .ia_use_btn:hover{
            opacity: 0.9;
            transform: translateY(-1px);
        }

        .ia_regen_btn{
            padding: 11px 18px;
            border-radius: 12px;
            border: 1.5px solid #e0dffe;
            background: transparent;
            color: #6d28d9;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: border-color 0.2s, background 0.2s;
        }

        .ia_regen_btn:hover{
            border-color: #8d4fff;
            background: #f7f2ff;
        }

        /* ════════════════════════════════════════════════════════════
           RESPONSIVE
        ════════════════════════════════════════════════════════════ */
        @media (max-width: 767px){
            .product_form_box{
                padding: 28px 20px;
                margin: 0 12px;
            }

            .product_form_title{
                font-size: 34px;
            }

            .product_form_grid{
                grid-template-columns: 1fr;
            }

            .ia_use_btn{
                min-width: unset;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="product_form_section">
        <div class="container">
            <div class="product_form_box">
                <h1 class="product_form_title">Ajouter un produit</h1>
                <p class="product_form_subtitle">Remplissez les informations du produit à publier sur Wingo</p>

                <div class="merchant_info_box">
                    Produit publié par : <strong>{{ app.user.fullName }}</strong>
                </div>

{{ form_start(formProduit, {
    'attr': {
        'novalidate': 'novalidate',
        'enctype': 'multipart/form-data'
    }
}) }}
                    <div class="product_form_grid">

                        {# ── NOM ── #}
                        <div>
                            {{ form_label(formProduit.nom) }}
                            {{ form_widget(formProduit.nom) }}
                            <div id="nom_live_error" class="form_error_block"></div>
                            <div class="form_error_block">{{ form_errors(formProduit.nom) }}</div>
                        </div>

                        {# ── PRIX ── #}
                        <div>
                            {{ form_label(formProduit.prix) }}
                            {{ form_widget(formProduit.prix) }}
                            <div class="form_error_block">{{ form_errors(formProduit.prix) }}</div>
                        </div>

                        {# ── DESCRIPTION + BOUTON IA ── #}
                        <div class="product_full">
                            <div class="description_label_row">
                                {{ form_label(formProduit.description) }}

                                {# Bouton "Générer avec IA" #}
                                <button type="button"
                                        id="btnGenererIA"
                                        class="ia_btn"
                                        title="Remplissez d'abord le nom, la catégorie et la région">
                                    <span id="iaSpinner" class="ia_btn_spinner"></span>
                                    ✨ Générer avec IA
                                </button>
                            </div>

                            {{ form_widget(formProduit.description, {'attr': {'id': 'produit_description'}}) }}
                            <div id="iaMsg" class="ia_msg"></div>
                            <div class="form_error_block">{{ form_errors(formProduit.description) }}</div>

                            {# Token CSRF dédié à la génération IA #}
                            <input type="hidden" id="csrf_ia" value="{{ csrf_token('generer_description') }}">

                            {# ══════════════════════════════════════════════════
                               PANEL RÉSULTAT IA
                            ══════════════════════════════════════════════════ #}
                            <div class="ia_panel" id="iaPanel">

                                {# En-tête #}
                                <div class="ia_panel_header">
                                    <div class="ia_panel_title">
                                        <span>✨</span>
                                        <span>Suggestion de l'assistant IA</span>
                                    </div>
                                    <span class="ia_panel_badge">Smart Product Assistant</span>
                                </div>

                                {# Corps #}
                                <div class="ia_panel_body">

                                    {# Titre amélioré #}
                                    <div>
                                        <span class="ia_block_label">Titre amélioré</span>
                                        <p class="ia_titre_value" id="iaTitre">—</p>
                                    </div>

                                    <hr class="ia_divider">

                                    {# Description #}
                                    <div>
                                        <span class="ia_block_label">Description générée</span>
                                        <p class="ia_desc_value" id="iaDescription">—</p>
                                    </div>

                                    <hr class="ia_divider">

                                    {# Tags #}
                                    <div>
                                        <span class="ia_block_label">Tags</span>
                                        <div class="ia_tags_wrap" id="iaTags"></div>
                                    </div>

                                    <hr class="ia_divider">

                                    {# Score qualité #}
                                    <div>
                                        <span class="ia_block_label">Score qualité de la fiche</span>
                                        <div class="ia_score_row">
                                            <div class="ia_score_bar_wrap">
                                                <div class="ia_score_fill" id="iaScoreFill"></div>
                                            </div>
                                            <span class="ia_score_number" id="iaScoreNumber">0 / 100</span>
                                        </div>
                                    </div>

                                    <hr class="ia_divider">

                                    {# Conseils #}
                                    <div>
                                        <span class="ia_block_label">Conseils pour améliorer la fiche</span>
                                        <ul class="ia_conseils_list" id="iaConseils"></ul>
                                    </div>

                                    <hr class="ia_divider">

                                    {# Actions #}
                                    <div class="ia_panel_actions">
                                        <button type="button" class="ia_use_btn" id="iaUseBtn">
                                            ✅ Utiliser cette description
                                        </button>
                                        <button type="button" class="ia_regen_btn" id="iaRegenBtn">
                                            🔄 Regénérer
                                        </button>
                                    </div>

                                </div>{# /ia_panel_body #}
                            </div>{# /ia_panel #}

                        </div>{# /product_full description #}

                        {# ── RÉGION ── #}
                        <div>
                            {{ form_label(formProduit.region) }}
                            {{ form_widget(formProduit.region) }}
                            <div class="form_error_block">{{ form_errors(formProduit.region) }}</div>
                        </div>

                        {# ── CATÉGORIE ── #}
                        <div>
                            {{ form_label(formProduit.categorie) }}
                            {{ form_widget(formProduit.categorie) }}
                            <div class="form_error_block">{{ form_errors(formProduit.categorie) }}</div>
                        </div>

                        {# ── STOCK ── #}
                        <div>
                            {{ form_label(formProduit.stock) }}
                            {{ form_widget(formProduit.stock) }}
                            <div class="form_error_block">{{ form_errors(formProduit.stock) }}</div>
                        </div>

                        {# ── IMAGE ── #}
                        <div class="product_full">
                            {{ form_label(formProduit.imageFile) }}
                            {{ form_widget(formProduit.imageFile) }}
                            <div class="form_error_block">{{ form_errors(formProduit.imageFile) }}</div>
                        </div>

                        {# ── DATE ── #}
                        <div class="product_full">
                            {{ form_label(formProduit.dateAjout) }}
                            {{ form_widget(formProduit.dateAjout) }}
                            <div class="form_error_block">{{ form_errors(formProduit.dateAjout) }}</div>
                        </div>

                    </div>{# /product_form_grid #}

                    <button type="submit" class="product_submit_btn">Enregistrer</button>

                {{ form_end(formProduit) }}

                <a href="{{ path('merchant_dashboard') }}" class="product_back_link">← Retour au dashboard commerçant</a>
            </div>
        </div>
    </div>

    <script>
    (function () {
        /* ── Éléments DOM ────────────────────────────────────────────── */
        const btnGenerer  = document.getElementById('btnGenererIA');
        const btnUse      = document.getElementById('iaUseBtn');
        const btnRegen    = document.getElementById('iaRegenBtn');
        const spinner     = document.getElementById('iaSpinner');
        const msg         = document.getElementById('iaMsg');
        const panel       = document.getElementById('iaPanel');
        const descField   = document.getElementById('produit_description');

        const elTitre     = document.getElementById('iaTitre');
        const elDesc      = document.getElementById('iaDescription');
        const elTags      = document.getElementById('iaTags');
        const elScoreFill = document.getElementById('iaScoreFill');
        const elScoreNum  = document.getElementById('iaScoreNumber');
        const elConseils  = document.getElementById('iaConseils');

        /* ── Helpers ─────────────────────────────────────────────────── */
        function getField(selectors) {
            for (const sel of selectors) {
                const el = document.querySelector(sel);
                if (el) return el.value.trim();
            }
            return '';
        }

        function setLoading(on) {
            btnGenerer.disabled      = on;
            spinner.style.display    = on ? 'inline-block' : 'none';
        }

        function showMsg(text, type) {
            msg.className   = 'ia_msg ' + type;
            msg.textContent = text;
        }

        /* ── Affiche le panel avec les données ───────────────────────── */
        function renderPanel(data) {
            /* Titre */
            elTitre.textContent = data.titre_ameliore || '—';

            /* Description */
            elDesc.textContent  = data.description    || '—';

            /* Tags */
            elTags.innerHTML = '';
            (data.tags || []).forEach(function (tag) {
                const span       = document.createElement('span');
                span.className   = 'ia_tag';
                span.textContent = tag;
                elTags.appendChild(span);
            });

            /* Score */
            const score           = Math.min(100, Math.max(0, data.score_qualite || 0));
            elScoreFill.style.width = score + '%';
            elScoreNum.textContent  = score + ' / 100';

            /* Conseils */
            elConseils.innerHTML = '';
            (data.conseils || []).forEach(function (c) {
                const li       = document.createElement('li');
                li.textContent = c;
                elConseils.appendChild(li);
            });

            /* Afficher le panel avec animation */
            panel.style.display = 'block';
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        /* ── Appel API Symfony → Flask → Gemini ──────────────────────── */
        async function generer() {
            const nom       = getField(['#produit_nom',       '[name$="[nom]"]']);
            const categorie = getField(['[name$="[categorie]"]', '#produit_categorie']);
            const region    = getField(['[name$="[region]"]',    '#produit_region']);
            const prix      = getField(['[name$="[prix][amount]"]', '[name$="[prix]"]', '#produit_prix']);
            const stock     = getField(['[name$="[stock]"]',    '#produit_stock']);

            /* Validation minimale côté client */
            if (!nom || !categorie || !region) {
                showMsg('Remplissez d\'abord le nom, la catégorie et la région.', 'error');
                return;
            }

            setLoading(true);
            panel.style.display = 'none';
            showMsg('Génération en cours…', '');

            const body = new URLSearchParams();
            body.append('_token',    document.getElementById('csrf_ia').value);
            body.append('nom',       nom);
            body.append('categorie', categorie);
            body.append('region',    region);
            body.append('prix',      prix);
            body.append('stock',     stock);

            try {
                const res  = await fetch('{{ path("produit_ai_generate") }}', {
                    method:  'POST',
                    body,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                });

                const data = await res.json();

                if (!res.ok || data.error || data.success === false) {
                    showMsg(data.error ?? 'Une erreur est survenue.', 'error');
                    return;
                }

                renderPanel(data);
                showMsg('✓ Suggestion générée — vous pouvez modifier avant d\'enregistrer.', 'success');

            } catch (err) {
                showMsg('Erreur réseau. Vérifiez que le service IA est actif.', 'error');
            } finally {
                setLoading(false);
            }
        }

        /* ── Événements ──────────────────────────────────────────────── */
        btnGenerer.addEventListener('click', generer);
        btnRegen.addEventListener('click',   generer);

        btnUse.addEventListener('click', function () {
            descField.value = elDesc.textContent;
            descField.dispatchEvent(new Event('input', { bubbles: true }));
            descField.focus();
            descField.scrollIntoView({ behavior: 'smooth', block: 'center' });
            showMsg('✓ Description appliquée dans le formulaire.', 'success');
        });
    })();
    </script>
{% endblock %}
