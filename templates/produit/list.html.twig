{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <div class="container" style="margin-top: 120px; margin-bottom: 60px;">
        <h1>Liste des produits</h1>

        <a href="{{ path('produit_add') }}" class="btn btn-primary" style="margin-bottom: 20px;">
            Ajouter produit
        </a>

        <table border="1" cellpadding="10" cellspacing="0" style="width:100%; background:white;">
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Prix</th>
                <th>Région</th>
                <th>Catégorie</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>

            {% for p in list %}
                <tr>
                    <td>{{ p.id }}</td>
                    <td>{{ p.nom }}</td>
                    <td>{{ p.prix }}</td>
                    <td>{{ p.region }}</td>
                    <td>{{ p.categorie }}</td>
                    <td>{{ p.stock }}</td>
                    <td>
                        <a href="{{ path('produit_details', {'id': p.id}) }}">Détails</a>
                        <a href="{{ path('produit_update', {'id': p.id}) }}">Modifier</a>
                        <a href="{{ path('produit_delete', {'id': p.id}) }}">Supprimer</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">Aucun produit trouvé</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}