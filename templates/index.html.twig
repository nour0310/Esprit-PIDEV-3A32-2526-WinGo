{% extends 'base.html.twig' %}

{% block title %}Travelix - Home{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/responsive.css') }}">
{% endblock %}

{% block content %}

	<!-- Home Slider -->
	<div class="home">
		<div class="home_slider_container">
			<div class="owl-carousel owl-theme home_slider">

				{% for slide in slides is defined ? slides : [{image: 'home_slider.jpg', title1: 'discover', title2: 'the world'}, {image: 'home_slider.jpg', title1: 'discover', title2: 'the world'}, {image: 'home_slider.jpg', title1: 'discover', title2: 'the world'}] %}
				<div class="owl-item home_slider_item">
<img class="home_slider_background" src="{{ asset('images/sidibou.jpg') }}" alt="">					<div class="home_slider_content text-center">
						<div class="home_slider_content_inner" data-animation-in="flipInX" data-animation-out="animate-out fadeOut">
							<h1>{{ slide.title1 }}</h1>
							<h1>{{ slide.title2 }}</h1>
							<div class="button home_slider_button"><div class="button_bcg"></div><a href="#">explore now<span></span><span></span><span></span></a></div>
						</div>
					</div>
				</div>
				{% endfor %}

			</div>

			<!-- Prev -->
			<div class="home_slider_nav home_slider_prev">
				<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="28px" height="33px" viewBox="0 0 28 33" enable-background="new 0 0 28 33" xml:space="preserve">
					<defs><linearGradient id='home_grad_prev'><stop offset='0%' stop-color='#fa9e1b'/><stop offset='100%' stop-color='#8d4fff'/></linearGradient></defs>
					<path class="nav_path" fill="#F3F6F9" d="M19,0H9C4.029,0,0,4.029,0,9v15c0,4.971,4.029,9,9,9h10c4.97,0,9-4.029,9-9V9C28,4.029,23.97,0,19,0z M26,23.091C26,27.459,22.545,31,18.285,31H9.714C5.454,31,2,27.459,2,23.091V9.909C2,5.541,5.454,2,9.714,2h8.571C22.545,2,26,5.541,26,9.909V23.091z"/>
					<polygon class="nav_arrow" fill="#F3F6F9" points="15.044,22.222 16.377,20.888 12.374,16.885 16.377,12.882 15.044,11.55 9.708,16.885 11.04,18.219 11.042,18.219"/>
				</svg>
			</div>

			<!-- Next -->
			<div class="home_slider_nav home_slider_next">
				<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="28px" height="33px" viewBox="0 0 28 33" enable-background="new 0 0 28 33" xml:space="preserve">
					<defs><linearGradient id='home_grad_next'><stop offset='0%' stop-color='#fa9e1b'/><stop offset='100%' stop-color='#8d4fff'/></linearGradient></defs>
					<path class="nav_path" fill="#F3F6F9" d="M19,0H9C4.029,0,0,4.029,0,9v15c0,4.971,4.029,9,9,9h10c4.97,0,9-4.029,9-9V9C28,4.029,23.97,0,19,0z M26,23.091C26,27.459,22.545,31,18.285,31H9.714C5.454,31,2,27.459,2,23.091V9.909C2,5.541,5.454,2,9.714,2h8.571C22.545,2,26,5.541,26,9.909V23.091z"/>
					<polygon class="nav_arrow" fill="#F3F6F9" points="13.044,11.551 11.71,12.885 15.714,16.888 11.71,20.891 13.044,22.224 18.379,16.888 17.048,15.554 17.046,15.554"/>
				</svg>
			</div>

			<!-- Dots -->
			<div class="home_slider_dots">
				<ul id="home_slider_custom_dots" class="home_slider_custom_dots">
					<li class="home_slider_custom_dot active"><div></div>01.</li>
					<li class="home_slider_custom_dot"><div></div>02.</li>
					<li class="home_slider_custom_dot"><div></div>03.</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Search -->
	<div class="search">
		<div class="container fill_height">
			<div class="row fill_height">
				<div class="col fill_height">

					<!-- Search Tabs -->
					<div class="search_tabs_container">
						<div class="search_tabs d-flex flex-lg-row flex-column align-items-lg-center align-items-start justify-content-lg-between justify-content-start">
							<div class="search_tab active d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/suitcase.png') }}" alt=""><span>hotels</span></div>
							<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/bus.png') }}" alt="">car rentals</div>
							<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/departure.png') }}" alt="">flights</div>
							<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/island.png') }}" alt="">trips</div>
							<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/cruise.png') }}" alt="">cruises</div>
							<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/diving.png') }}" alt="">activities</div>
						</div>
					</div>

					{% for i in 1..6 %}
					<!-- Search Panel -->
					<div class="search_panel {% if i == 1 %}active{% endif %}">
						<form action="#" id="search_form_{{ i }}" class="search_panel_content d-flex flex-lg-row flex-column align-items-lg-center align-items-start justify-content-lg-between justify-content-start">
							<div class="search_item">
								<div>destination</div>
								<input type="text" class="destination search_input" required="required">
							</div>
							<div class="search_item">
								<div>check in</div>
								<input type="text" class="check_in search_input" placeholder="YYYY-MM-DD">
							</div>
							<div class="search_item">
								<div>check out</div>
								<input type="text" class="check_out search_input" placeholder="YYYY-MM-DD">
							</div>
							<div class="search_item">
								<div>adults</div>
								<select name="adults" id="adults_{{ i }}" class="dropdown_item_select search_input">
									<option>01</option>
									<option>02</option>
									<option>03</option>
								</select>
							</div>
							<div class="search_item">
								<div>children</div>
								<select name="children" id="children_{{ i }}" class="dropdown_item_select search_input">
									<option>0</option>
									<option>02</option>
									<option>03</option>
								</select>
							</div>
							<button class="button search_button">search<span></span><span></span><span></span></button>
						</form>
					</div>
					{% endfor %}

				</div>
			</div>
		</div>
	</div>

	<!-- Intro -->
	<div class="intro">
		<div class="container">
			<div class="row">
				<div class="col">
					<h2 class="intro_title text-center">We have the best tours</h2>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-10 offset-lg-1">
					<div class="intro_text text-center">
						<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam eu convallis tortor. Suspendisse potenti. In faucibus massa arcu, vitae cursus mi hendrerit nec.</p>
					</div>
				</div>
			</div>
			<div class="row intro_items">

				{% set intro_items = intro_items is defined ? intro_items : [
					{image: 'intro_1.jpg', date: 'May 25th - June 01st', name: 'Mauritius', price: 'From $1450'},
					{image: 'intro_2.jpg', date: 'May 25th - June 01st', name: 'Greece', price: 'From $1450'},
					{image: 'intro_3.jpg', date: 'May 25th - June 01st', name: 'Scotland', price: 'From $1450'}
				] %}

				{% for item in intro_items %}
				<div class="col-lg-4 intro_col">
					<div class="intro_item">
						<div class="intro_item_overlay"></div>
						<div class="intro_item_background" style="background-image:url({{ asset('images/' ~ item.image) }})"></div>
						<div class="intro_item_content d-flex flex-column align-items-center justify-content-center">
							<div class="intro_date">{{ item.date }}</div>
							<div class="button intro_button"><div class="button_bcg"></div><a href="#">see more<span></span><span></span><span></span></a></div>
							<div class="intro_center text-center">
								<h1>{{ item.name }}</h1>
								<div class="intro_price">{{ item.price }}</div>
								<div class="rating rating_4">
									<i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
				{% endfor %}

			</div>
		</div>
	</div>

	<!-- CTA -->
	<div class="cta">
		<div class="cta_background" style="background-image:url({{ asset('images/cta.jpg') }})"></div>
		<div class="container">
			<div class="row">
				<div class="col">
					<div class="cta_slider_container">
						<div class="owl-carousel owl-theme cta_slider">

							{% set cta_items = cta_items is defined ? cta_items : [
								{title: 'maldives deluxe package', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam eu convallis tortor. Suspendisse potenti.'},
								{title: 'maldives deluxe package', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam eu convallis tortor. Suspendisse potenti.'},
								{title: 'maldives deluxe package', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam eu convallis tortor. Suspendisse potenti.'}
							] %}

							{% for item in cta_items %}
							<div class="owl-item cta_item text-center">
								<div class="cta_title">{{ item.title }}</div>
								<div class="rating_r rating_r_4"><i></i><i></i><i></i><i></i><i></i></div>
								<p class="cta_text">{{ item.text }}</p>
								<div class="button cta_button"><div class="button_bcg"></div><a href="#">book now<span></span><span></span><span></span></a></div>
							</div>
							{% endfor %}

						</div>
						<!-- CTA Prev -->
						<div class="cta_slider_nav cta_slider_prev">
							<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="28px" height="33px" viewBox="0 0 28 33" enable-background="new 0 0 28 33" xml:space="preserve">
								<defs><linearGradient id='cta_grad_prev'><stop offset='0%' stop-color='#fa9e1b'/><stop offset='100%' stop-color='#8d4fff'/></linearGradient></defs>
								<path class="nav_path" fill="#F3F6F9" d="M19,0H9C4.029,0,0,4.029,0,9v15c0,4.971,4.029,9,9,9h10c4.97,0,9-4.029,9-9V9C28,4.029,23.97,0,19,0z M26,23.091C26,27.459,22.545,31,18.285,31H9.714C5.454,31,2,27.459,2,23.091V9.909C2,5.541,5.454,2,9.714,2h8.571C22.545,2,26,5.541,26,9.909V23.091z"/>
								<polygon class="nav_arrow" fill="#F3F6F9" points="15.044,22.222 16.377,20.888 12.374,16.885 16.377,12.882 15.044,11.55 9.708,16.885 11.04,18.219 11.042,18.219"/>
							</svg>
						</div>
						<!-- CTA Next -->
						<div class="cta_slider_nav cta_slider_next">
							<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="28px" height="33px" viewBox="0 0 28 33" enable-background="new 0 0 28 33" xml:space="preserve">
								<defs><linearGradient id='cta_grad_next'><stop offset='0%' stop-color='#fa9e1b'/><stop offset='100%' stop-color='#8d4fff'/></linearGradient></defs>
								<path class="nav_path" fill="#F3F6F9" d="M19,0H9C4.029,0,0,4.029,0,9v15c0,4.971,4.029,9,9,9h10c4.97,0,9-4.029,9-9V9C28,4.029,23.97,0,19,0z M26,23.091C26,27.459,22.545,31,18.285,31H9.714C5.454,31,2,27.459,2,23.091V9.909C2,5.541,5.454,2,9.714,2h8.571C22.545,2,26,5.541,26,9.909V23.091z"/>
								<polygon class="nav_arrow" fill="#F3F6F9" points="13.044,11.551 11.71,12.885 15.714,16.888 11.71,20.891 13.044,22.224 18.379,16.888 17.048,15.554 17.046,15.554"/>
							</svg>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Offers -->
	<div class="offers">
		<div class="container">
			<div class="row">
				<div class="col text-center">
					<h2 class="section_title">the best offers with rooms</h2>
				</div>
			</div>
			<div class="row offers_items">

				{% set offers = offers is defined ? offers : [
					{image: 'offer_1.jpg', name: 'grand castle', price: '$70', text: 'Suspendisse potenti. In faucibus massa. Lorem ipsum dolor sit amet, consectetur adipiscing elit.'},
					{image: 'offer_2.jpg', name: 'turkey hills', price: '$50', text: 'Suspendisse potenti. In faucibus massa. Lorem ipsum dolor sit amet, consectetur adipiscing elit.'},
					{image: 'offer_3.jpg', name: 'island dream', price: '$90', text: 'Suspendisse potenti. In faucibus massa. Lorem ipsum dolor sit amet, consectetur adipiscing elit.'},
					{image: 'offer_4.jpg', name: 'travel light', price: '$30', text: 'Suspendisse potenti. In faucibus massa. Lorem ipsum dolor sit amet, consectetur adipiscing elit.'}
				] %}

				{% for offer in offers %}
				<div class="col-lg-6 offers_col">
					<div class="offers_item">
						<div class="row">
							<div class="col-lg-6">
								<div class="offers_image_container">
									<div class="offers_image_background" style="background-image:url({{ asset('images/' ~ offer.image) }})"></div>
									<div class="offer_name"><a href="#">{{ offer.name }}</a></div>
								</div>
							</div>
							<div class="col-lg-6">
								<div class="offers_content">
									<div class="offers_price">{{ offer.price }}<span>per night</span></div>
									<div class="rating_r rating_r_4 offers_rating"><i></i><i></i><i></i><i></i><i></i></div>
									<p class="offers_text">{{ offer.text }}</p>
									<div class="offers_icons">
										<ul class="offers_icons_list">
											<li class="offers_icons_item"><img src="{{ asset('images/post.png') }}" alt=""></li>
											<li class="offers_icons_item"><img src="{{ asset('images/compass.png') }}" alt=""></li>
											<li class="offers_icons_item"><img src="{{ asset('images/bicycle.png') }}" alt=""></li>
											<li class="offers_icons_item"><img src="{{ asset('images/sailboat.png') }}" alt=""></li>
										</ul>
									</div>
									<div class="offers_link"><a href="{{ path('offers') }}">read more</a></div>
								</div>
							</div>
						</div>
					</div>
				</div>
				{% endfor %}

			</div>
		</div>
	</div>

	<!-- Testimonials -->
	<div class="testimonials">
		<div class="test_border"></div>
		<div class="container">
			<div class="row">
				<div class="col text-center">
					<h2 class="section_title">what our clients say about us</h2>
				</div>
			</div>
			<div class="row">
				<div class="col">
					<div class="test_slider_container">
						<div class="owl-carousel owl-theme test_slider">

							{% set testimonials = testimonials is defined ? testimonials : [
								{image: 'test_1.jpg', icon: 'backpack.png', name: 'carla smith', date: 'May 24, 2017', quote: 'Best holliday ever', text: 'Nullam eu convallis tortor. Suspendisse potenti. In faucibus massa arcu, vitae cursus mi hendrerit nec.'},
								{image: 'test_2.jpg', icon: 'island_t.png', name: 'carla smith', date: 'May 24, 2017', quote: 'Best holliday ever', text: 'Nullam eu convallis tortor. Suspendisse potenti. In faucibus massa arcu, vitae cursus mi hendrerit nec.'},
								{image: 'test_3.jpg', icon: 'kayak.png', name: 'carla smith', date: 'May 24, 2017', quote: 'Best holliday ever', text: 'Nullam eu convallis tortor. Suspendisse potenti. In faucibus massa arcu, vitae cursus mi hendrerit nec.'}
							] %}

							{% for test in testimonials %}
							<div class="owl-item">
								<div class="test_item">
									<div class="test_image"><img src="{{ asset('images/' ~ test.image) }}" alt=""></div>
									<div class="test_icon"><img src="{{ asset('images/' ~ test.icon) }}" alt=""></div>
									<div class="test_content_container">
										<div class="test_content">
											<div class="test_item_info">
												<div class="test_name">{{ test.name }}</div>
												<div class="test_date">{{ test.date }}</div>
											</div>
											<div class="test_quote_title">" {{ test.quote }} "</div>
											<p class="test_quote_text">{{ test.text }}</p>
										</div>
									</div>
								</div>
							</div>
							{% endfor %}

						</div>
						<!-- Test Prev -->
						<div class="test_slider_nav test_slider_prev">
							<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="28px" height="33px" viewBox="0 0 28 33" enable-background="new 0 0 28 33" xml:space="preserve">
								<defs><linearGradient id='test_grad_prev'><stop offset='0%' stop-color='#fa9e1b'/><stop offset='100%' stop-color='#8d4fff'/></linearGradient></defs>
								<path class="nav_path" fill="#F3F6F9" d="M19,0H9C4.029,0,0,4.029,0,9v15c0,4.971,4.029,9,9,9h10c4.97,0,9-4.029,9-9V9C28,4.029,23.97,0,19,0z M26,23.091C26,27.459,22.545,31,18.285,31H9.714C5.454,31,2,27.459,2,23.091V9.909C2,5.541,5.454,2,9.714,2h8.571C22.545,2,26,5.541,26,9.909V23.091z"/>
								<polygon class="nav_arrow" fill="#F3F6F9" points="15.044,22.222 16.377,20.888 12.374,16.885 16.377,12.882 15.044,11.55 9.708,16.885 11.04,18.219 11.042,18.219"/>
							</svg>
						</div>
						<!-- Test Next -->
						<div class="test_slider_nav test_slider_next">
							<svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="28px" height="33px" viewBox="0 0 28 33" enable-background="new 0 0 28 33" xml:space="preserve">
								<defs><linearGradient id='test_grad_next'><stop offset='0%' stop-color='#fa9e1b'/><stop offset='100%' stop-color='#8d4fff'/></linearGradient></defs>
								<path class="nav_path" fill="#F3F6F9" d="M19,0H9C4.029,0,0,4.029,0,9v15c0,4.971,4.029,9,9,9h10c4.97,0,9-4.029,9-9V9C28,4.029,23.97,0,19,0z M26,23.091C26,27.459,22.545,31,18.285,31H9.714C5.454,31,2,27.459,2,23.091V9.909C2,5.541,5.454,2,9.714,2h8.571C22.545,2,26,5.541,26,9.909V23.091z"/>
								<polygon class="nav_arrow" fill="#F3F6F9" points="13.044,11.551 11.71,12.885 15.714,16.888 11.71,20.891 13.044,22.224 18.379,16.888 17.048,15.554 17.046,15.554"/>
							</svg>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Trending -->
	<div class="trending">
		<div class="container">
			<div class="row">
				<div class="col text-center">
					<h2 class="section_title">trending now</h2>
				</div>
			</div>
			<div class="row trending_container">

				{% set trending = trending is defined ? trending : [
					{image: 'trend_1.png', title: 'grand hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_2.png', title: 'mars hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_3.png', title: 'queen hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_4.png', title: 'mars hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_5.png', title: 'grand hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_6.png', title: 'mars hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_7.png', title: 'queen hotel', price: 'From $182', location: 'madrid, spain'},
					{image: 'trend_8.png', title: 'mars hotel', price: 'From $182', location: 'madrid, spain'}
				] %}

				{% for item in trending %}
				<div class="col-lg-3 col-sm-6">
					<div class="trending_item clearfix">
						<div class="trending_image"><img src="{{ asset('images/' ~ item.image) }}" alt=""></div>
						<div class="trending_content">
							<div class="trending_title"><a href="#">{{ item.title }}</a></div>
							<div class="trending_price">{{ item.price }}</div>
							<div class="trending_location">{{ item.location }}</div>
						</div>
					</div>
				</div>
				{% endfor %}

			</div>
		</div>
	</div>

	<!-- Contact -->
	<div class="contact">
		<div class="contact_background" style="background-image:url({{ asset('images/contact.png') }})"></div>
		<div class="container">
			<div class="row">
				<div class="col-lg-5">
					<div class="contact_image"></div>
				</div>
				<div class="col-lg-7">
					<div class="contact_form_container">
						<div class="contact_title">get in touch</div>
						<form action="#" method="post" id="contact_form" class="contact_form">
							<input type="text" id="contact_form_name" class="contact_form_name input_field" placeholder="Name" required="required" data-error="Name is required.">
							<input type="text" id="contact_form_email" class="contact_form_email input_field" placeholder="E-mail" required="required" data-error="Email is required.">
							<input type="text" id="contact_form_subject" class="contact_form_subject input_field" placeholder="Subject" required="required" data-error="Subject is required.">
							<textarea id="contact_form_message" class="text_field contact_form_message" name="message" rows="4" placeholder="Message" required="required" data-error="Please, write us a message."></textarea>
							<input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
							<button type="submit" id="form_submit_button" class="form_submit_button button">send message<span></span><span></span><span></span></button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
