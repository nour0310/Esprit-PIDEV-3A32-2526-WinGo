				</div>
				<div class="col-lg-2 col-md-4 col-sm-6 text-center mb-4" style="margin-bottom: 40px;">
					<div class="team_member_wrapper">
						<img src="{{ asset('images/team/member_5.png') }}" alt="Fatma Aloui" style="width: 160px; height: 160px; object-fit: cover; border-radius: 50%; border: 6px solid #fa9e1b; box-shadow: 0px 10px 25px rgba(0,0,0,0.5);">
