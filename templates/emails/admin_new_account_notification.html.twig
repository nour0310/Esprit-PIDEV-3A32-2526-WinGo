<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouveau compte WinGo</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fb;font-family:Arial,sans-serif;color:#1f2937;">
    <div style="max-width:640px;margin:40px auto;background:#ffffff;border-radius:18px;overflow:hidden;box-shadow:0 10px 35px rgba(0,0,0,0.08);">
        <div style="padding:32px 36px;background:linear-gradient(135deg,#1a1a2e,#0f3460);color:#ffffff;">
            <div style="font-size:32px;font-weight:800;color:#fa9e1b;">WinGo</div>
            <div style="margin-top:10px;font-size:24px;font-weight:700;">Nouveau compte cree</div>
        </div>

        <div style="padding:32px 36px;">
            <p style="font-size:16px;line-height:1.7;margin:0 0 18px;">
                Un nouvel utilisateur vient de creer un compte sur WinGo.
            </p>

            <div style="background:#f8f9fc;border-radius:14px;padding:18px 20px;margin:24px 0;">
                <div style="font-size:13px;color:#6b7280;text-transform:uppercase;letter-spacing:.08em;margin-bottom:10px;">Informations du compte</div>
                <div style="font-size:15px;line-height:1.8;">
                    <strong>Nom complet :</strong> {{ user.fullName }}<br>
                    <strong>Email :</strong> {{ user.email }}<br>
                    <strong>Telephone :</strong> {{ user.telephone ?? 'Non renseigne' }}<br>
                    <strong>Age :</strong> {{ user.age ?? 'Non renseigne' }}<br>
                    <strong>Role :</strong> {{ user.type ?? 'CLIENT' }}
                </div>
            </div>
        </div>
    </div>
</body>
</html>
