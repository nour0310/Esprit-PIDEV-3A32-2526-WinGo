{% extends 'base.html.twig' %}

{% block title %}{{ listing.name is defined ? listing.name : 'The Offer' }} - Travelix{% endblock %}

{% block stylesheets %}
<link href="{{ asset('plugins/colorbox/colorbox.css') }}" rel="stylesheet" type="text/css">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/single_listing_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/single_listing_responsive.css') }}">
{% endblock %}

{% block content %}

	<!-- Home Banner -->
	<div class="home">
		<div class="home_background parallax-window" data-parallax="scroll" data-image-src="{{ asset('images/single_background.jpg') }}"></div>
		<div class="home_content">
			<div class="home_title">the offers</div>
		</div>
	</div>

	<!-- Listing -->
	<div class="listing">

		<!-- Search -->
		<div class="search">
			<div class="search_inner">
				<div class="container fill_height no-padding">
					<div class="row fill_height no-margin">
						<div class="col fill_height no-padding">

							<!-- Search Tabs -->
							<div class="search_tabs_container">
								<div class="search_tabs d-flex flex-lg-row flex-column align-items-lg-center align-items-start justify-content-lg-between justify-content-start">
									<div class="search_tab active d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/suitcase.png') }}" alt=""><span>hotels</span></div>
									<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/bus.png') }}" alt="">car rentals</div>
									<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/departure.png') }}" alt="">flights</div>
									<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/island.png') }}" alt="">trips</div>
									<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/cruise.png') }}" alt="">cruises</div>
									<div class="search_tab d-flex flex-row align-items-center justify-content-lg-center justify-content-start"><img src="{{ asset('images/diving.png') }}" alt="">activities</div>
								</div>
							</div>

							<!-- Search Panel Hotels (with extras) -->
							<div class="search_panel active">
								<form action="#" id="search_form_1" class="search_panel_content d-flex flex-lg-row flex-column align-items-lg-center align-items-start justify-content-lg-between justify-content-start">
									<div class="search_item"><div>destination</div><input type="text" class="destination search_input" required="required"></div>
									<div class="search_item"><div>check in</div><input type="text" class="check_in search_input" placeholder="YYYY-MM-DD"></div>
									<div class="search_item"><div>check out</div><input type="text" class="check_out search_input" placeholder="YYYY-MM-DD"></div>
									<div class="search_item"><div>adults</div><select name="adults" id="adults_1" class="dropdown_item_select search_input"><option>01</option><option>02</option><option>03</option></select></div>
									<div class="search_item"><div>children</div><select name="children" id="children_1" class="dropdown_item_select search_input"><option>0</option><option>02</option><option>03</option></select></div>
									<div class="extras">
										<ul class="search_extras clearfix">
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_1" class="search_extras_cb"><label for="search_extras_1">Pet Friendly</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_2" class="search_extras_cb"><label for="search_extras_2">Car Parking</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_3" class="search_extras_cb"><label for="search_extras_3">Wireless Internet</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_4" class="search_extras_cb"><label for="search_extras_4">Reservations</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_5" class="search_extras_cb"><label for="search_extras_5">Private Parking</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_6" class="search_extras_cb"><label for="search_extras_6">Smoking Area</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_7" class="search_extras_cb"><label for="search_extras_7">Wheelchair Accessible</label></div></li>
											<li class="search_extras_item"><div class="clearfix"><input type="checkbox" id="search_extras_8" class="search_extras_cb"><label for="search_extras_8">Pool</label></div></li>
										</ul>
									</div>
									<button class="button search_button">search<span></span><span></span><span></span></button>
								</form>
							</div>

							{% for i in 2..6 %}
							<div class="search_panel">
								<form action="#" id="search_form_{{ i }}" class="search_panel_content d-flex flex-lg-row flex-column align-items-lg-center align-items-start justify-content-lg-between justify-content-start">
									<div class="search_item"><div>destination</div><input type="text" class="destination search_input" required="required"></div>
									<div class="search_item"><div>check in</div><input type="text" class="check_in search_input" placeholder="YYYY-MM-DD"></div>
									<div class="search_item"><div>check out</div><input type="text" class="check_out search_input" placeholder="YYYY-MM-DD"></div>
									<div class="search_item"><div>adults</div><select name="adults" id="adults_{{ i }}" class="dropdown_item_select search_input"><option>01</option><option>02</option><option>03</option></select></div>
									<div class="search_item"><div>children</div><select name="children" id="children_{{ i }}" class="dropdown_item_select search_input"><option>0</option><option>02</option><option>03</option></select></div>
									<button class="button search_button">search<span></span><span></span><span></span></button>
								</form>
							</div>
							{% endfor %}

						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Listing Content -->
		<div class="container">
			<div class="row">
				<div class="col-lg-1 temp_col"></div>

				<!-- Main Content -->
				<div class="col-lg-7">

					{% set listing = listing is defined ? listing : {
						name: 'Grand Castle Hotel',
						rating: 'rating_4',
						price: 70,
						address: '123 Paradise Road, Maldives',
						description: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus quis vulputate eros, iaculis consequat nisl. Nunc et suscipit urna. Integer elementum orci eu vehicula pretium.',
						gallery: ['single_1.jpg', 'single_2.jpg', 'single_3.jpg', 'single_4.jpg', 'single_5.jpg', 'single_6.jpg'],
						amenities: ['Pet Friendly', 'Car Parking', 'Wireless Internet', 'Pool', 'Restaurant', 'Gym']
					} %}

					<!-- Listing Title -->
					<div class="listing_title_container d-flex flex-lg-row flex-column">
						<div class="listing_title">
							<h1>{{ listing.name }}</h1>
							<div class="listing_address">{{ listing.address }}</div>
						</div>
						<div class="listing_price ml-lg-auto">
							<span>${{ listing.price }}</span>per night
						</div>
					</div>

					<!-- Rating -->
					<div class="listing_rating">
						<div class="rating_r {{ listing.rating }}"><i></i><i></i><i></i><i></i><i></i></div>
					</div>

					<!-- Gallery -->
					<div class="listing_gallery">
						<ul class="listing_gallery_list d-flex flex-row align-items-start justify-content-between flex-wrap">
							{% for img in listing.gallery %}
							<li class="listing_gallery_item">
								<a class="colorbox" href="{{ asset('images/' ~ img) }}">
									<img src="{{ asset('images/' ~ img) }}" alt="">
								</a>
							</li>
							{% endfor %}
						</ul>
					</div>

					<!-- Description -->
					<div class="listing_description">
						<div class="listing_section_title">Description</div>
						<p>{{ listing.description }}</p>
					</div>

					<!-- Amenities -->
					<div class="listing_features">
						<div class="listing_section_title">Amenities</div>
						<ul class="listing_features_list d-flex flex-row align-items-start justify-content-start flex-wrap">
							{% for amenity in listing.amenities %}
							<li class="listing_feature_item">
								<i class="fa fa-check"></i>{{ amenity }}
							</li>
							{% endfor %}
						</ul>
					</div>

					<!-- Map -->
					<div class="listing_map">
						<div class="listing_section_title">Location</div>
						<div id="listing_map" class="listing_map_container"></div>
					</div>

					<!-- Reviews -->
					<div class="listing_reviews">
						<div class="listing_section_title">Reviews</div>

						{% set reviews = reviews is defined ? reviews : [
							{image: 'test_1.jpg', name: 'Carla Smith', date: 'May 24, 2017', rating: 'rating_4', text: 'Nullam eu convallis tortor. Suspendisse potenti. In faucibus massa arcu, vitae cursus mi hendrerit nec.'},
							{image: 'test_2.jpg', name: 'John Doe', date: 'June 12, 2017', rating: 'rating_5', text: 'Nullam eu convallis tortor. Suspendisse potenti. In faucibus massa arcu, vitae cursus mi hendrerit nec.'}
						] %}

						{% for review in reviews %}
						<div class="review_item d-flex flex-row">
							<div class="review_image"><img src="{{ asset('images/' ~ review.image) }}" alt=""></div>
							<div class="review_content">
								<div class="review_info d-flex flex-row">
									<div class="review_name">{{ review.name }}</div>
									<div class="review_date ml-auto">{{ review.date }}</div>
								</div>
								<div class="rating_r {{ review.rating }}"><i></i><i></i><i></i><i></i><i></i></div>
								<p class="review_text">{{ review.text }}</p>
							</div>
						</div>
						{% endfor %}

						<!-- Add Review Form -->
						<div class="add_review">
							<div class="listing_section_title">Add a Review</div>
							<form action="#" class="add_review_form">
								<input type="text" class="input_field review_name_input" placeholder="Your Name" required>
								<input type="email" class="input_field review_email_input" placeholder="Your Email" required>
								<div class="review_rating_title">Your Rating</div>
								<div class="review_rating_container">
									<div class="review_stars">
										<i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i>
									</div>
								</div>
								<textarea class="text_field review_text_input" rows="5" placeholder="Your Review" required></textarea>
								<button type="submit" class="button review_submit_button">submit review<span></span><span></span><span></span></button>
							</form>
						</div>

					</div>

				</div>

				<!-- Sidebar -->
				<div class="col-lg-3 offset-lg-1 sidebar_col">

					<!-- Book Now Widget -->
					<div class="sidebar_booking">
						<div class="sidebar_booking_title">Book Now</div>
						<form action="#" class="sidebar_booking_form">
							<div class="sidebar_booking_item">
								<div>check in</div>
								<input type="text" class="check_in search_input" placeholder="YYYY-MM-DD">
							</div>
							<div class="sidebar_booking_item">
								<div>check out</div>
								<input type="text" class="check_out search_input" placeholder="YYYY-MM-DD">
							</div>
							<div class="sidebar_booking_item">
								<div>adults</div>
								<select name="adults" class="dropdown_item_select search_input">
									<option>01</option><option>02</option><option>03</option>
								</select>
							</div>
							<div class="sidebar_booking_item">
								<div>children</div>
								<select name="children" class="dropdown_item_select search_input">
									<option>0</option><option>02</option><option>03</option>
								</select>
							</div>
							<button type="submit" class="button booking_button">book now<span></span><span></span><span></span></button>
						</form>
					</div>

					<!-- Sidebar Latest Posts -->
					<div class="sidebar_latest_posts">
						<div class="sidebar_title">Latest Posts</div>
						<div class="latest_posts_container">
							<ul>
								{% set latest_posts = latest_posts is defined ? latest_posts : [
									{image: 'latest_1.jpg', title: 'A simple blog post', author: 'Jane Smith', date: 'Aug 25, 2016'},
									{image: 'latest_2.jpg', title: 'Dream destination for you', author: 'Jane Smith', date: 'Aug 25, 2016'},
									{image: 'latest_3.jpg', title: 'Tips to travel light', author: 'Jane Smith', date: 'Aug 25, 2016'}
								] %}
								{% for lpost in latest_posts %}
								<li class="latest_post clearfix">
									<div class="latest_post_image"><a href="#"><img src="{{ asset('images/' ~ lpost.image) }}" alt=""></a></div>
									<div class="latest_post_content">
										<div class="latest_post_title trans_200"><a href="#">{{ lpost.title }}</a></div>
										<div class="latest_post_meta">
											<div class="latest_post_author trans_200"><a href="#">by {{ lpost.author }}</a></div>
											<div class="latest_post_date trans_200"><a href="#">{{ lpost.date }}</a></div>
										</div>
									</div>
								</li>
								{% endfor %}
							</ul>
						</div>
					</div>

					<!-- Sidebar Tags -->
					<div class="sidebar_tags">
						<div class="sidebar_title">Tags</div>
						<ul class="tags_list clearfix">
							<li class="tag_item"><a href="#">design</a></li>
							<li class="tag_item"><a href="#">fashion</a></li>
							<li class="tag_item"><a href="#">travel</a></li>
							<li class="tag_item"><a href="#">adventure</a></li>
							<li class="tag_item"><a href="#">photography</a></li>
						</ul>
					</div>

				</div>

			</div>
		</div>

	</div>

{% endblock %}

{% block javascripts %}
<script src="{{ asset('plugins/parallax/parallax.min.js') }}"></script>
<script src="{{ asset('plugins/colorbox/jquery.colorbox-min.js') }}"></script>
{% endblock %}
