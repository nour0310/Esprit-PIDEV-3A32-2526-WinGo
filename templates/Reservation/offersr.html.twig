<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/tippy.js@6"></script>
{{ parent() }} 
    
    <script>
        function toggleChat() {
            const chatPopup = document.getElementById('chat-popup');
            const badge = document.getElementById('chat-badge'); 
            
            if (chatPopup.classList.contains('d-none')) {
                chatPopup.classList.remove('d-none');
                chatPopup.style.display = 'flex'; 
                
                if(badge) badge.style.display = 'none'; 
                console.log("Chat Opened"); 
            } else {
                chatPopup.classList.add('d-none');
                chatPopup.style.display = 'none';
                console.log("Chat Closed");
            }
        }

        // On cible les VRAIS éléments de ton chat
        const sendBtn = document.getElementById('send-btn');
        const userInput = document.getElementById('user-input');

        // On vérifie qu'ils existent TOUS LES DEUX sur cette page avant d'ajouter les événements
        if (sendBtn && userInput) {
            
            sendBtn.addEventListener('click', async () => {
                const content = document.getElementById('chat-content');
                const message = userInput.value.trim();

                if (!message) return;

                content.innerHTML += `<div class="user-msg">${message}</div>`;
                
                userInput.value = '';
                content.scrollTop = content.scrollHeight;

                const typingId = 'typing-' + Date.now();
                content.innerHTML += `<div class="ai-msg" id="${typingId}">...</div>`;
                content.scrollTop = content.scrollHeight;

                try {
                    const response = await fetch("{{ path('app_chat_ask') }}", {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `message=${encodeURIComponent(message)}`
                    });

                    const data = await response.json();
                    
                    const typingElement = document.getElementById(typingId);
                    if(typingElement) typingElement.remove();
                    
                    content.innerHTML += `<div class="ai-msg">${data.response}</div>`;
                    content.scrollTop = content.scrollHeight;

                } catch (e) {
                    const typingElement = document.getElementById(typingId);
                    if(typingElement) {
                        typingElement.innerText = "Désolé, j'ai rencontré un problème de connexion.";
                    }
                }
            });

            // On protège AUSSI l'événement de la touche "Entrée" !
            userInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    sendBtn.click();
                }
            });
            
