            </div>
        {% else %}
            <div class="text-center text-muted my-5">
                <i class="fa fa-history fa-3x mb-3" style="opacity: 0.2;"></i>
                <p class="font-italic">Aucun historique disponible pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
