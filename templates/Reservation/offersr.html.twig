    <script>
document.addEventListener('DOMContentLoaded', function() {
    const widgets = document.querySelectorAll('.weather-widget');

    widgets.forEach(async (widget) => {
        let city = widget.getAttribute('data-city');
        const infoDiv = widget.querySelector('.weather-info');
        const loadingSpinner = widget.querySelector('.loading-icon');

        if (!city || city.length < 3) {
            city = "Tunis";
        }

        try {
            const baseUrl = "{{ path('api_weather', {'city': 'PLACEHOLDER'}) }}";
            const finalUrl = baseUrl.replace('PLACEHOLDER', encodeURIComponent(city));

            const response = await fetch(finalUrl);
            
            if (!response.ok) throw new Error("Server returned " + response.status);

            const data = await response.json();
            if (data.error) throw new Error(data.error);

            widget.querySelector('.w-icon').src = `https://openweathermap.org/img/wn/${data.icon}.png`;
            widget.querySelector('.w-temp').innerText = `${Math.round(data.temp)}°C`;
            widget.querySelector('.w-desc').innerText = data.desc;

            loadingSpinner.classList.add('d-none');
            infoDiv.classList.remove('d-none');
            infoDiv.classList.add('d-flex'); 

        } catch (e) {
            console.error("Weather Widget Error for " + city + ":", e);
            loadingSpinner.classList.add('d-none');
            widget.innerHTML = '<small class="text-muted"><i class="fa fa-map-marker"></i> Météo N/A</small>';
        }
    });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des clics sur les étoiles
    document.querySelectorAll('.inline-clickable-star').forEach(star => {
        star.addEventListener('click', function(e) {
            e.stopPropagation();

            const val = this.getAttribute('data-value');
            const resId = this.getAttribute('data-id');
            const container = document.getElementById('stars-container-' + resId);
            const form = document.getElementById('form-' + resId);
            const inputStar = document.getElementById('input-star-' + resId);

            if (!container) return;

            // Mise à jour visuelle
            container.querySelectorAll('.fa-star').forEach(s => {
                s.style.color = (parseInt(s.getAttribute('data-value')) <= val) ? '#fa9e1b' : '#eee';
            });

            if (inputStar) inputStar.value = val;

            // 🔔 JOUER LE SON (fichier local)
            const audio = new Audio('/sounds/star.mp3');
            audio.volume = 0.5;
            audio.play().catch(err => {
                console.warn('Son bloqué :', err.message);
                // Notification discrète
                const toast = document.createElement('div');
                toast.textContent = '🔇 Son indisponible';
                toast.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#333;color:#fff;padding:8px 16px;border-radius:20px;z-index:9999;';
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 2000);
            });

            // Afficher le formulaire
            if (form) form.style.display = 'block';

            // Sauvegarde AJAX
            fetch(`/reservation/rate/${resId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: `stars=${val}`
            })
            .then(response => response.json())
            .then(data => console.log('Stars saved:', data))
            .catch(err => console.error('Error saving stars:', err));
        });
    });

    // Soumission du formulaire de commentaire en AJAX (inchangé)
    document.querySelectorAll('form[id^="form-"]').forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                alert('Merci ! Votre avis a été enregistré.');
                this.style.opacity = '0.7';
            })
            //.catch(err => alert('Erreur lors de l\'enregistrement.'));
        });
    });
});
</script>

