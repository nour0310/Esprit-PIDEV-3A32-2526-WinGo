{% extends 'base.html.twig' %}

{% block title %}Offers - Travelix{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/offers_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/offers_responsive.css') }}">
{% endblock %}

{% block content %}

    <div class="home" style="width: 100%; height: 60vh; position: relative;">
        <div class="home_background" style="background-image: url('{{ asset('images/about_background.jpg') }}'); background-size: cover; background-position: center; width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 1;"></div>
        <div class="home_content" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2; width: 100%; text-align: center;">
            <div class="home_title" style="color: #FFFFFF; font-size: 72px; font-weight: 800; text-transform: uppercase;">our offers</div>
        </div>
    </div>

    <div class="offers">

        <div class="container text-center mb-5" style="margin-top: -60px; position: relative; z-index: 100;">
    <div class="d-flex flex-column align-items-center">
        <button class="btn btn-warning shadow-lg px-5 py-3 mb-3" 
                type="button" 
                data-toggle="collapse" 
                data-target="#mon_formulaire" {# FIXED: Matched ID below #}
                aria-expanded="{{ editMode ? 'true' : 'false' }}" 
                style="border-radius: 50px; font-weight: 700; color: white; letter-spacing: 1px; border: none; background: #fa9e1b;">
            <i class="fa fa-plus-circle mr-2"></i> {{ editMode ? 'MODIFIER LA RÉSERVATION' : 'AJOUTER UNE RÉSERVATION' }}
        </button>

        <a href="{{ path('app_front_offers') }}" class="jump-link text-muted small font-weight-bold" style="text-decoration: none; transition: 0.3s; letter-spacing: 0.5px;">
            <i class="fa fa-bus mr-1"></i> VOIR LES OFFRES DE TRANSPORT <i class="fa fa-chevron-right ml-1" style="font-size: 10px;"></i>
        </a>
    </div>
    {# --- SECTION FIDÉLITÉ GLOBALE (HORS DES CARTES) --- #}
{% if app.user %}
<div class="container mt-4 mb-5">
    <div class="wingo-global-journey p-4 shadow-sm" style="background: white; border-radius: 20px; border-left: 5px solid #fa9e1b;">
        <div class="d-flex align-items-center mb-3">
            <div class="user-avatar-glow mr-3">
                <i class="fa fa-user-circle fa-3x text-warning"></i>
            </div>
            <div>
                <h4 class="mb-0">Bonjour, {{ app.user.nom }} !</h4>
                <p class="text-muted mb-0">Suivez votre progression vers le statut <strong>GOLD</strong></p>
            </div>
            <div class="ml-auto text-right">
                <span class="badge badge-pill p-2 px-3" style="background: #fff3e0; color: #e65100;">
                    <i class="fa fa-ticket-alt"></i> {{ userCount }} Réservations cette année
                </span>
            </div>
        </div>

        {# LA LIFELINE ANIMÉE #}
        <div class="position-relative py-4">
            <div class="progress" style="height: 12px; border-radius: 10px; background-color: #eee;">
                <div id="global-lifeline" 
                     class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" 
                     style="width: 0%; background: linear-gradient(90deg, #cd7f32, #c0c0c0, #ffd700); border-radius: 10px;" 
                     data-progress="{{ (userCount / 10 * 100) > 100 ? 100 : (userCount / 10 * 100) }}">
                </div>
            </div>

            {# MARQUEURS DE JALONS #}
            <div class="milestone" style="left: 0%;">
                <div class="milestone-dot reached"><i class="fa fa-star"></i></div>
                <span class="milestone-label">Bronze</span>
            </div>
            <div class="milestone" style="left: 50%;">
                <div class="milestone-dot {{ userCount >= 5 ? 'reached' : '' }}"><i class="fa fa-medal"></i></div>
                <span class="milestone-label">Silver</span>
            </div>
            <div class="milestone" style="right: 0%;">
                <div class="milestone-dot {{ userCount >= 10 ? 'reached' : '' }}"><i class="fa fa-trophy"></i></div>
                <span class="milestone-label">Gold</span>
            </div>
        </div>

        <div class="mt-4 text-center">
            {% if userCount < 5 %}
                <p class="mb-0">Encore <span class="badge badge-warning">{{ 5 - userCount }}</span> réservations pour débloquer les <strong>-15% Silver</strong> !</p>
            {% elseif userCount < 10 %}
                <p class="mb-0 text-secondary">✨ Vous êtes Silver ! Plus que <span class="badge badge-secondary">{{ 10 - userCount }}</span> voyages pour le <strong>CADEAU GOLD</strong> !</p>
            {% else %}
                <p class="mb-0 text-success">🏆 <strong>FÉLICITATIONS !</strong> Vous êtes membre GOLD. Profitez de vos trajets gratuits !</p>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}


    <div class="collapse {{ editMode ? 'show' : '' }} mt-4" id="mon_formulaire">
        <div class="card card-body border-0 shadow-lg p-4 p-md-5" style="border-radius: 30px; background: #ffffff;">
            <h4 class="mb-4 text-dark font-weight-bold" style="letter-spacing: -0.5px;">Détails de la Réservation</h4>
            
            {{ form_start(f, {
    'attr': {'class': 'row align-items-end'},
    'action': editMode ? path('updateReservation', {'id': app.request.get('id')}) : path('app_front_reservations')
}) }}
                <div class="col-md-3 mb-3 text-left">
                    <label class="small font-weight-bold text-uppercase text-muted ml-2">Client</label>
                    {{ form_widget(f.user, {'attr': {'class': 'form-control modern-input'}}) }}
                </div>
                <div class="col-md-3 mb-3 text-left">
                    <label class="small font-weight-bold text-uppercase text-muted ml-2">Statut</label>
                    {{ form_widget(f.statut, {'attr': {'class': 'form-control modern-input'}}) }}
                </div>
                <div class="col-md-3 mb-3 text-left">
                    <label class="small font-weight-bold text-uppercase text-muted ml-2">Expérience</label>
                    {{ form_widget(f.exp, {'attr': {'class': 'form-control modern-input'}}) }}
                </div>
                <div class="col-md-3 mb-3 text-left">
                    <label class="small font-weight-bold text-uppercase text-muted ml-2">Date</label>
                    <div class="modern-input-date-wrapper">
                         {{ form_widget(f.date) }}
                    </div>
                </div>
                <div class="form-group mb-3">
    <label>Code Promo (Optionnel)</label>
    <input type="text" name="promo_code_input" class="form-control" placeholder="Entrez votre code GOLD ici">
</div>
                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-dark px-5 py-3" style="border-radius: 50px; font-weight: 600; background: #2d2c2c;">
                        {{ editMode ? 'METTRE À JOUR' : 'CONFIRMER L\'AJOUT' }}
                    </button>
                    {% if editMode %}
                        <a href="{{ path('app_front_reservations') }}" class="btn btn-link text-muted ml-2">Annuler</a>
                    {% endif %}
                </div>
                <div style="display:none;">{{ form_rest(f) }}</div>
            {{ form_end(f) }}
        </div>
    </div>
</div>

        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="offers_sorting_container d-flex flex-row align-items-end justify-content-start">
                        <div class="sorting_item" style="margin-right: 30px; margin-bottom: 5px;">
                            <form action="{{ path('app_front_reservations') }}" method="get">
                                <input type="text" name="search" value="{{ searchTerm|default('') }}" placeholder="Rechercher par client/statut..." 
                                       style="height: 40px; border: 1px solid #ededed; padding-left: 15px; border-radius: 5px; width: 250px;">
                            </form>
                        </div>

                        <ul class="offers_sorting">
                            <li>
                                <span class="sorting_text">date</span>
                                <i class="fa fa-chevron-down"></i>
                                <ul>
                                    <li><a href="{{ path('app_front_reservations', {sort: 'date_desc', search: searchTerm|default('')}) }}">Newest First</a></li>
                                    <li><a href="{{ path('app_front_reservations', {sort: 'date_asc', search: searchTerm|default('')}) }}">Oldest First</a></li>
                                </ul>
                            </li>
                        </ul>
                    </div>

                    {# --- 1. RÉSERVATIONS EN COURS --- #}
                    <h3 class="mb-4 mt-4" style="font-weight: 800; color: #2d2c2c; text-transform: uppercase;">
                        <i class="fa fa-clock-o text-warning mr-2"></i> Réservations en cours
                    </h3>
                    
                    <div class="offers_grid mb-5">
                        <div class="row">
                            {% for reservation in list %}
                                {% set img_index = (loop.index0 % 4) + 1 %}
                                
                                <div class="col-lg-4 col-md-6 mb-5">
                                    <div class="card h-100 border-0 shadow-sm custom-reservation-card" style="overflow: visible; position: relative; border-radius: 20px;">
                                        
                                        <div class="star-rating-badge" style="position: absolute; top: -10px; right: -10px; z-index: 100; width: 65px; height: 65px; background: #FFD100; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 4px 8px rgba(0,0,0,0.2);">
    <div style="font-weight: 900; color: #000; font-size: 1rem; line-height: 1; margin-top: 2px;">
        {{ reservation.dynamicRating|default(5.0)|number_format(1) }}
    </div>
    <div style="font-size: 0.5rem; font-weight: 700; color: #000; text-transform: uppercase;">/ 5</div>
</div>

                                        <div class="position-relative overflow-hidden" style="height: 200px; border-radius: 20px 20px 0 0;">
                                            <img src="{{ asset('images/offer_' ~ img_index ~ '.jpg') }}" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="offer">
                                            <div class="badge position-absolute" style="top: 15px; left: 15px; background: #fa9e1b; color: white; padding: 8px 15px; font-weight: 700; text-transform: uppercase; border-radius: 20px; font-size: 11px;">
                                                {{ reservation.statut }}
                                            </div>
                                        </div>

                                        <div class="card-body d-flex flex-column" style="background: white; border-radius: 0 0 20px 20px;">
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <h5 class="card-title font-weight-bold mb-0 text-dark" style="text-transform: capitalize;">
                                                    <i class="fa fa-map-marker mr-2" style="color: #fa9e1b;"></i> {{ reservation.exp }}
                                                </h5>
                                                
                                                {# --- AFFICHAGE DU PRIX --- #}
                                                <div class="d-flex align-items-center">
    {% if reservation.price < reservation.basePriceDisplay %}
        {# Le client a eu une réduction : on affiche l'ancien prix barré en rouge #}
        <span class="text-danger mr-2" style="text-decoration: line-through; font-size: 0.9rem; font-weight: bold;">
            {{ reservation.basePriceDisplay }} DT
        </span>
        {# Et le nouveau prix en orange avec une icône cadeau #}
        <span class="badge badge-pill text-white" style="background-color: #ff9800; font-size: 1.1rem; padding: 8px 12px;">
            <i class="fa fa-gift mr-1"></i> {{ reservation.price }} DT
        </span>
    {% else %}
        {# Pas de réduction : affichage normal #}
        <span class="badge badge-pill text-white" style="background-color: #ff9800; font-size: 1.1rem; padding: 8px 12px;">
            {{ reservation.price }} DT
        </span>
    {% endif %}
</div>
                                            </div>

                                            <div class="reservation-info text-muted mb-4" style="font-size: 14px; line-height: 1.8;">
                                                <p class="mb-1" style="font-weight: 600; color: #fa9e1b;">
                                                    Basé sur {{ reservation.totalReviews|default(0) }} avis
                                                </p>
                                                <h5 class="card-title">
    <i class="fa fa-user" style="color: #fa9e1b;"></i> 
    {{ reservation.user_id.nom|default('Anonyme') }}
    
    {# --- L'icône de badge sur le côté --- #}
    {% if reservation.clientStatus == 'Gold' %}
        <i class="fa fa-trophy" style="color: #ffd700;" title="Membre Gold"></i>
    {% elseif reservation.clientStatus == 'Silver' %}
        <i class="fa fa-medal" style="color: #c0c0c0;" title="Membre Silver"></i>
    {% else %}
        <i class="fa fa-star" style="color: #cd7f32;" title="Membre Bronze"></i>
    {% endif %}
</h5>

{# --- La barre de progression (Journey) --- #}
<div class="small text-muted mb-2">
    {% if reservation.clientStatus == 'Gold' %}
        <span class="text-warning">🏆 Expert Wingo ({{ reservation.userReservationCount }} résas)</span>
    {% elseif reservation.clientStatus == 'Silver' %}
        <span>🥈 Silver Journey: {{ reservation.userReservationCount }}/10 pour Gold</span>
    {% else %}
        <span>🥉 Bronze Journey: {{ reservation.userReservationCount }}/5 pour Silver</span>
    {% endif %}
</div>
                                                <div class="d-flex align-items-center">
                                                    <i class="fa fa-calendar mr-2 text-warning"></i> <strong>Date:</strong> <span class="ml-1">{{ reservation.date ? reservation.date|date('d M Y') : 'N/A' }}</span>
                                                </div>
                                                
                                                <div class="weather-widget mt-3 pt-2 border-top" data-city="{{ reservation.exp }}">
                                                    <div class="spinner-border spinner-border-sm text-warning loading-icon" role="status"></div>
                                                    <div class="weather-info d-none d-flex align-items-center">
                                                        <img src="" class="w-icon" style="width: 35px; margin-right: 5px;">
                                                        <span class="w-temp font-weight-bold text-dark mr-2">--°C</span>
                                                        <small class="w-desc text-muted text-capitalize"></small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                                {% set isOwner = app.user and reservation.user_id and reservation.user_id.id == app.user.id %}
                                                {% set isAdmin = is_granted('ROLE_ADMIN') %}

                                                {% if isOwner or isAdmin %}
                                                    <a href="{{ path('updateReservation', {'id': reservation.id}) }}#mon_formulaire" class="btn btn-outline-warning btn-sm px-3 font-weight-bold" style="border-radius: 15px;">
                                                        MODIFIER
                                                    </a>
                                                    <a href="{{ path('deleteReservation', {'id': reservation.id}) }}" onclick="return confirm('Supprimer ?');" class="text-danger small">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                {% else %}
                                                    <span class="text-muted small font-italic">Lecture seule</span>
                                                {% endif %}
                                            </div>
                                            
                                            <div class="mt-3 pt-3 border-top text-center">
                                                <span class="small font-weight-bold text-muted d-block mb-2 text-uppercase">
                                                    {{ reservation.stars is not null ? 'Votre note' : 'Notez ce voyage' }}
                                                </span>
                                                
                                                <div class="rating-stars mb-2" id="stars-container-{{ reservation.id }}">
                                                    {% for i in 1..5 %}
                                                        <i class="fa fa-star inline-clickable-star" 
                                                        data-value="{{ i }}" 
                                                        data-id="{{ reservation.id }}"
                                                        style="font-size: 28px; cursor: pointer; color: {{ reservation.stars >= i ? '#fa9e1b' : '#eee' }}; margin: 0 3px; transition: 0.2s;"></i>
                                                    {% endfor %}
                                                </div>

                                                <form action="{{ path('app_reservation_rate', {'id': reservation.id}) }}" method="POST" id="form-{{ reservation.id }}" style="display: {{ reservation.stars is not null ? 'block' : 'none' }};">
                                                    <input type="hidden" name="stars" id="input-star-{{ reservation.id }}" value="{{ reservation.stars|default(0) }}">
                                                    <textarea name="comment" class="form-control mb-2 mt-2 shadow-sm" rows="2" placeholder="Un petit commentaire ? (Optionnel)" style="border-radius: 12px; font-size: 13px; border: 1px solid #eee; resize: none;">{{ reservation.comment }}</textarea>
                                                    <button type="submit" class="btn btn-warning btn-sm btn-block shadow-sm" style="border-radius: 20px; font-weight: 700; color: white;">
                                                        ENREGISTRER
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="col-12 text-center my-4">
                                    <p class="text-muted font-italic">Aucune réservation en cours à afficher.</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    
                </div> {# Fin col-lg-12 #}
            </div> {# Fin row #}
        </div> {# Fin container #}
                </div>
            </div>
        </div>
    </div>
    <div class="container mt-5 mb-5 text-center">
        
        <button id="toggleCalendarBtn" class="btn btn-warning mb-4 px-4 py-2 shadow-sm" style="background-color: #fa9e1b; color: white; border: none; border-radius: 20px; font-weight: bold; font-size: 1.2rem;">
            <i class="fa fa-calendar-alt mr-2"></i> Afficher Mon Planning
        </button>

        <div id="calendarContainer" style="display: none; text-align: left;">
            <div class="card border-0 shadow-lg" style="border-radius: 30px; overflow: hidden;">
                <div class="card-header bg-dark text-white p-4 border-0 text-center">
                    <h3 class="mb-0 font-weight-bold" style="letter-spacing: 1px;">
                        <i class="fa fa-calendar-alt mr-2 text-warning"></i> Mon Itinéraire de Voyage
                    </h3>
                </div>
                <div class="card-body p-4 bg-light">
                    <div id="travel-calendar" style="min-height: 600px;"></div>
                </div>
            </div>
        </div>
        
    </div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css">
