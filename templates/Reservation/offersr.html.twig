<script>
    document.addEventListener('DOMContentLoaded', function() {
        // We use 'travel-calendar' here to match your HTML
        let calendarEl = document.getElementById('travel-calendar'); 
        let calendarContainer = document.getElementById('calendarContainer');
        let toggleBtn = document.getElementById('toggleCalendarBtn');
        
        let calendar = null;

        toggleBtn.addEventListener('click', function() {
            if (calendarContainer.style.display === 'none') {
                // Show the container
                calendarContainer.style.display = 'block';
                // Change button text so they know they can click it again to close
                toggleBtn.innerHTML = '<i class="fa fa-times mr-2"></i> Masquer Mon Planning';
                
                if (!calendar) {
                    // Build the calendar the first time it opens
                    calendar = new FullCalendar.Calendar(calendarEl, {
                        initialView: 'dayGridMonth',
                        // Make sure your localization and other settings stay here!
                        locale: 'fr',
                        events: '/fc-load-events',
                    });
                    calendar.render();
                } else {
                    // Fix the size if it's opened a second time
                    calendar.updateSize();
                }
            } else {
                // Hide the container
                calendarContainer.style.display = 'none';
                // Reset button text
                toggleBtn.innerHTML = '<i class="fa fa-calendar-alt mr-2"></i> Afficher Mon Planning';
            }
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const btnOpen = document.getElementById('btn-open-history');
        const btnClose = document.getElementById('btn-close-history');
        const sidebar = document.getElementById('history-sidebar');
        const overlay = document.getElementById('history-overlay');

        // Fonction pour ouvrir le panneau
        function openSidebar() {
            sidebar.style.right = '0';
            overlay.style.visibility = 'visible';
            overlay.style.opacity = '1';
            document.body.style.overflow = 'hidden'; // Empêche le défilement de la page derrière
        }

        // Fonction pour fermer le panneau
        function closeSidebar() {
            sidebar.style.right = '-400px';
            overlay.style.visibility = 'hidden';
            overlay.style.opacity = '0';
            document.body.style.overflow = ''; // Restaure le défilement
        }

        // Écouteurs d'événements
        btnOpen.addEventListener('click', openSidebar);
        btnClose.addEventListener('click', closeSidebar);
        overlay.addEventListener('click', closeSidebar); // Ferme si on clique sur le fond sombre
    });
</script>
