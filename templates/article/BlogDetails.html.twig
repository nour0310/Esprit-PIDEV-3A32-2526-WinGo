{% extends 'base.html.twig' %}

{% block title %}{{ article.titre }} — WinGo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/responsive.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/blog_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/blog_responsive.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/wingo_blog.css') }}">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
	:root {
		--primary-color: #8d4fff;
		--accent-color: #fa9e1c;
		--text-color: #4a4a4a;
		--light-bg: #f9f9fc;
	}
	body { background-color: var(--light-bg); font-family: 'Inter', sans-serif; }
	.article-main-container {
		max-width: 900px;
		margin: 0 auto 80px; 
		padding: 40px 20px;
		position: relative;
		z-index: 10;
	}
	.article-creative-image {
		width: 100%;
		max-width: 450px;
		height: auto;
		border-radius: 20px;
		margin: 0 auto 40px auto;
		display: block;
		box-shadow: 0 10px 30px rgba(0,0,0,0.1);
		border: 4px solid #fff;
	}
	.article-header { text-align: center; margin-bottom: 40px; }
	.article-category {
		display: inline-block;
		background: rgba(250, 158, 28, 0.1);
		color: var(--accent-color);
		padding: 6px 20px;
		border-radius: 30px;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: 20px;
	}
	.article-title {
		font-family: 'Playfair Display', serif;
		font-size: 2.8rem;
		font-weight: 700;
		color: #2d3436;
		line-height: 1.3;
		margin-bottom: 20px;
	}
	.article-meta {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 20px;
		color: #888;
		font-size: 0.95rem;
		flex-wrap: wrap;
	}
	.article-meta i { margin-right: 8px; color: var(--primary-color); }
	.article-content {
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--text-color);
		text-align: justify;
	}
	.article-content p { margin-bottom: 25px; }
	.article-tags {
		display: flex;
		gap: 12px;
		margin-top: 50px;
		padding-top: 30px;
		border-top: 1px solid #f1f2f6;
		justify-content: center;
	}
	.article-tag {
		display: inline-flex;
		align-items: center;
		background: #f8f9fa;
		color: var(--primary-color);
		padding: 8px 20px;
		border-radius: 30px;
		font-size: 0.9rem;
		font-weight: 500;
		transition: all 0.3s ease;
		border: 1px solid rgba(141, 79, 255, 0.2);
	}
	.article-tag i { margin-right: 8px; }
	.article-tag:hover { background: var(--primary-color); color: #fff; }
	.article-actions {
		display: flex;
		gap: 15px;
		justify-content: center;
		margin-top: 50px;
	}
	.btn-custom {
		padding: 12px 35px;
		border-radius: 30px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		font-size: 0.95rem;
	}
	.btn-primary-gradient {
		background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
		color: #fff;
		border: none;
		box-shadow: 0 5px 15px rgba(141, 79, 255, 0.3);
	}
	.btn-primary-gradient:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 25px rgba(250, 158, 28, 0.4);
		color: #fff;
	}
	.btn-secondary-outline {
		background: #fff;
		color: var(--primary-color);
		border: 2px solid var(--primary-color);
	}
	.btn-secondary-outline:hover {
		background: var(--primary-color);
		color: #fff;
	}
	.blog-details-hero {
		background-image: url('{{ asset('images/BlogBack.jpg') }}');
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		height: 400px;
		position: relative;
		width: 100%;
		z-index: 1;
	}
	.blog-details-wrapper { padding-top: 40px; }
	.blog-details-hero-overlay {
		position: absolute;
		top: 0; left: 0; width: 100%; height: 100%;
		background: rgba(45, 52, 54, 0.6);
	}
	.hero-title-container {
		position: absolute;
		top: 50%; left: 50%;
		transform: translate(-50%, -50%);
		text-align: center;
		color: white;
		width: 100%;
		z-index: 2;
	}
	.hero-title-container h1 {
		font-family: 'Playfair Display', serif;
		font-size: 3.5rem;
		font-weight: 700;
		text-transform: capitalize;
		text-shadow: 0 2px 10px rgba(0,0,0,0.3);
		margin: 0;
	}
	@media (max-width: 768px) {
		.blog-details-hero { height: 300px; }
		.article-title { font-size: 2rem; }
		.hero-title-container h1 { font-size: 2.5rem; }
	}
	.comments-section {
		margin-top: 60px;
		padding-top: 40px;
		border-top: 2px dashed #ececec;
	}
	.comments-title {
		font-family: 'Playfair Display', serif;
		font-size: 1.8rem;
		color: #2d3436;
		margin-bottom: 30px;
		font-weight: 700;
	}
	.comment-card {
		background: #fff;
		border-radius: 16px;
		padding: 20px;
		margin-bottom: 20px;
		box-shadow: 0 5px 20px rgba(0,0,0,0.03);
		border-left: 4px solid var(--primary-color);
	}
	.comment-header {
		display: flex;
		align-items: center;
		margin-bottom: 12px;
	}
	.comment-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		font-weight: bold;
		margin-right: 15px;
	}
	.comment-author { font-weight: 600; color: #333; font-size: 1rem; }
	.comment-date { font-size: 0.8rem; color: #999; margin-left: auto; }
	.comment-body {
		color: #555;
		font-size: 0.95rem;
		line-height: 1.6;
		padding-left: 55px;
	}
	.comment-form-container {
		background: #fff;
		border-radius: 20px;
		padding: 30px;
		margin-top: 40px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
	}
	.comment-form-title {
		font-family: 'Playfair Display', serif;
		font-size: 1.5rem;
		color: #2d3436;
		margin-bottom: 20px;
		font-weight: 600;
	}
	.wingo-input {
		background-color: var(--light-bg);
		border: 2px solid transparent !important;
		border-radius: 16px !important;
		padding: 16px 20px !important;
		font-size: 1rem !important;
		color: #333 !important;
		transition: all 0.3s ease !important;
		width: 100%;
		box-shadow: none !important;
		resize: vertical;
	}
	.wingo-input:focus {
		background-color: #fff;
		border-color: var(--primary-color) !important;
		box-shadow: 0 8px 25px rgba(141, 79, 255, 0.1) !important;
		outline: none;
	}
	.btn-submit-comment {
		margin-top: 15px;
		padding: 12px 30px;
		border-radius: 25px;
		background: var(--primary-color);
		color: white;
		font-weight: 600;
		border: none;
		float: right;
		transition: all 0.3s ease;
		box-shadow: 0 4px 15px rgba(141, 79, 255, 0.3);
	}
	.btn-submit-comment:hover {
		background: var(--accent-color);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(250, 158, 28, 0.4);
	}
	.clearfix::after { content: ""; clear: both; display: table; }
	.error-text { color: #dc3545; font-size: 0.85rem; margin-top: 5px; display: block; }

	/* Styles pour l'édition inline */
	.edit-comment-form {
		display: none;
		margin-top: 15px;
		padding: 15px;
		background: #f8f9fa;
		border-radius: 12px;
	}
	.edit-comment-form textarea {
		width: 100%;
		padding: 12px;
		border-radius: 12px;
		border: 1px solid #e0e0e0;
		resize: vertical;
		font-family: inherit;
	}
	.edit-actions {
		margin-top: 10px;
		text-align: right;
	}
	.btn-save, .btn-cancel {
		padding: 6px 20px;
		border-radius: 20px;
		border: none;
		cursor: pointer;
		font-size: 0.85rem;
	}
	.btn-save {
		background: linear-gradient(135deg, #8d4fff, #fa9e1c);
		color: white;
		margin-right: 10px;
	}
	.btn-cancel {
		background: #e9ecef;
		color: #333;
	}
</style>
{% endblock %}

{% block content %}
{% set blog_img_fallback = asset('images/placeholder.svg') %}
{% set im = article.image|default('')|trim %}
{% if im is empty %}
	{% set cover_src = asset('images/placeholder.svg') %}
{% elseif im starts with 'http://' or im starts with 'https://' %}
	{% set cover_src = im %}
{% elseif im starts with '//' %}
	{% set cover_src = 'https:' ~ im %}
{% else %}
	{% set fn = im|replace({'\\':'/'})|split('/')|last %}
	{% set cover_src = asset('uploads/articles/' ~ fn) %}
{% endif %}
<div class="blog-details-hero">
	<div class="blog-details-hero-overlay"></div>
	<div class="hero-title-container">
		<h1>Article Details</h1>
	</div>
</div>

<div class="blog-details-wrapper">
    <div class="container">
    	<div class="article-main-container">

    		<div class="article-header">
    			<div class="article-category">{{ article.categorie|default('Général') }}</div>
    			<h2 class="article-title">{{ article.titre|default('Titre de l\'article') }}</h2>
    			<div class="article-meta">
    				<span><i class="fas fa-calendar-alt"></i>{{ article.datePublication ? article.datePublication|date('d F Y') : 'Aujourd\'hui' }}</span>
    				<span><i class="fas fa-user-circle"></i>{{ article.auteur ? article.auteur.prenom ~ ' ' ~ article.auteur.nom : 'Anonyme' }}</span>
    				<span><i class="fas fa-map-marker-alt"></i>{{ article.region|default('Non spécifiée') }}</span>
    			</div>
    		</div>

    		<img src="{{ cover_src }}" alt="{{ article.titre|e('html_attr') }}" class="article-creative-image" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='{{ blog_img_fallback|e('html_attr') }}';">

    		<div class="article-content">{{ article.contenu|default('<p>Le contenu de cet article est vide pour le moment.</p>')|raw }}</div>

    		<div class="article-tags">
    			<span class="article-tag"><i class="fas fa-tag"></i> {{ article.categorie|default('Général') }}</span>
    			<span class="article-tag"><i class="fas fa-map-pin"></i> {{ article.region|default('Non spécifiée') }}</span>
    		</div>

    		{# 🆕 Bloc Like pour la page de détails #}
    		<div class="article-likes-section" style="text-align: center; margin-top: 40px; padding: 20px; background: #fff; border-radius: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.02);">
                <a href="javascript:void(0);"
                   class="like-button btn-custom"
                   data-article-id="{{ article.id }}"
                   data-like-url="{{ path('app_article_like', {id: article.id}) }}"
                   data-unlike-url="{{ path('app_article_unlike', {id: article.id}) }}"
                   data-liked="{{ userLiked ? 'true' : 'false' }}"
                   title="Cliquez pour aimer ou ne plus aimer"
                   style="background: rgba(141, 79, 255, 0.1); color: var(--primary-color); border: 1px solid rgba(141, 79, 255, 0.2); box-shadow: none;">
                    <i class="{% if userLiked %}fas{% else %}far{% endif %} fa-heart like-icon" style="margin-right: 8px;"></i>
                    <span class="like-count" style="font-weight: bold;">{{ likesCount }}</span> 
                </a>
                <p style="margin-top: 15px; color: #666; font-size: 0.95rem; font-style: italic;" class="likers-text">
                    {{ likersText }}
                </p>
    		</div>

    		<div class="article-actions" style="margin-bottom: 40px;">
    			<a href="{{ path('blog') }}" class="btn-custom btn-secondary-outline">
    				<i class="fas fa-arrow-left" style="margin-right: 8px;"></i> Retour aux blogs
    			</a>
                {% if app.user and (app.user == article.auteur or is_granted('ROLE_ADMIN')) %}
    			<a href="{{ path('app_article_edit', {id: article.id}) }}" class="btn-custom btn-primary-gradient">
    				<i class="fas fa-edit" style="margin-right: 8px;"></i> Modifier l'article
    			</a>
    			{% endif %}
    		</div>

    		<div class="comments-section">
    		    <h3 class="comments-title">Commentaires ({{ article.commentaires|length }})</h3>
    		    <div class="comments-list">
    		        {% for comm in article.commentaires %}
    		            {% set commAuthorName = comm.utilisateur ? comm.utilisateur.prenom ~ ' ' ~ comm.utilisateur.nom : 'Visiteur' %}
    		            <div class="comment-card" id="comment-card-{{ comm.id }}">
    		                <div class="comment-header">
    		                    <div class="comment-avatar">{{ commAuthorName|slice(0, 1)|upper }}</div>
    		                    <div class="comment-author">{{ commAuthorName }}</div>
    		                    <div class="comment-date">{{ comm.dateCommentaire ? comm.dateCommentaire|date('d/m/Y H:i') : '' }}</div>
    		                    {% if app.user and (app.user == comm.utilisateur or is_granted('ROLE_ADMIN')) %}
    		                    <div class="comment-actions" style="margin-left: 15px;">
    		                        <a href="javascript:void(0);" onclick="showEditForm({{ comm.id }})" class="btn-edit" style="color: #8d4fff; margin-right: 8px;">
    		                            <i class="fas fa-edit"></i>
    		                        </a>
    		                        <form method="post" action="{{ path('app_commentaire_delete', {id: comm.id}) }}" style="display:inline-block; margin:0;" onsubmit="return confirm('Supprimer ce commentaire ?');">
    		                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comm.id) }}">
    		                            <button type="submit" style="color: #dc3545; background: transparent; border: none; cursor: pointer; padding: 0;"><i class="fas fa-trash-alt"></i></button>
    		                        </form>
    		                    </div>
    		                    {% endif %}
    		                </div>
    		                <div class="comment-body" id="comment-body-{{ comm.id }}">
    		                    {{ comm.contenu|nl2br }}
    		                </div>
    		                <div class="edit-comment-form" id="edit-form-{{ comm.id }}">
    		                    <textarea id="edit-text-{{ comm.id }}" rows="3">{{ comm.contenu }}</textarea>
    		                    <div class="edit-actions">
    		                        <button class="btn-save" onclick="saveComment({{ comm.id }})">Enregistrer</button>
    		                        <button class="btn-cancel" onclick="hideEditForm({{ comm.id }})">Annuler</button>
    		                    </div>
    		                </div>
    		            </div>
    		        {% else %}
    		            <p style="color: #888; font-style: italic;">Aucun commentaire pour le moment. Soyez le premier !</p>
    		        {% endfor %}
    		    </div>

    		    <div class="comment-form-container">
    		        <h4 class="comment-form-title">Laisser un commentaire</h4>
    		        {{ form_start(commentForm, {'attr': {'novalidate': 'novalidate', 'class': 'clearfix'}}) }}
    		            {{ form_widget(commentForm.contenu, {'attr': {'class': 'wingo-input', 'rows': 4, 'id': 'new-comment-content'}}) }}
    		            {{ form_errors(commentForm.contenu, {'attr': {'class': 'error-text'}}) }}
    		            <button type="submit" class="btn-submit-comment">
    		                <i class="fas fa-paper-plane" style="margin-right: 8px;"></i> Publier
    		            </button>
    		        {{ form_end(commentForm) }}
    		    </div>
    		</div>

    	</div>
    </div>
</div>

<script>
function showEditForm(commentId) {
    // Masquer tous les formulaires d'édition ouverts
    document.querySelectorAll('.edit-comment-form').forEach(form => {
        form.style.display = 'none';
    });
    const form = document.getElementById('edit-form-' + commentId);
    if (form) {
        form.style.display = 'block';
        // Scroll fluide vers ce formulaire
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

function hideEditForm(commentId) {
    const form = document.getElementById('edit-form-' + commentId);
    if (form) {
        form.style.display = 'none';
        // Remettre le texte original
        const originalText = document.getElementById('comment-body-' + commentId).innerText.replace(/\n/g, '');
        document.getElementById('edit-text-' + commentId).value = originalText;
    }
}

async function saveComment(commentId) {
    const newContent = document.getElementById('edit-text-' + commentId).value;
    if (!newContent.trim()) {
        alert('Le commentaire ne peut pas être vide.');
        return;
    }
    try {
        const response = await fetch('/commentaire/' + commentId + '/update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ contenu: newContent })
        });
        if (response.ok) {
            const data = await response.json();
            if (data.success) {
                // Mettre à jour l'affichage du commentaire
                document.getElementById('comment-body-' + commentId).innerHTML = data.contenu.replace(/\n/g, '<br>');
                hideEditForm(commentId);
            } else {
                alert('Erreur lors de la mise à jour : ' + (data.message || ''));
            }
        } else {
            alert('Erreur serveur.');
        }
    } catch (error) {
        console.error(error);
        alert('Impossible de communiquer avec le serveur.');
    }
}

// 🆕 Gestion du bouton Like sur la page de détails
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.like-button').forEach(function(button) {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            const isLiked = this.dataset.liked === 'true';
            const icon = this.querySelector('.like-icon');
            const countSpan = this.querySelector('.like-count');
            
            const url = isLiked ? this.dataset.unlikeUrl : this.dataset.likeUrl;
            
            fetch(url, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                if (!response.ok) {
                    if(response.status === 401) {
                        alert("Vous devez être connecté pour liker un article.");
                    } else {
                        alert("Une erreur s'est produite (Erreur " + response.status + ")");
                    }
                    return Promise.reject('Not OK');
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Mettre à jour l'interface (couleur du coeur)
                    if (data.liked) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        this.dataset.liked = 'true';
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        this.dataset.liked = 'false';
                    }
                    // Mettre à jour le compteur
                    countSpan.textContent = data.count;
                    
                    // Rafraichir la page légèrement pour mettre à jour la liste des noms
                    // (ou alors on recharge la page complètement, ce qui est le plus simple pour le texte)
                    window.location.reload();
                } else {
                    if(data.message) {
                        alert(data.message);
                    }
                }
            })
            .catch(error => {
                console.error('Erreur lors du traitement du like:', error);
                alert("Une erreur inattendue s'est produite. Vérifiez votre connexion.");
            });
        });
    });
});
</script>
{% endblock %}