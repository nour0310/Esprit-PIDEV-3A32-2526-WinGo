{% extends 'base.html.twig' %}

{# --- Calcul de l'URL de l'image (pour OG et affichage) --- #}
{% set blog_img_fallback = absolute_url(asset('images/placeholder.svg')) %}
{% set im = article.image|default('')|trim %}
{% if im is empty %}
    {% set cover_src = blog_img_fallback %}
    {% set cover_src_absolute = blog_img_fallback %}
{% elseif im starts with 'http://' or im starts with 'https://' %}
    {% set cover_src = im %}
    {% set cover_src_absolute = im %}
{% elseif im starts with '//' %}
    {% set cover_src = 'https:' ~ im %}
    {% set cover_src_absolute = 'https:' ~ im %}
{% else %}
    {# Utilisation de la route Symfony pour servir l'image (URL relative pour l'affichage) #}
    {% set cover_src = path('app_article_image', {'id': article.id}) %}
    {# URL absolue pour les balises Open Graph #}
    {% set cover_src_absolute = url('app_article_image', {'id': article.id}) %}
{% endif %}

{% block title %}{{ article.titre }} — WinGo{% endblock %}

{% block stylesheets %}
    {# --- Balises Open Graph pour les réseaux sociaux --- #}
    <meta property="og:title" content="{{ article.titre|striptags|e('html_attr') }}" />
    <meta property="og:description" content="{{ article.contenu|striptags|slice(0, 200)|e('html_attr') }}..." />
    <meta property="og:image" content="{{ cover_src_absolute|e('html_attr') }}" />
    <meta property="og:url" content="{{ url('app_article_show', {'id': article.id})|e('html_attr') }}" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="WinGo - Voyages en Tunisie" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('styles/responsive.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('styles/blog_styles.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('styles/blog_responsive.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('styles/wingo_blog.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #8d4fff;
            --accent-color: #fa9e1c;
            --text-color: #4a4a4a;
            --light-bg: #f9f9fc;
        }
        body { background-color: var(--light-bg); font-family: 'Inter', sans-serif; }
        .article-main-container {
            max-width: 900px;
            margin: 0 auto 80px; 
            padding: 40px 20px;
            position: relative;
            z-index: 10;
        }
        .article-creative-image {
            width: 100%;
            max-width: 450px;
            height: auto;
            border-radius: 20px;
            margin: 0 auto 40px auto;
            display: block;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 4px solid #fff;
        }
        .article-header { text-align: center; margin-bottom: 40px; }
        .article-category {
            display: inline-block;
            background: rgba(250, 158, 28, 0.1);
            color: var(--accent-color);
            padding: 6px 20px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }
        .article-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 700;
            color: #2d3436;
            line-height: 1.3;
            margin-bottom: 20px;
        }
        .article-meta {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            color: #888;
            font-size: 0.95rem;
            flex-wrap: wrap;
        }
        .article-meta i { margin-right: 8px; color: var(--primary-color); }
        .article-content {
            font-size: 1.1rem;
            line-height: 1.8;
            color: var(--text-color);
            text-align: justify;
        }
        .article-content p { margin-bottom: 25px; }
        .article-tags {
            display: flex;
            gap: 12px;
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid #f1f2f6;
            justify-content: center;
        }
        .article-tag {
            display: inline-flex;
            align-items: center;
            background: #f8f9fa;
            color: var(--primary-color);
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid rgba(141, 79, 255, 0.2);
        }
        .article-tag i { margin-right: 8px; }
        .article-tag:hover { background: var(--primary-color); color: #fff; }
        .article-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 50px;
        }
        .btn-custom {
            padding: 12px 35px;
            border-radius: 30px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            font-size: 0.95rem;
        }
        .btn-primary-gradient {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            color: #fff;
            border: none;
            box-shadow: 0 5px 15px rgba(141, 79, 255, 0.3);
        }
        .btn-primary-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(250, 158, 28, 0.4);
            color: #fff;
        }
        .btn-secondary-outline {
            background: #fff;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
        }
        .btn-secondary-outline:hover {
            background: var(--primary-color);
            color: #fff;
        }
        .share-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 20px 0;
            flex-wrap: wrap;
        }
        .share-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            padding: 10px 15px;
            border-radius: 30px;
            cursor: pointer;
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .share-btn i { font-size: 18px; }
        .share-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
        }
        .share-btn-whatsapp { background-color: #25D366; }
        .share-btn-facebook { background-color: #4267B2; }
        .share-btn-instagram {
            background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
        }
        .article-summary-box {
            display: none;
            margin: 24px 0 8px;
            padding: 20px 22px;
            background: #fff;
            border-radius: 16px;
            border: 1px solid rgba(141, 79, 255, 0.2);
            box-shadow: 0 8px 28px rgba(141, 79, 255, 0.08);
        }
        .article-summary-box.is-visible { display: block; }
        .article-summary-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: #2d3436;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .article-summary-title i { color: var(--primary-color); }
        .article-summary-text {
            font-size: 1rem;
            line-height: 1.75;
            color: #555;
            text-align: justify;
            margin: 0;
        }
        .blog-details-hero {
            background-image: url('{{ asset('images/BlogBack.jpg') }}');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            height: 400px;
            position: relative;
            width: 100%;
            z-index: 1;
        }
        .blog-details-wrapper { padding-top: 40px; }
        .blog-details-hero-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(45, 52, 54, 0.6);
        }
        .hero-title-container {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: white;
            width: 100%;
            z-index: 2;
        }
        .hero-title-container h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 700;
            text-transform: capitalize;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            margin: 0;
        }
        @media (max-width: 768px) {
            .blog-details-hero { height: 300px; }
            .article-title { font-size: 2rem; }
            .hero-title-container h1 { font-size: 2.5rem; }
        }
        .comments-section {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 2px dashed #ececec;
        }
        .comments-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: #2d3436;
            margin-bottom: 30px;
            font-weight: 700;
        }
        .comment-card {
            background: #fff;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            border-left: 4px solid var(--primary-color);
        }
        .comment-header {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }
        .comment-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-right: 15px;
        }
        .comment-author { font-weight: 600; color: #333; font-size: 1rem; }
        .comment-date { font-size: 0.8rem; color: #999; margin-left: auto; }
        .comment-body {
            color: #555;
            font-size: 0.95rem;
            line-height: 1.6;
            padding-left: 55px;
        }
        .comment-form-container {
            background: #fff;
            border-radius: 20px;
            padding: 30px;
            margin-top: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .comment-form-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: #2d3436;
            margin-bottom: 20px;
            font-weight: 600;
        }
        .wingo-input {
            background-color: var(--light-bg);
            border: 2px solid transparent !important;
            border-radius: 16px !important;
            padding: 16px 20px !important;
            font-size: 1rem !important;
            color: #333 !important;
            transition: all 0.3s ease !important;
            width: 100%;
            box-shadow: none !important;
            resize: vertical;
        }
        .wingo-input:focus {
            background-color: #fff;
            border-color: var(--primary-color) !important;
            box-shadow: 0 8px 25px rgba(141, 79, 255, 0.1) !important;
            outline: none;
        }
        .btn-submit-comment {
            margin-top: 15px;
            padding: 12px 30px;
            border-radius: 25px;
            background: var(--primary-color);
            color: white;
            font-weight: 600;
            border: none;
            float: right;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(141, 79, 255, 0.3);
        }
        .btn-submit-comment:hover {
            background: var(--accent-color);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(250, 158, 28, 0.4);
        }
        .clearfix::after { content: ""; clear: both; display: table; }
        .error-text { color: #dc3545; font-size: 0.85rem; margin-top: 8px; display: block; font-weight: 500; }
        .error-text ul { margin: 0; padding: 0; list-style: none; }

        .edit-comment-form {
            display: none;
            margin-top: 15px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 12px;
        }
        .edit-comment-form textarea {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            border: 1px solid #e0e0e0;
            resize: vertical;
            font-family: inherit;
        }
        .edit-actions {
            margin-top: 10px;
            text-align: right;
        }
        .btn-save, .btn-cancel {
            padding: 6px 20px;
            border-radius: 20px;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .btn-save {
            background: linear-gradient(135deg, #8d4fff, #fa9e1c);
            color: white;
            margin-right: 10px;
        }
        .btn-cancel {
            background: #e9ecef;
            color: #333;
        }
        .pagination-container nav {
            display: flex;
            justify-content: center;
        }
        .pagination {
            display: flex;
            gap: 8px;
            list-style: none;
            padding: 0;
        }
        .pagination .page-item .page-link {
            background: #fff;
            color: #8d4fff;
            border: 1px solid rgba(141, 79, 255, 0.2);
            border-radius: 8px;
            padding: 8px 14px;
            text-decoration: none;
        }
        .pagination .page-item.active .page-link {
            background: linear-gradient(135deg, #8d4fff, #fa9e1c);
            color: #fff;
            border-color: transparent;
        }
    </style>
{% endblock %}

{% macro comment_tree(comment, article, commentForm, app) %}
    {% set commAuthorName = comment.utilisateur ? comment.utilisateur.prenom ~ ' ' ~ comment.utilisateur.nom : 'Visiteur' %}
    <div class="comment-card" id="comment-card-{{ comment.id }}" style="border-left: {{ comment.parent ? '3px solid #fa9e1c' : '4px solid var(--primary-color)' }};">
        <div class="comment-header">
            <div class="comment-avatar" style="{{ comment.parent ? 'width: 30px; height: 30px; font-size: 0.8rem;' : '' }}">{{ commAuthorName|slice(0, 1)|upper }}</div>
            <div class="comment-author">{{ commAuthorName }}</div>
            <div class="comment-date">{{ comment.dateCommentaire ? comment.dateCommentaire|date('d/m/Y H:i') : '' }}</div>
            
            {% if app.user %}
            <div style="margin-left: auto;">
                <a href="javascript:void(0);" onclick="showReplyForm({{ comment.id }})" style="color: #8d4fff; font-size: 0.9rem; text-decoration: none; margin-right: 15px;">
                    <i class="fas fa-reply"></i> Répondre
                </a>
            </div>
            {% endif %}

            {% if app.user and (app.user == comment.utilisateur or is_granted('ROLE_ADMIN')) %}
            <div class="comment-actions" style="{{ not app.user ? 'margin-left: auto;' : '' }}">
                <a href="javascript:void(0);" onclick="showEditForm({{ comment.id }})" class="btn-edit" style="color: #8d4fff; margin-right: 8px;">
                    <i class="fas fa-edit"></i>
                </a>
                <form method="post" action="{{ path('app_commentaire_delete', {id: comment.id}) }}" style="display:inline-block; margin:0;" onsubmit="return confirm('Supprimer ce commentaire ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                    <button type="submit" style="color: #dc3545; background: transparent; border: none; cursor: pointer; padding: 0;"><i class="fas fa-trash-alt"></i></button>
                </form>
            </div>
            {% endif %}
        </div>
        <div class="comment-body" id="comment-body-{{ comment.id }}">
            {{ comment.contenu|censor|raw }}
        </div>

        <div class="comment-sentiment" id="sentiment-{{ comment.id }}" style="margin-left: 55px; margin-top: 5px;">
            <span class="badge bg-secondary">⏳ Analyse...</span>
        </div>
        <script>
            (function() {
                const container = document.getElementById('sentiment-{{ comment.id }}');
                if (!container) return;

                fetch('{{ path('app_commentaire_sentiment', {id: comment.id}) }}')
                    .then(response => response.json())
                    .then(data => {
                        let badgeClass = '';
                        if (data.class === 'success') badgeClass = 'bg-success';
                        else if (data.class === 'danger') badgeClass = 'bg-danger';
                        else badgeClass = 'bg-secondary';
                        
                        if(data.emoji && data.text) {
                            container.innerHTML = `<span class="badge ${badgeClass}">${data.emoji} ${data.text}</span>`;
                        } else {
                            container.innerHTML = `<span class="badge bg-secondary">${data.label || 'Inconnu'}</span>`;
                        }
                    })
                    .catch(() => {
                        container.innerHTML = '<span class="badge bg-secondary">❌ Erreur</span>';
                    });
            })();
        </script>
        <div class="edit-comment-form" id="edit-form-{{ comment.id }}">
            <textarea id="edit-text-{{ comment.id }}" rows="3">{{ comment.contenu }}</textarea>
            <div class="edit-actions">
                <button class="btn-save" onclick="saveComment({{ comment.id }})">Enregistrer</button>
                <button class="btn-cancel" onclick="hideEditForm({{ comment.id }})">Annuler</button>
            </div>
        </div>

        <div class="reply-form-container" id="reply-form-{{ comment.id }}" style="display: none; margin-top: 15px; padding-left: 20px;">
            <form method="post" action="{{ path('app_article_show', {id: article.id}) }}">
                <textarea name="commentaire[contenu]" class="wingo-input" rows="3" placeholder="Tapez votre réponse ici..." required></textarea>
                <input type="hidden" name="commentaire[parent_id]" value="{{ comment.id }}">
                {% if commentForm._token is defined %}
                <input type="hidden" name="commentaire[_token]" value="{{ commentForm._token.vars.value }}">
                {% endif %}
                <div style="text-align: right; margin-top: 10px;">
                    <button type="button" class="btn-cancel" onclick="hideReplyForm({{ comment.id }})" style="margin-right: 10px;">Annuler</button>
                    <button type="submit" class="btn-save"><i class="fas fa-paper-plane"></i> Répondre</button>
                </div>
            </form>
        </div>
    </div>

    {% if comment.reponses|length > 0 %}
        <div class="replies-container" style="margin-left: 40px; border-left: 2px dashed #ececec; padding-left: 20px; margin-top: -10px; margin-bottom: 20px;">
            {% for reponse in comment.reponses %}
                {{ _self.comment_tree(reponse, article, commentForm, app) }}
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% block content %}
<div class="blog-details-hero">
    <div class="blog-details-hero-overlay"></div>
    <div class="hero-title-container">
        <h1>Article Details</h1>
    </div>
</div>

<div class="blog-details-wrapper">
    <div class="container">
        <div class="article-main-container">

            <div class="article-header">
                <div class="article-category">{{ article.categorie|default('Général') }}</div>
                <h2 class="article-title">{{ article.titre|default('Titre de l\'article') }}</h2>
                <div class="article-meta">
                    <span><i class="fas fa-calendar-alt"></i>{{ article.datePublication ? article.datePublication|date('d F Y') : 'Aujourd\'hui' }}</span>
                    <span><i class="fas fa-user-circle"></i>{{ article.auteur ? article.auteur.prenom ~ ' ' ~ article.auteur.nom : 'Anonyme' }}</span>
                    <span><i class="fas fa-map-marker-alt"></i>{{ article.region|default('Non spécifiée') }}</span>
                </div>
            </div>

            <img src="{{ cover_src }}" alt="{{ article.titre|e('html_attr') }}" class="article-creative-image" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='{{ blog_img_fallback|e('html_attr') }}';">

            <div class="article-content ql-snow">
                <div class="ql-editor" style="padding: 0;">
                    {{ article.contenu|default('<p>Le contenu de cet article est vide pour le moment.</p>')|raw }}
                </div>
            </div>

            <div id="articleSummaryPanel" class="article-summary-box" aria-live="polite">
                <div class="article-summary-title"><i class="fas fa-magic"></i> Résumé automatique</div>
                <p id="articleSummaryText" class="article-summary-text"></p>
            </div>

            <div class="article-tags">
                <span class="article-tag"><i class="fas fa-tag"></i> {{ article.categorie|default('Général') }}</span>
                <span class="article-tag"><i class="fas fa-map-pin"></i> {{ article.region|default('Non spécifiée') }}</span>
            </div>
            <div class="article-actions" style="margin-bottom: 40px;">
                <a href="{{ path('blog') }}" class="btn-custom btn-secondary-outline">
                    <i class="fas fa-arrow-left" style="margin-right: 8px;"></i> Retour aux blogs
                </a>
                <button id="listenButton" type="button" class="btn-custom btn-secondary-outline">
                    <i class="fas fa-volume-up" style="margin-right: 8px;"></i> Écouter
                </button>
                <button id="summaryButton" type="button" class="btn-custom btn-secondary-outline">
                    <i class="fas fa-compress-alt" style="margin-right: 8px;"></i> Résumé IA
                </button>
                {% if app.user and (app.user == article.auteur or is_granted('ROLE_ADMIN')) %}
                <a href="{{ path('app_article_edit', {id: article.id}) }}" class="btn-custom btn-primary-gradient">
                    <i class="fas fa-edit" style="margin-right: 8px;"></i> Modifier l'article
                </a>
                {% endif %}
            </div>
            <div class="share-buttons">
                <button id="shareWhatsApp" class="share-btn share-btn-whatsapp" data-platform="whatsapp" type="button">
                    <i class="fab fa-whatsapp"></i> WhatsApp
                </button>
                <button id="shareFacebook" class="share-btn share-btn-facebook" data-platform="facebook" type="button">
                    <i class="fab fa-facebook-f"></i> Facebook
                </button>
                <button id="shareInstagram" class="share-btn share-btn-instagram" data-platform="instagram" type="button">
                    <i class="fab fa-instagram"></i> Instagram
                </button>
            </div>

            <div class="comments-section">
                <h3 class="comments-title">Commentaires ({{ commentsPagination.getTotalItemCount|default(0) }})</h3>
                <div class="comments-list">
                    {% for comm in commentsPagination %}
                        {{ _self.comment_tree(comm, article, commentForm, app) }}
                    {% else %}
                        <p style="color: #888; font-style: italic;">Aucun commentaire pour le moment. Soyez le premier !</p>
                    {% endfor %}
                </div>
                <div class="pagination-container" style="margin-top: 20px;">
                    {{ knp_pagination_render(commentsPagination) }}
                </div>

                <div class="comment-form-container">
                    <h4 class="comment-form-title">Laisser un commentaire</h4>
                    {{ form_start(commentForm, {'attr': {'novalidate': 'novalidate', 'class': 'clearfix'}}) }}
                        {{ form_widget(commentForm.contenu, {'attr': {'class': 'wingo-input', 'rows': 4, 'id': 'new-comment-content'}}) }}
                        <div class="error-text">
                            {{ form_errors(commentForm.contenu) }}
                        </div>

                        <!-- GIF Picker -->
                        <div class="gif-picker" style="margin-top: 12px;">
                            <button type="button" id="openGifPicker" style="background: linear-gradient(135deg, #8d4fff, #fa9e1c); color: #fff; border: none; padding: 8px 20px; border-radius: 25px; font-weight: 600; cursor: pointer; font-size: 0.9rem; transition: all 0.3s;">
                                🎥 Ajouter un GIF
                            </button>
                            <div id="gifSearchContainer" style="display: none; margin-top: 12px; background: #f8f9fa; border-radius: 16px; padding: 15px; border: 1px solid #e9ecef;">
                                <input type="text" id="gifSearchInput" placeholder="Rechercher un GIF (ex: happy, love, travel)..." class="wingo-input" style="margin-bottom: 10px;">
                                <div id="gifResults" style="display: flex; flex-wrap: wrap; gap: 8px; max-height: 250px; overflow-y: auto;"></div>
                                <div id="gifLoading" style="display: none; text-align: center; padding: 20px; color: #888;"><i class="fas fa-spinner fa-spin"></i> Recherche...</div>
                            </div>
                            <div id="gifPreview" style="display: none; margin-top: 10px; position: relative;">
                            </div>
                        </div>

                        <button type="submit" class="btn-submit-comment">
                            <i class="fas fa-paper-plane" style="margin-right: 8px;"></i> Publier
                        </button>
                    {{ form_end(commentForm) }}
                </div>
            </div>

        </div>
    </div>
</div>

<script>
const WINGO_API_TTS_URL = "{{ path('api_tts')|e('js') }}";
const WINGO_API_SUMMARY_URL = "{{ path('api_summary_ai')|e('js') }}";
const WINGO_JSON_FETCH_HEADERS = {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
    'X-Requested-With': 'XMLHttpRequest'
};

async function wingoReadJsonResponse(response) {
    const raw = await response.text();
    try {
        return JSON.parse(raw);
    } catch (e) {
        console.error('Réponse non-JSON (HTTP ' + response.status + ')', raw.substring(0, 400));
        return null;
    }
}

function showReplyForm(commentId) {
    document.querySelectorAll('.reply-form-container').forEach(form => form.style.display = 'none');
    const formContainer = document.getElementById('reply-form-' + commentId);
    if (formContainer) {
        formContainer.style.display = 'block';
        const textarea = formContainer.querySelector('textarea');
        if(textarea) {
            textarea.focus();
            textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    }
}

function hideReplyForm(commentId) {
    const formContainer = document.getElementById('reply-form-' + commentId);
    if (formContainer) {
        formContainer.style.display = 'none';
        const textarea = formContainer.querySelector('textarea');
        if(textarea) textarea.value = '';
    }
}

function showEditForm(commentId) {
    document.querySelectorAll('.edit-comment-form').forEach(form => {
        form.style.display = 'none';
    });
    const form = document.getElementById('edit-form-' + commentId);
    if (form) {
        form.style.display = 'block';
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

function hideEditForm(commentId) {
    const form = document.getElementById('edit-form-' + commentId);
    if (form) {
        form.style.display = 'none';
        const originalText = document.getElementById('comment-body-' + commentId).innerText.replace(/\n/g, '');
        document.getElementById('edit-text-' + commentId).value = originalText;
    }
}

async function saveComment(commentId) {
    const newContent = document.getElementById('edit-text-' + commentId).value;
    if (!newContent.trim()) {
        alert('Le commentaire ne peut pas être vide.');
        return;
    }
    try {
        const response = await fetch('/commentaire/' + commentId + '/update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ contenu: newContent })
        });
        if (response.ok) {
            const data = await response.json();
            if (data.success) {
                document.getElementById('comment-body-' + commentId).innerHTML = data.contenu.replace(/\n/g, '<br>');
                hideEditForm(commentId);
            } else {
                alert('Erreur lors de la mise à jour : ' + (data.message || ''));
            }
        } else {
            alert('Erreur serveur.');
        }
    } catch (error) {
        console.error(error);
        alert('Impossible de communiquer avec le serveur.');
    }
}

const summaryButton = document.getElementById('summaryButton');
const summaryPanel = document.getElementById('articleSummaryPanel');
const summaryTextEl = document.getElementById('articleSummaryText');
if (summaryButton && summaryPanel && summaryTextEl) {
    summaryButton.addEventListener('click', async function () {
        const button = this;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Résumé...';
        button.disabled = true;

        const contentContainer = document.querySelector('.article-content');
        const content = contentContainer ? contentContainer.innerText.trim() : '';

        if (!content || content.length < 80) {
            alert('Le texte est trop court pour générer un résumé.');
            button.innerHTML = originalText;
            button.disabled = false;
            return;
        }

        try {
            const response = await fetch(WINGO_API_SUMMARY_URL, {
                method: 'POST',
                credentials: 'same-origin',
                headers: WINGO_JSON_FETCH_HEADERS,
                body: JSON.stringify({ text: content })
            });
            const data = await wingoReadJsonResponse(response);
            if (data === null) {
                alert('Réponse du serveur invalide (voir la console ou les logs PHP).');
            } else if (data.summary != null && String(data.summary).trim() !== '') {
                summaryTextEl.textContent = data.summary;
                summaryPanel.classList.add('is-visible');
                summaryPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
                let msg = data.error || 'Impossible de générer le résumé.';
                if (data.detail) {
                    msg += '\n\n' + data.detail;
                }
                alert(msg);
            }
        } catch (error) {
            console.error(error);
            alert('Erreur de communication avec le serveur.');
        } finally {
            button.innerHTML = originalText;
            button.disabled = false;
        }
    });
}

const listenButton = document.getElementById('listenButton');
if (listenButton) {
    listenButton.addEventListener('click', async function () {
        const button = this;
        const originalText = button.innerHTML;
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Génération...';
        button.disabled = true;

        const contentContainer = document.querySelector('.article-content');
        const content = contentContainer ? contentContainer.innerText.trim() : '';

        if (!content) {
            alert('Aucun contenu à lire.');
            button.innerHTML = originalText;
            button.disabled = false;
            return;
        }

        try {
            const response = await fetch(WINGO_API_TTS_URL, {
                method: 'POST',
                credentials: 'same-origin',
                headers: WINGO_JSON_FETCH_HEADERS,
                body: JSON.stringify({
                    text: content,
                    lang: 'fr'
                })
            });

            const data = await wingoReadJsonResponse(response);
            if (data === null) {
                alert('Réponse du serveur invalide (voir la console ou les logs PHP).');
            } else if (data.audioContent) {
                try {
                    const audioBlob = base64ToBlob(data.audioContent, 'audio/mp3');
                    const audioUrl = URL.createObjectURL(audioBlob);
                    const audio = new Audio(audioUrl);
                    await audio.play();
                } catch (playErr) {
                    console.error(playErr);
                    alert('L’audio a été reçu mais la lecture a échoué (navigateur ou format).');
                }
            } else if (data.error) {
                let msg = data.error;
                if (data.detail) {
                    msg += '\n\n' + data.detail;
                }
                alert(msg);
            } else {
                alert('Erreur lors de la génération audio.');
            }
        } catch (error) {
            console.error(error);
            alert('Erreur de communication avec le serveur.');
        } finally {
            button.innerHTML = originalText;
            button.disabled = false;
        }
    });
}

function base64ToBlob(base64, mimeType) {
    const byteCharacters = atob(base64);
    const byteNumbers = new Array(byteCharacters.length);
    for (let i = 0; i < byteCharacters.length; i++) {
        byteNumbers[i] = byteCharacters.charCodeAt(i);
    }
    const byteArray = new Uint8Array(byteNumbers);
    return new Blob([byteArray], { type: mimeType });
}

document.addEventListener('DOMContentLoaded', function () {
    // Récupération de l'URL absolue générée par Symfony (pour que le partage utilise l'URL publique)
    const articleUrl = '{{ app_domain }}{{ path('app_article_show', {'id': article.id}) }}';
    const articleTitle = '{{ article.titre|e('js') }}';
    
    const contentContainer = document.querySelector('.article-content');
    const articleContent = contentContainer ? contentContainer.innerText.trim() : '';
    const preview = articleContent.substring(0, 100);
    const shareText = `${articleTitle} - ${preview}... ${articleUrl}`;
    const encodedText = encodeURIComponent(shareText);
    const encodedUrl = encodeURIComponent(articleUrl);
    const encodedTitle = encodeURIComponent(articleTitle);

    const whatsappBtn = document.getElementById('shareWhatsApp');
    const facebookBtn = document.getElementById('shareFacebook');
    const instagramBtn = document.getElementById('shareInstagram');

    if (whatsappBtn) {
        whatsappBtn.addEventListener('click', function () {
            window.open(`https://wa.me/?text=${encodedText}`, '_blank');
        });
    }

    if (facebookBtn) {
        facebookBtn.addEventListener('click', function () {
            window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&quote=${encodedTitle}`, '_blank', 'width=600,height=400');
        });
    }

    if (instagramBtn) {
        instagramBtn.addEventListener('click', function () {
            navigator.clipboard.writeText(shareText).then(() => {
                showShareNotification('Texte copié ! Collez-le dans Instagram.');
            }).catch((err) => {
                console.error('Erreur de copie :', err);
                alert('Impossible de copier automatiquement. Veuillez copier le texte manuellement.');
            });
        });
    }
});

function showShareNotification(message) {
    const notification = document.createElement('div');
    notification.textContent = message;
    notification.style.position = 'fixed';
    notification.style.bottom = '20px';
    notification.style.left = '50%';
    notification.style.transform = 'translateX(-50%)';
    notification.style.backgroundColor = '#333';
    notification.style.color = '#fff';
    notification.style.padding = '12px 24px';
    notification.style.borderRadius = '30px';
    notification.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
    notification.style.zIndex = '9999';
    notification.style.fontSize = '14px';
    notification.style.fontWeight = '500';
    document.body.appendChild(notification);
    setTimeout(() => notification.remove(), 3000);
}

// ==================== GIF PICKER ====================
(function() {
    const textarea = document.getElementById('new-comment-content') || document.querySelector('.comment-form-container textarea');
    const openBtn = document.getElementById('openGifPicker');
    const container = document.getElementById('gifSearchContainer');
    const searchInput = document.getElementById('gifSearchInput');
    const resultsDiv = document.getElementById('gifResults');
    const loadingDiv = document.getElementById('gifLoading');
    const previewDiv = document.getElementById('gifPreview');

    if (!openBtn || !textarea) return;

    openBtn.addEventListener('click', () => {
        container.style.display = container.style.display === 'none' ? 'block' : 'none';
        if (container.style.display === 'block') {
            searchInput.focus();
        }
    });

    let timeout;
    searchInput.addEventListener('input', function() {
        clearTimeout(timeout);
        const query = this.value.trim();
        if (query.length < 2) {
            resultsDiv.innerHTML = '';
            return;
        }
        loadingDiv.style.display = 'block';
        resultsDiv.innerHTML = '';

        timeout = setTimeout(() => {
            fetch(`/comment/gif-search?q=${encodeURIComponent(query)}`)
                .then(res => res.json())
                .then(gifs => {
                    loadingDiv.style.display = 'none';
                    resultsDiv.innerHTML = '';
                    if (gifs.length === 0) {
                        resultsDiv.innerHTML = '<p style="color:#888;font-size:0.85rem;width:100%;text-align:center;">Aucun GIF trouvé.</p>';
                        return;
                    }
                    gifs.forEach(gif => {
                        const img = document.createElement('img');
                        img.src = gif.url;
                        img.alt = gif.title || 'GIF';
                        img.title = 'Cliquez pour ajouter ce GIF';
                        img.style.cssText = 'width:100px;height:75px;object-fit:cover;cursor:pointer;border-radius:10px;border:2px solid transparent;transition:all 0.2s;';
                        img.addEventListener('mouseenter', () => { img.style.borderColor = '#8d4fff'; img.style.transform = 'scale(1.05)'; });
                        img.addEventListener('mouseleave', () => { img.style.borderColor = 'transparent'; img.style.transform = 'scale(1)'; });
                        img.addEventListener('click', () => {
                            const imgTag = `<img src="${gif.url}" alt="GIF" style="max-width:200px;border-radius:8px;">`;
                            const start = textarea.selectionStart;
                            const end = textarea.selectionEnd;
                            const text = textarea.value;
                            textarea.value = text.substring(0, start) + imgTag + text.substring(end);
                            textarea.focus();

                            previewDiv.style.display = 'block';
                            previewDiv.innerHTML = `
                                <p style="font-size:0.8rem;color:#888;margin-bottom:5px;">Aperçu du GIF :</p>
                                <img src="${gif.url}" style="max-width:150px;border-radius:10px;border:2px solid #8d4fff;">
                                <button type="button" onclick="this.parentElement.style.display='none'" style="position:absolute;top:-5px;right:-5px;background:#dc3545;color:#fff;border:none;border-radius:50%;width:20px;height:20px;font-size:12px;cursor:pointer;line-height:1;">×</button>
                            `;

                            container.style.display = 'none';
                            searchInput.value = '';
                            resultsDiv.innerHTML = '';
                        });
                        resultsDiv.appendChild(img);
                    });
                })
                .catch(() => {
                    loadingDiv.style.display = 'none';
                    resultsDiv.innerHTML = '<p style="color:#dc3545;font-size:0.85rem;">Erreur de connexion à GIPHY.</p>';
                });
        }, 400);
    });
})();
</script>
{% endblock %}