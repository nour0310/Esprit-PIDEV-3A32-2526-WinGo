{% extends 'base.html.twig' %}

{% block title %}Participer à l'événement — WinGo{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/responsive.css') }}">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<style>
    :root {
        --form-primary: #8d4fff;
        --form-primary-light: rgba(141, 79, 255, 0.15);
        --form-accent: #fa9e1c;
        --form-gray: #f7f9fc;
    }
    body { background-color: #f9f9fc; }
    .form-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-top: 40px;
        position: relative;
        z-index: 10;
    }
    .form-header {
        background: linear-gradient(135deg, var(--form-primary) 0%, var(--form-accent) 100%);
        padding: 50px 30px;
        text-align: center;
        color: white;
    }
    .form-header h3 {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        font-weight: 700;
        margin: 0;
    }
    .form-body { padding: 50px 60px; }
    .form-group-custom { margin-bottom: 25px; }
    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 12px;
        display: block;
    }
    .wingo-input {
        background-color: var(--form-gray);
        border: 2px solid transparent !important;
        border-radius: 16px !important;
        padding: 16px 20px !important;
        width: 100%;
        transition: all 0.3s ease;
    }
    .wingo-input:focus {
        background-color: #fff;
        border-color: var(--form-primary) !important;
        box-shadow: 0 8px 25px var(--form-primary-light) !important;
    }
    .submit-btn {
        background: linear-gradient(135deg, var(--form-primary) 0%, var(--form-accent) 100%);
        color: #fff;
        border: none;
        padding: 16px 50px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }
    .form-error-message, .invalid-feedback, ul li {
        color: #dc3545 !important;
        font-size: 0.85rem;
        margin-top: 5px;
        list-style: none;
        font-weight: 500;
    }
    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 1px solid #f5c6cb;
    }
    .alert-success {
        background-color: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 12px;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
    }
</style>
{% endblock %}

{% block content %}
<div class="home" style="background-image: url('{{ asset('images/Photography by Ridha Gharbi.jpg') }}'); background-size: cover; background-position: center; height: 350px; position: relative;">
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5);"></div>
    <div style="position: absolute; top: 50%; width: 100%; text-align: center; transform: translateY(-50%);">
        <h1 style="color: white; font-size: 3.5rem; font-family: 'Playfair Display', serif;">RESERVATION</h1>
    </div>
</div>

<div class="container" style="padding-bottom: 80px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="form-card">
                {% if mode == 'show' %}
                    <div class="form-header">
                        <h3>Merci pour votre inscription !</h3>
                        <p>Votre demande pour <strong>{{ event.title }}</strong> est bien reçue.</p>
                    </div>
                    <div class="form-body text-center">
                        <p>Un email de confirmation sera envoyé à : <strong>{{ participation.emailParticipant }}</strong></p>
                        <a href="{{ path('event_front') }}" class="submit-btn">Retour aux événements</a>
                    </div>
                {% else %}
                    <div class="form-header">
                        <h3>Rejoignez l'aventure</h3>
                        <p>Inscrivez-vous à l'événement : {{ event.title }}</p>
                    </div>
                    <div class="form-body">
                        {% for message in app.flashes('error') %}
                            <div class="alert-danger">{{ message }}</div>
                        {% endfor %}
                        {% for message in app.flashes('success') %}
                            <div class="alert-success">{{ message }}</div>
                        {% endfor %}

                        <form method="post" novalidate>
                            <div class="row">
                                <div class="col-md-6 form-group-custom">
                                    <label class="form-label">Nom *</label>
                                    <input type="text" name="nom_participant" class="wingo-input" placeholder="Votre nom" required>
                                </div>
                                <div class="col-md-6 form-group-custom">
                                    <label class="form-label">Prénom *</label>
                                    <input type="text" name="prenom_participant" class="wingo-input" placeholder="Votre prénom" required>
                                </div>
                            </div>
                            <div class="form-group-custom">
                                <label class="form-label">Email *</label>
                                <input type="email" name="email_participant" class="wingo-input" placeholder="exemple@mail.com" required>
                            </div>
                            <div class="row">
                                <div class="col-md-6 form-group-custom">
                                    <label class="form-label">Téléphone *</label>
                                    <input type="tel" name="telephone" class="wingo-input" placeholder="+216 XX XXX XXX" required>
                                </div>
                                <div class="col-md-6 form-group-custom">
                                    <label class="form-label">Nombre de places *</label>
                                    <input type="number" name="nombre_places" class="wingo-input" value="1" min="1" max="{{ event.available_places }}" required>
                                    <small style="color: #666;">Maximum disponible : {{ event.available_places }}</small>
                                </div>
                            </div>
                            <div class="form-group-custom">
                                <label class="form-label">Statut</label>
                                <select name="statut" class="wingo-input">
                                    <option value="pending">En attente</option>
                                    <option value="confirmed">Confirmé</option>
                                </select>
                            </div>
                            <div class="text-center mt-4">
                                <button type="submit" class="submit-btn">Confirmer ma place</button>
                            </div>
                        </form>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}