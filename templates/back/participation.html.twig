{% extends 'admin/base_admin.html.twig' %}

{% block title %}Manage Participations - {{ event.title }} · WinGo Admin{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" type="text/css" href="{{ asset('styles/main_styles.css') }}">
<link rel="stylesheet" type="text/css" href="{{ asset('styles/responsive.css') }}">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
    :root {
        --gold: #fa9e1b;
        --violet: #8d4fff;
        --deep: #31124b;
        --ink: #1a1a2e;
        --mist: #f6f9fb;
        --white: #ffffff;
        --grey: #929191;
        --success: #27ae60;
        --danger: #e74c3c;
        --warning: #f39c12;
    }
    * { box-sizing: border-box; }
    body { font-family: 'DM Sans', sans-serif; background: #f0f2f5; }

    .admin-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 100px 24px 60px;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 16px;
    }
    .admin-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 32px;
        font-weight: 900;
        color: var(--ink);
        margin: 0;
    }
    .admin-header .event-badge {
        background: linear-gradient(135deg, var(--gold), var(--violet));
        padding: 8px 20px;
        border-radius: 30px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
    }
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--white);
        padding: 10px 20px;
        border-radius: 40px;
        text-decoration: none;
        color: var(--deep);
        font-weight: 600;
        font-size: 13px;
        transition: all 200ms;
        border: 1px solid #e0e0e0;
    }
    .back-link:hover { border-color: var(--gold); color: var(--gold); }

    .admin-card {
        background: var(--white);
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 30px;
    }
    .admin-card-header {
        background: linear-gradient(135deg, var(--deep), #5a1a8a);
        padding: 20px 28px;
        color: #fff;
    }
    .admin-card-header h2 {
        font-family: 'Playfair Display', serif;
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }
    .admin-card-header p { margin: 5px 0 0; opacity: 0.7; font-size: 13px; }
    .admin-card-body { padding: 28px; }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    .form-group { margin-bottom: 8px; }
    .form-group.full-width { grid-column: span 2; }
    .form-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--deep);
        margin-bottom: 6px;
    }
    .form-input, .form-select, .form-textarea {
        width: 100%;
        height: 44px;
        border: 2px solid #eee;
        border-radius: 10px;
        padding: 0 14px;
        font-family: 'DM Sans', sans-serif;
        font-size: 14px;
        color: var(--ink);
        outline: none;
        transition: all 200ms;
        background: #fafafa;
    }
    .form-textarea { height: auto; padding: 12px; resize: vertical; }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: var(--gold);
        background: #fff;
        box-shadow: 0 0 0 3px rgba(250,158,27,0.1);
    }
    .form-input.is-invalid, .form-select.is-invalid, .form-textarea.is-invalid {
        border-color: var(--danger);
        background: #fff5f5;
    }
    .error-message {
        color: #e74c3c;
        font-size: 11px;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .error-message::before { content: "⚠"; font-size: 10px; }

    .alert-error {
        background: #ffebee;
        color: #c62828;
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-left: 4px solid #c62828;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }
    .btn-primary {
        background: linear-gradient(135deg, var(--gold), var(--violet));
        color: #fff;
        border: none;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
        transition: all 200ms;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }
    .btn-secondary {
        background: #f0f0f0;
        color: var(--ink);
        border: none;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 600;
        cursor: pointer;
        transition: all 200ms;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-secondary:hover { background: #e0e0e0; }
    .btn-danger {
        background: var(--danger);
        color: #fff;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 200ms;
        text-decoration: none;
    }
    .btn-danger:hover { background: #c0392b; }

    .table-responsive { overflow-x: auto; }
    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }
    .admin-table th, .admin-table td {
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid #eee;
    }
    .admin-table th {
        background: #f8f9fa;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--grey);
    }
    .admin-table tr:hover { background: #fafbff; }
    .status-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }
    .status-pending { background: #fff3e0; color: #e67e22; }
    .status-confirmed { background: #e8f8f5; color: #27ae60; }
    .status-cancelled { background: #fdeded; color: #e74c3c; }
    .action-buttons { display: flex; gap: 8px; }
    .action-btn {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        transition: all 200ms;
    }
    .action-view { background: #e8f4fd; color: #2980b9; }
    .action-edit { background: #fff3e0; color: #f39c12; }
    .action-delete { background: #fdeded; color: #e74c3c; }
    .action-view:hover, .action-edit:hover, .action-delete:hover { opacity: 0.7; }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }
    .detail-item {
        background: #f8f9fa;
        padding: 16px;
        border-radius: 12px;
    }
    .detail-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--grey);
        margin-bottom: 6px;
    }
    .detail-value {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
    }

    .empty-state {
        text-align: center;
        padding: 60px;
        color: var(--grey);
    }
    .empty-state i { font-size: 48px; margin-bottom: 16px; opacity: 0.3; }
</style>
{% endblock %}

{% block content %}
<div class="admin-container">
    <div class="admin-header">
        <div>
            <h1>Manage Participations</h1>
            <div class="event-badge">{{ event.title }}</div>
        </div>
        <a href="{{ path('event_index') }}" class="back-link">
            <i class="fa fa-arrow-left"></i> Back to Events
        </a>
    </div>

    {% if mode == 'list' %}
        <div class="admin-card">
            <div class="admin-card-header">
                <h2><i class="fa fa-users"></i> All Registrations</h2>
                <p>{{ participations|length }} participant(s) for this event</p>
            </div>
            <div class="admin-card-body">
                <a href="{{ path('participation_new', {'id_event': event.id_event}) }}" class="btn-primary" style="margin-bottom: 20px; display: inline-flex;">
                    <i class="fa fa-plus"></i> Add Registration
                </a>
                
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Participant</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Places</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in participations %}
                            <tr>
                                <td>#{{ p.id_participation }}</td>
                                <td>{{ p.prenomParticipant }} {{ p.nomParticipant }}</td>
                                <td>{{ p.emailParticipant }}</td>
                                <td>{{ p.telephone }}</td>
                                <td>{{ p.nombrePlaces }}</td>
                                <td>{{ p.dateParticipation|date('Y-m-d') }}</td>
                                <td>
                                    <span class="status-badge status-{{ p.statut }}">
                                        {{ p.statut }}
                                    </span>
                                </td>
                                <td class="action-buttons">
                                    <a href="{{ path('participation_show', {'id_event': event.id_event, 'id_participation': p.idParticipation}) }}" class="action-btn action-view">View</a>
                                    <a href="{{ path('participation_edit', {'id_event': event.id_event, 'id_participation': p.idParticipation}) }}" class="action-btn action-edit">Edit</a>
                                    <a href="{{ path('participation_delete', {'id_event': event.id_event, 'id_participation': p.idParticipation}) }}" class="action-btn action-delete" onclick="return confirm('Delete this registration?')">Delete</a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="fa fa-ticket"></i>
                                        <p>No registrations yet for this event.</p>
                                        <a href="{{ path('participation_new', {'id_event': event.id_event}) }}" class="btn-primary" style="margin-top: 16px;">Add First Registration</a>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    {% elseif mode == 'new' or mode == 'edit' %}
        <div class="admin-card">
            <div class="admin-card-header">
                <h2><i class="fa {{ mode == 'new' ? 'fa-plus' : 'fa-pencil' }}"></i> {{ mode == 'new' ? 'Add Registration' : 'Edit Registration' }}</h2>
                {# FIX: dateEvent → date_event #}
                <p>{{ event.title }} · {{ event.date_event|date('M d, Y') }}</p>
            </div>
            <div class="admin-card-body">
                {% if error is defined %}
                    <div class="alert-error">
                        <i class="fa fa-exclamation-triangle"></i>
                        {{ error }}
                    </div>
                {% endif %}

                {% if validationErrors is defined and validationErrors|length > 0 %}
                    <div class="alert-error">
                        <i class="fa fa-exclamation-triangle"></i>
                        <strong>Please correct the following errors:</strong>
                    </div>
                    <ul style="margin: -10px 0 20px 25px; color: #c62828; font-size: 13px;">
                        {% for error in validationErrors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <form method="post" novalidate>
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Last Name *</label>
                            <input type="text" name="nom_participant" class="form-input" value="{{ participation.nomParticipant }}">
                        </div>
                        <div class="form-group">
                            <label class="form-label">First Name *</label>
                            <input type="text" name="prenom_participant" class="form-input" value="{{ participation.prenomParticipant }}">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email *</label>
                            <input type="text" name="email_participant" class="form-input" value="{{ participation.emailParticipant }}">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Phone *</label>
                            <input type="text" name="telephone" class="form-input" value="{{ participation.telephone }}">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Number of Seats *</label>
                            <input type="text" name="nombre_places" class="form-input" value="{{ participation.nombrePlaces ?: 1 }}">
                            {# FIX: availablePlaces → available_places #}
                            <small style="color: var(--grey); font-size: 11px;">Max available: {{ event.available_places }} seats</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Status *</label>
                            <select name="statut" class="form-select">
                                <option value="pending" {% if participation.statut == 'pending' %}selected{% endif %}>Pending</option>
                                <option value="confirmed" {% if participation.statut == 'confirmed' %}selected{% endif %}>Confirmed</option>
                                <option value="cancelled" {% if participation.statut == 'cancelled' %}selected{% endif %}>Cancelled</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">User ID</label>
                            <input type="number" name="id_user" class="form-input" value="{{ participation.idUser ?: 0 }}">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Participation Date</label>
                            <input type="datetime-local" name="date_participation" class="form-input" value="{{ participation.dateParticipation ? participation.dateParticipation|date('Y-m-d\\TH:i') : '' }}">
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            <i class="fa fa-save"></i> {{ mode == 'new' ? 'Create Registration' : 'Update Registration' }}
                        </button>
                        <a href="{{ path('participation_index', {'id_event': event.id_event}) }}" class="btn-secondary">
                            <i class="fa fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <h2><i class="fa fa-info-circle"></i> Event Information</h2>
            </div>
            <div class="admin-card-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-label">Event</div>
                        <div class="detail-value">{{ event.title }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Date & Time</div>
                        {# FIX: dateEvent → date_event, startTime → start_time #}
                        <div class="detail-value">{{ event.date_event|date('M d, Y') }} at {{ event.start_time }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Location</div>
                        <div class="detail-value">{{ event.location }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Available Places</div>
                        {# FIX: availablePlaces → available_places #}
                        <div class="detail-value">{{ event.available_places }} / {{ event.capacity }}</div>
                    </div>
                </div>
            </div>
        </div>

    {% elseif mode == 'show' %}
        <div class="admin-card">
            <div class="admin-card-header">
                <h2><i class="fa fa-eye"></i> Registration Details</h2>
                <p>ID: #{{ participation.idParticipation }}</p>
            </div>
            <div class="admin-card-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <div class="detail-label">Participant</div>
                        <div class="detail-value">{{ participation.prenomParticipant }} {{ participation.nomParticipant }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Email</div>
                        <div class="detail-value">{{ participation.emailParticipant }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Phone</div>
                        <div class="detail-value">{{ participation.telephone }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Number of Seats</div>
                        <div class="detail-value">{{ participation.nombrePlaces }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                            <span class="status-badge status-{{ participation.statut }}">{{ participation.statut }}</span>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Participation Date</div>
                        <div class="detail-value">{{ participation.dateParticipation|date('Y-m-d H:i:s') }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">User ID</div>
                        <div class="detail-value">{{ participation.idUser ?: 'N/A' }}</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Event</div>
                        {# FIX: dateEvent → date_event #}
                        <div class="detail-value">{{ event.title }} ({{ event.date_event|date('M d, Y') }})</div>
                    </div>
                </div>

                <div class="form-actions">
                    {# FIX: idEvent → id_event #}
                    <a href="{{ path('participation_edit', {'id_event': event.id_event, 'id_participation': participation.idParticipation}) }}" class="btn-primary">
                        <i class="fa fa-pencil"></i> Edit
                    </a>
                    <a href="{{ path('participation_index', {'id_event': event.id_event}) }}" class="btn-secondary">
                        <i class="fa fa-list"></i> Back to List
                    </a>
                    <a href="{{ path('participation_delete', {'id_event': event.id_event, 'id_participation': participation.idParticipation}) }}" class="btn-danger" style="margin-left: auto;" onclick="return confirm('Delete this registration?')">
                        <i class="fa fa-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}