{% extends 'admin/base_admin.html.twig' %}
{% block title %}Prédictions IA - Admin WinGo{% endblock %}
{% block page_title %}Prédictions d'achat — IA{% endblock %}

{% block content %}
<div class="data_card">

    <div class="data_card_header">
        <div class="data_card_title">
            <i class="fa fa-magic" style="color:#8d4fff"></i>
            Prédictions — Qui va acheter son panier ?
        </div>
        <div style="font-size:13px;color:#8d9bb5;margin-top:4px;">
            Modèle : RandomForest &nbsp;|&nbsp; Dataset : wingo_tnd.csv (2000 sessions)
        </div>
    </div>

    {# Compteurs résumé #}
    {% set nb_achete  = predictions|filter(p => p.prediction == 1)|length %}
    {% set nb_abandon = predictions|filter(p => p.prediction == 0)|length %}

    <div style="display:flex;gap:16px;padding:20px 24px;flex-wrap:wrap;">

        <div style="flex:1;min-width:160px;background:#f9fafb;border:1px solid #ebebf5;border-radius:12px;padding:16px 20px;text-align:center;">
            <div style="font-size:28px;font-weight:900;color:#fa9e1b;">{{ predictions|length }}</div>
            <div style="font-size:12px;color:#8d9bb5;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Paniers analysés</div>
        </div>

        <div style="flex:1;min-width:160px;background:#e8f8f3;border:1px solid #b2dfdb;border-radius:12px;padding:16px 20px;text-align:center;">
            <div style="font-size:28px;font-weight:900;color:#0f7a5a;">{{ nb_achete }}</div>
            <div style="font-size:12px;color:#0f7a5a;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Vont acheter</div>
        </div>

        <div style="flex:1;min-width:160px;background:#fdecea;border:1px solid #f5c6cb;border-radius:12px;padding:16px 20px;text-align:center;">
            <div style="font-size:28px;font-weight:900;color:#c62828;">{{ nb_abandon }}</div>
            <div style="font-size:12px;color:#c62828;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Risque d'abandon</div>
        </div>

    </div>

    <table>
        <thead>
            <tr>
                <th>Client</th>
                <th>Produits dans panier</th>
                <th>Total panier</th>
                <th>Probabilité d'achat</th>
                <th>Prédiction IA</th>
            </tr>
        </thead>
        <tbody>
            {% for p in predictions %}
                <tr>
                    <td>
                        <strong>{{ p.user.fullName }}</strong><br>
                        <small style="color:#8d9bb5;">{{ p.user.email }}</small>
                    </td>

                    <td style="text-align:center;">
                        <span style="font-weight:700;color:#1f2235;">{{ p.nb_produits }}</span>
                        <br><small style="color:#aaa;">ligne(s)</small>
                    </td>

                    <td>
                        <strong style="color:#fa9e1b;">{{ p.total|number_format(2, '.', ' ') }} TND</strong>
                    </td>

                    <td>
                        {# Barre colorée : rouge < 40%, orange 40-60%, vert >= 60% #}
                        <div style="background:#f0f2f8;border-radius:99px;height:10px;width:140px;overflow:hidden;margin-bottom:4px;">
                            <div style="
                                height:100%;
                                width:{{ p.probabilite }}%;
                                border-radius:99px;
                                background:linear-gradient(90deg,
                                    {% if p.probabilite >= 60 %}#43a047,#66bb6a
                                    {% elseif p.probabilite >= 40 %}#fa9e1b,#ffcc02
                                    {% else %}#e53935,#ff6b6b{% endif %}
                                );
                            "></div>
                        </div>
                        <small style="color:#8d9bb5;font-weight:600;">{{ p.probabilite }}%</small>
                    </td>

                    <td>
                        {% if p.prediction == 1 %}
                            <span style="background:#e8f8f3;color:#0f7a5a;padding:6px 14px;border-radius:99px;font-weight:800;font-size:12px;white-space:nowrap;">
                                ✅ Va acheter
                            </span>
                        {% else %}
                            <span style="background:#fdecea;color:#c62828;padding:6px 14px;border-radius:99px;font-weight:800;font-size:12px;white-space:nowrap;">
                                ⚠️ Risque d'abandon
                            </span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="text-align:center;color:#aaa;padding:50px;">
                        <i class="fa fa-magic" style="font-size:32px;opacity:.3;display:block;margin-bottom:12px;"></i>
                        Aucun client avec un panier actif — ou Flask est indisponible.<br>
                        <small>Lance : <code>python ai_model/app.py</code></small>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}