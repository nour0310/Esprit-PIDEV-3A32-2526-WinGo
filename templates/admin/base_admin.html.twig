<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin - WinGo{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/bootstrap4/bootstrap.min.css') }}">
    <link href="{{ asset('plugins/font-awesome-4.7.0/css/font-awesome.min.css') }}" rel="stylesheet">
    <style>
        :root {
            --primary: #fa9e1b;
            --secondary: #8d4fff;
            --dark: #1a1a2e;
            --sidebar-w: 260px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--dark);
            color: #fff;
            z-index: 1000;
            overflow-y: auto;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
        }

        .sidebar_logo {
            padding: 28px 24px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar_logo .brand {
            font-size: 26px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar_logo .role_badge {
            font-size: 11px;
            background: var(--primary);
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 4px;
        }

        .sidebar_user {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user_avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .user_info .user_name {
            font-size: 14px;
            font-weight: 600;
        }

        .user_info .user_email {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
        }

        .sidebar_nav {
            padding: 16px 0;
            flex: 1;
        }

        .nav_section_title {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.35);
            padding: 12px 24px 6px;
        }

        .sidebar_link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 24px;
            color: rgba(255,255,255,0.65);
            text-decoration: none;
            transition: all 0.2s;
            font-size: 14px;
        }

        .sidebar_link:hover,
        .sidebar_link.active {
            color: #fff;
            background: rgba(255,255,255,0.08);
            border-right: 3px solid var(--primary);
        }

        .sidebar_link.active {
            background: rgba(250,158,27,0.15);
        }

        .sidebar_link i {
            width: 20px;
            text-align: center;
            font-size: 15px;
        }

        .sidebar_link .badge_count {
            margin-left: auto;
            background: var(--primary);
            color: #fff;
            font-size: 10px;
            padding: 2px 7px;
            border-radius: 10px;
        }

        .sidebar_bottom {
            padding: 16px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .logout_btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            background: rgba(255,255,255,0.06);
            border-radius: 10px;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 14px;
            transition: all 0.2s;
        }

        .logout_btn:hover {
            background: rgba(220,53,69,0.2);
            color: #ff6b6b;
        }

        .main_content {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: #fff;
            padding: 16px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .page_title {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a2e;
        }

        .topbar_actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar_btn {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            color: #fff;
            padding: 8px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .content_area {
            padding: 28px;
            flex: 1;
        }

        .stat_card {
            background: #fff;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            display: flex;
            align-items: center;
            gap: 18px;
            transition: all 0.2s;
            border: 1px solid rgba(0,0,0,0.04);
        }

        .stat_card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .stat_icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #fff;
            flex-shrink: 0;
        }

        .stat_icon.orange { background: linear-gradient(135deg, #fa9e1b, #f76b1c); }
        .stat_icon.purple { background: linear-gradient(135deg, #8d4fff, #6a11cb); }
        .stat_icon.blue { background: linear-gradient(135deg, #2196F3, #0d47a1); }
        .stat_icon.green { background: linear-gradient(135deg, #4CAF50, #1b5e20); }
        .stat_icon.red { background: linear-gradient(135deg, #f44336, #b71c1c); }

        .stat_num {
            font-size: 30px;
            font-weight: 800;
            color: #1a1a2e;
            line-height: 1;
        }

        .stat_label {
            font-size: 13px;
            color: #888;
            margin-top: 4px;
        }

        .data_card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            overflow: hidden;
            margin-bottom: 24px;
            border: 1px solid rgba(0,0,0,0.04);
        }

        .data_card_header {
            padding: 20px 24px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .data_card_title {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a2e;
        }

        .data_card_link {
            font-size: 13px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f8f9fa;
            padding: 12px 20px;
            text-align: left;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            font-weight: 600;
        }

        td {
            padding: 14px 20px;
            border-bottom: 1px solid #f5f5f5;
            font-size: 14px;
            color: #444;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tr:hover td {
            background: #fafbff;
        }

        .badge_status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge_admin { background: #ffe8f0; color: #c2185b; }
        .badge_client { background: #e8f4fd; color: #1565c0; }
        .badge_pending { background: #fff8e1; color: #f57f17; }
        .badge_done { background: #e8f5e9; color: #2e7d32; }

        .flash_success {
            background: #e8f5e9;
            border-left: 4px solid #4CAF50;
            color: #2e7d32;
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .flash_error {
            background: #ffebee;
            border-left: 4px solid #f44336;
            color: #c62828;
            padding: 14px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .nav_notification_wrapper {
            position: relative;
        }

        .notification_bell {
            position: relative;
            width: 44px;
            height: 44px;
            border: none;
            border-radius: 50%;
            background: #f5f7fb;
            color: #1a1a2e;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .25s ease;
            box-shadow: 0 3px 10px rgba(0,0,0,0.06);
        }

        .notification_bell:hover {
            transform: translateY(-1px);
            background: #eef2f9;
        }

        .notification_badge {
            position: absolute;
            top: -4px;
            right: -2px;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            border-radius: 999px;
            background: #ff4d6d;
            color: #fff;
            font-size: 11px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(255, 77, 109, 0.35);
        }

        .notification_dropdown {
            position: absolute;
            top: 56px;
            right: 0;
            width: 360px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(18, 22, 45, 0.18);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all .25s ease;
            z-index: 9999;
        }

        .notification_dropdown.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .notification_header {
            padding: 16px 18px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
        }

        .notification_header small {
            font-size: 12px;
            opacity: .95;
        }

        .notification_list {
            max-height: 320px;
            overflow-y: auto;
            background: #fff;
        }

        .notification_item {
            display: flex;
            gap: 12px;
            padding: 14px 16px;
            text-decoration: none !important;
            border-bottom: 1px solid #f1f3f8;
            transition: background .2s ease;
        }

        .notification_item:hover {
            background: #f8faff;
        }

        .notification_item.unread {
            background: #fcfcff;
        }

        .notification_icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 16px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
        }

        .notification_content {
            flex: 1;
            min-width: 0;
        }

        .notification_title {
            font-size: 14px;
            font-weight: 800;
            color: #1f2235;
            margin-bottom: 3px;
        }

        .notification_text {
            font-size: 13px;
            color: #6d748b;
            line-height: 1.5;
            margin-bottom: 4px;
        }

        .notification_time {
            font-size: 11px;
            color: #9aa1b5;
            font-weight: 600;
        }

        .notification_empty {
            padding: 18px 16px;
            color: #7b8095;
            font-size: 13px;
            text-align: center;
        }

        .notification_footer {
            padding: 12px 16px;
            background: #fafbff;
            text-align: center;
        }

        .notification_footer a {
            color: #8d4fff;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
        }

        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }

            .main_content {
                margin-left: 0;
            }

            .notification_dropdown {
                width: 300px;
                right: 0;
            }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<div class="sidebar">
    <div class="sidebar_logo">
        <div class="brand">WinGo</div>
        <span class="role_badge"><i class="fa fa-shield"></i> Admin</span>
    </div>

    <div class="sidebar_user">
        <div class="user_avatar">{{ app.user.prenom|first|upper }}</div>
        <div class="user_info">
            <div class="user_name">{{ app.user.fullName }}</div>
            <div class="user_email">{{ app.user.email }}</div>
        </div>
    </div>

    <nav class="sidebar_nav">
        <div class="nav_section_title">Tableau de bord</div>
        <a href="{{ path('admin_dashboard') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_dashboard' %}active{% endif %}">
            <i class="fa fa-tachometer"></i> Tableau de bord
        </a>

        <div class="nav_section_title">Gestion</div>
        <a href="{{ path('admin_users') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_users' %}active{% endif %}">
            <i class="fa fa-users"></i> Utilisateurs
        </a>
        <a href="{{ path('admin_articles') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_articles' %}active{% endif %}">
            <i class="fa fa-newspaper-o"></i> Articles
        </a>
        <a href="{{ path('admin_produits') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_produits' %}active{% endif %}">
            <i class="fa fa-shopping-bag"></i> Produits
        </a>
        <a href="{{ path('admin_demandes_commercant') }}" class="sidebar_link {% if app.request.attributes.get('_route') starts with 'admin_demandes_commercant' %}active{% endif %}">
            <i class="fa fa-store"></i> Commerçants
        </a>
        <a href="{{ path('admin_reservations') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_reservations' %}active{% endif %}">
            <i class="fa fa-calendar"></i> Réservations
        </a>
        <a href="{{ path('admin_transports') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_transports' %}active{% endif %}">
            <i class="fa fa-bus"></i> Transports
        </a>

        <div class="nav_section_title">Réclamations</div>
        <a href="{{ path('admin_reclamations') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_reclamations' %}active{% endif %}">
            <i class="fa fa-exclamation-circle"></i> Réclamations
        </a>
        <a href="{{ path('admin_suggestions') }}" class="sidebar_link {% if app.request.attributes.get('_route') == 'admin_suggestions' %}active{% endif %}">
            <i class="fa fa-lightbulb-o"></i> Suggestions
        </a>

        <div class="nav_section_title">Mon compte</div>
        <a href="{{ path('app_profile') }}" class="sidebar_link {% if app.request.attributes.get('_route') starts with 'app_profile' %}active{% endif %}">
            <i class="fa fa-user"></i> Mon profil
        </a>
        <a href="{{ path('home') }}" class="sidebar_link">
            <i class="fa fa-globe"></i> Voir le site
        </a>
    </nav>

    <div class="sidebar_bottom">
        <a href="{{ path('app_logout') }}" class="logout_btn">
            <i class="fa fa-sign-out"></i> Déconnexion
        </a>
    </div>
</div>

<div class="main_content">
    <div class="topbar">
        <div class="page_title">{% block page_title %}Tableau de bord{% endblock %}</div>

        <div class="topbar_actions">
{{ render(controller('App\\Controller\\AdminNotificationController::bell')) }}
            {% block topbar_actions %}{% endblock %}
        </div>
    </div>

    <div class="content_area">
        {% for message in app.flashes('success') %}
            <div class="flash_success"><i class="fa fa-check-circle"></i> {{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash_error"><i class="fa fa-times-circle"></i> {{ message }}</div>
        {% endfor %}

        {% block content %}{% endblock %}
    </div>
</div>

<script src="{{ asset('js/jquery-3.2.1.min.js') }}"></script>
<script src="{{ asset('styles/bootstrap4/bootstrap.min.js') }}"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function bindBellEvents() {
            const bell = document.getElementById('notificationBell');
            const dropdown = document.getElementById('notificationDropdown');

            if (!bell || !dropdown) {
                return;
            }

            bell.addEventListener('click', function (e) {
                e.stopPropagation();
                dropdown.classList.toggle('show');
            });

            document.addEventListener('click', function (e) {
                const currentBell = document.getElementById('notificationBell');
                const currentDropdown = document.getElementById('notificationDropdown');

                if (currentBell && currentDropdown) {
                    if (!currentDropdown.contains(e.target) && !currentBell.contains(e.target)) {
                        currentDropdown.classList.remove('show');
                    }
                }
            });
        }

        async function refreshNotificationBell() {
            const wrapper = document.getElementById('adminNotificationWrapper');
            if (!wrapper) {
                return;
            }

            const bellUrl = wrapper.dataset.bellUrl;
            if (!bellUrl) {
                return;
            }

            try {
                const response = await fetch(bellUrl, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    console.error('Erreur HTTP refresh:', response.status);
                    return;
                }

                const html = await response.text();
                wrapper.outerHTML = html;
                bindBellEvents();
            } catch (error) {
                console.error('Erreur refresh notifications:', error);
            }
        }

        bindBellEvents();

        const wrapper = document.getElementById('adminNotificationWrapper');
        if (!wrapper) {
            return;
        }

        const mercureUrl = wrapper.dataset.mercureUrl;
        if (!mercureUrl) {
            console.error('URL Mercure absente.');
            return;
        }

        const eventSource = new EventSource(mercureUrl);

        eventSource.onmessage = function () {
            refreshNotificationBell();
        };

        eventSource.onerror = function (error) {
            console.error('Erreur Mercure:', error);
        };

        window.addEventListener('beforeunload', function () {
            eventSource.close();
        });
    });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>