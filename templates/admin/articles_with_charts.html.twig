{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des Articles - WinGo{% endblock %}
{% block page_title %}Gestion des Articles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .chart-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .chart-title {
            font-weight: 600;
            margin-bottom: 15px;
            color: #2d3436;
            text-align: center;
        }
        .chart-container {
            position: relative;
            height: 300px;
        }
        .articles-table {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .search-form-inline {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .search-input-inline {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            flex: 1;
        }
        .search-btn-inline {
            padding: 8px 16px;
            background: #fa9e1b;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <h1>Gestion des Articles</h1>

    {# 🆕 Section Statistiques #}
    <div class="stats-grid">
        <div class="chart-card">
            <div class="chart-title">📅 Articles par mois</div>
            <div class="chart-container">
                <canvas id="articlesChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-title">🏷️ Articles par catégorie</div>
            <div class="chart-container">
                <canvas id="categoriesChart"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-title">📈 Commentaires & Likes</div>
            <div class="chart-container">
                <canvas id="evolutionChart"></canvas>
            </div>
        </div>
    </div>

    {# 📋 Tableau des articles #}
    <div class="articles-table">
        <div class="table-header">
            <h3>Liste des Articles</h3>
            <div class="search-form-inline">
                <form method="GET">
                    <input 
                        type="text" 
                        name="search" 
                        class="search-input-inline" 
                        placeholder="Rechercher par titre ou contenu..." 
                        value="{{ search|default('') }}"
                        autocomplete="off"
                    >
                    <button type="submit" class="search-btn-inline">
                        <i class="fa fa-search"></i> Rechercher
                    </button>
                </form>
            </div>
        </div>

        {% if search %}
            <div style="margin-bottom: 15px; color: #666;">
                {{ articles|length }} résultat(s) pour "{{ search }}"
            </div>
        {% endif %}

        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Titre</th>
                    <th>Région</th>
                    <th>Catégorie</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                <tr>
                    <td>{{ article.id }}</td>
                    <td>{{ article.titre }}</td>
                    <td>{{ article.region|default('-') }}</td>
                    <td>{{ article.categorie|default('-') }}</td>
                    <td>{{ article.datePublication ? article.datePublication|date('d/m/Y') : '-' }}</td>
                    <td>
                        <a href="{{ path('admin_article_show', {'id': article.id}) }}" class="btn btn-primary btn-sm">
                            <i class="fa fa-eye"></i>
                        </a>
                        <a href="{{ path('admin_article_edit', {'id': article.id}) }}" class="btn btn-warning btn-sm">
                            <i class="fa fa-edit"></i>
                        </a>
                        <form method="POST" action="{{ path('admin_article_delete', {'id': article.id}) }}" style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_admin' ~ article.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer cet article ?')">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" style="text-align: center; color: #999; padding: 30px;">
                        Aucun article trouvé
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Graphique 1 : Articles par mois
            const articlesCtx = document.getElementById('articlesChart').getContext('2d');
            new Chart(articlesCtx, {
                type: 'bar',
                data: {
                    labels: [{% for item in articlesParMois %}'{{ item.mois }}',{% endfor %}],
                    datasets: [{
                        label: 'Articles',
                        data: [{% for item in articlesParMois %}{{ item.nb }},{% endfor %}],
                        backgroundColor: '#8d4fff',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });

            // Graphique 2 : Catégories (camembert)
            const catCtx = document.getElementById('categoriesChart').getContext('2d');
            new Chart(catCtx, {
                type: 'pie',
                data: {
                    labels: [{% for item in articlesParCategorie %}'{{ item.categorie }}',{% endfor %}],
                    datasets: [{
                        data: [{% for item in articlesParCategorie %}{{ item.nb }},{% endfor %}],
                        backgroundColor: ['#8d4fff', '#fa9e1c', '#10b981', '#ef4444', '#3b82f6', '#f59e0b']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { 
                        legend: { 
                            position: 'bottom',
                            labels: {
                                color: '#333',
                                font: { size: 12, weight: '600' }
                            }
                        }
                    }
                }
            });

            // Graphique 3 : Évolution commentaires/likes
            const evoCtx = document.getElementById('evolutionChart').getContext('2d');
            
            const commMap = { {% for item in commentairesParMois %}'{{ item.mois }}': {{ item.nb }},{% endfor %} };
            const likeMap = { {% for item in likesParMois %}'{{ item.mois }}': {{ item.nb }},{% endfor %} };
            
            const allMonths = [...new Set([...Object.keys(commMap), ...Object.keys(likeMap)])].sort();
            
            new Chart(evoCtx, {
                type: 'line',
                data: {
                    labels: allMonths,
                    datasets: [
                        {
                            label: 'Commentaires',
                            data: allMonths.map(m => commMap[m] || 0),
                            borderColor: '#8d4fff',
                            tension: 0.3,
                            pointBackgroundColor: '#8d4fff'
                        },
                        {
                            label: 'Likes',
                            data: allMonths.map(m => likeMap[m] || 0),
                            borderColor: '#fa9e1c',
                            tension: 0.3,
                            pointBackgroundColor: '#fa9e1c'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        });
    </script>
{% endblock %}
