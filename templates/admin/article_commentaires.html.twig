{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commentaires de l'article - Admin WinGo{% endblock %}
{% block page_title %}Gérer les commentaires{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            color: #fff;
            text-decoration: none;
            margin-right: 5px;
            border: none;
            cursor: pointer;
            transition: background 0.3s;
        }
        .btn-delete { background: #dc3545; }
        .btn-delete:hover { background: #c82333; }
        
        .data_card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            overflow: hidden;
            margin-bottom: 24px;
            border: 1px solid rgba(0,0,0,0.04);
        }
        .data_card_header {
            padding: 20px 24px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .data_card_title {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a2e;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            background: #f8f9fa;
            padding: 12px 20px;
            text-align: left;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            font-weight: 600;
        }
        td {
            padding: 14px 20px;
            border-bottom: 1px solid #f5f5f5;
            font-size: 14px;
            color: #444;
            vertical-align: middle;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafbff; }

        /* Bad Word Badges */
        .badge-badword {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            color: #fff;
            letter-spacing: 0.3px;
        }
        .badge-danger { background: linear-gradient(135deg, #dc3545, #c0392b); }
        .badge-clean { background: linear-gradient(135deg, #28a745, #20c997); }
        
        .badword-alert {
            background: linear-gradient(135deg, #fff5f5, #ffe0e0);
            border: 1px solid #f5c6cb;
            border-left: 4px solid #dc3545;
            border-radius: 8px;
            padding: 14px 20px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.92rem;
            color: #721c24;
        }
        .badword-alert i { font-size: 1.3rem; }
        .badword-alert strong { color: #dc3545; }

        .row-flagged { background-color: #fff8f8 !important; }
        .row-flagged:hover { background-color: #fff0f0 !important; }

        .filter-btns { display: flex; gap: 8px; }
        .filter-btn {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
        }
        .filter-btn.active { box-shadow: 0 2px 8px rgba(0,0,0,0.15); }
        .filter-btn-all { background: #f0f0f0; color: #333; }
        .filter-btn-all.active { background: #333; color: #fff; }
        .filter-btn-bad { background: #fde8e8; color: #dc3545; }
        .filter-btn-bad.active { background: #dc3545; color: #fff; }
        .filter-btn-clean { background: #e8fde8; color: #28a745; }
        .filter-btn-clean.active { background: #28a745; color: #fff; }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom: 20px;">
        <div>
            <h1>Commentaires de l'article</h1>
            <p style="color:#666; margin:0; font-size: 1.1em;">
                Article visé : <strong style="color: #6f42c1;">{{ article.titre }}</strong>
            </p>
        </div>
        <div>
            <a href="{{ path('admin_articles') }}" style="display:inline-block; padding:8px 15px; background:#f0f0f0; color:#333; text-decoration:none; border-radius:6px; font-weight:bold;">
                <i class="fa fa-arrow-left"></i> Retour aux articles
            </a>
        </div>
    </div>

    {% if badWordCount > 0 %}
    <div class="badword-alert">
        <i class="fa fa-exclamation-triangle"></i>
        <div>
            <strong>🚫 {{ badWordCount }} commentaire{{ badWordCount > 1 ? 's' : '' }}</strong> contenant des mots inappropriés {{ badWordCount > 1 ? 'ont été détectés' : 'a été détecté' }}.
            <br><small>Vérifiez et supprimez les commentaires signalés si nécessaire.</small>
        </div>
    </div>
    {% endif %}

    <div class="data_card">
        <div class="data_card_header">
            <div class="data_card_title">
                <i class="fa fa-comments" style="color:#6f42c1; margin-right:8px;"></i> Liste des Commentaires ({{ article.commentaires|length }})
            </div>
            
            <div class="filter-btns">
                <button class="filter-btn filter-btn-all active" onclick="filterComments('all')">Tous ({{ article.commentaires|length }})</button>
                <button class="filter-btn filter-btn-bad" onclick="filterComments('flagged')">🚫 Signalés ({{ badWordCount }})</button>
                <button class="filter-btn filter-btn-clean" onclick="filterComments('clean')">✅ OK ({{ article.commentaires|length - badWordCount }})</button>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th style="width: 250px;">Auteur</th>
                    <th style="width: 150px;">Date</th>
                    <th>Contenu</th>
                    <th style="width: 100px;">Statut</th>
                    <th style="width: 80px; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for comment in article.commentaires %}
                {% set analysis = badWordResults[comment.id] ?? {has_bad_words: false, severity: 'clean'} %}
                
                <tr class="{{ analysis.has_bad_words ? 'row-flagged' : '' }}" data-status="{{ analysis.has_bad_words ? 'flagged' : 'clean' }}">
                    <td><span style="color:#888; font-size:12px;">#{{ comment.id }}</span></td>
                    <td>
                        <div style="display:flex; align-items:center; gap:10px;">
                            {% set u = comment.utilisateur %}
                            {% set initials = u ? u.initials : '?' %}
                            {% set avatarUrl = u ? u.avatarUrl : 'https://api.dicebear.com/9.x/avataaars/svg?seed=deleted-user&backgroundColor=b6e3f4' %}
                            
                            <div style="position: relative; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                {# Pastille de couleur (si image échoue) #}
                                <div style="position: absolute; width: 100%; height: 100%; background: linear-gradient(135deg, #fa9e1c, #8d4fff); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; border: 2px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                                    {{ initials }}
                                </div>
                                {# Avatar #}
                                <img src="{{ avatarUrl|default('https://api.dicebear.com/9.x/avataaars/svg?seed=U') }}" 
                                     alt="Avatar" 
                                     style="position: relative; z-index: 2; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid #fff; transition: opacity 0.3s;"
                                     onerror="this.style.opacity='0';">
                            </div>

                            <div>
                                <strong style="display:block; color:#333;">{{ u ? u.fullName : 'Utilisateur supprimé' }}</strong>
                                <span style="font-size:12px; color:#aaa;">{{ u ? u.email : 'Inconnu' }}</span>
                            </div>
                        </div>
                    </td>
                    <td style="color:#666;">
                        {{ comment.dateCommentaire ? comment.dateCommentaire|date('d/m/Y H:i') : '-' }}
                    </td>
                    <td style="max-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color:#444;" title="{{ comment.contenu }}">
                        {% if analysis.has_bad_words %}
                            <span style="color: #dc3545; font-weight: bold;">[Masqué/Inapproprié]</span>
                            <br><small style="color: #888;">Original: {{ comment.contenu }}</small>
                        {% else %}
                            {{ comment.contenu }}
                        {% endif %}
                    </td>
                    <td>
                        {% if analysis.severity == 'danger' %}
                            <span class="badge-badword badge-danger">🚫 Signalé</span>
                        {% else %}
                            <span class="badge-badword badge-clean">✅ OK</span>
                        {% endif %}
                    </td>
                    <td style="text-align:right;">
                        <form method="post" action="{{ path('admin_commentaire_delete', {id: comment.id}) }}" style="margin: 0; display:inline-block;" onsubmit="return confirm('Souhaitez-vous vraiment supprimer ce commentaire ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_admin_comment' ~ comment.id) }}">
                            <button type="submit" class="action-btn btn-delete" title="Supprimer ce commentaire definitivement">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" style="text-align:center; color:#aaa; padding:60px 20px; font-size:1.1em;">
                    <i class="fa fa-comment-o" style="font-size:3em; display:block; margin-bottom:15px; color:#ddd;"></i>
                    Aucun commentaire pour cet article.
                </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
function filterComments(type) {
    const rows = document.querySelectorAll('tbody tr[data-status]');
    const btns = document.querySelectorAll('.filter-btn');
    
    btns.forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    
    rows.forEach(row => {
        if (type === 'all') {
            row.style.display = '';
        } else if (type === 'flagged') {
            row.style.display = row.dataset.status === 'flagged' ? '' : 'none';
        } else {
            row.style.display = row.dataset.status === 'clean' ? '' : 'none';
        }
    });
}
</script>
{% endblock %}
