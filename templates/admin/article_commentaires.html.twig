{% extends 'admin/base_admin.html.twig' %}
{% block title %}Commentaires de l'article - Admin WinGo{% endblock %}
{% block page_title %}Commentaires de l'article{% endblock %}

{% block content %}
<div class="data_card">
    <div class="data_card_header">
        <div class="data_card_title">
            <i class="fa fa-comments" style="color:#6f42c1"></i> Commentaires pour : {{ article.titre }}
            <a href="{{ path('admin_articles') }}" style="float: right; font-size: 14px; text-decoration: none; color: #fa9e1b;">&laquo; Retour aux articles</a>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Auteur</th>
                <th>Commentaire</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commentaire in commentaires %}
            <tr>
                <td>{{ commentaire.id }}</td>
                <td><strong>{{ commentaire.utilisateur ? commentaire.utilisateur.nom : 'Anonyme' }}</strong></td>
                <td style="max-width: 400px; word-wrap: break-word;">{{ commentaire.contenu }}</td>
                <td>{{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y H:i') : '-' }}</td>
                <td>
                    <form method="post" action="{{ path('admin_commentaire_delete', {id: commentaire.id}) }}" style="margin: 0;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_admin' ~ commentaire.id) }}">
                        <button type="submit" style="background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer;">
                            <i class="fa fa-trash"></i> Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="5" style="text-align:center;color:#aaa;padding:40px;">Aucun commentaire pour cet article.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
