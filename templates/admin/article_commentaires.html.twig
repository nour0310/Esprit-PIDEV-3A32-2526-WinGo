{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commentaires de l'article - Admin WinGo{% endblock %}
{% block page_title %}Gérer les commentaires{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            color: #fff;
            text-decoration: none;
            margin-right: 5px;
            border: none;
            cursor: pointer;
            transition: background 0.3s;
        }
        .btn-delete { background: #dc3545; }
        .btn-delete:hover { background: #c82333; }
        
        .data_card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            overflow: hidden;
            margin-bottom: 24px;
            border: 1px solid rgba(0,0,0,0.04);
        }
        .data_card_header {
            padding: 20px 24px;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .data_card_title {
            font-size: 16px;
            font-weight: 700;
            color: #1a1a2e;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th {
            background: #f8f9fa;
            padding: 12px 20px;
            text-align: left;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            font-weight: 600;
        }
        td {
            padding: 14px 20px;
            border-bottom: 1px solid #f5f5f5;
            font-size: 14px;
            color: #444;
            vertical-align: middle;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafbff; }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom: 20px;">
        <div>
            <h1>Commentaires de l'article</h1>
            <p style="color:#666; margin:0; font-size: 1.1em;">
                Article visé : <strong style="color: #6f42c1;">{{ article.titre }}</strong>
            </p>
        </div>
        <div>
            <a href="{{ path('admin_articles') }}" style="display:inline-block; padding:8px 15px; background:#f0f0f0; color:#333; text-decoration:none; border-radius:6px; font-weight:bold;">
                <i class="fa fa-arrow-left"></i> Retour aux articles
            </a>
        </div>
    </div>

    <div class="data_card">
        <div class="data_card_header">
            <div class="data_card_title">
                <i class="fa fa-comments" style="color:#6f42c1; margin-right:8px;"></i> Liste des Commentaires ({{ article.commentaires|length }})
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th style="width: 250px;">Auteur</th>
                    <th style="width: 150px;">Date</th>
                    <th>Contenu</th>
                    <th style="width: 80px; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for comment in article.commentaires %}
                <tr>
                    <td><span style="color:#888; font-size:12px;">#{{ comment.id }}</span></td>
                    <td>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed={{ comment.utilisateur.prenom|default('U') }}&backgroundColor=f0db4f,6f42c1,fa9e1b,17a2b8" alt="Avatar" style="width:36px; height:36px; border-radius:50%; box-shadow:0 2px 5px rgba(0,0,0,0.1);">
                            <div>
                                <strong style="display:block; color:#333;">{{ comment.utilisateur.prenom }} {{ comment.utilisateur.nom }}</strong>
                                <span style="font-size:12px; color:#aaa;">{{ comment.utilisateur.email }}</span>
                            </div>
                        </div>
                    </td>
                    <td style="color:#666;">
                        {{ comment.dateCommentaire ? comment.dateCommentaire|date('d/m/Y H:i') : '-' }}
                    </td>
                    <td style="max-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color:#444;" title="{{ comment.description }}">
                        {{ comment.description }}
                    </td>
                    <td style="text-align:right;">
                        <form method="post" action="{{ path('admin_commentaire_delete', {id: comment.id}) }}" style="margin: 0; display:inline-block;" onsubmit="return confirm('Souhaitez-vous vraiment supprimer ce commentaire ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_admin_comment' ~ comment.id) }}">
                            <button type="submit" class="action-btn btn-delete" title="Supprimer ce commentaire definitivement">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" style="text-align:center; color:#aaa; padding:60px 20px; font-size:1.1em;">
                    <i class="fa fa-comment-o" style="font-size:3em; display:block; margin-bottom:15px; color:#ddd;"></i>
                    Aucun commentaire pour cet article.
                </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
