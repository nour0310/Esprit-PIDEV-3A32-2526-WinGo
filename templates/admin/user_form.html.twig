{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ title }} - Admin WinGo{% endblock %}
{% block page_title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form_card {
            background: #fff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            max-width: 800px;
            margin: 0 auto;
        }
        .form_group {
            margin-bottom: 24px;
        }
        .form_label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #4a5568;
            font-size: 14px;
        }
        .form_control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #edf2f7;
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.3s ease;
            outline: none;
        }
        .form_control:focus {
            border-color: #fa9e1b;
            box-shadow: 0 0 0 4px rgba(250, 158, 27, 0.1);
        }
        .form_error {
            color: #e53e3e;
            font-size: 13px;
            margin-top: 6px;
        }
        .form_actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #edf2f7;
        }
        .btn_save {
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            color: #fff;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .btn_save:hover {
            transform: translateY(-2px);
            opacity: 0.9;
        }
        .btn_cancel {
            background: #f7fafc;
            color: #718096;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #e2e8f0;
        }
        .btn_cancel:hover {
            background: #edf2f7;
        }
        .radio_group {
            display: flex;
            gap: 20px;
            background: #f8fafc;
            padding: 14px;
            border-radius: 10px;
        }
        .radio_item {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        .radio_item input {
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block content %}
<div class="form_card">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px dashed #eee;">
            <div style="width: 80px; height: 80px; border-radius: 50%; padding: 4px; border: 2px solid #fa9e1b; background: #fff; box-shadow: 0 5px 15px rgba(0,0,0,0.08);">
                <img src="{{ user.id ? user.avatarUrl : 'https://api.dicebear.com/8.x/avataaars/svg?seed=new-user' }}" 
                     alt="Avatar" 
                     style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
            </div>
            <div>
                <h3 style="margin: 0; font-size: 18px; color: #1a1a2e;">Profil Utilisateur</h3>
                <p style="margin: 0; font-size: 13px; color: #888;">Générez ou modifiez l'identité visuelle de votre client.</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="form_group">
                    <label class="form_label">{{ form_label(form.prenom) }}</label>
                    {{ form_widget(form.prenom, {'attr': {'class': 'form_control'}}) }}
                    <div class="form_error">{{ form_errors(form.prenom) }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form_group">
                    <label class="form_label">{{ form_label(form.nom) }}</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form_control'}}) }}
                    <div class="form_error">{{ form_errors(form.nom) }}</div>
                </div>
            </div>
        </div>

        <div class="form_group">
            <label class="form_label">{{ form_label(form.email) }}</label>
            {{ form_widget(form.email, {'attr': {'class': 'form_control'}}) }}
            <div class="form_error">{{ form_errors(form.email) }}</div>
        </div>

        <div class="form_group">
            <label class="form_label">{{ form_label(form.plainPassword) }}</label>
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form_control'}}) }}
            <div class="form_error">{{ form_errors(form.plainPassword) }}</div>
        </div>

        <div class="row">
            <div class="col-md-4">
                <div class="form_group">
                    <label class="form_label">{{ form_label(form.type) }}</label>
                    {{ form_widget(form.type, {'attr': {'class': 'form_control'}}) }}
                    <div class="form_error">{{ form_errors(form.type) }}</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form_group">
                    <label class="form_label">{{ form_label(form.telephone) }}</label>
                    {{ form_widget(form.telephone, {'attr': {'class': 'form_control'}}) }}
                    <div class="form_error">{{ form_errors(form.telephone) }}</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form_group">
                    <label class="form_label">{{ form_label(form.age) }}</label>
                    {{ form_widget(form.age, {'attr': {'class': 'form_control'}}) }}
                    <div class="form_error">{{ form_errors(form.age) }}</div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="form_group">
                    <label class="form_label">{{ form_label(form.genre) }}</label>
                    {{ form_widget(form.genre, {'attr': {'class': 'form_control'}}) }}
                    <div class="form_error">{{ form_errors(form.genre) }}</div>
                </div>
            </div>
        </div>

        <div class="form_group">
            <label class="form_label">{{ form_label(form.isVerified) }}</label>
            <div class="radio_group">
                {% for child in form.isVerified %}
                    <label class="radio_item">
                        {{ form_widget(child) }}
                        {{ child.vars.label }}
                    </label>
                {% endfor %}
            </div>
            <div class="form_error">{{ form_errors(form.isVerified) }}</div>
        </div>

        <div class="form_actions">
            <a href="{{ path('admin_users') }}" class="btn_cancel">Annuler</a>
            <button type="submit" class="btn_save">
                <i class="fa fa-save"></i> Enregistrer
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
