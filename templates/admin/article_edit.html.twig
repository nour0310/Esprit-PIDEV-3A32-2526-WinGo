{% extends 'admin/base_admin.html.twig' %}
{% block title %}Modifier l'article - Admin WinGo{% endblock %}
{% block page_title %}Modifier un article{% endblock %}

{% block content %}
<style>
    .admin-form-container {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        padding: 40px;
        max-width: 900px;
        margin: 0 auto;
    }
    .form-group {
        margin-bottom: 25px;
    }
    .form-label {
        display: block;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 0.95rem;
    }
    .form-control-custom {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid #e1e8ed;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: #f8f9fa;
        color: #333;
    }
    .form-control-custom:focus {
        border-color: #fa9e1b;
        background-color: #fff;
        outline: none;
        box-shadow: 0 0 0 4px rgba(250, 158, 27, 0.1);
    }
    .form-error {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
        font-weight: 500;
    }
    .btn-submit {
        background: #fa9e1b;
        color: white;
        border: none;
        padding: 14px 30px;
        font-size: 1.05rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.3s, transform 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }
    .btn-submit:hover {
        background: #e08b15;
        transform: translateY(-2px);
    }
    .btn-cancel {
        color: #7f8c8d;
        text-decoration: none;
        font-weight: 600;
        margin-left: 20px;
        transition: color 0.3s;
    }
    .btn-cancel:hover {
        color: #34495e;
    }
    .image-preview-container {
        background: #f1f4f6;
        padding: 15px;
        border-radius: 8px;
        margin-top: 15px;
        display: inline-block;
        border: 1px dashed #bdc3c7;
    }
</style>

<div class="data_card" style="background: transparent; box-shadow: none;">
    <div class="admin-form-container">
        <h2 style="margin-top: 0; color: #2c3e50; font-size: 1.8rem; margin-bottom: 30px; border-bottom: 2px solid #f1f4f6; padding-bottom: 15px;">
            <i class="fa fa-pencil" style="color: #fa9e1b; margin-right: 10px;"></i>
            Édition de l'article #{{ article.id }}
        </h2>
        
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
            
            <div class="form-group">
                {{ form_label(form.titre, 'Titre de l\'article', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'form-control-custom', 'placeholder': 'Saisissez un titre attractif'}}) }}
                <div class="form-error">{{ form_errors(form.titre) }}</div>
            </div>
            
            <div class="form-group">
                {{ form_label(form.contenu, 'Contenu principal', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.contenu, {'attr': {'class': 'form-control-custom', 'rows': 8, 'placeholder': 'Rédigez le contenu de l\'article ici...'}}) }}
                <div class="form-error">{{ form_errors(form.contenu) }}</div>
            </div>
            
            <div style="display: flex; gap: 20px;">
                <div class="form-group" style="flex: 1;">
                    {{ form_label(form.region, 'Région', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.region, {'attr': {'class': 'form-control-custom'}}) }}
                    <div class="form-error">{{ form_errors(form.region) }}</div>
                </div>
                <div class="form-group" style="flex: 1;">
                    {{ form_label(form.categorie, 'Catégorie', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-control-custom'}}) }}
                    <div class="form-error">{{ form_errors(form.categorie) }}</div>
                </div>
            </div>
            
            <div class="form-group">
                {{ form_label(form.image, 'Image de couverture (laissez vide pour conserver l\'image actuelle)', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.image, {'attr': {'class': 'form-control-custom', 'style': 'padding: 10px; background: white;'}}) }}
                <div class="form-error">{{ form_errors(form.image) }}</div>
                
                {% if article.image %}
                    <div class="image-preview-container">
                        <p style="margin: 0 0 10px 0; font-size: 0.85rem; color: #7f8c8d; font-weight: 600;">Image actuelle en ligne :</p>
                        <img src="{{ asset('uploads/articles/' ~ article.image) }}" onerror="this.src='{{ asset('images/placeholder.svg') }}'" alt="Aperçu" style="max-height: 140px; border-radius: 6px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                    </div>
                {% endif %}
            </div>
            
            <div style="margin-top: 40px; border-top: 2px solid #f1f4f6; padding-top: 25px; display: flex; align-items: center;">
                <button type="submit" class="btn-submit">
                    <i class="fa fa-save"></i> Enregistrer l'article
                </button>
                <a href="{{ path('admin_articles') }}" class="btn-cancel">Annuler et retourner</a>
            </div>
            
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
