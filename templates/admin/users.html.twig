{% extends 'admin/base_admin.html.twig' %}
{% block title %}Utilisateurs - Admin WinGo{% endblock %}
{% block page_title %}Gestion des Utilisateurs{% endblock %}

{% block content %}
<!-- Stats Section -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon orange"><i class="fa fa-users"></i></div>
            <div>
                <div class="stat_num">{{ stats.total }}</div>
                <div class="stat_label">Total Utilisateurs</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon purple"><i class="fa fa-user-secret"></i></div>
            <div>
                <div class="stat_num">{{ stats.admins }}</div>
                <div class="stat_label">Administrateurs</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon blue"><i class="fa fa-store"></i></div>
            <div>
                <div class="stat_num">{{ stats.merchants }}</div>
                <div class="stat_label">Commerçants</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon green"><i class="fa fa-shield"></i></div>
            <div>
                <div class="stat_num">{{ stats.avg_reliability }}%</div>
                <div class="stat_label">Fiabilité Moyenne</div>
            </div>
        </div>
    </div>
</div>

<div class="data_card">
    <div class="data_card_header">
        <div class="data_card_title"><i class="fa fa-list" style="color:#fa9e1b"></i> Liste des utilisateurs ({{ users|length }})</div>
    </div>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Nom complet</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Âge</th>
                <th>Rôle</th>
                <th>Vérifié</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td><strong>{{ user.fullName }}</strong></td>
                <td>{{ user.email }}</td>
                <td>{{ user.telephone ?? '-' }}</td>
                <td>{{ user.age ?? '-' }}</td>
                <td>
                    {% if user.isAdmin %}
                        <span class="badge_status badge_admin">Admin</span>
                    {% else %}
                        <span class="badge_status badge_client">Client</span>
                    {% endif %}
                </td>
                <td>
                    {% if user.isVerified %}
                        <span style="color:#4CAF50"><i class="fa fa-check-circle"></i></span>
                    {% else %}
                        <span style="color:#ccc"><i class="fa fa-times-circle"></i></span>
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr><td colspan="7" style="text-align:center;color:#aaa;padding:40px;">Aucun utilisateur</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
