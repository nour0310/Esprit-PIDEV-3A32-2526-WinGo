{% extends 'admin/base_admin.html.twig' %}

{% block title %}Espace admin - WinGo{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block content %}
<!-- Stats -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon orange"><i class="fa fa-users"></i></div>
            <div>
                <div class="stat_num">{{ total_users }}</div>
                <div class="stat_label">Utilisateurs</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon purple"><i class="fa fa-newspaper-o"></i></div>
            <div>
                <div class="stat_num">{{ total_articles }}</div>
                <div class="stat_label">Articles</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon blue"><i class="fa fa-calendar-check-o"></i></div>
            <div>
                <div class="stat_num">{{ total_reservations }}</div>
                <div class="stat_label">Réservations</div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat_card">
            <div class="stat_icon red"><i class="fa fa-exclamation-circle"></i></div>
            <div>
                <div class="stat_num">{{ total_reclamations }}</div>
                <div class="stat_label">Réclamations</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="data_card">
            <div class="data_card_header">
                <div class="data_card_title"><i class="fa fa-bolt" style="color:#fa9e1b"></i> Accès rapide</div>
            </div>
           <div style="padding: 20px 24px; display:flex; flex-wrap:wrap; gap:12px;">
    <a href="{{ path('admin_users') }}" class="topbar_btn"><i class="fa fa-users"></i> Gérer utilisateurs</a>
    <a href="{{ path('admin_articles') }}" class="topbar_btn"><i class="fa fa-newspaper-o"></i> Gérer articles</a>
    <a href="{{ path('admin_reclamations') }}" class="topbar_btn"><i class="fa fa-exclamation-circle"></i> Réclamations</a>
    <a href="{{ path('admin_produits') }}" class="topbar_btn"><i class="fa fa-shopping-bag"></i> Produits</a>
    <a href="{{ path('admin_transports') }}" class="topbar_btn"><i class="fa fa-bus"></i> Transports</a>
    <a href="{{ path('admin_demandes_commercant') }}" class="topbar_btn"><i class="fa fa-store"></i> Commerçants</a>
    <a href="{{ path('admin_commandes') }}" class="topbar_btn"><i class="fa fa-shopping-cart"></i> Commandes</a>
</div>
        </div>
    </div>
</div>

<!-- Démographie & Ages -->
<div class="row mb-4">
    <div class="col-12">
        <div class="data_card">
            <div class="data_card_header">
                <div class="data_card_title"><i class="fa fa-pie-chart" style="color:#d32f2f"></i> Démographie par tranche d'âge</div>
                     <div style="padding: 20px 24px; display:flex; flex-wrap:wrap; gap:20px;">
                <div style="flex:1; min-width: 120px; text-align: center; border-right: 1px solid #eee;">
                    <div style="font-size:28px; font-weight:800; color:#fa9e1b; margin-bottom:5px;">{{ stats_age['< 18'] }}</div>
                    <div style="font-size:13px; color:#666; font-weight:600;">Moins de 18 ans</div>
                    <div style="width: 100%; background: #eee; height: 8px; border-radius: 4px; margin-top:10px;">
                        <div style="width: {{ stats_age_percent['< 18'] }}%; background: #fa9e1b; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>

                <div style="flex:1; min-width: 120px; text-align: center; border-right: 1px solid #eee;">
                    <div style="font-size:28px; font-weight:800; color:#8d4fff; margin-bottom:5px;">{{ stats_age['18 - 25'] }}</div>
                    <div style="font-size:13px; color:#666; font-weight:600;">18 - 25 ans</div>
                    <div style="width: 100%; background: #eee; height: 8px; border-radius: 4px; margin-top:10px;">
                        <div style="width: {{ stats_age_percent['18 - 25'] }}%; background: #8d4fff; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>

                <div style="flex:1; min-width: 120px; text-align: center; border-right: 1px solid #eee;">
                    <div style="font-size:28px; font-weight:800; color:#4CAF50; margin-bottom:5px;">{{ stats_age['26 - 40'] }}</div>
                    <div style="font-size:13px; color:#666; font-weight:600;">26 - 40 ans</div>
                    <div style="width: 100%; background: #eee; height: 8px; border-radius: 4px; margin-top:10px;">
                        <div style="width: {{ stats_age_percent['26 - 40'] }}%; background: #4CAF50; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>

                <div style="flex:1; min-width: 120px; text-align: center; border-right: 1px solid #eee;">
                    <div style="font-size:28px; font-weight:800; color:#2196F3; margin-bottom:5px;">{{ stats_age['41 - 60'] }}</div>
                    <div style="font-size:13px; color:#666; font-weight:600;">41 - 60 ans</div>
                    <div style="width: 100%; background: #eee; height: 8px; border-radius: 4px; margin-top:10px;">
                        <div style="width: {{ stats_age_percent['41 - 60'] }}%; background: #2196F3; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>

                <div style="flex:1; min-width: 120px; text-align: center; border-right: 1px solid #eee;">
                    <div style="font-size:28px; font-weight:800; color:#9C27B0; margin-bottom:5px;">{{ stats_age['61 - 80'] }}</div>
                    <div style="font-size:13px; color:#666; font-weight:600;">61 - 80 ans</div>
                    <div style="width: 100%; background: #eee; height: 8px; border-radius: 4px; margin-top:10px;">
                        <div style="width: {{ stats_age_percent['61 - 80'] }}%; background: #9C27B0; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>

                <div style="flex:1; min-width: 120px; text-align: center;">
                    <div style="font-size:28px; font-weight:800; color:#1a1a2e; margin-bottom:5px;">{{ stats_age['> 80'] }}</div>
                    <div style="font-size:13px; color:#666; font-weight:600;">> 80 ans</div>
                    <div style="width: 100%; background: #eee; height: 8px; border-radius: 4px; margin-top:10px;">
                        <div style="width: {{ stats_age_percent['> 80'] }}%; background: #1a1a2e; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>
            </div>    </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent users -->
    <div class="col-lg-6 mb-4">
        <div class="data_card">
            <div class="data_card_header">
                <div class="data_card_title">Derniers utilisateurs</div>
                <a href="{{ path('admin_users') }}" class="data_card_link">Voir tout</a>
            </div>
            <table>
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in recent_users %}
                    <tr>
                        <td>
                            <div style="position: relative; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                                {# Pastille de couleur avec initiales (visible si l'image échoue) #}
                                <div style="position: absolute; width: 100%; height: 100%; background: linear-gradient(135deg, #8d4fff, #fa9e1c); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; box-shadow: 0 2px 5px rgba(0,0,0,0.15); border: 2px solid #fff;">
                                    {{ user.initials }}
                                </div>
                                {# L'image d'avatar (se cache si erreur) #}
                                <img src="{{ user.avatarUrl }}" 
                                     alt="{{ user.initials }}" 
                                     style="position: relative; z-index: 2; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid #fff; transition: opacity 0.3s;"
                                     onerror="this.style.opacity='0';">
                            </div>
                        </td>
                        <td><strong>{{ user.fullName }}</strong></td>
                        <td>{{ user.email }}</td>
                        <td>
                            {% if user.isAdmin %}
                                <span class="badge_status badge_admin">Admin</span>
                            {% else %}
                                <span class="badge_status badge_client">Client</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="4" style="text-align:center;color:#aaa;padding:30px;">Aucun utilisateur</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent reclamations -->
    <div class="col-lg-6 mb-4">
        <div class="data_card">
            <div class="data_card_header">
                <div class="data_card_title">Dernières réclamations</div>
                <a href="{{ path('admin_reclamations') }}" class="data_card_link">Voir tout</a>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Sujet</th>
                        <th>Type</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rec in recent_reclamations %}
                    <tr>
                        <td>{{ rec.sujet ?? 'Sans sujet' }}</td>
                        <td>{{ rec.typeReclamation ?? '-' }}</td>
                        <td>
                            <span class="badge_status {% if rec.statut == 'Résolue' %}badge_done{% else %}badge_pending{% endif %}">
                                {{ rec.statut }}
                            </span>
                        </td>
                    </tr>
                    {% else %}
                    <tr><td colspan="3" style="text-align:center;color:#aaa;padding:30px;">Aucune réclamation</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
