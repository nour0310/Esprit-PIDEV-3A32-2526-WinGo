<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}WinGo - Espace Client{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/bootstrap4/bootstrap.min.css') }}">
    <link href="{{ asset('plugins/font-awesome-4.7.0/css/font-awesome.min.css') }}" rel="stylesheet">
    <style>
        :root { --primary: #fa9e1b; --secondary: #8d4fff; --dark: #1a1a2e; }
        body { font-family: 'Segoe UI', sans-serif; background: #f8f9fa; }

        .client_topbar { background: var(--dark); color: #fff; padding: 0; position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.3); border-bottom: 2px solid rgba(250,158,27,0.5); }
        .client_topbar_inner { display: flex; align-items: center; justify-content: space-between; padding: 0 28px; height: 64px; }
        .brand_logo { font-size: 24px; font-weight: 800; background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; text-decoration: none; }
        .client_nav { display: flex; align-items: center; gap: 4px; }
        .client_nav a { color: rgba(255,255,255,0.75); text-decoration: none; padding: 8px 14px; border-radius: 8px; font-size: 14px; transition: all 0.2s; }
        .client_nav a:hover, .client_nav a.active { color: #fff; background: rgba(255,255,255,0.1); }
        .client_nav a.active { border-bottom: 2px solid var(--primary); border-radius: 8px 8px 0 0; }
        .topbar_user { display: flex; align-items: center; gap: 12px; }
        .user_badge { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.08); padding: 6px 14px 6px 8px; border-radius: 24px; }
        .user_avatar_sm { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--secondary)); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; color: #fff; }
        .user_badge_name { font-size: 13px; font-weight: 600; color: #fff; }
        .btn_logout { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: rgba(255,255,255,0.7); padding: 6px 14px; border-radius: 8px; font-size: 13px; text-decoration: none; transition: all 0.2s; }
        .btn_logout:hover { background: rgba(220,53,69,0.3); color: #ff6b6b; }

        .page_hero { background: linear-gradient(135deg, #0f3460 0%, #16213e 100%); padding: 36px 28px; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.06); }
        .hero_title { font-size: 26px; font-weight: 700; margin: 0; }
        .hero_subtitle { color: rgba(255,255,255,0.6); font-size: 14px; margin-top: 4px; }

        .main_area { padding: 28px; }

        /* Cards */
        .dash_card { background: #fff; border-radius: 14px; padding: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 24px; border: 1px solid rgba(0,0,0,0.04); }
        .dash_card_title { font-size: 16px; font-weight: 700; color: #1a1a2e; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .dash_card_title i { color: var(--primary); }
        .stat_row { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
        .stat_mini { background: #fff; border-radius: 12px; padding: 20px; flex: 1; min-width: 160px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); text-align: center; border: 1px solid rgba(0,0,0,0.04); }
        .stat_mini_num { font-size: 28px; font-weight: 800; background: linear-gradient(135deg, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .stat_mini_label { font-size: 12px; color: #888; margin-top: 4px; }

        /* Article cards */
        .article_grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
        .article_card { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.06); transition: all 0.3s; border: 1px solid rgba(0,0,0,0.04); }
        .article_card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.12); }
        .article_img { height: 180px; background: linear-gradient(135deg, #667eea, #764ba2); position: relative; overflow: hidden; }
        .article_img img { width: 100%; height: 100%; object-fit: cover; }
        .article_img_placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 40px; color: rgba(255,255,255,0.5); }
        .article_cat { position: absolute; top: 12px; left: 12px; background: var(--primary); color: #fff; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; }
        .article_body { padding: 18px; }
        .article_title { font-size: 15px; font-weight: 700; color: #1a1a2e; margin-bottom: 8px; line-height: 1.4; }
        .article_meta { font-size: 12px; color: #aaa; display: flex; gap: 12px; }

        /* Table */
        .data_table { width: 100%; border-collapse: collapse; }
        .data_table th { background: #f8f9fa; padding: 12px 16px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #888; font-weight: 600; }
        .data_table td { padding: 14px 16px; border-bottom: 1px solid #f5f5f5; font-size: 14px; color: #444; }
        .data_table tr:last-child td { border-bottom: none; }
        .data_table tr:hover td { background: #fafbff; }
        .badge_s { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
        .badge_pending { background: #fff8e1; color: #f57f17; }
        .badge_done { background: #e8f5e9; color: #2e7d32; }
        .badge_active { background: #e3f2fd; color: #1565c0; }

        .flash_success { background: #e8f5e9; border-left: 4px solid #4CAF50; color: #2e7d32; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; }
        .flash_error { background: #ffebee; border-left: 4px solid #f44336; color: #c62828; padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; }
        .empty_state { text-align: center; padding: 40px; color: #aaa; font-size: 14px; }
        .empty_state i { font-size: 36px; display: block; margin-bottom: 12px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="client_topbar">
    <div class="client_topbar_inner">
        <a href="{{ path('home') }}" class="brand_logo">WinGo</a>
        <div class="client_nav">
            <a href="{{ path('client_dashboard') }}" class="{% if app.request.attributes.get('_route') == 'client_dashboard' %}active{% endif %}">
                <i class="fa fa-home"></i> Accueil
            </a>
            <a href="{{ path('client_articles') }}" class="{% if app.request.attributes.get('_route') == 'client_articles' %}active{% endif %}">
                <i class="fa fa-newspaper-o"></i> Articles
            </a>
            <a href="{{ path('client_produits') }}" class="{% if app.request.attributes.get('_route') == 'client_produits' %}active{% endif %}">
                <i class="fa fa-shopping-bag"></i> Produits
            </a>
            <a href="{{ path('client_reservations') }}" class="{% if app.request.attributes.get('_route') == 'client_reservations' %}active{% endif %}">
                <i class="fa fa-calendar"></i> Réservations
            </a>
            <a href="{{ path('client_reclamations') }}" class="{% if app.request.attributes.get('_route') == 'client_reclamations' %}active{% endif %}">
                <i class="fa fa-exclamation-circle"></i> Réclamations
            </a>
        </div>
        <div class="topbar_user">
            <a href="{{ path('app_profile') }}" class="user_badge" style="text-decoration:none">
                <div class="user_avatar_sm">{{ app.user.prenom|first|upper }}</div>
                <span class="user_badge_name">{{ app.user.prenom }}</span>
            </a>
            <a href="{{ path('app_logout') }}" class="btn_logout"><i class="fa fa-sign-out"></i></a>
        </div>
    </div>
</nav>

<div class="page_hero">
    <div class="container-fluid">
        <div class="hero_title">{% block page_title %}Mon espace{% endblock %}</div>
        <div class="hero_subtitle">{% block page_subtitle %}Bonjour, {{ app.user.fullName }}{% endblock %}</div>
    </div>
</div>

<div class="main_area">
    <div class="container-fluid">
        {% for message in app.flashes('success') %}
            <div class="flash_success"><i class="fa fa-check-circle"></i> {{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash_error"><i class="fa fa-times-circle"></i> {{ message }}</div>
        {% endfor %}
        {% block content %}{% endblock %}
    </div>
</div>

<script src="{{ asset('js/jquery-3.2.1.min.js') }}"></script>
<script src="{{ asset('styles/bootstrap4/bootstrap.min.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
