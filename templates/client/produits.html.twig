{% extends 'base.html.twig' %}

{% block title %}Produits - WinGo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .client_products_section {
            padding: 180px 0 90px 0;
            background: #f3f6f9;
        }

        .client_products_box {
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            padding: 35px;
            margin-bottom: 35px;
            text-align: center;
        }

        .client_products_title {
            font-size: 42px;
            font-weight: 800;
            color: #2d2c2c;
            margin-bottom: 10px;
        }

        .client_products_subtitle {
            color: #777;
            font-size: 16px;
            margin-bottom: 0;
        }

        .client_product_card {
            background: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            margin-bottom: 30px;
            transition: 0.3s ease;
            height: 100%;
        }

        .client_product_card:hover {
            transform: translateY(-6px);
        }

        .client_product_img {
            height: 240px;
            position: relative;
            background: linear-gradient(to right, #6a85f1, #8d4fff);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .client_product_img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .client_product_placeholder {
            color: rgba(255,255,255,0.75);
            font-size: 54px;
        }

        .client_product_cat {
            position: absolute;
            top: 15px;
            left: 15px;
            background: #fa9e1b;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            padding: 6px 12px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .client_product_body {
            padding: 22px;
        }

        .client_product_title {
            font-size: 24px;
            font-weight: 700;
            color: #2d2c2c;
            margin-bottom: 10px;
        }

        .client_product_desc {
            font-size: 14px;
            color: #777;
            line-height: 1.7;
            margin-bottom: 14px;
            min-height: 70px;
        }

        .client_product_price {
            font-size: 24px;
            font-weight: 800;
            background: linear-gradient(to right, #fa9e1b, #8d4fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .client_product_meta {
            margin-top: 10px;
            color: #929191;
            font-size: 14px;
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .client_stock_badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .client_stock_ok {
            background: rgba(76, 175, 80, 0.14);
            color: #2e7d32;
        }

        .client_stock_empty {
            background: rgba(244, 67, 54, 0.12);
            color: #c62828;
        }

        .client_empty_state {
            padding: 50px 20px;
            text-align: center;
            color: #999;
            font-size: 18px;
            background: #f8f8f8;
            border-radius: 16px;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="client_products_section">
        <div class="container">

            <div class="client_products_box">
                <div class="client_products_title">Boutique WinGo</div>
                <p class="client_products_subtitle">
                    Bonjour, {{ app.user.fullName }}. Découvrez nos produits disponibles.
                </p>
            </div>

            <div class="row">
                {% for p in produits %}
                    <div class="col-lg-4 col-md-6">
                        <div class="client_product_card">
                            <div class="client_product_img">
                                {% if p.image %}
                                    <img src="{{ asset('images/' ~ p.image) }}" alt="{{ p.nom }}" onerror="this.style.display='none'; this.parentNode.querySelector('.client_product_placeholder').style.display='flex';">
                                    <div class="client_product_placeholder" style="display:none">
                                        <i class="fa fa-shopping-bag"></i>
                                    </div>
                                {% else %}
                                    <div class="client_product_placeholder">
                                        <i class="fa fa-shopping-bag"></i>
                                    </div>
                                {% endif %}

                                {% if p.categorie %}
                                    <span class="client_product_cat">{{ p.categorie }}</span>
                                {% endif %}
                            </div>

                            <div class="client_product_body">
                                <div class="client_product_title">{{ p.nom }}</div>

                                {% if p.description %}
                                    <div class="client_product_desc">
                                        {{ p.description|slice(0, 100) }}{% if p.description|length > 100 %}...{% endif %}
                                    </div>
                                {% else %}
                                    <div class="client_product_desc">Pas de description disponible.</div>
                                {% endif %}

                                <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
                                    <div class="client_product_price">{{ p.prix }} TND</div>

                                    {% if p.stock > 0 %}
                                        <span class="client_stock_badge client_stock_ok">En stock ({{ p.stock }})</span>
                                    {% else %}
                                        <span class="client_stock_badge client_stock_empty">Rupture</span>
                                    {% endif %}
                                </div>

                                <div class="client_product_meta">
                                    {% if p.region %}
                                        <span><i class="fa fa-map-marker"></i> {{ p.region }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="client_empty_state">
                            <i class="fa fa-shopping-bag"></i> Aucun produit disponible
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
{% endblock %}