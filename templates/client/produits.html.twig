{% extends 'base.html.twig' %}

{% block title %}Produits - WinGo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .client_products_section {
            padding: 190px 0 110px 0;
            background:
                radial-gradient(circle at top left, rgba(141,79,255,0.18), transparent 30%),
                radial-gradient(circle at top right, rgba(250,158,27,0.18), transparent 30%),
                linear-gradient(180deg, #eef3f8 0%, #f7f9fc 100%);
            min-height: 100vh;
        }

        .products_hero_box {
            position: relative;
            overflow: hidden;
            border-radius: 32px;
            padding: 55px 40px;
            margin-bottom: 55px;
            background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(255,255,255,0.62));
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            box-shadow: 0 18px 50px rgba(31, 38, 135, 0.12);
            border: 1px solid rgba(255,255,255,0.35);
            text-align: center;
        }

        .products_hero_box::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -120px;
            left: -100px;
            background: radial-gradient(circle, rgba(250,158,27,0.22), transparent 70%);
            border-radius: 50%;
        }

        .products_hero_box::after {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            bottom: -140px;
            right: -120px;
            background: radial-gradient(circle, rgba(141,79,255,0.20), transparent 70%);
            border-radius: 50%;
        }

        .products_hero_sub {
            display: inline-block;
            padding: 8px 18px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #fff;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            margin-bottom: 18px;
            position: relative;
            z-index: 2;
        }

        .products_hero_title {
            font-size: 56px;
            font-weight: 900;
            line-height: 1.05;
            margin-bottom: 14px;
            position: relative;
            z-index: 2;
            background: linear-gradient(135deg, #1d2140 10%, #8d4fff 55%, #fa9e1b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .products_hero_text {
            font-size: 18px;
            color: #6f7287;
            max-width: 760px;
            margin: 0 auto 26px auto;
            position: relative;
            z-index: 2;
        }

        .products_top_stats {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
            position: relative;
            z-index: 2;
        }

        .products_stat {
            min-width: 150px;
            padding: 16px 22px;
            border-radius: 20px;
            background: rgba(255,255,255,0.7);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

        .products_stat_num {
            font-size: 24px;
            font-weight: 900;
            margin-bottom: 3px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .products_stat_label {
            font-size: 13px;
            color: #777;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .products_grid {
            margin-top: 10px;
        }

        .wow_product_card {
            position: relative;
            background: rgba(255,255,255,0.92);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 18px 40px rgba(20, 25, 60, 0.10);
            transition: all 0.35s ease;
            height: 100%;
            border: 1px solid rgba(255,255,255,0.55);
        }

        .wow_product_card:hover {
            transform: translateY(-10px) scale(1.01);
            box-shadow: 0 28px 55px rgba(20, 25, 60, 0.18);
        }

        .wow_product_image_wrap {
            position: relative;
            height: 270px;
            overflow: hidden;
            background: linear-gradient(135deg, #5d7cf3 0%, #8d4fff 100%);
        }

        .wow_product_image_wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .wow_product_card:hover .wow_product_image_wrap img {
            transform: scale(1.08);
        }

        .wow_product_image_wrap::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(18,16,40,0.35), rgba(18,16,40,0.02));
        }

        .wow_product_placeholder {
            font-size: 64px;
            color: rgba(255,255,255,0.78);
            position: relative;
            z-index: 2;
        }

        .wow_product_category {
            position: absolute;
            top: 18px;
            left: 18px;
            z-index: 3;
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: #fff;
            background: linear-gradient(135deg, #fa9e1b, #ff7b54);
            box-shadow: 0 10px 25px rgba(250,158,27,0.35);
        }

        .wow_product_stock {
            position: absolute;
            right: 18px;
            bottom: 18px;
            z-index: 3;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            color: #fff;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .wow_product_stock.ok {
            background: rgba(76, 175, 80, 0.82);
        }

        .wow_product_stock.empty {
            background: rgba(220, 53, 69, 0.82);
        }

        .wow_product_body {
            padding: 24px 24px 22px 24px;
        }

        .wow_product_title {
            font-size: 28px;
            font-weight: 900;
            line-height: 1.1;
            color: #1f2235;
            margin-bottom: 12px;
        }

        .wow_product_desc {
            color: #73778a;
            font-size: 14px;
            line-height: 1.8;
            min-height: 78px;
            margin-bottom: 18px;
        }

        .wow_product_bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .wow_product_price {
            font-size: 30px;
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(135deg, #fa9e1b 0%, #8d4fff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .wow_product_region {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #7c8195;
            font-size: 14px;
            font-weight: 600;
        }

        .wow_product_line {
            width: 100%;
            height: 1px;
            background: linear-gradient(to right, rgba(141,79,255,0.25), rgba(250,158,27,0.25));
            margin: 14px 0 16px 0;
        }

        .wow_product_footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .wow_product_tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(141,79,255,0.08);
            color: #6c52c9;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .wow_product_btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 20px;
            border-radius: 999px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            color: #fff !important;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            text-decoration: none !important;
            box-shadow: 0 12px 28px rgba(141,79,255,0.22);
            transition: all 0.3s ease;
        }

        .wow_product_btn:hover {
            transform: translateY(-2px);
            opacity: 0.96;
        }

        .client_empty_state {
            text-align: center;
            padding: 70px 20px;
            border-radius: 24px;
            background: rgba(255,255,255,0.9);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            color: #888;
            font-size: 18px;
        }

        @media (max-width: 991px) {
            .products_hero_title {
                font-size: 40px;
            }

            .products_hero_text {
                font-size: 16px;
            }

            .client_products_section {
                padding-top: 160px;
            }
        }

        .products_hero_box_wow {
    position: relative;
    overflow: hidden;
    border-radius: 34px;
    padding: 65px 45px;
    margin-bottom: 65px;
    background:
        linear-gradient(135deg, rgba(255,255,255,0.88), rgba(255,255,255,0.68));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
        0 20px 60px rgba(26, 35, 80, 0.12),
        inset 0 1px 0 rgba(255,255,255,0.55);
    border: 1px solid rgba(255,255,255,0.45);
    text-align: center;
}

.hero_glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
    z-index: 1;
    pointer-events: none;
}

.hero_glow_1 {
    width: 280px;
    height: 280px;
    top: -80px;
    left: -70px;
    background: radial-gradient(circle, rgba(250,158,27,0.25), transparent 70%);
}

.hero_glow_2 {
    width: 320px;
    height: 320px;
    right: -100px;
    bottom: -120px;
    background: radial-gradient(circle, rgba(141,79,255,0.22), transparent 70%);
}

.products_hero_title_wrap,
.products_hero_sub,
.products_hero_text,
.products_top_stats,
.products_hero_actions {
    position: relative;
    z-index: 2;
}

.products_hero_title_wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.products_hero_title {
    font-size: 64px;
    font-weight: 900;
    line-height: 1;
    margin: 0;
    background: linear-gradient(135deg, #1d2140 10%, #8d4fff 58%, #fa9e1b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.products_hero_badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(255,255,255,0.72);
    color: #6b49d8;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 10px 25px rgba(0,0,0,0.06);
    border: 1px solid rgba(255,255,255,0.65);
}

.products_hero_text {
    font-size: 18px;
    color: #71758a;
    max-width: 780px;
    margin: 0 auto 30px auto;
    line-height: 1.8;
}

.wow_stats {
    gap: 20px;
}

.wow_stat_card {
    min-width: 170px;
    padding: 20px 22px;
    border-radius: 24px;
    background: rgba(255,255,255,0.72);
    box-shadow: 0 12px 30px rgba(0,0,0,0.06);
    border: 1px solid rgba(255,255,255,0.55);
}

.products_stat_icon {
    width: 50px;
    height: 50px;
    margin: 0 auto 12px auto;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 20px;
    background: linear-gradient(135deg, #fa9e1b, #8d4fff);
    box-shadow: 0 12px 28px rgba(141,79,255,0.22);
}

.products_hero_actions {
    margin-top: 34px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
}

.products_hero_btn_main {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 999px;
    background: linear-gradient(135deg, #fa9e1b, #8d4fff);
    color: #fff !important;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    text-decoration: none !important;
    box-shadow: 0 16px 35px rgba(141,79,255,0.24);
    transition: all 0.3s ease;
}

.products_hero_btn_main:hover {
    transform: translateY(-3px);
    opacity: 0.97;
}

.products_hero_note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    border-radius: 999px;
    background: rgba(255,255,255,0.68);
    color: #73738b;
    font-size: 13px;
    font-weight: 700;
    border: 1px solid rgba(255,255,255,0.55);
}

@media (max-width: 991px) {
    .products_hero_box_wow {
        padding: 45px 22px;
    }

    .products_hero_title {
        font-size: 42px;
    }

    .products_hero_text {
        font-size: 16px;
    }

    .wow_stat_card {
        min-width: 140px;
    }
}
    </style>
{% endblock %}

{% block content %}
    <div class="client_products_section">
        <div class="container">

<div class="products_hero_box products_hero_box_wow">
    <div class="hero_glow hero_glow_1"></div>
    <div class="hero_glow hero_glow_2"></div>

    <div class="products_hero_sub">Collection Signature</div>

    <div class="products_hero_title_wrap">
        <h1 class="products_hero_title">Boutique WinGo</h1>
        <div class="products_hero_badge">
            <i class="fa fa-diamond"></i> Sélection Premium
        </div>
    </div>

    <p class="products_hero_text">
        Bonjour, <strong>{{ app.user.fullName }}</strong>. Explorez une vitrine raffinée de produits tunisiens entre artisanat, élégance et authenticité.
    </p>

    <div class="products_top_stats wow_stats">
        <div class="products_stat wow_stat_card">
            <div class="products_stat_icon"><i class="fa fa-shopping-bag"></i></div>
            <div class="products_stat_num">{{ produits|length }}</div>
            <div class="products_stat_label">Produits</div>
        </div>

        <div class="products_stat wow_stat_card">
            <div class="products_stat_icon"><i class="fa fa-check-circle"></i></div>
            <div class="products_stat_num">{{ produits|filter(p => p.stock > 0)|length }}</div>
            <div class="products_stat_label">Disponibles</div>
        </div>

        <div class="products_stat wow_stat_card">
            <div class="products_stat_icon"><i class="fa fa-star"></i></div>
            <div class="products_stat_num">100%</div>
            <div class="products_stat_label">Style local</div>
        </div>
    </div>

    <div class="products_hero_actions">
        <a href="#products-grid" class="products_hero_btn_main">
            Explorer la collection <i class="fa fa-arrow-right"></i>
        </a>
        <div class="products_hero_note">
            <i class="fa fa-sparkles"></i> Design exclusif WinGo
        </div>
    </div>
</div>
            <div class="row products_grid" id="products-grid">
                {% for p in produits %}
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="wow_product_card">
                            <div class="wow_product_image_wrap">
                                {% if p.image %}
                                    <img src="{{ asset('images/' ~ p.image) }}" alt="{{ p.nom }}" onerror="this.style.display='none'; this.parentNode.querySelector('.wow_product_placeholder').style.display='flex';">
                                    <div class="wow_product_placeholder" style="display:none;">
                                        <i class="fa fa-shopping-bag"></i>
                                    </div>
                                {% else %}
                                    <div class="wow_product_placeholder">
                                        <i class="fa fa-shopping-bag"></i>
                                    </div>
                                {% endif %}

                                {% if p.categorie %}
                                    <span class="wow_product_category">{{ p.categorie }}</span>
                                {% endif %}

                                {% if p.stock > 0 %}
                                    <span class="wow_product_stock ok">En stock {{ p.stock }}</span>
                                {% else %}
                                    <span class="wow_product_stock empty">Rupture</span>
                                {% endif %}
                            </div>

                            <div class="wow_product_body">
                                <div class="wow_product_title">{{ p.nom }}</div>

                                <div class="wow_product_desc">
                                    {% if p.description %}
                                        {{ p.description|slice(0, 110) }}{% if p.description|length > 110 %}...{% endif %}
                                    {% else %}
                                        Pas de description disponible pour ce produit.
                                    {% endif %}
                                </div>

                                <div class="wow_product_bottom">
                                    <div class="wow_product_price">{{ p.prix }} TND</div>

                                    {% if p.region %}
                                        <div class="wow_product_region">
                                            <i class="fa fa-map-marker"></i>
                                            {{ p.region }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="wow_product_line"></div>

                                <div class="wow_product_footer">
                                    <div class="wow_product_tag">
                                        <i class="fa fa-diamond"></i>
                                        Produit local
                                    </div>

                                    <a href="{{ path('client_dashboard') }}" class="wow_product_btn">
                                        Explorer
                                        <i class="fa fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="client_empty_state">
                            <i class="fa fa-shopping-bag"></i><br><br>
                            Aucun produit disponible pour le moment.
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
{% endblock %}