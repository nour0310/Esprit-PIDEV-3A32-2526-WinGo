{% extends 'base.html.twig' %}

{% block title %}Produits - WinGo{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .client_products_section {
            padding: 190px 0 110px 0;
            background:
                radial-gradient(circle at top left, rgba(141,79,255,0.10), transparent 28%),
                radial-gradient(circle at top right, rgba(250,158,27,0.10), transparent 28%),
                linear-gradient(180deg, #eef3f8 0%, #f7f9fc 100%);
            min-height: 100vh;
        }

        .products_hero_box_wow {
            position: relative;
            overflow: hidden;
            border-radius: 34px;
            padding: 60px 40px;
            margin-bottom: 60px;
            background: linear-gradient(135deg, rgba(255,255,255,0.88), rgba(255,255,255,0.68));
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            box-shadow: 0 20px 60px rgba(26, 35, 80, 0.10);
            border: 1px solid rgba(255,255,255,0.45);
            text-align: center;
        }

        .hero_glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(10px);
            z-index: 1;
            pointer-events: none;
        }

        .hero_glow_1 {
            width: 280px;
            height: 280px;
            top: -80px;
            left: -70px;
            background: radial-gradient(circle, rgba(250,158,27,0.22), transparent 70%);
        }

        .hero_glow_2 {
            width: 320px;
            height: 320px;
            right: -100px;
            bottom: -120px;
            background: radial-gradient(circle, rgba(141,79,255,0.18), transparent 70%);
        }

        .products_hero_sub,
        .products_hero_title_wrap,
        .products_hero_text,
        .products_top_stats,
        .products_hero_actions {
            position: relative;
            z-index: 2;
        }

        .products_hero_sub {
            display: inline-block;
            padding: 8px 18px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #fff;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            margin-bottom: 18px;
        }

        .products_hero_title_wrap {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .products_hero_title {
            font-size: 58px;
            font-weight: 900;
            line-height: 1;
            margin: 0;
            background: linear-gradient(135deg, #1d2140 10%, #8d4fff 58%, #fa9e1b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .products_hero_badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 999px;
            background: rgba(255,255,255,0.72);
            color: #6b49d8;
            font-size: 13px;
            font-weight: 800;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border: 1px solid rgba(255,255,255,0.65);
        }

        .products_hero_text {
            font-size: 18px;
            color: #71758a;
            max-width: 780px;
            margin: 0 auto 30px auto;
            line-height: 1.8;
        }

        .products_top_stats {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .wow_stat_card {
            min-width: 170px;
            padding: 18px 22px;
            border-radius: 22px;
            background: rgba(255,255,255,0.72);
            box-shadow: 0 12px 30px rgba(0,0,0,0.05);
            border: 1px solid rgba(255,255,255,0.55);
        }

        .products_stat_icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 12px auto;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
        }

        .products_stat_num {
            font-size: 24px;
            font-weight: 900;
            margin-bottom: 3px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .products_stat_label {
            font-size: 13px;
            color: #777;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .products_hero_actions {
            margin-top: 32px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .products_hero_btn_main {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 15px 28px;
            border-radius: 999px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            color: #fff !important;
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            text-decoration: none !important;
            box-shadow: 0 16px 35px rgba(141,79,255,0.20);
            transition: all 0.3s ease;
        }

        .products_hero_btn_main:hover {
            transform: translateY(-3px);
            opacity: 0.97;
        }

        .products_hero_note {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 18px;
            border-radius: 999px;
            background: rgba(255,255,255,0.68);
            color: #73738b;
            font-size: 13px;
            font-weight: 700;
            border: 1px solid rgba(255,255,255,0.55);
        }

        .products_grid {
            margin-top: 10px;
        }

        .product_hover_card {
            position: relative;
            border-radius: 28px;
            overflow: hidden;
            background: rgba(255,255,255,0.92);
            box-shadow: 0 16px 38px rgba(25, 30, 70, 0.10);
            height: 360px;
            transition: all 0.35s ease;
        }

        .product_hover_card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 55px rgba(25, 30, 70, 0.16);
        }

        .product_image_zone {
            position: absolute;
            inset: 0;
            height: 100%;
            width: 100%;
            background: linear-gradient(135deg, #5d7cf3, #8d4fff);
        }

        .product_image_zone img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product_image_zone::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(17,17,30,0.22), rgba(17,17,30,0.03));
        }

        .product_placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.80);
            font-size: 58px;
        }

        .product_category_badge {
            position: absolute;
            top: 18px;
            left: 18px;
            z-index: 4;
            padding: 9px 16px;
            border-radius: 999px;
            background: linear-gradient(135deg, #fa9e1b, #ff7b54);
            color: #fff;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .product_stock_badge {
            position: absolute;
            right: 18px;
            bottom: 18px;
            z-index: 4;
            padding: 9px 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 800;
            color: #fff;
            background: linear-gradient(135deg, #43a047, #66bb6a);
        }

        .product_basic_content {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 3;
            padding: 22px 22px 20px 22px;
            background: linear-gradient(to top, rgba(255,255,255,0.98), rgba(255,255,255,0.88));
            transition: all 0.35s ease;
        }

        .product_title_basic {
            font-size: 28px;
            font-weight: 900;
            color: #1f2235;
            margin-bottom: 10px;
            line-height: 1.05;
        }

        .product_price_basic {
            font-size: 28px;
            font-weight: 900;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 6px;
        }

        .product_region_basic {
            color: #7b8095;
            font-size: 14px;
            font-weight: 600;
        }

        .product_hover_details {
            position: absolute;
            inset: auto 0 0 0;
            z-index: 5;
            padding: 28px 22px 22px 22px;
            background: rgba(255,255,255,0.98);
            transform: translateY(105%);
            opacity: 0;
            transition: all 0.38s ease;
            min-height: 58%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .product_hover_card:hover .product_hover_details {
            transform: translateY(0);
            opacity: 1;
        }

        .product_hover_card:hover .product_basic_content {
            opacity: 0;
            transform: translateY(20px);
        }

        .product_hover_label {
            display: inline-block;
            width: fit-content;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(141,79,255,0.10);
            color: #7157d8;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .product_hover_title {
            font-size: 34px;
            font-weight: 900;
            line-height: 1.02;
            color: #1f2235;
            margin-bottom: 14px;
        }

        .product_hover_desc {
            font-size: 14px;
            color: #73778a;
            line-height: 1.8;
            margin-bottom: 16px;
        }

        .product_hover_meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 18px;
        }

        .product_hover_price {
            font-size: 32px;
            font-weight: 900;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .product_hover_region {
            color: #7a8094;
            font-size: 14px;
            font-weight: 600;
        }

        .product_hover_actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .product_hover_tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 14px;
            border-radius: 999px;
            background: rgba(141,79,255,0.08);
            color: #6c52c9;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .product_hover_btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px;
            border-radius: 999px;
            background: linear-gradient(135deg, #fa9e1b, #8d4fff);
            color: #fff !important;
            text-decoration: none !important;
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .client_empty_state {
            text-align: center;
            padding: 70px 20px;
            border-radius: 24px;
            background: rgba(255,255,255,0.9);
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            color: #888;
            font-size: 18px;
        }

        @media (max-width: 991px) {
            .client_products_section {
                padding-top: 160px;
            }

            .products_hero_box_wow {
                padding: 45px 22px;
            }

            .products_hero_title {
                font-size: 42px;
            }

            .products_hero_text {
                font-size: 16px;
            }

            .wow_stat_card {
                min-width: 140px;
            }

            .product_hover_card {
                height: auto;
                min-height: 360px;
            }

            .product_hover_details {
                position: relative;
                transform: none;
                opacity: 1;
                min-height: auto;
            }

            .product_basic_content {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="client_products_section">
        <div class="container">

            <div class="products_hero_box_wow">
                <div class="hero_glow hero_glow_1"></div>
                <div class="hero_glow hero_glow_2"></div>

                <div class="products_hero_sub">Collection Signature</div>

                <div class="products_hero_title_wrap">
                    <h1 class="products_hero_title">Boutique WinGo</h1>
                    <div class="products_hero_badge">
                        <i class="fa fa-diamond"></i> Sélection Premium
                    </div>
                </div>

                <p class="products_hero_text">
                    Bonjour, <strong>{{ app.user.fullName }}</strong>. Découvrez une présentation élégante : affichage simple au départ, puis détails premium au survol.
                </p>

                <div class="products_top_stats">
                    <div class="wow_stat_card">
                        <div class="products_stat_icon"><i class="fa fa-shopping-bag"></i></div>
                        <div class="products_stat_num">{{ produits|length }}</div>
                        <div class="products_stat_label">Produits</div>
                    </div>

                    <div class="wow_stat_card">
                        <div class="products_stat_icon"><i class="fa fa-check-circle"></i></div>
                        <div class="products_stat_num">{{ produits|filter(p => p.stock > 0)|length }}</div>
                        <div class="products_stat_label">Disponibles</div>
                    </div>

                    <div class="wow_stat_card">
                        <div class="products_stat_icon"><i class="fa fa-star"></i></div>
                        <div class="products_stat_num">Hover</div>
                        <div class="products_stat_label">Effet interactif</div>
                    </div>
                </div>

                <div class="products_hero_actions">
                    <a href="#products-grid" class="products_hero_btn_main">
                        Voir les produits <i class="fa fa-arrow-right"></i>
                    </a>
                    <div class="products_hero_note">
                        <i class="fa fa-diamond"></i> Affichage dynamique
                    </div>
                </div>
            </div>

            <div class="row products_grid" id="products-grid">
                {% for p in produits %}
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="product_hover_card">

                            <div class="product_image_zone">
                                {% if p.image %}
                                    <img src="{{ asset('images/' ~ p.image) }}" alt="{{ p.nom }}">
                                {% else %}
                                    <div class="product_placeholder"><i class="fa fa-shopping-bag"></i></div>
                                {% endif %}
                            </div>

                            {% if p.categorie %}
                                <span class="product_category_badge">{{ p.categorie }}</span>
                            {% endif %}

                            {% if p.stock > 0 %}
                                <span class="product_stock_badge">En stock {{ p.stock }}</span>
                            {% endif %}

                            <div class="product_basic_content">
                                <div class="product_title_basic">{{ p.nom }}</div>
                                <div class="product_price_basic">{{ p.prix }} TND</div>
                                {% if p.region %}
                                    <div class="product_region_basic"><i class="fa fa-map-marker"></i> {{ p.region }}</div>
                                {% endif %}
                            </div>

                            <div class="product_hover_details">
                                <div class="product_hover_label">Produit vedette</div>
                                <div class="product_hover_title">{{ p.nom }}</div>

                                <div class="product_hover_desc">
                                    {% if p.description %}
                                        {{ p.description|slice(0, 120) }}{% if p.description|length > 120 %}...{% endif %}
                                    {% else %}
                                        Pas de description disponible pour ce produit.
                                    {% endif %}
                                </div>

                                <div class="product_hover_meta">
                                    <div class="product_hover_price">{{ p.prix }} TND</div>
                                    {% if p.region %}
                                        <div class="product_hover_region"><i class="fa fa-map-marker"></i> {{ p.region }}</div>
                                    {% endif %}
                                </div>

                                <div class="product_hover_actions">
                                    <div class="product_hover_tag">
                                        <i class="fa fa-diamond"></i> Produit local
                                    </div>

                                    <a href="{{ path('client_dashboard') }}" class="product_hover_btn">
                                        Explorer <i class="fa fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="client_empty_state">
                            <i class="fa fa-shopping-bag"></i><br><br>
                            Aucun produit disponible pour le moment.
                        </div>
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
{% endblock %}