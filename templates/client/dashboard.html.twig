{% extends 'client/base_client.html.twig' %}
{% block title %}Mon Dashboard - WinGo{% endblock %}
{% block page_title %}Mon Tableau de Bord{% endblock %}
{% block page_subtitle %}Bienvenue, {{ app.user.fullName }} ! Voici votre espace personnel.{% endblock %}

{% block content %}
<!-- Stats -->
<div class="stat_row">
    <div class="stat_mini">
        <div class="stat_mini_num">{{ my_reservations|length }}</div>
        <div class="stat_mini_label"><i class="fa fa-calendar"></i> Réservations</div>
    </div>
    <div class="stat_mini">
        <div class="stat_mini_num">{{ my_commandes|length }}</div>
        <div class="stat_mini_label"><i class="fa fa-shopping-cart"></i> Commandes</div>
    </div>
    <div class="stat_mini">
        <div class="stat_mini_num">{{ recent_articles|length }}</div>
        <div class="stat_mini_label"><i class="fa fa-newspaper-o"></i> Articles</div>
    </div>
    <div class="stat_mini">
        <div class="stat_mini_num">{{ my_reclamations|length }}</div>
        <div class="stat_mini_label"><i class="fa fa-exclamation-circle"></i> Réclamations</div>
    </div>
</div>

<!-- Quick Actions -->
<div class="dash_card">
    <div class="dash_card_title"><i class="fa fa-bolt"></i> Actions rapides</div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="{{ path('client_articles') }}" style="background:linear-gradient(135deg,#fa9e1b,#8d4fff);color:#fff;padding:10px 20px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600;">
            <i class="fa fa-newspaper-o"></i> Voir les articles
        </a>
        <a href="{{ path('client_produits') }}" style="background:linear-gradient(135deg,#2196F3,#0d47a1);color:#fff;padding:10px 20px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600;">
            <i class="fa fa-shopping-bag"></i> Explorer les produits
        </a>
        <a href="{{ path('client_reservations') }}" style="background:linear-gradient(135deg,#4CAF50,#1b5e20);color:#fff;padding:10px 20px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600;">
            <i class="fa fa-calendar-plus-o"></i> Mes réservations
        </a>
        <a href="{{ path('app_profile') }}" style="background:linear-gradient(135deg,#607D8B,#263238);color:#fff;padding:10px 20px;border-radius:10px;text-decoration:none;font-size:14px;font-weight:600;">
            <i class="fa fa-user"></i> Mon profil
        </a>
    </div>
</div>

<!-- Recent Articles -->
<div class="dash_card">
    <div class="dash_card_title"><i class="fa fa-newspaper-o"></i> Articles récents</div>
    <div class="article_grid">
        {% for article in recent_articles %}
        <div class="article_card">
            <div class="article_img">
                {% if article.image %}
                    <img src="{{ article.image }}" alt="{{ article.titre }}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                    <div class="article_img_placeholder" style="display:none"><i class="fa fa-image"></i></div>
                {% else %}
                    <div class="article_img_placeholder"><i class="fa fa-image"></i></div>
                {% endif %}
                {% if article.categorie %}
                    <span class="article_cat">{{ article.categorie }}</span>
                {% endif %}
            </div>
            <div class="article_body">
                <div class="article_title">{{ article.titre }}</div>
                <div class="article_meta">
                    {% if article.region %}<span><i class="fa fa-map-marker"></i> {{ article.region }}</span>{% endif %}
                    {% if article.datePublication %}<span><i class="fa fa-clock-o"></i> {{ article.datePublication|date('d/m/Y') }}</span>{% endif %}
                </div>
            </div>
        </div>
        {% else %}
        <div class="empty_state" style="grid-column:1/-1"><i class="fa fa-newspaper-o"></i> Aucun article disponible</div>
        {% endfor %}
    </div>
</div>

{% if my_reclamations|length > 0 %}
<div class="dash_card">
    <div class="dash_card_title"><i class="fa fa-exclamation-circle"></i> Mes dernières réclamations</div>
    <table class="data_table">
        <thead><tr><th>Sujet</th><th>Type</th><th>Statut</th><th>Date</th></tr></thead>
        <tbody>
            {% for rec in my_reclamations %}
            <tr>
                <td>{{ rec.sujet ?? 'Sans sujet' }}</td>
                <td>{{ rec.typeReclamation ?? '-' }}</td>
                <td><span class="badge_s badge_pending">{{ rec.statut }}</span></td>
                <td>{{ rec.dateReclamation ? rec.dateReclamation|date('d/m/Y') : '-' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
