<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720" prefWidth="1200"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controlles.UtilisateurController">

    <!-- BACKGROUND -->
    <Pane mouseTransparent="true"
          style="-fx-background-image: url('/assets/testt.png');
                 -fx-background-size: cover;
                 -fx-background-position: center;" />

    <!-- DARK OVERLAY -->
    <Pane mouseTransparent="true"
          style="-fx-background-color: rgba(0,0,0,0.25);" />

    <!-- GLASS CONTAINER -->
    <BorderPane maxWidth="1100" maxHeight="650"
                style="-fx-background-color: rgba(0,0,0,0.25);
                       -fx-background-radius: 26;
                       -fx-border-color: rgba(255,255,255,0.18);
                       -fx-border-radius: 26;">

        <effect>
            <DropShadow radius="25" offsetY="10" color="#00000066"/>
        </effect>

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: rgba(0,0,0,0.30);
                         -fx-background-radius: 26 26 18 18;">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Button text="← Back"
                        onAction="#backToDashboard"
                        style="-fx-background-color: rgba(255,255,255,0.2);
                               -fx-text-fill: white;
                               -fx-background-radius: 10;
                               -fx-padding: 8 14;" />
                <Label text="👤 Gestion Utilisateurs"
                       style="-fx-text-fill: white;
                              -fx-font-size: 20px;
                              -fx-font-weight: 900;" />

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔔"
                        style="-fx-background-color: rgba(255,255,255,0.12);
                               -fx-text-fill: white;
                               -fx-background-radius: 14;
                               -fx-padding: 8 14;" />

                <Button text="⚙"
                        style="-fx-background-color: #FFBD00;
                               -fx-text-fill: #390099;
                               -fx-background-radius: 14;
                               -fx-padding: 8 14;
                               -fx-font-weight: 900;" />
            </HBox>
        </top>

        <!-- CENTER CONTENT -->
        <center>
            <VBox spacing="20">
                <padding>
                    <Insets top="25" right="25" bottom="25" left="25"/>
                </padding>

                <!-- FORM CARD -->
                <StackPane style="-fx-background-color: rgba(0,0,0,0.35);
                                  -fx-background-radius: 22;
                                  -fx-border-color: rgba(255,255,255,0.18);
                                  -fx-border-radius: 22;">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <VBox spacing="15">

                        <Label text="✨ Nouveau Utilisateur"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 18px;
                                      -fx-font-weight: 900;" />

                        <GridPane hgap="15" vgap="15">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <!-- NOM -->
                            <TextField fx:id="nomField" promptText="👤 Nom"
                                       GridPane.rowIndex="0" GridPane.columnIndex="0"
                                       style="-fx-background-color: rgba(255,255,255,0.12);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.6);
                                              -fx-padding: 10;" />

                            <!-- PRENOM -->
                            <TextField fx:id="prenomField" promptText="🧑 Prenom"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       style="-fx-background-color: rgba(255,255,255,0.12);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.6);
                                              -fx-padding: 10;" />

                            <!-- EMAIL -->
                            <TextField fx:id="emailField" promptText="📧 Email"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0"
                                       style="-fx-background-color: rgba(255,255,255,0.12);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-padding: 10;" />

                            <!-- PASSWORD -->
                            <PasswordField fx:id="passwordField" promptText="🔒 Mot de passe"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1"
                                           style="-fx-background-color: rgba(255,255,255,0.12);
                                                  -fx-background-radius: 12;
                                                  -fx-text-fill: white;
                                                  -fx-padding: 10;" />

                            <!-- TYPE -->
                            <TextField fx:id="typeField" promptText="🎭 Type (admin/user)"
                                       GridPane.rowIndex="2" GridPane.columnIndex="0"
                                       style="-fx-background-color: rgba(255,255,255,0.12);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-padding: 10;" />

                            <!-- TELEPHONE -->
                            <TextField fx:id="telephoneField" promptText="📱 Telephone"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       style="-fx-background-color: rgba(255,255,255,0.12);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-padding: 10;" />

                            <!-- AGE -->
                            <TextField fx:id="ageField" promptText="🎂 Age"
                                       GridPane.rowIndex="3" GridPane.columnIndex="0"
                                       style="-fx-background-color: rgba(255,255,255,0.12);
                                              -fx-background-radius: 12;
                                              -fx-text-fill: white;
                                              -fx-padding: 10;" />

                        </GridPane>

                        <!-- BUTTONS -->
                        <HBox spacing="15" alignment="CENTER_RIGHT">

                            <Button text="🗑 Supprimer"
                                    onAction="#supprimerUtilisateur"
                                    style="-fx-background-color: #FF0054;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 18;
                                           -fx-font-weight: 900;" />

                            <Button text="✏ Modifier"
                                    onAction="#modifierUtilisateur"
                                    style="-fx-background-color: #8338EC;
                                           -fx-text-fill: white;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 18;
                                           -fx-font-weight: 900;" />

                            <Button text="➕ Ajouter"
                                    onAction="#ajouterUtilisateur"
                                    style="-fx-background-color: #FFBD00;
                                           -fx-text-fill: #390099;
                                           -fx-background-radius: 999;
                                           -fx-padding: 10 18;
                                           -fx-font-weight: 900;" />
                        </HBox>

                    </VBox>
                </StackPane>

                <!-- TABLE CARD -->
                <StackPane style="-fx-background-color: rgba(0,0,0,0.35);
                                  -fx-background-radius: 22;
                                  -fx-border-color: rgba(255,255,255,0.18);
                                  -fx-border-radius: 22;">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <TableView fx:id="tableUser"
                               style="-fx-background-color: transparent;
                                      -fx-control-inner-background: rgba(255,255,255,0.08);
                                      -fx-text-fill: white;">

                        <columns>
                            <TableColumn fx:id="colId" text="ID"/>
                            <TableColumn fx:id="colNom" text="Nom"/>
                            <TableColumn fx:id="colPrenom" text="Prenom"/>
                            <TableColumn fx:id="colEmail" text="Email"/>
                            <TableColumn fx:id="colType" text="Type"/>
                            <TableColumn fx:id="colTelephone" text="Telephone"/>
                            <TableColumn fx:id="colAge" text="Age"/>
                        </columns>

                    </TableView>
                </StackPane>

            </VBox>
        </center>

    </BorderPane>
</StackPane>
