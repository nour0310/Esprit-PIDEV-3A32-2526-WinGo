<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controlles.SignupController"
            prefWidth="550" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #1e1e2f, #2b2b45);">

    <children>

        <VBox alignment="CENTER"
              spacing="20"
              AnchorPane.topAnchor="40"
              AnchorPane.leftAnchor="80"
              AnchorPane.rightAnchor="80">

            <!-- Title -->
            <Label text="📝 Create Account"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;" />

            <!-- Card Container -->
            <VBox spacing="15"
                  style="-fx-background-color: #2f2f4f;
                         -fx-padding: 30;
                         -fx-background-radius: 20;">

                <TextField fx:id="nomField"
                           promptText="👤 Nom"
                           style="-fx-background-radius: 10;" />

                <TextField fx:id="prenomField"
                           promptText="👤 Prenom"
                           style="-fx-background-radius: 10;" />

                <TextField fx:id="telephoneField"
                           promptText="📱 Telephone"
                           style="-fx-background-radius: 10;" />

                <TextField fx:id="ageField"
                           promptText="🎂 Age"
                           style="-fx-background-radius: 10;" />

                <TextField fx:id="emailField"
                           promptText="📧 Email"
                           style="-fx-background-radius: 10;" />

                <PasswordField fx:id="passwordField"
                               promptText="🔑 Password"
                               style="-fx-background-radius: 10;" />

                <!-- Register Button -->
                <Button text="✅ Register"
                        onAction="#register"
                        style="-fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 15;" />

                <!-- Back Button -->
                <Button text="⬅ Back to Login"
                        onAction="#backToLogin"
                        style="-fx-background-color: #444;
                               -fx-text-fill: white;
                               -fx-background-radius: 15;" />

                <!-- Message Label -->
                <Label fx:id="messageLabel"
                       style="-fx-text-fill: red;" />

            </VBox>
        </VBox>
    </children>
</AnchorPane>
