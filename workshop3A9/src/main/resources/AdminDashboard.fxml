<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controlles.AdminDashboardController"
            prefWidth="800" prefHeight="500"
            style="-fx-background-color: linear-gradient(to bottom right, #1e1e2f, #2b2b45);">

    <children>

        <VBox spacing="20" alignment="CENTER"
              AnchorPane.topAnchor="40"
              AnchorPane.leftAnchor="40"
              AnchorPane.rightAnchor="40">

            <Label text="👑 Admin Dashboard"
                   style="-fx-text-fill: white;
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;" />

            <HBox spacing="30" alignment="CENTER">

                <Button fx:id="manageUsersButton" text="👥 Manage Users"
                        onAction="#openUsers"
                        prefWidth="180" prefHeight="100"
                        style="-fx-background-color: linear-gradient(to right, #ff512f, #dd2476);
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <Button text="📝 Manage Profiles"
                        onAction="#openProfiles"
                        prefWidth="180" prefHeight="100"
                        style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d);
                               -fx-text-fill: white;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <Button fx:id="backToShopButton" text="🛒 WinGo Shop"
                        onAction="#backToShop"
                        prefWidth="180" prefHeight="100"
                        style="-fx-background-color: linear-gradient(to right, #FFBD00, #ff9500);
                               -fx-text-fill: #390099;
                               -fx-font-size: 16px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <Button text="🚪 Logout"
                        onAction="#logout"
                        prefWidth="150" prefHeight="100"
                        style="-fx-background-color: linear-gradient(to right, #e53935, #e35d5b);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

            </HBox>

        </VBox>

    </children>
</AnchorPane>
